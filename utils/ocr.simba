

{$DEFINE WL_OCR_INCLUDED}
{$INCLUDE_ONCE WaspLib/utils.simba}




function TPixelFont.SameGlyph(const a, b: Char): Boolean;
var
  aN, bN: Integer;
begin
  if a = b then
    Exit(True);
  for aN := 0 to High(Self.Glyphs) do
    if Self.Glyphs[aN].Value = a then
      Break;
  for bN := 0 to High(Self.Glyphs) do
    if Self.Glyphs[bN].Value = b then
      Break;

  Result := Self.GlyphSimilarities[aN, bN] = $FF;
end;


function TPixelFont.SameText(const s1, s2: String): Boolean;
var
  i: Integer;
begin
  if Length(s1) <> Length(s2) then
     Exit(False);
  for i := 1 to Length(s1) do
     if not Self.SameGlyph(s1[i], s2[i]) then
        Exit(False);
  Result := True;
end;


function TPixelFont.ReplaceAlignedGlyphs(const s1, s2: String): String;
var
  i: Integer;
begin
  if Length(s1) > Length(s2) then
    raise GetDebugLn('TPixelFont', 's2 length should be equal or larger than s1');

  SetLength(Result, Length(s1));
  for i := 1 to Length(s1) do
  begin
    if Self.SameGlyph(s1[i], s2[i]) then
      Result[i] := s2[i]
    else
      Result[i] := s1[i];
  end;
end;


function TPixelFont.NormalizeGlyphs(const str, normalized: String): String;
var
  i, j: Integer;
begin
  SetLength(Result, Length(str));
  for i := 1 to Length(str) do
  begin
    for j := 1 to Length(normalized) do
      if Self.SameGlyph(str[i], normalized[j]) then
      begin
        Result[i] := normalized[j];
        Continue(2);
      end;

    Result[i] := str[i];
  end;
end;

var
  TEXT_SHADOW: TColor = $000000;

type

  TOCR = record
    Engine: TPixelOCR;
  end;


function TOCR.RecognizeStatic(bounds: TBox; constref font: TPixelFont; colors: TColorArray; tolerance: Single): String;
var
  img: TImage;
begin
  img := Target.GetImage(bounds);
  img.ReplaceColorBinary(False, colors, tolerance);
  Result := Self.Engine.Recognize(img, font, [0,0]);
end;


function TOCR.RecognizeStaticInvert(bounds: TBox; constref font: TPixelFont; colors: TColorArray): String;
var
  img: TImage;
begin
  img := Target.GetImage(bounds);
  img.ReplaceColorBinary(True, colors);
  Result := Self.Engine.Recognize(img, font, [0,0]);
end;


function TOCR.Recognize(bounds: TBox; constref font: TPixelFont; colors: TColorArray; tolerance: Single): String;
var
  img: TImage;
begin
  img := Target.GetImage(bounds);
  img.ReplaceColorBinary(False, colors, tolerance);
  Result := Self.Engine.Recognize(img, font);
end;


function TOCR.RecognizeLines(bounds: TBox; constref font: TPixelFont; colors: TColorArray; tolerance: Single): TStringArray;
var
  img: TImage;
begin
  img := Target.GetImage(bounds);
  img.ReplaceColorBinary(False, colors, tolerance);
  Result := Self.Engine.RecognizeLines(img, font);
end;


function TOCR.RecognizeShadow(bounds: TBox; constref font: TPixelFont; tolerance: Single): String;
var
  img: TImage;
  shadows: TPointArray;
  colors: TColorArray;
begin
  img := Target.GetImage(bounds);
  shadows := img.FindColor(TEXT_SHADOW, 0, [1, 1, img.Width - 1, img.Height - 1]).Offset([-1,-1]);

  colors := img.GetColors(shadows).Unique();
  colors.Remove(TEXT_SHADOW);
  img.ReplaceColorBinary(False, colors, tolerance);

  Result := Self.Engine.Recognize(img, font);
end;


function TOCR.RecognizeNumber(bounds: TBox; constref font: TPixelFont; colors: TColorArray; tolerance: Single): Integer;
begin
  Result := Self.Recognize(bounds, font, colors, tolerance).ExtractInteger();
end;

function TOCR.Locate(bounds: TBox; Text: String; colors: TColorArray; tolerance: Single; constref font: TPixelFont): Single;
var
  img: TImage;
begin
  img := Target.GetImage(bounds);
  img.ReplaceColorBinary(False, colors, tolerance);
  Result := Self.Engine.Locate(img, font, Text);
end;

function TOCR.LocateInvert(bounds: TBox; Text: String; colors: TColorArray; tolerance: Single; constref font: TPixelFont): Single;
var
  img: TImage;
begin
  img := Target.GetImage(bounds);
  img.ReplaceColorBinary(True, colors, tolerance);
  Result := Self.Engine.Locate(img, font, Text);
end;


var

  OCR: TOCR;

type

  TFonts = record
    PLAIN_11, PLAIN_12,
    BOLD, BOLD_SHADOW,
    VERDANA_11, VERDANA_13, VERDANA_15,
    QUILL_8, QUILL: TPixelFont;

    const WHITE: TColor        = $FFFFFF;
    const BLACK: TColor        = $000000;
    const ORANGE: TColor       = $1F98FF;
    const GREY: TColor         = $9F9F9F;
    const GREEN: TColor        = $00FF00;
    const LIGHT_GREEN: TColor  = $0DC10D;
    const YELLOW: TColor       = $00FFFF;
    const RED: TColor          = $0000FF;
    const BLUE: TColor         = $FF0000;
    const DARK_BLUE: TColor    = $800000;
    const LIGHT_ORANGE: TColor = $3FB8FF;
    const LIGHT_YELLOW: TColor = $A2D8E4;
    const BROWN: TColor        = $002040;
  end;

procedure TFonts.Setup();
begin
  FontLoader.Load();

  Self.PLAIN_11 := OCR.Engine.LoadFont(FontLoader.Fonts[0].GetGlyphImages(), 4);
  Self.PLAIN_12 := OCR.Engine.LoadFont(FontLoader.Fonts[1].GetGlyphImages(), 4);

  Self.BOLD        := OCR.Engine.LoadFont(FontLoader.Fonts[2].GetGlyphImages(), 4);
  Self.BOLD_SHADOW := OCR.Engine.LoadFont(FontLoader.Fonts[2].GetGlyphShadowImages(), 4);

  Self.VERDANA_11 := OCR.Engine.LoadFont(FontLoader.Fonts[3].GetGlyphImages(), 4);
  Self.VERDANA_13 := OCR.Engine.LoadFont(FontLoader.Fonts[4].GetGlyphImages(), 4);
  Self.VERDANA_15 := OCR.Engine.LoadFont(FontLoader.Fonts[5].GetGlyphImages(), 4);

  Self.QUILL_8 := OCR.Engine.LoadFont(FontLoader.Fonts[6].GetGlyphImages(), 4);
  Self.QUILL   := OCR.Engine.LoadFont(FontLoader.Fonts[7].GetGlyphImages(), 4);
end;

var

  Fonts: TFonts;
