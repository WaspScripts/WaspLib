
{$DEFINE WL_DATABASE_INCLUDED}
{$INCLUDE_ONCE WaspLib/utils.simba}

type
  TDatabaseIndex = record
    FirstRow: TStringMap<Integer>;
    NextRow: TIntegerArray;
    IsBuilt: Boolean;
  end;

  TDatabase = record
    Name: String;
    Columns: TStringArray;
    Data: TStringMap<TStringArray>;
    Indices: array of TDatabaseIndex;
    DataDir, CacheDir: String;
  end;


procedure TDatabase.Setup(name: String; columns: TStringArray; path, version: String);
var
  i: Integer;
  dir, tmp, column, filename: String;
  data: TStringArray;
begin
  Self.Name := name + '.database';
  Self.CacheDir := WLEnv.CacheDir + 'databases' + PATH_SEP + name + PATH_SEP;

  for dir in DirList(Self.CacheDir) do
  begin
    tmp := Copy(dir, Length(dir)-Length(version)+1, Length(dir));
    if tmp = version then Continue;
    DirDelete(dir, False);
  end;

  Self.CacheDir += version + PATH_SEP;

  if not DirCreate(Self.CacheDir) then
    raise GetDebugLn(Self.Name, 'Failed to create cache directory: ' + Self.CacheDir);

  Self.DataDir := path;
  Self.Columns := Copy(columns);
  Self.Data.Clear();
  SetLength(Self.Indices, 0);
  SetLength(Self.Indices, Length(columns));

  for i := 0 to High(columns) do
  begin
    column := columns[i];

    filename := Self.CacheDir + column + '.data';
    if not FileExists(filename) then
      fileName := Self.DataDir + column + '.txt';

    if not FileExists(filename) then
      raise GetDebugLn(Self.Name, 'Failed to find data file: ' + filename);

    data := FileReadLines(filename);

    if (i > 0) and (Length(data) <> Length(Self.Data.Value[columns[0]])) then
      raise GetDebugLn(Self.Name, 'Column "' + column + '" has ' + ToStr(Length(data)) +
                                  ' rows but column "' + columns[0] + '" has ' +
                                  ToStr(Length(Self.Data.Value[columns[0]])));

    Self.Data.Value[column] := data;
  end;
end;


function TDatabase._ColumnIndex(column: String): Integer;
begin
  Result := Self.Columns.IndexOf(column);
  if Result = -1 then
    raise GetDebugLn(Self.Name, 'Unknown column: ' + column);
end;


procedure TDatabase._BuildIndex(columnIndex: Integer);
var
  row: Integer;
  data: TStringArray;
  index: TDatabaseIndex;
begin
  if Self.Indices[columnIndex].IsBuilt then
    Exit;

  data := Self.Data.Value[Self.Columns[columnIndex]];

  index.FirstRow.CaseSens := True;
  index.FirstRow.InvalidVal := -1;
  SetLength(index.NextRow, Length(data));

  for row := High(data) downto 0 do
  begin
    index.NextRow[row] := index.FirstRow.Value[data[row]];
    index.FirstRow.Value[data[row]] := row;
  end;

  index.IsBuilt := True;
  Self.Indices[columnIndex] := index;
end;


function TDatabase._FirstRow(value, column: String): Integer;
var
  columnIndex: Integer;
begin
  columnIndex := Self._ColumnIndex(column);
  Self._BuildIndex(columnIndex);
  Result := Self.Indices[columnIndex].FirstRow.Value[value];
end;




function TDatabase.Contains(value, column: String): Boolean;
begin
  Result := Self._FirstRow(value, column) > -1;
end;



function TDatabase.Get(value, column_name, result_column: String): String;
var
  row: Integer;
begin
  Self._ColumnIndex(result_column);

  row := Self._FirstRow(value, column_name);
  if row = -1 then Exit;

  Result := Self.Data.Value[result_column][row];
end;


function TDatabase.GetAll(value, column_name, result_column: String): TStringArray;
var
  row, columnIndex: Integer;
  data: TStringArray;
begin
  Self._ColumnIndex(result_column);

  row := Self._FirstRow(value, column_name);
  if row = -1 then Exit;

  columnIndex := Self.Columns.IndexOf(column_name);
  data := Self.Data.Value[result_column];

  while row <> -1 do
  begin
    Result += data[row];
    row := Self.Indices[columnIndex].NextRow[row];
  end;
end;


procedure TDatabase.Insert(values: TStringArray; saveCache: Boolean = False);
var
  i, row, last: Integer;
  column: String;
  data: TStringArray;
begin
  if Length(values) <> Length(Self.Columns) then
    raise GetDebugLn(Self.Name, 'The values being added are not the same length as the existing columns.');

  for i := 0 to High(values) do
  begin
    column := Self.Columns[i];

    data := Self.Data.Value[column];
    row := Length(data);
    data += values[i];
    Self.Data.Value[column] := data;

    if Self.Indices[i].IsBuilt then
    begin
      SetLength(Self.Indices[i].NextRow, row + 1);
      Self.Indices[i].NextRow[row] := -1;

      last := Self.Indices[i].FirstRow.Value[values[i]];
      if last = -1 then
        Self.Indices[i].FirstRow.Value[values[i]] := row
      else
      begin
        while Self.Indices[i].NextRow[last] <> -1 do
          last := Self.Indices[i].NextRow[last];
        Self.Indices[i].NextRow[last] := row;
      end;
    end;

    if saveCache then
      if not FileWrite(Self.CacheDir + column + '.data', data.Join(LINE_SEP)) then
        raise GetDebugLn(Self.Name, 'Failed to create cache file: ' + Self.CacheDir + column + '.data');
  end;
end;
