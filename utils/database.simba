(*
# Database
`TDatabase` is used to create a extremely basic single table database.

Despite being basic it's very effective and fast and you can use this when you
have a large set of data and need to retrieve values very fast.

To make this possible `TDatabase` creates several maps between the data and
their respective row placement, so to use this you need to have your data
prepared, split into database columns saved in different files and each
"row" should be in orderder between the files.

Credits: Torwent

Your data has to be split into columns, each saved to its own file, with every
row on the same line of each file.

Let's use for example a little bit of what is used for the items database:

```
+-------------------+-------+------------+
| items             | id    | hash       |
+-------------------+-------+------------+
| dwarf remains     | 0     | 069702cc6  |
| toolkit           | 1     | ff026bd51  |
| cannonball        | 2     | 0224ca70f  |
| nulodion's notes  | 3     | 047160bd7  |
| ammo mould        | 4     | f986eb373  |
| ...               | ...   | ...        |
| abyssal whip      | 4151  | 02f197ebf  |
+-------------------+-------+------------+
```

The data in this example should be saved to 3 files with the column name
(item.txt, id.txt, hash.txt), and line `N` of each file belongs to row `N`.

`TDatabase` keeps every column in that original row order, so once you know a
row number, reading any column at that row is a single array access.

To find the row of a value, each column you search gets an index: a map from
every distinct value in the column to the first row holding it, and for every
row, the next row holding the same value (or `-1`). Using the table above:

```
+-------------------+-----------+       +-------+-----------+
| item index        | first row |       | row   | next row  |
+-------------------+-----------+       +-------+-----------+
| abyssal whip      | 3551      |       | 0     | -1        |
| ammo mould        | 4         |       | 1     | -1        |
| cannonball        | 2         |       | ...   | ...       |
| ...               | ...       |       | 3551  | -1        |
+-------------------+-----------+       +-------+-----------+
```

So to get the `abyssal whip` id:
- Look `abyssal whip` up in the "item" index, which gives row `3551`.
- Read the "id" column at row `3551`, which is `4151`.

Finding every row with a value just follows "next row" from the first one until
it reaches `-1`, so rows always come back in ascending order.

An index is only built the first time a column is searched, so columns you only
read values from never pay for one.
*)
{$DEFINE WL_DATABASE_INCLUDED}
{$INCLUDE_ONCE WaspLib/utils.simba}

type
  TDatabaseIndex = record
    FirstRow: TStringMap<Integer>;
    NextRow: TIntegerArray;
    IsBuilt: Boolean;
  end;

  TDatabase = record
    Name: String;
    Columns: TStringArray;
    Data: TStringMap<TStringArray>;
    Indices: array of TDatabaseIndex;
    DataDir, CacheDir: String;
  end;

(*
## TDatabase.Setup
```pascal
procedure TDatabase.Setup(name: String; columns: TStringArray; path, version: String);
```
Sets up a new `TDatabase`, loading one `<column>.txt` file per column from
`path`.

If rows were saved with {ref}`Database.Insert`, the column files in the cache
directory for this `version` are loaded instead. Cache directories of other
versions are deleted.

Every column must have the same number of rows.
*)
procedure TDatabase.Setup(name: String; columns: TStringArray; path, version: String);
var
  i: Integer;
  dir, tmp, column, fileName: String;
  data: TStringArray;
begin
  Self.Name := name + '.database';
  Self.CacheDir := WLEnv.CacheDir + 'databases' + PATH_SEP + name + PATH_SEP;

  for dir in DirList(Self.CacheDir) do
  begin
    tmp := Copy(dir, Length(dir)-Length(version)+1, Length(dir));
    if tmp = version then Continue;
    DirDelete(dir, False);
  end;

  Self.CacheDir += version + PATH_SEP;

  if not DirCreate(Self.CacheDir) then
    raise GetDebugLn(Self.Name, 'Failed to create cache directory: ' + Self.CacheDir);

  Self.DataDir := path;
  Self.Columns := Copy(columns);
  Self.Data.Clear();
  SetLength(Self.Indices, 0);
  SetLength(Self.Indices, Length(columns));

  for i := 0 to High(columns) do
  begin
    column := columns[i];

    fileName := Self.CacheDir + column + '.data';
    if not FileExists(fileName) then
      fileName := Self.DataDir + column + '.txt';

    if not FileExists(fileName) then
      raise GetDebugLn(Self.Name, 'Failed to find data file: ' + fileName);

    data := FileReadLines(fileName);

    if (i > 0) and (Length(data) <> Length(Self.Data.Value[columns[0]])) then
      raise GetDebugLn(Self.Name, 'Column "' + column + '" has ' + ToStr(Length(data)) +
                                  ' rows but column "' + columns[0] + '" has ' +
                                  ToStr(Length(Self.Data.Value[columns[0]])));

    Self.Data.Value[column] := data;
  end;
end;

(*
## TDatabase._ColumnIndex
```pascal
function TDatabase._ColumnIndex(column: String): Integer;
```
Returns the position of `column` in `TDatabase.Columns`, raising if the database
has no such column.
*)
function TDatabase._ColumnIndex(column: String): Integer;
begin
  Result := Self.Columns.IndexOf(column);
  if Result = -1 then
    raise GetDebugLn(Self.Name, 'Unknown column: ' + column);
end;

(*
## TDatabase._BuildIndex
```pascal
procedure TDatabase._BuildIndex(columnIndex: Integer);
```
Builds the index of the column at `columnIndex` if it was not built yet.

Rows are walked from last to first so that every value ends up pointing at its
lowest row and each "next row" chain is in ascending order.
*)
procedure TDatabase._BuildIndex(columnIndex: Integer);
var
  row: Integer;
  data: TStringArray;
  index: TDatabaseIndex;
begin
  if Self.Indices[columnIndex].IsBuilt then
    Exit;

  data := Self.Data.Value[Self.Columns[columnIndex]];

  index.FirstRow.CaseSens := True;
  index.FirstRow.InvalidVal := -1;
  SetLength(index.NextRow, Length(data));

  for row := High(data) downto 0 do
  begin
    index.NextRow[row] := index.FirstRow.Value[data[row]];
    index.FirstRow.Value[data[row]] := row;
  end;

  index.IsBuilt := True;
  Self.Indices[columnIndex] := index;
end;

(*
## TDatabase._FirstRow
```pascal
function TDatabase._FirstRow(value, column: String): Integer;
```
Returns the lowest row where `column` holds `value`, or `-1` if no row does.
*)
function TDatabase._FirstRow(value, column: String): Integer;
var
  columnIndex: Integer;
begin
  columnIndex := Self._ColumnIndex(column);
  Self._BuildIndex(columnIndex);
  Result := Self.Indices[columnIndex].FirstRow.Value[value];
end;

(*
## Querying Data
A database is only useful if you can query data from it.
Below in this page you will see several examples of how to use `TDatabase` and
these examples will be accompanied with a `SQL` equivalent.

One thing to note is that `TDatabase` is a "single table" database.
This is also not a thing in real databases so in the following SQL examples we
will be using `TDatabaseTable` as our imaginary table.
*)

(*
## Database.Contains
```pascal
function TDatabase.Contains(value, column: String): Boolean;
```
Returns true/false if the specified `value` exists on the specified `column`.

Example:
```pascal
database.Contains('abyssal whip', 'item');
```
The SQL equivalent would be something like this:
```sql
SELECT EXISTS (
  SELECT 1
  FROM "TDatabaseTable"
  WHERE item = 'abyssal whip'
);
```
*)
function TDatabase.Contains(value, column: String): Boolean;
begin
  Result := Self._FirstRow(value, column) > -1;
end;


(*
## Database.Get
```pascal
function TDatabase.Get(value, column_name, result_column: String): String;
```
Returns the data at `result_column` where the `column_name` column has the
specified `value`. If several rows match, the lowest one is used. If none does,
an empty string is returned.

Example:
```pascal
WriteLn database.Get('abyssal whip', 'item', 'id');
```
The SQL equivalent would be something like this:
```sql
SELECT id
FROM "TDatabaseTable"
WHERE item = 'abyssal whip'
LIMIT 1;
```
*)
function TDatabase.Get(value, column_name, result_column: String): String;
var
  row: Integer;
begin
  Self._ColumnIndex(result_column);

  row := Self._FirstRow(value, column_name);
  if row = -1 then Exit;

  Result := Self.Data.Value[result_column][row];
end;

(*
## Database.GetAll
```pascal
function TDatabase.GetAll(value, column_name, result_column: String): TStringArray;
```
Same as {ref}`Database.Get` but will return all existing values instead of just
one, in row order.

Example:
```pascal
WriteLn database.GetAll('abyssal whip', 'item', 'id');
```
The SQL equivalent would be something like this:
```sql
SELECT id
FROM "TDatabaseTable"
WHERE item = 'abyssal whip';
```
Basically the same as {ref}`Database.Get` SQL example without the `LIMIT`.
*)
function TDatabase.GetAll(value, column_name, result_column: String): TStringArray;
var
  row, columnIndex: Integer;
  data: TStringArray;
begin
  Self._ColumnIndex(result_column);

  row := Self._FirstRow(value, column_name);
  if row = -1 then Exit;

  columnIndex := Self.Columns.IndexOf(column_name);
  data := Self.Data.Value[result_column];

  while row <> -1 do
  begin
    Result += data[row];
    row := Self.Indices[columnIndex].NextRow[row];
  end;
end;

(*
## Database.Insert
```pascal
procedure TDatabase.Insert(values: TStringArray; saveCache: Boolean = False);
```
Inserts a row of data. `values` must have a value for each of
`TDatabase.Columns`, in the same order.

By default, this data insertion only stays in memory, if you want to save it to
disk, you need to set `saveCache` to `True`. Saved rows are loaded by
{ref}`TDatabase.Setup` until the database version changes.

Example:
```pascal
database.Insert(['Custom Item', '99999', 'abcdef']);
```
The SQL equivalent would be something like this:
```sql
INSERT INTO "TDatabaseTable" (item, id, hash)
VALUES ('Custom Item', '99999', 'abcdef');
```
*)
procedure TDatabase.Insert(values: TStringArray; saveCache: Boolean = False);
var
  i, row, last: Integer;
  column: String;
  data: TStringArray;
begin
  if Length(values) <> Length(Self.Columns) then
    raise GetDebugLn(Self.Name, 'The values being added are not the same length as the existing columns.');

  for i := 0 to High(values) do
  begin
    column := Self.Columns[i];

    data := Self.Data.Value[column];
    row := Length(data);
    data += values[i];
    Self.Data.Value[column] := data;

    if Self.Indices[i].IsBuilt then
    begin
      SetLength(Self.Indices[i].NextRow, row + 1);
      Self.Indices[i].NextRow[row] := -1;

      last := Self.Indices[i].FirstRow.Value[values[i]];
      if last = -1 then
        Self.Indices[i].FirstRow.Value[values[i]] := row
      else
      begin
        while Self.Indices[i].NextRow[last] <> -1 do
          last := Self.Indices[i].NextRow[last];
        Self.Indices[i].NextRow[last] := row;
      end;
    end;

    if saveCache then
      if not FileWrite(Self.CacheDir + column + '.data', data.Join(LINE_SEP)) then
        raise GetDebugLn(Self.Name, 'Failed to create cache file: ' + Self.CacheDir + column + '.data');
  end;
end;
