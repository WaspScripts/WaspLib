
{$DEFINE WL_ITEM_INCLUDED}
{$INCLUDE_ONCE WaspLib/utils.simba}

const

  QUANTITY_ALL = 0;
  QUANTITY_ALL_BUT_ONE = -1;

var

  ITEM_SHADOW: TColor = $202030;


  ITEM_SHADOW_GRAY: TColor = $333333;


  ITEM_BORDER: TColor = $010000;


  ITEM_BORDER_WHITE: TColor = $FFFFFF;

type

  EItemQuantity = enum(ONE, FIVE, TEN, CUSTOM, ALL);


function EItemQuantity.Integer2Quantity(quantity: Integer): EItemQuantity; static;
begin
  case quantity of
    1:     Result := EItemQuantity.ONE;
    5:     Result := EItemQuantity.FIVE;
    10:    Result := EItemQuantity.TEN;
    0, -1: Result := EItemQuantity.ALL;
    else   Result := EItemQuantity.CUSTOM;
  end;
end;


function EItemQuantity.String2Quantity(str: String): EItemQuantity; static;
begin
  case LowerCase(str) of
    '1':   Result := EItemQuantity.ONE;
    '5':   Result := EItemQuantity.FIVE;
    '10':  Result := EItemQuantity.TEN;
    'all': Result := EItemQuantity.ALL;
    else   Result := EItemQuantity.CUSTOM;
  end;
end;

type

  EStack = enum(YELLOW, WHITE, GREEN);


property EStack.Color: TColor;
begin
  case Self of
    EStack.YELLOW: Result := $00FFFF;
    EStack.WHITE:  Result := $FFFFFF;
    EStack.GREEN:  Result := $80FF00;
  end;
end;


property EStack.Multiplier: Integer;
begin
  Result := Round(10 ** (3 * Ord(Self)));
end;


type

  TItem = String;

  TItemArray = array of TItem;



function TItem.InBounds(bounds: TBox; fadeTolerance: Single = 8.5; trgt: TTarget = Target): Boolean; static;
begin
  Result := trgt.HasColor(ITEM_BORDER, fadeTolerance, 1, bounds) or
            trgt.HasColor(ITEM_BORDER_WHITE, 0, 1, bounds);
end;



function TItem.HasAmount(): Boolean;
begin
  Result := Self.EndsWith(')', True);
end;


function TItem.Spread(): TItemArray;
var
  parts: TStringArray;
  first, last, i: Integer;
  name: String;
begin
  parts := Self.Split('..');
  if Length(parts) <= 1 then
    Exit([Self]);

  first := StrToInt(parts[0].Last);
  last :=  StrToInt(parts[1].First);
  name := parts[0].CopyRange(1, parts[0].Length-1);

  if first < last then
  begin
    for i := first to last do
      Result += name + ToStr(i) + ')';
    Exit;
  end;

  for i := first downto last do
    Result += name + ToStr(i) + ')';
end;


function TItem.SimplifyName(): String;
var
  short, long: Integer;
begin
  if Self.Contains(' of ') then
    Result := Self.After(' of ').ToLower()
  else
    Result := Self.ToLower();

  if Result.EndsWith(')') then Result := Result.Before('(');

  long := Length(Result);
  short := Min(0, long - Ceil(long/3));
  Result := Result.CopyRange(0, Random(short, long));
end;


property TItem.StackBox(slot: TBox): TBox; static;
begin
  Result := [slot.X1, slot.Y1-1, slot.X1 + 35, slot.Y1 + 11];
end;



function TItem.ReadStack(slot: TBox): Integer; static;
var
  stack: EStack;
  color: TColor;
begin
  slot := TItem.StackBox[slot];

  for stack := Low(EStack) to High(EStack) do
  begin
    color := stack.Color;
    if Target.HasColor(color, 1, 1, slot) then
      Exit(OCR.RecognizeNumber(slot, Fonts.PLAIN_11, [color], 1) * stack.Multiplier);
  end;

  if TItem.InBounds(slot, 0) then
    Exit;

  Result := -1;
end;

type

  TBankItem = object
    Item: TItem;
    Quantity: Integer;
    Noted: Boolean;
  end;


  TBankItemArray = array of TBankItem;


function TBankItem.Construct(item: TItem; quantity: Integer = QUANTITY_ALL_BUT_ONE): TBankItem; static;
begin
  Result := item.ToBankItem(quantity);
end;


function TItem.ToBankItem(quantity: Integer = QUANTITY_ALL_BUT_ONE): TBankItem;
begin
  Result.Quantity := quantity;
  Result.Noted := Self.StartsWith('Noted ', False);
  if Result.Noted then Result.Item := Self.After('Noted ')
  else Result.Item := Self;
end;


function TBankItem.ToItem(): TItem;
begin
  Result := Self.Item;
  if Self.Noted then
    Result := 'noted ' + Result.ToLower();
end;
