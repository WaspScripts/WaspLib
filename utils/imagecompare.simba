
{$DEFINE WL_IMAGECOMPARE_INCLUDED}

type

  TImageMatch = record
    Index: Integer;
    Box: TBox;
    Match: Single;
  end;

  TImageMatchArray = array of TImageMatch;

  TImageCompareFilter = procedure(constref image, template: TImage) of object;


  TImageCompareUtils = record
    Clean: procedure (image, template: TImage) of object;
    Align: function (image, template: TImage): Boolean of object;
    Filter: TImageCompareFilter;
  end;


function TImageCompareUtils.Compare(image, template: TImage; out similarity: Single): Boolean;
var
  match: Single;
  img, tmp: TImage;
begin
  img := image.Copy();
  tmp := template.Copy();

  if @Self.Align <> nil then
    if not Self.Align(img, tmp) then Exit;

  if (tmp.Width < img.Width) or (tmp.Height < img.Height) then
  begin
    similarity := 0;
    Exit;
  end;

  tmp.SetSize(img.Width, img.Height);

  if @Self.Clean <> nil then Self.Clean(img, tmp);
  if @Self.Filter <> nil then Self.Filter(img, tmp);

  if similarity = 1 then
    Exit(img.Equals(tmp));

  match := img.Compare(tmp);
  Result := match >= similarity;
  similarity := match;
end;

function TImageCompareUtils.Compare(image: TImage; slot: TBox; out similarity: Single): Boolean; overload;
var
  template: TImage;
begin
  if slot.Width < 37 then
    slot.X2 := slot.X1 + 36;

  template := Target.GetImage(slot);
  Result := Self.Compare(image, template, similarity);
end;


function TImageCompareUtils.FindMatch(img: TImage; container: TIntegerMatrix; offset: TPoint; out match: TImageMatch): Boolean;
var
  matrix: TSingleMatrix;
  similarity: Single;
  best: TPoint;
begin
  matrix := MatchTemplateMask(container, img.ToMatrix(), ETMFormula.TM_CCOEFF_NORMED);
  best := matrix.ArgMax();

  similarity := matrix[best.Y][best.X];
  if similarity < match.Match then
    Exit;

  match.Index := 0;

  match.Box.X1 := offset.X + best.X;
  match.Box.Y1 := offset.Y + best.Y;
  match.Box.X2 := match.Box.X1 + img.Width;
  match.Box.Y2 := match.Box.Y1 + img.Height;

  match.Match := similarity;

  Result := True;
end;


function TImageCompareUtils.FindExact(img, container: TImage; offset: TPoint; out match: TImageMatch): Boolean;
var
  pt: TPoint;
begin
  pt := container.FindImage(img, 0);
  if pt = [-1,-1] then
    Exit;

  match.Index := 0;
  match.Box.X1 := offset.X + pt.X;
  match.Box.Y1 := offset.Y + pt.Y;
  match.Box.X2 := match.Box.X1 + img.Width;
  match.Box.Y2 := match.Box.Y1 + img.Height;

  match.Match := 1;

  Result := True;
end;
