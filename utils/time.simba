
{$DEFINE WL_TIME_INCLUDED}



const

  TICK:   Integer = 600;


  SECOND: Integer = 1000;


  MINUTE: Integer = 60000;


  HOUR: Integer = 3600000;


  DAY: Integer = 86400000;




  DT_FORMAL_DATE: String = 'YYYY "years", M "months and" D "days"';


  MS_DATE_FORMAL: String = 'Y \year\s, M \mont\h\s and D \day\s';



  DT_SHORT_DATE: String = 'DD"/"MM"/"YYYY';


  MS_DATE_SHORT: String = 'DD/MM/YY';



  DT_SHORT_DATE_R: String = 'YYYY"/"MM"/"DD';


  MS_DATE_SHORT_R: String = 'YY/MM/DD';





  DT_TIME_FORMAL: String = 'h "hours", n "minutes and" s "seconds"';


  MS_TIME_FORMAL: String = 'h \ho\ur\s, m \min\ute\s and s \second\s';



  TIME_SHORT: String = 'hh:mm:ss';



  DT_MINUTES_FORMAL: String = 'n "minutes and" s "seconds"';


  MS_MINUTES_FORMAL: String = 'm \min\ute\s and s \second\s';



  FILE_TIME_FORMAT: String = 'YYYY-MM-DD_hh-mm-ss-ms';


procedure TCountDown.Restart(min, max: Integer); overload;
begin
  Self.Restart(Random(min, max));
end;
