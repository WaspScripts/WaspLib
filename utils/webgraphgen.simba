

{$DEFINE WL_WEBGRAPHGEN_INCLUDED}
{$INCLUDE_ONCE WaspLib/utils.simba}

{$R-}
{$IFDEF RANGECHECKS}
begin
  WriteLn GetDebugLn('WebGraphGenerator', 'Range checks are enabled for webgraph generator, these should be disabled in production!', ELogLevel.WARN);
end;
{$ENDIF}

{.$DEFINE WL_GENERATE_GRAPH_ALWAYS}

type

  TWebGraphGenerator = record
    Spacing, MinSpace: UInt32;
    Disabled: Boolean;
    BlockedChunks: T3DPointArray;
  end;


property TWebGraphGenerator.CRC: UInt32;
var
  data: TIntegerArray;
  len: Int32;
begin
  data := [Self.Spacing, Self.MinSpace];
  Result := CrcData(@data[0], Length(data) * SizeOf(Int32));

  len := Length(Self.BlockedChunks);
  if len > 0 then
    Result += CrcData(@Self.BlockedChunks[0], len * SizeOf(T3DPoint));
end;


procedure TWebGraphGenerator.Setup(spacing, minSpace: UInt32);
begin
  Self.Spacing := spacing;
  Self.MinSpace := minSpace;
end;

function TWebGraphGenerator.BuildGraph(name: String; map: TImage): TWebGraph;
var
  white, gray, walls, tpa, nodes, tmp, subset: TPointArray;
  i, hiY, hiX, size, y, x, start, n, mX, mY: Int32;
  t: UInt64;
  pt, adjacent: TPoint;
  wClusters, clusters: T2DPointArray;
  matrix: TIntegerMatrix;
  kdtree: TKDTree;
  items, query: TKDItems;
  itemA, itemB: TKDItem;
  b: TBox;
begin
  WriteLn GetDebugLn('WebGraphGenerator', 'Generating webgraph: ' + name + ' this can take a few seconds.');
  t := GetTimeRunning();

  if Self.Spacing mod 4 <> 0 then
    raise GetDebugLn('WebGraphGenerator', 'Spacing should be a multiple of 4.');

  matrix := map.ToMatrix();

  hiY := matrix.Height - 1 - Self.Spacing;
  hiX := matrix.Width -1 - Self.Spacing;

  size := Self.Spacing + (Self.Spacing div 2);

  for y := Self.Spacing to hiY with Self.Spacing do
    for x := Self.Spacing to hiX with Self.Spacing do
    begin
      for mY := y to y+Self.Spacing-1 do
        for mX := x to x+Self.Spacing-1 do
          if matrix[mY, mX] = $FFFFFF then
            tmp += Point(mX, mY);

      if tmp = [] then
        Continue;

      tpa += tmp.Cluster(1).Means();
      tmp := [];
    end;

  white := map.FindColor($FFFFFF, 0);
  gray := map.FindColor($333333, 0);
  walls := map.FindColor($0, 0) + map.FindColor($FF, 0);
  wClusters := white.Cluster(1).SortBySize(True).ExcludeSize(Self.MinSpace, EComparator.__LE__);

  for i := 0 to High(wClusters) do
  begin
    nodes := wClusters[i].Intersection(tpa);
    if nodes = [] then
      Continue;

    start := Length(Result.Nodes);
    Result.Nodes += nodes;
    SetLength(Result.Paths, Length(Result.Nodes));

    items := [];
    for n := start to High(Result.Nodes) do
    begin
      pt := Result.Nodes[n];
      items += [n, [pt.X, pt.Y]];
    end;
    kdtree := TKDTree.Create(items);

    for n := 0 to High(kdtree.Data) do
    begin
      itemA := kdtree.Data[n].Split;
      kdtree.Data[n].Hidden := True;

      query := kdtree.RangeQuery(
            [itemA.Vector[0]-size, itemA.Vector[1]-size],
            [itemA.Vector[0]+size, itemA.Vector[1]+size], [ETreeSetting.IgnoreHidden]);
      if query = [] then
        Continue;

      pt := Point(Round(itemA.Vector[0]), Round(itemA.Vector[1]));
      subset := wClusters[i].ExtractBox(Box(pt, size, size));

      for itemB in query do
      begin
        adjacent := Point(Round(itemB.Vector[0]), Round(itemB.Vector[1]));
        if subset.ExtractBox(Box(pt, adjacent)).AStar(pt, adjacent, False) = [] then
          Continue;

        Result.Paths[itemA.Ref] += itemB.Ref;
        Result.Paths[itemB.Ref] += itemA.Ref;
      end;
    end;
  end;

  for i := 0 to High(wClusters) do
  begin
    b := wClusters[i].Bounds().Expand(80);
    subset := gray.ExtractBox(b) + walls.ExtractBox(b);
    tpa := wClusters[i] + subset;
    clusters := tpa.Cluster(1);

    for n := 0 to High(clusters) do
      if clusters[n].Contains(wClusters[i, 0]) then
      begin
        Result.WalkableClusters += clusters[n];
        Break;
      end;
  end;

  Result.WalkableSpace  := white + gray;
  Result.ObjectClusters := gray.Cluster(1);

  DebugLn('WebGraphGenerator', 'Generating webgraph took ' + ToStr(Round(((GetTimeRunning()-t)/1000), 2)) + ' seconds.', ELogLevel.SUCCESS);
end;
{$R+}



var

  WebGraphGenerator: TWebGraphGenerator;
