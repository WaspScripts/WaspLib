end;

property TLazControl.Height(value: Integer); override;
begin
  inherited(Round(value * FormUtils.Scale));
end;

property TLazControl.Height: Integer; override;
begin
  Result := Round(inherited() / FormUtils.Scale);
end;

property TLazControl.Right: Integer;
begin
  Result := Self.Left+Self.Width;
end;

property TLazControl.Bottom: Integer;
begin
  Result := Self.Top+Self.Height;
end;


procedure TLazControl.SetBounds(aLeft, aTop, aWidth, aHeight: Integer); override;
begin
  inherited(
    Round(aLeft * FormUtils.Scale), Round(aTop * FormUtils.Scale),
    Round(aWidth * FormUtils.Scale), Round(aHeight * FormUtils.Scale)
  );
end;


