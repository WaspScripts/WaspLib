  locY := 10;

  Self.GermanyCheckbox := TLazCheckBox.CreateEx(
    Self.LocationPanel, 'Germany', '', 10, locY, 100, checkboxHeight
  );
  Self.GermanyCheckbox.Checked := True;

  locY += checkboxHeight + 3;
  Self.UKCheckbox := TLazCheckBox.CreateEx(
    Self.LocationPanel, 'UK', '', 10, locY, 100, checkboxHeight
  );
  Self.UKCheckbox.Checked := True;

  locY += checkboxHeight + 3;
  Self.USCheckbox := TLazCheckBox.CreateEx(
    Self.LocationPanel, 'USA', '', 10, locY, 100, checkboxHeight
  );
  Self.USCheckbox.Checked := True;

  locY += checkboxHeight + 3;
  Self.AustraliaCheckbox := TLazCheckBox.CreateEx(
    Self.LocationPanel, 'Australia', '', 10, locY, 100, checkboxHeight
  );
  Self.AustraliaCheckbox.Checked := True;

  locY += checkboxHeight + 3;
  Self.BrazilCheckbox := TLazCheckBox.CreateEx(
    Self.LocationPanel, 'Brazil', '', 10, locY, 100, checkboxHeight

  );
  Self.BrazilCheckbox.Checked := True;
end;


procedure TProfileForm.SetupActivityPanel();
var
  actY: Integer;
  checkboxHeight: Integer;
begin
  checkboxHeight := 18;
  actY := 10;

  Self.NormalCheckbox := TLazCheckBox.CreateEx(
    Self.ActivityPanel, 'Normal', '', 10, actY, 130, checkboxHeight
  );
  Self.NormalCheckbox.Checked := True;

  actY += checkboxHeight + 3;
  Self.DangerousCheckbox := TLazCheckBox.CreateEx(
    Self.ActivityPanel, 'Dangerous', '', 10, actY, 130, checkboxHeight
  );
  Self.DangerousCheckbox.Checked := False;

  actY += checkboxHeight + 3;
  Self.RestrictedCheckbox := TLazCheckBox.CreateEx(
    Self.ActivityPanel, 'Restricted', '', 10, actY, 130, checkboxHeight
  );
  Self.RestrictedCheckbox.Checked := False;

  actY += checkboxHeight + 3;
  Self.SkillTotalCheckbox := TLazCheckBox.CreateEx(
    Self.ActivityPanel, 'Skill Total', '', 10, actY, 130, checkboxHeight
  );
  Self.SkillTotalCheckbox.Checked := True;
end;


procedure TProfileForm.SetupSpecificActivityPanel();
begin
  Self.SelectAllActivitiesCheckbox := TLazCheckBox.CreateEx(
    Self.SpecificActivityPanel, 'Select/Deselect All', '',
    5, 5, 200, 18
  );
  Self.SelectAllActivitiesCheckbox.Checked := True;
  Self.SelectAllActivitiesCheckbox.OnClick := @Self.OnSelectAllActivitiesClick;
end;



procedure TProfileForm.LoadWorldData();
begin
  Self.StatsLabel.Caption := 'Fetching...';
  Self.EditForm.Update();

  WorldFetcher.Setup();
  WorldFetcher.Settings.ExcludeActivities := [];

  if WorldFetcher.FetchAll() then
  begin
    Self.AllWorldsCache := WorldFetcher.GetFilteredWorlds();
    Self.RefreshActivities();
    Self.StatsLabel.Caption := Format('Ready: %d worlds', [Length(Self.AllWorldsCache)]);
    Self.OnGenerateClick(Self.GenerateButton);
  end
  else
    Self.StatsLabel.Caption := 'Fetch failed!';
end;


procedure TProfileForm.LoadSavedWorlds(worlds: TIntegerArray);
begin
  if worlds = [] then
    Exit;

  WorldFetcher.Setup();
  if not WorldFetcher.Fetch(worlds) then
    Exit;

  Self.FilteredWorlds := WorldFetcher.Worlds;
  Self.DisplayResults();

  Self.F2PCheckbox.Checked := False;
  Self.MembersCheckbox.Checked := False;
  Self.GermanyCheckbox.Checked := False;
  Self.UKCheckbox.Checked := False;
  Self.USCheckbox.Checked := False;
  Self.AustraliaCheckbox.Checked := False;
  Self.NormalCheckbox.Checked := False;
  Self.DangerousCheckbox.Checked := False;
  Self.RestrictedCheckbox.Checked := False;
  Self.SkillTotalCheckbox.Checked := False;
  Self.SelectAllActivitiesCheckbox.Checked := False;
end;



procedure TProfileForm.SetupEditDialog(
  const profile: TProfile; isNew: Boolean; editIndex: Integer
);
const
  EDIT_FORM_WIDTH = 700;
  EDIT_FORM_HEIGHT = 520;
  FIELD_WIDTH = 172;
  FIELD_HEIGHT = 25;
  BUTTON_WIDTH = 100;
  BUTTON_HEIGHT = 30;
  PANEL_HEIGHT = 120;
var
  currentX, fieldY, worldY: Integer;
begin
  Self.IsNewProfile := isNew;
  Self.EditIndex := editIndex;

  Self.EditForm := TLazForm.Create(nil);
  Self.EditForm.Width := EDIT_FORM_WIDTH;
  Self.EditForm.Height := EDIT_FORM_HEIGHT;

  if isNew then
    Self.EditForm.Caption := ' New Account Profile'
  else
    Self.EditForm.Caption := ' Edit Account Profile: ' + profile.Name;
  Self.EditForm.Position := ELazFormPosition.OwnerFormCenter;
  Self.EditForm.BorderStyle := ELazFormBorderStyle.Dialog;

  currentX := 15;
  fieldY := 35;

  Self.NameEdit := TLazEdit.CreateEx(
    Self.EditForm, 'Profile Name*:', '',
    currentX, fieldY, FIELD_WIDTH, FIELD_HEIGHT
  );
  Self.NameEdit.MaxLength := 50;
  Self.NameEdit.Text := profile.Name;
  currentX += 187;

  Self.UsernameEdit := TLazEdit.CreateEx(
    Self.EditForm, 'Username (optional):', 'Optional for Jagex accounts',
    currentX, fieldY, FIELD_WIDTH, FIELD_HEIGHT
  );
  Self.UsernameEdit.MaxLength := 50;
  Self.UsernameEdit.Text := profile.Username;
  currentX += 187;

  Self.PasswordEdit := TLazEdit.CreateEx(
    Self.EditForm, 'Password (optional):', 'Optional for Jagex accounts',
    currentX, fieldY, FIELD_WIDTH, FIELD_HEIGHT
  );
  Self.PasswordEdit.PasswordChar := '*';
  Self.PasswordEdit.MaxLength := 100;
  Self.PasswordEdit.Text := profile.Password;
  currentX += 187;

  Self.BankPinEdit := TLazEdit.CreateEx(
    Self.EditForm, 'Bank PIN:', '', currentX, fieldY, 102, FIELD_HEIGHT
  );
  Self.BankPinEdit.PasswordChar := '*';
  Self.BankPinEdit.OnKeyPress := @FormUtils.NumberField;
  Self.BankPinEdit.MaxLength := 4;  //Bank PIN must be 4 digits
  Self.BankPinEdit.Text := profile.Pin;

  worldY := fieldY + 65;

  Self.TypePanel := TLazScrollBox.CreateEx(
    Self.EditForm, 'World Type', '', 15, worldY, 125, PANEL_HEIGHT
  );
  Self.SetupWorldTypePanel();

  Self.LocationPanel := TLazScrollBox.CreateEx(
    Self.EditForm, 'Location', '',
    145, worldY, 115, PANEL_HEIGHT
  );
  Self.SetupLocationPanel();

  Self.ActivityPanel := TLazScrollBox.CreateEx(
    Self.EditForm, 'Activity', '',
    265, worldY, 145, PANEL_HEIGHT
  );
  Self.SetupActivityPanel();

  Self.SpecificActivityPanel := TLazScrollBox.CreateEx(
    Self.EditForm, 'Specific Activities', '',
    415, worldY, 265, PANEL_HEIGHT
  );
  Self.SetupSpecificActivityPanel();

  worldY += 125;

  Self.StatsLabel := TLazLabel.CreateEx(
    Self.EditForm, 'Found: 0 worlds', '', 15, worldY, 120, 20
  );

  worldY += 25;

  Self.GenerateButton := TLazButton.CreateEx(
    Self.EditForm, 'Generate Worlds', '', 15, worldY, 150, 25
  );
  Self.GenerateButton.OnClick := @Self.OnGenerateClick;

  Self.SortCombo := TLazComboBox.CreateEx(
    Self.EditForm, 'Sort by:', '', 170, worldY, 130, 22
  );
  Self.SortCombo.Style := ELazComboBoxStyle.DropDownList;
  Self.SortCombo.Items.Add('World Number');
  Self.SortCombo.Items.Add('Players (Lo/Hi)');
  Self.SortCombo.Items.Add('Players (Hi/Lo)');
  Self.SortCombo.ItemIndex := 0;
  Self.SortCombo.OnChange := @Self.OnSortChange;

  Self.MinPlayersEdit := TLazEdit.CreateEx(
    Self.EditForm, 'Players Min/Max', '0', 305, worldY, 50, 22
  );
  Self.MinPlayersEdit.OnKeyPress := @FormUtils.NumberField;
  Self.MinPlayersEdit.MaxLength := 4;
  Self.MinPlayersEdit.Text := '0';

  TLazLabel.CreateEx(Self.EditForm, '-', '', 365, worldY + 2, 10, 20);

  Self.MaxPlayersEdit := TLazEdit.CreateEx(
    Self.EditForm, '', '2000', 375, worldY, 50, 22
  );
  Self.MaxPlayersEdit.OnKeyPress := @FormUtils.NumberField;
  Self.MaxPlayersEdit.MaxLength := 4;
  Self.MaxPlayersEdit.Text := '2000';

  Self.ExcludeWorldsEdit := TLazEdit.CreateEx(
    Self.EditForm, 'Exclude worlds:', 'e.g., 301, 302', 450, worldY, 230, 22
  );

  worldY += 45;

  Self.WorldList := TLazListBox.CreateEx(
    Self.EditForm, '', '', 15, worldY, 665, 160
  );
  Self.WorldList.Font.Name := 'Courier New';
  Self.WorldList.Font.Size := 12;

  worldY += 175;

  Self.SaveButton := TLazButton.CreateEx(
    Self.EditForm, 'Save Profile', 'Save this profile',
    15, worldY, BUTTON_WIDTH, BUTTON_HEIGHT
  );
  Self.SaveButton.OnClick := @Self.OnSaveClick;

  if not isNew then
  begin
    Self.DeleteButton := TLazButton.CreateEx(
      Self.EditForm, 'Delete', 'Delete this profile',
      125, worldY, 80, BUTTON_HEIGHT
    );
    Self.DeleteButton.OnClick := @Self.OnDeleteClick;
  end;

  Self.CloseButton := TLazButton.CreateEx(
    Self.EditForm, 'Close', 'Close dialog', 600, worldY, 80, BUTTON_HEIGHT
  );
  Self.CloseButton.OnClick := @Self.OnCloseClick;

  Self.LoadWorldData();

  if not isNew and (profile.Worlds <> []) then
    Self.LoadSavedWorlds(profile.Worlds);
end;



{$H-}
procedure TProfileForm.OnEditClick(sender: TLazObject);
var
  selectedIndex: Integer;
  profile: TProfile;
  isNewProfile: Boolean;
begin
  selectedIndex := Self.ProfileCombo.ItemIndex;
  isNewProfile := (selectedIndex = Self.ProfileCombo.Items.Count - 1); // Last item is "New Profile"

  if isNewProfile then
  begin
    profile := Default(TProfile);
    Self.SetupEditDialog(profile, True, -1);
  end
  else if InRange(selectedIndex, 0, High(Profiles)) then
  begin
    profile := Profiles[selectedIndex];
    Self.SetupEditDialog(profile, False, selectedIndex);
  end
  else
    Exit;

  Self.EditForm.ShowModal();
end;
{$H+}


procedure TProfileForm.OnProfileChange(sender: TLazObject);
var
  i: Integer;
begin
  ProfileIndex := TLazComboBox(sender).ItemIndex;
  for i := 0 to High(Self.ProfileUpdateTasks) do
    Self.ProfileUpdateTasks[i]();
end;



procedure TProfileForm.SetupUI(parent: TLazComponent);
var
  lbl: TLazLabel;
begin
  Self.EditButton := TLazButton.CreateEx(parent, 'Edit Profile');
  Self.EditButton.Align := ELazAlign.Left;
  Self.EditButton.BorderSpacing.Top := 2;
  Self.EditButton.BorderSpacing.Bottom := 4;
  Self.EditButton.BorderSpacing.Left:= 8;
  Self.EditButton.Width := 90;
  Self.EditButton.OnClick := @Self.OnEditClick;

  Self.ProfileCombo := TLazComboBox.CreateEx(parent);
  Self.ProfileCombo.Align := ELazAlign.Left;
  Self.ProfileCombo.BorderSpacing.Top := -2;
  Self.ProfileCombo.Width := 240;
  Self.ProfileCombo.BorderSpacing.Around := 6;
  Self.ProfileCombo.OnChange := @Self.OnProfileChange;

  lbl := TLazLabel.CreateEx(parent, 'Profile:', '');
  lbl.Align := ELazAlign.Left;
  lbl.BorderSpacing.Top := 8;
  lbl.BorderSpacing.Left := 8;
  lbl.BorderSpacing.Bottom := 11;
  
  Self.UpdateProfileCombo();
  
  if Self.ProfileCombo.Items.Count > 0 then
    Self.ProfileCombo.ItemIndex := 0;
end;

var
  ProfileForm: TProfileForm;
