(*
# Data
This page is about fetching game data with WaspLib.
WaspLib has several tools to get information about items, npcs, weapons, ...
*)

{$DEFINE WL_DATA_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type
(*
## TItemData
Record responsible for providing item information in WaspLib.
*)
  TItemData = record
    PricesJSON: TJSONParser;
    Items: TArchive;
    Filename: String;
    Timeout: UInt64;
    Disabled: Boolean;
    const CacheDir: String = WLEnv.CacheDir + 'data' + PATH_SEP;
    const PRICES_URL: String = 'https://prices.runescape.wiki/api/v1/osrs/latest';
  end;

(*
## TItemPriceData
Record responsible for holding item price data.
*)
  TItemPriceData = record
    High, HighTime, Low, LowTime: Integer;
  end;

procedure TItemData.UpdateFile();
var
  t: UInt64;
  files: TStringArray;
  i: Integer;
begin
  files := DirList(Self.CacheDir + 'prices' + PATH_SEP).Sorted();
  for i := 0 to High(files)-1 do FileDelete(files[i]);

  if files <> [] then
  begin
    Self.Filename := files.Last;
    Self.Timeout := StrToInt64(PathExtractNameWithoutExt(Self.Filename), Self.Timeout);
  end;

  t := Time();

  if Self.Timeout < t then
  begin
    if Self.Filename <> '' then
    begin
      WriteLn GetDebugLn('ItemData', 'Data cached is old and will be updated.');
      FileDelete(Self.Filename);
    end;

    Self.Timeout := t + HOUR;
    Self.Filename := Self.CacheDir  + 'prices' + PATH_SEP + ToStr(Self.Timeout) + '.json';
    HTTPClient.GetFile(Self.PRICES_URL, Self.Filename);
  end;
end;

procedure TItemData.Reload();
var
  current: String;
begin
  if Self.Disabled then Exit;

  current := Self.Filename;
  Self.UpdateFile();
  if current = Self.Filename then Exit;

  Self.PricesJSON := new TJSONParser();

  try
    Self.PricesJSON.Load(Self.Filename);
  except
    FileDelete(Self.Filename);
    Self.Disabled := True;
  end;
end;

procedure TItemData.Setup();
begin
  if not DirCreate(Self.CacheDir + 'prices' + PATH_SEP) then
    raise GetDebugLn('ItemData', 'Failed to create cache directory: ' + Self.CacheDir + 'prices' + PATH_SEP);

  CacheReader.Indices[ECacheIndex.CONFIGS].Cache();
  Self.Items := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.ITEM];
end;


(*
## ItemData.GetDefinition
```pascal
function TItemData.GetDefinition(id: Integer): TItemDefinition;
```
This is mostly for internal use but you may use it for whatever you wish.

This returns the {ref}`TItemDefinition` of an item, read straight from the game cache.

Item definitions are items information stored in the game cache, things like:
- Item ID
- Item name
- Item is tradeable
- Item is stackable
- Item is members
- ...

Example:
```pascal
id := ItemFinder.Database.Get('abyssal whip', 'item', 'id');
def := ItemData.GetDefinition(StrToInt(id));
WriteLn def.Name, ' costs ', def.Cost;
```
*)
function TItemData.GetDefinition(id: Integer): TItemDefinition;
begin
  if not Self.Items.Files.Exists(id) then
    raise GetDebugLn('ItemData', 'Couldn''t find item ' + ToStr(id) + ' in the cache.');

  Result := TItemDefinition.Create(id, Self.Items.Files.Value[id].Data);
end;

(*
## ItemData.GetTradeableID
```pascal
function TItemData.GetTradeableID(item: TItem): String;
```
Mostly for internal use but you may use it as you see fit.

Some items in the game have versions of themselves that are not tradeable and
can't be used to fetch item prices, such as degraded items, ornamented items, etc.

This function checks every id associated with the specified `item` and checks
the item definition of each one (check {ref}`ItemData.GetDefinition`) for the
tradeable key.

The first tradeable id found is returned.

Example:
```pascal
WriteLn ItemData.GetTradeableID('Rune scimitar'); //rune scimitar has 2 ids and one is not tradeable.
```
*)
function TItemData.GetTradeableID(item: TItem): String;
var
  ids: TStringArray;
  id: String;
begin
  if item.IsNumeric then ids := [item]
  else ids := ItemFinder.Database.GetAll(item.ToLower(), 'item', 'id');

  for id in ids do
  begin
    if Self.GetDefinition(StrToInt(id)).Tradeable then
      Exit(id);
  end;
end;

(*
## ItemData.GetPriceData
```pascal
function TItemData.GetPriceData(item: TItem): TItemPriceData;
```
Method used to return the price data of the specified `item`.

Example:
```pascal
var
  priceData: TItemPriceData;
begin
  priceData := ItemData.GetPriceData('Abyssal whip');
  WriteLn('High: ' + ToStr(priceData.high) + ' Low: ' + ToStr(priceData.low));
end;
```
*)
function TItemData.GetPriceData(item: TItem): TItemPriceData;
var
  id: String;
  json: TJSONItem;
begin
  id := Self.GetTradeableID(item);
  if id = '' then Exit;

  Self.Reload();
  if Self.Disabled then Exit;
  if not Self.PricesJSON.Item[0].GetObject(id, json) then Exit;

  Result.High := json.Item['high'].AsInt;
  Result.HighTime := json.Item['highTime'].AsInt;
  Result.Low := json.Item['low'].AsInt;
  Result.LowTime := json.Item['lowTime'].AsInt;
end;

(*
## ItemData.GetPrice
```pascal
function TItemData.GetPrice(item: TItem): Integer;
```
Method used to return the average price of the specified `item`.

Example:
```pascal
WriteLn ItemData.GetPrice('Abyssal whip');
```
*)
function TItemData.GetPrice(item: TItem): Integer;
var
  priceData: TItemPriceData;
begin
  case item of
    'coins', 'Coins', '995', '996', '997', '998',
    '999', '1000', '1001', '1002', '1003', '1004': Exit(1);
  end;

  priceData := Self.GetPriceData(item);

  if priceData = Default(TItemPriceData) then Exit;

  if priceData.low = priceData.high then Exit(priceData.low);
  if priceData.low = 0 then Exit(priceData.high);
  if priceData.high = 0 then Exit(priceData.low);

  Result := (priceData.high + priceData.low) div 2;
end;


(*
## ItemData.GetLowAlch()
```pascal
function TItemData.GetLowAlch(item: TItem): Integer;
```
Method used to get the the low alchemy value of an item.

Example:
```pascal
WriteLn ItemData.GetLowAlch('Magic longbow');
```
*)
function TItemData.GetLowAlch(item: TItem): Integer;
var
  ids: TStringArray;
  id: String;
  cost: Integer;
begin
  if item.IsNumeric then ids := [item]
  else ids := ItemFinder.Database.GetAll(item.ToLower(), 'item', 'id');

  for id in ids do
  begin
    cost := Self.GetDefinition(StrToInt(id)).Cost;
    if cost > 0 then
      Exit(Floor(cost * 0.4));
  end;
end;

(*
## ItemData.GetHighAlch()
```pascal
function TItemData.GetHighAlch(item: TItem): Integer;
```
Method used to get the the high alchemy value of an item.

Example:
```pascal
WriteLn ItemData.GetHighAlch('Magic longbow');
```
*)
function TItemData.GetHighAlch(item: TItem): Integer;
var
  ids: TStringArray;
  id: String;
  cost: Integer;
begin
  if item.IsNumeric then ids := [item]
  else ids := ItemFinder.Database.GetAll(item.ToLower(), 'item', 'id');

  for id in ids do
  begin
    cost := Self.GetDefinition(StrToInt(id)).Cost;
    if cost > 0 then
      Exit(Floor(cost * 0.6));
  end;
end;

function TItemData.IsStackable(item: TItem): Boolean;
var
  ids: TStringArray;
  id: String;
begin
  if item.IsNumeric then ids := [item]
  else ids := ItemFinder.Database.GetAll(item.ToLower(), 'item', 'id');

  for id in ids do
    if Self.GetDefinition(StrToInt(id)).Stackable <> 0 then
      Exit(True);
end;

var
(*
## ItemData variable
Global {ref}`TItemData` variable.
*)
  ItemData: TItemData;

type
(*
## TGearData
Type responsible for retrieving gear data.
"Gear" refers to as any equippable item in the game.
*)
  TGearData = record
    Data: TJSONItem;
  end;

(*
## GearData.Setup
```pascal
procedure TGearData.Setup();
```
Internal method to setup TGearData, loading `gear.json` out of the item database
{ref}`TItemLoader.WriteDatabase` builds from the game cache.
*)
procedure TGearData.Setup();
begin
  if Self.Data <> nil then
    Exit;

  Self.Data := new TJSONParser();
  TJSONParser(Self.Data).Load(ItemFinder.DB_PATH + 'gear.json');
end;

(*
## GearData.GetArray
```pascal
function TGearData.GetArray(index: Integer): TJSONItem;
function TGearData.GetArray(key: String): TJSONItem; overload;
```
Method to fetch json arrays from gear.json.

```{note}
Using this requires knowledge of the structure of gear.json
```
*)
function TGearData.GetArray(index: Integer): TJSONItem;
begin
  Self.Setup();
  Result := Self.Data.Item[index];
end;

function TGearData.GetArray(key: String): TJSONItem; overload;
begin
  Self.Setup();
  if key = 'secondary_ammo' then key := 'ammo';
  Result := Self.Data.Item[key];
end;

(*
## GearData.GetItems
```pascal
function TGearData.GetItems(key: Integer): TItemArray;
function TGearData.GetItems(key: String): TItemArray; overload;
```
Method to fetch items under a key in gear.json.
*)
function TGearData.GetItems(key: Integer): TItemArray;
var
  i: Int32;
begin
  Self.Setup();
  for i := 0 to Self.Data.Item[key].Count-1 do
    Result += Self.Data.Item[key].Item[i].AsString;
end;

function TGearData.GetItems(key: String): TItemArray; overload;
var
  i: Int32;
begin
  Self.Setup();
  if key = 'secondary_ammo' then key := 'ammo';
  for i := 0 to Self.Data.Item[key].Count-1 do
    Result += Self.Data.Item[key].Item[i].AsString;
end;

var
(*
## GearData variable
Global {ref}`TGearData` variable.
*)
  GearData: TGearData;

type

  TWeaponData = record
    Data: TJSONItem;
  end;


procedure TWeaponData.Setup();
begin
  if Self.Data <> nil then Exit;
  Self.Data := new TJSONParser();
  TJSONParser(Self.Data).Load(WLEnv.AssetsDir + 'jsons' + PATH_SEP + 'weapons.json');
end;


function TWeaponData.GetArray(index: Integer): TJSONItem;
begin
  Self.Setup();
  Result := Self.Data.Item[index];
end;

function TWeaponData.GetArray(key: String): TJSONItem; overload;
begin
  Self.Setup();
  if key = 'secondary_ammo' then key := 'ammo';
  Result := Self.Data.Item[key];
end;


function TWeaponData.GetItems(key: Integer): TItemArray;
var
  i: Int32;
begin
  Self.Setup();
  for i := 0 to Self.Data.Item[key].Count-1 do
    Result += Self.Data.Item[key].Item[i].AsString;
end;

function TWeaponData.GetItems(key: String): TItemArray; overload;
var
  i: Int32;
begin
  Self.Setup();
  if key = 'secondary_ammo' then key := 'ammo';
  for i := 0 to Self.Data.Item[key].Count-1 do
    Result += Self.Data.Item[key].Item[i].AsString;
end;

var
{$H-}
  WeaponData: TWeaponData;
{$H+}
