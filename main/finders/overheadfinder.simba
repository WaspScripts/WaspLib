(*
# OverheadFinder

Prayer/Protection Overhead Detection System.

A comprehensive system for detecting and locating prayer and protection overhead icons
in game. This module uses template matching to identify various
overhead prayer effects on players and NPCs.

The overhead icons are read straight from the game cache.
*)
{$DEFINE WL_OVERHEADFINDER_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

(*
## EOverhead
```pascal
EOverhead = (
  MAGIC, RANGED, MELEE, RETRIBUTION, REDEMPTION, SMITE,
  MAGIC_AND_RANGED, MAGIC_AND_MELEE, RANGED_AND_MELEE, ALL,
  DAMPEN_MELEE, DAMPEN_RANGED, DAMPEN_MAGIC
);
```
Enumeration of all detectable overhead prayer and protection types in game.
Includes individual protections, combinations, and special prayer effects.

`DAMPEN_RANGED` and `DAMPEN_MAGIC` are last so the values of the others stay the same for scripts
that saved them.
*)
type
  EOverhead = (
    MAGIC, RANGED, MELEE, RETRIBUTION, REDEMPTION, SMITE,
    MAGIC_AND_RANGED, MAGIC_AND_MELEE, RANGED_AND_MELEE, ALL,
    DAMPEN_MELEE, DAMPEN_RANGED, DAMPEN_MAGIC
  );

(*
## TOverhead
```pascal
TOverhead = record
  Position: TPoint;
  Overhead: EOverhead;
end;
```
Record containing information about a detected overhead prayer icon.
Stores both the screen position and the type of overhead detected.
*)
  TOverhead = record
    Position: TPoint;
    Overhead: EOverhead;
  end;

(*
## TOverheadArray
```pascal
TOverheadArray = array of TOverhead;
```
Dynamic array of TOverhead records for storing multiple detected overhead icons.
*)
  TOverheadArray = array of TOverhead;

(*
## TOverheadFinder
```pascal
TOverheadFinder = record
  Images: array[EOverhead] of TImage;
  Similarity: Single;
end;
```
Main overhead detection system that manages template images and performs
overhead icon recognition using template matching algorithms.
*)
  TOverheadFinder = record
    Images: array[EOverhead] of TImage;
    Similarity: Single;
  end;

(*
## TOverheadFinder.Setup
```pascal
procedure TOverheadFinder.Setup();
```

Internal procedure called when library is loaded.
Sets the default similarity threshold.

Example:
```pascal
OverheadFinder.Setup();
WriteLn('OverheadFinder initialized successfully');
```
*)
procedure TOverheadFinder.Setup();
begin
  //only set similarity if the user didn't set it already
  if Self.Similarity = 0 then
    Self.Similarity := 0.90;
end;

(*
## TOverheadFinder.LoadImages
```pascal
procedure TOverheadFinder.LoadImages();
```
Internal procedure that reads the overhead icons out of the game cache and fills `Images`.

All overheads are frames of the same 25x25 sprite. Only the middle 14x14 of each frame is kept,
which leaves out the transparent corners so the icons match whatever the game draws behind them.
It runs once, the first time an overhead image is needed.
*)
procedure TOverheadFinder.LoadImages();
const
  SPRITE_ID: Integer = 440;
  FRAMES: array [EOverhead] of Integer = [2, 1, 0, 3, 5, 4, 6, 8, 7, 9, 12, 13, 14];
  CROP: TBox = [6, 6, 19, 19];
var
  index: TCacheIndex;
  sector: TArchiveSector;
  sprites: TSpriteDefinitionArray;
  overhead: EOverhead;
begin
  index := CacheReader.Indices[ECacheIndex.SPRITES];
  sector := index.ReadArchiveSector(SPRITE_ID, index.ID, index.IndexData);
  if sector.Data = [] then
    raise GetDebugLn('OverheadFinder', 'Failed to read the overhead sprite from the cache');

  sprites := TSpriteDefinition.Create(SPRITE_ID, sector.Decompress());

  for overhead in EOverhead do
  begin
    Self.Images[overhead] := sprites[FRAMES[overhead]].ToImage();
    Self.Images[overhead].Crop(CROP);
  end;
end;

(*
## TOverheadFinder.GetImage
```pascal
function TOverheadFinder.GetImage(overhead: EOverhead): TImage;
```
Internal function.
Retrieves the template image for a specific overhead type.
Images are read from the game cache the first time one is needed and kept in memory after that.

Parameters:
- overhead: The overhead type to get the template image for

Returns TImage object containing the template, or raises exception if image cannot be loaded.
*)
function TOverheadFinder.GetImage(overhead: EOverhead): TImage;
begin
  if Self.Images[overhead] = nil then
    Self.LoadImages();

  Result := Self.Images[overhead];
end;

(*
## TOverheadFinder.Find
```pascal
function TOverheadFinder.Find(overheads: set of EOverhead; maxToFind: Integer = 5): TOverheadArray;
```
Searches the main screen for specified overhead prayer/protection icons using template matching.
Detects overhead icons by first finding their characteristic colors: the tan background of the
protection prayers, the purple background of the dampen ones, the red of retribution and the teal
of smite and redemption. The regions around those colors are then searched with template matching.

Parameters:
- overheads: Set of overhead types to search for
- maxToFind: Maximum number of overhead icons to detect (default: 5)

Returns TOverheadArray containing detected overhead positions and types.

Example:
```pascal
var
  foundOverheads: TOverheadArray;
  i: Integer;
begin
  OverheadFinder.Setup();
  foundOverheads := OverheadFinder.Find([MAGIC, RANGED, MELEE], 10);

  if Length(foundOverheads) > 0 then
  begin
    WriteLn('Found ' + ToStr(Length(foundOverheads)) + ' overhead icons:');
    for i := 0 to High(foundOverheads) do
      WriteLn('- ' + ToStr(foundOverheads[i].Overhead) + ' at ' + ToStr(foundOverheads[i].Position));
  end else
    WriteLn('No overhead icons detected');
end;
```

{figure} ../../images/overhead_detection_example.png
*)
function TOverheadFinder.Find(overheads: set of EOverhead; maxToFind: Integer = 5): TOverheadArray;
const
  //the tan and purple backgrounds, then the red of retribution and the teal of smite and redemption
  COLORS: array of TColorTolerance = [
    [$74B0C7, 2.844, EColorSpace.RGB, [0.681, 1.299, 1.021]],
    [$A77EBC, 3, EColorSpace.RGB, [0.681, 1.299, 1.021]],
    [$0000FB, 3, EColorSpace.RGB, [1, 1, 1]],
    [$ACC814, 3, EColorSpace.RGB, [1, 1, 1]]
  ];
  //a color pixel inside a template is at most this far from the template's opposite edge
  MARGIN: Integer = 13;
  //every overhead has more pixels of its colors than this, smaller clusters are just noise
  MIN_POINTS: Integer = 20;
var
  color: TColorTolerance;
  tpa, cluster: TPointArray;
  overhead: EOverhead;
  bounds: TBox;
  searchingBounds: TBoxArray;
  img, templt: TImage;
  imgMatrix: TIntegerMatrix;
  matrix: TSingleMatrix;
begin
  for color in COLORS do
    tpa += Target.FindColor(color, MainScreen.Bounds);

  if tpa = [] then
    Exit;

  for cluster in tpa.Cluster(8) do
    if Length(cluster) >= MIN_POINTS then
      searchingBounds += cluster.Bounds().Expand(MARGIN, MainScreen.Bounds);

  for overhead in overheads do
  begin
    img := Self.GetImage(overhead);
    imgMatrix := img.ToMatrix();
    for bounds in searchingBounds do
    begin
      if (bounds.Width < img.Width) or (bounds.Height < img.Height) then
        Continue;

      templt := Target.GetImage(bounds);
      matrix := MatchTemplate(templt.ToMatrix(), imgMatrix, ETMFormula.TM_CCOEFF_NORMED);

      with matrix.ArgMax() do
      begin
        if matrix[Y,X] < Self.Similarity then
          Continue;

        Result += [Point(X + 6, Y + 6).Offset(bounds.TopLeft), overhead];
        if Result.Length = maxToFind then
          Exit;
      end;
    end;
  end;
end;

(*
## OverheadFinder variable
Global {ref}`TOverheadFinder` variable. Use this instance for all overhead
detection operations in your scripts.
*)
var
  OverheadFinder: TOverheadFinder;
