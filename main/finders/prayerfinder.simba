

{$DEFINE WL_PRAYERFINDER_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  EPrayer = enum(
    THICK_SKIN,           BURST_OF_STRENGTH,  CLARITY_OF_THOUGHT,
    SHARP_EYE,            MYSTIC_WILL,        ROCK_SKIN,
    SUPERHUMAN_STRENGTH,  IMPROVED_REFLEXES,  RAPID_RESTORE,
    RAPID_HEAL,           PROTECT_ITEM,       HAWK_EYE,
    MYSTIC_LORE,          STEEL_SKIN,         ULTIMATE_STRENGTH,
    INCREDIBLE_REFLEXES,  PROTECT_FROM_MAGIC, PROTECT_FROM_MISSILES,
    PROTECT_FROM_MELEE,   EAGLE_EYE,          MYSTIC_MIGHT,
    DEADEYE,              MYSTIC_VIGOUR,      RETRIBUTION,
    REDEMPTION,           SMITE,              PRESERVE,
    CHIVALRY,             PIETY,              RIGOUR,
    AUGURY
  );


  TPrayerFinder = record
    PrayerImages: array [EPrayer] of TImage;
    SpriteIDs: array [EPrayer] of Integer;
    Similarity: Single;
    ImageCompare: TImageCompareUtils;
    Enums, Items: TArchive;
    IsSetup, IsResolved: Boolean;
  end;

const

  PRAYER_BOOK_ENUMS: array [0..1] of Integer = [4956, 3343];
  PRAYER_NAME_PARAM: Integer = 1752;
  PRAYER_SPRITE_PARAM: Integer = 1757;


procedure TPrayerFinder.Setup();
begin
  if Self.IsSetup then
    Exit;

  //only set similarity if the user didn't set it already
  if Self.Similarity = 0 then
    Self.Similarity := 0.97;

  CacheReader.Indices[ECacheIndex.CONFIGS].Cache();
  Self.Enums := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.ENUMS];
  Self.Items := CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.ITEM];

  Self.IsSetup := True;
end;


procedure TPrayerFinder.Resolve();
var
  id, i, j, sprite: Integer;
  enumDef: TEnumDefinition;
  itemDef: TItemDefinition;
  name: String;
  prayer: EPrayer;
begin
  for prayer in EPrayer do
    Self.SpriteIDs[prayer] := -1;

  for id in PRAYER_BOOK_ENUMS do
  begin
    enumDef := TEnumDefinition.Create(id, Self.Enums.Files.Value[id].Data);

    for i := 0 to High(enumDef.IntVals) do
    begin
      itemDef := TItemDefinition.Create(enumDef.IntVals[i], Self.Items.Files.Value[enumDef.IntVals[i]].Data);

      name := '';
      sprite := -1;
      for j := 0 to High(itemDef.Params) do
        if itemDef.Params[j].Key = PRAYER_NAME_PARAM then
          name := itemDef.Params[j].StrValue
        else if itemDef.Params[j].Key = PRAYER_SPRITE_PARAM then
          sprite := itemDef.Params[j].IntValue;

      name := LowerCase(name);
      if name = '' then
        Continue;

      for prayer in EPrayer do
        if ToStr(prayer).After('.').Replace('_', ' ').ToLower() = name then
          Self.SpriteIDs[prayer] := sprite;
    end;
  end;

  Self.IsResolved := True;
end;


function TPrayerFinder.GetImage(prayer: EPrayer): TImage;
var
  index: TCacheIndex;
  sector: TArchiveSector;
begin
  if Self.PrayerImages[prayer] <> nil then
    Exit(Self.PrayerImages[prayer]);

  if not Self.IsResolved then
    Self.Resolve();

  if Self.SpriteIDs[prayer] = -1 then
    Exit;

  index := CacheReader.Indices[ECacheIndex.SPRITES];
  sector := index.ReadArchiveSector(Self.SpriteIDs[prayer], index.ID, index.IndexData);
  if sector.Data = [] then
    Exit;

  Self.PrayerImages[prayer] := TSpriteDefinition.Create(Self.SpriteIDs[prayer], sector.Decompress())[0].ToImage();
  Result := Self.PrayerImages[prayer];
end;


function TPrayerFinder.FindAll(prayers: array of EPrayer; boxes: TBoxArray; maxToFind: Integer = 0): TImageMatchArray;
var
  prayer: EPrayer;
  img, container: TImage;
  bounds: TBox;
  match: TImageMatch;
  i: Integer;
begin
  if boxes = [] then
    Exit;

  //icons can slightly overflow their slot so search the whole area at once
  bounds := boxes.Merge().Expand(2);
  container := Target.GetImage(bounds);

  for prayer in prayers do
  begin
    img := Self.GetImage(prayer);
    if img = nil then
      Continue;

    if not Self.ImageCompare.FindExact(img, container, bounds.TopLeft, match) then
      Continue;

    match.Index := -1;
    for i := 0 to High(boxes) do
      if boxes[i].Contains(match.Box.Center) then
      begin
        match.Index := i;
        Break;
      end;

    Result += match;
    if (maxToFind > 0) and (Length(Result) >= maxToFind) then
      Exit;
  end;
end;

function TPrayerFinder.FindAll(prayers: array of EPrayer; boxes: TBoxArray; out matches: TImageMatchArray): Boolean; overload;
var
  prayer: EPrayer;
  results: TImageMatchArray;
begin
  for prayer in prayers do
  begin
    results := Self.FindAll([prayer], boxes, 1);
    if results = [] then
      Exit;

    matches += results;
  end;

  Result := True;
end;


function TPrayerFinder.Find(prayers: array of EPrayer; boxes: TBoxArray; out match: TImageMatch): Boolean;
var
  matches: TImageMatchArray;
begin
  matches := Self.FindAll(prayers, boxes, 1);
  Result := matches <> [];
  if Result then
    match := matches[0];
end;

var

  PrayerFinder: TPrayerFinder;
