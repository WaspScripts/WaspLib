(*
# House Layout Finder
Provides and compares images for {ref}`House Viewer`.
*)
{$DEFINE WL_HOUSE_LAYOUT_FINDER_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type
(*
## THouseLayoutFinder
Main record used to interact with the {ref}`House Viewer`.
*)
  THouseLayoutFinder = record
    RoomImages: array [EHouseRoom] of TImageArray;
    Similarity: Single;
    ImageCompare: TImageCompareUtils;
  end;

(*
## HouseLayoutFinder.Setup
```pascal
procedure THouseLayoutFinder.Setup();
```
Sets up the {ref}`THouseLayoutFinder` similarity.

Example:
```pascal
HouseLayoutFinder.Setup();
```
*)
procedure THouseLayoutFinder.Setup();
begin
  //only set similarity if the user didn't set it already
  if Self.Similarity = 0 then
    Self.Similarity := 0.85;
end;

(*
## HouseLayoutFinder.GetImages
```pascal
function THouseLayoutFinder.GetImages(room: EHouseRoom): TImageArray;
```
Retrieves the images for a specific `room`, as the {ref}`House Viewer` draws them.
This returns a `TImageArray` with 4 images, one for each possible rotation.
`EHouseRoom.UNKNOWN` has no image and returns an empty array.

The images are read from the game cache the first time a room is asked for and kept in memory
after that. The house viewer picks each room's image from an enum keyed by the room's type,
which is not the same as its {ref}`EHouseRoom` value.

Example:
```pascal
img := HouseLayoutFinder.GetImage(EHouseRoom.ACHIEVEMENT_GALLERY)[0];
img.Show();
```
*)
property THouseLayoutFinder.Images(room: EHouseRoom): TImageArray;
const
  SPRITE_ENUM: Integer = 1423;
  ROOM_TYPES: array [EHouseRoom] of Integer = [
    -1, 1, 2, 3, 4, 12, 5, 7,
    29, 6, 22, 9, 25,
    24, 13, 23, 11, 14, 21,
    15, 26, 28, 27
  ];
var
  enumDef: TEnumDefinition;
  index: TCacheIndex;
  sector: TArchiveSector;
  i, spriteId: Integer;
begin
  if (Self.RoomImages[room] <> []) or (room = EHouseRoom.UNKNOWN) then
    Exit(Self.RoomImages[room]);

  CacheReader.Indices[ECacheIndex.CONFIGS].Cache();
  enumDef := TEnumDefinition.Create(
    SPRITE_ENUM,
    CacheReader.Indices[ECacheIndex.CONFIGS].ReferenceTable.Archives.Value[EConfigArchive.ENUMS].Files.Value[SPRITE_ENUM].Data
  );

  i := enumDef.Keys.IndexOf(ROOM_TYPES[room]);
  if i = -1 then
    raise GetDebugLn('HouseLayoutFinder', 'Failed to find the ' + ToStr(room) + ' image in the cache.');
  spriteId := enumDef.IntVals[i];

  index := CacheReader.Indices[ECacheIndex.SPRITES];
  sector := index.ReadArchiveSector(spriteId, index.ID, index.IndexData);
  if sector.Data = [] then
    raise GetDebugLn('HouseLayoutFinder', 'Failed to read the ' + ToStr(room) + ' image from the cache.');

  Self.RoomImages[room] += TSpriteDefinition.Create(spriteId, sector.Decompress())[0].ToImage();

  for i := 1 to 3 do
    Self.RoomImages[room] += Self.RoomImages[room][i-1].RotateClockWise(1);

  Result := Self.RoomImages[room];
end;

function THouseLayoutFinder.Compare(bounds: TBox; out rotation: Integer): EHouseRoom;
var
  room: EHouseRoom;
  sample: TImage;
  templates: TImageArray;
  match, best: Single;
  i: Integer;
begin
  rotation := 0;
  if Target.HasColor($3F4A53, 0.4, 1, bounds) then
    Exit(EHouseRoom.UNKNOWN);

  sample := Target.GetImage(bounds);
  for room := EHouseRoom.PARLOUR to High(EHouseRoom) do
  begin
    //rooms that look alike when turned pass the similarity in more than one rotation, the best one is the real one
    templates := Self.Images[room];
    best := 0;
    for i := 0 to High(templates) do
    begin
      match := templates[i].Compare(sample);
      if match > best then
      begin
        best := match;
        rotation := i;
      end;
    end;

    if best >= Self.Similarity then
      Exit(room);
  end;

  rotation := 0;
end;

var
(*
## HouseLayoutFinder variable
Global {ref}`THouseLayoutFinder` variable.
*)
  HouseLayoutFinder: THouseLayoutFinder;
