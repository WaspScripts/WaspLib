

{$DEFINE WL_DOTFILTERS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TDotFilter = record
    Poly   : TPolygon;
    Circle : TCircle;
    Inside : Boolean;
    Timeout: Boolean;
    Timer  : TCountDown;
  end;


function TDotFilter.Create(
  const bounds: TPolygon; const circle: TCircle;
  inside: Boolean; time: Integer = -1
): TDotFilter; static;
var
  timer: TCountDown;
begin
  timer.Start(time);
  Result := [bounds, circle, inside, (time > 0), timer];
end;


function TDotFilter.IsExpired(): Boolean;
begin
  Result := (Self.Timeout and Self.Timer.IsFinished);
end;


function TDotFilter.IsValid(const pt: TPoint): Boolean;
var
  inPoly, inCircle: Boolean;
begin
  if Self.Poly <> Default(TPolygon) then
    inPoly := Self.Poly.Contains(pt);
  if Self.Circle <> Default(TCircle) then
    inCircle := Self.Circle.Contains(pt);

  if Self.Inside then
    Result := inPoly or inCircle
  else
    Result := not inPoly and not inCircle;
end;

{$R-}

{$IFDEF RANGECHECKS}
begin
  WriteLn GetDebugLn('TDotFilterArray', 'Range checks are enabled for TDotFilterArray, these should be disabled in production!', ELogLevel.WARN);
end;
{$ENDIF}

type

  TDotFilterArray = array of TDotFilter;


procedure TDotFilterArray.Setup(const bounds: TPolygon; const circle: TCircle; inside: Boolean; time: Integer = -1);
begin
  Self += TDotFilter.Create(bounds, circle, inside, time);
end;

procedure TDotFilterArray.SetupBounds(const bounds: TPolygon; inside: Boolean; time: Integer = -1);
begin
  Self.Setup(bounds, Default(TCircle), inside, time);
end;

procedure TDotFilterArray.SetupCircle(const circle: TCircle; inside: Boolean; time: Integer = -1);
begin
  Self.Setup(Default(TPolygon), circle, inside, time);
end;



procedure TDotFilterArray.ClearExpired();
var
  i: Integer;
begin
  for i := High(Self) downto 0 do
    if Self[i].IsExpired() then
      Delete(Self, i, 1);
end;



function TDotFilterArray.IsValid(const pt: TPoint; clearExpired: Boolean = True): Boolean;
var
  i: Integer;
  inPoly, inCircle: TBooleanArray;
  filter: TDotFilter;
begin
  if clearExpired then
  begin
    for i := High(Self) downto 0 do
    begin
      if Self[i].IsExpired() then
      begin
        Delete(Self, i, 1);
        Continue;
      end;

      if Self[i].IsValid(pt) then
        Exit(True);
    end;
    Exit;
  end;

  SetLength(inPoly, Length(Self));
  SetLength(inCircle, Length(Self));

  for i := 0 to High(Self) do
  begin
    filter := Self[i];
    if filter.Poly <> Default(TPolygon) then
      inPoly[i] := filter.Poly.Contains(pt);
    if filter.Circle <> Default(TCircle) then
      inCircle[i] := filter.Circle.Contains(pt);

    if Self[i].Inside then
      Continue;

    if inPoly[i] or inCircle[i] then
      Exit;
  end;

  for i := 0 to High(Self) do
    if inPoly[i] or inCircle[i] then
      Exit(True);
end;


function TDotFilterArray.FilterDots(const dots: TPointArray; clearExpired: Boolean): TPointArray;
var
  dot: TPoint;
begin
  for dot in dots do
    if Self.IsValid(dot, clearExpired) then
      Result += dot;
end;


function TMinimap.GetFilteredDotArray(dots: EDots; filters: TDotFilterArray; clearExpired: Boolean): TPointArray;
var
  tpa, flat: TPointArray;
begin
  for tpa in Self.GetDots(dots) do
    flat += tpa;
  Result := filters.FilterDots(flat, clearExpired);
end;

function TMinimap.GetFilteredDot(dots: EDots; filters: TDotFilterArray; clearExpired: Boolean): TPoint;
var
  tpa: TPointArray;
begin
  tpa := Self.GetFilteredDotArray(dots, filters, clearExpired);
  if not tpa.IsEmpty then
    Result := tpa[0];
end;
{$R+}
