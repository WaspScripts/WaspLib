

{$DEFINE WL_RECORDER_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

{%anchor WL_DEBUG_RECORDER}
{.$DEFINE WL_DEBUG_RECORDER}

type

  TSimbaRecorder = record
    Enabled, IsRecording: Boolean;
    BufferSeconds: UInt64;
  end;

procedure TSimbaRecorder.Start();
var
  window, plugin: String;
  process: TRunningProcess;
begin
  if not Self.Enabled or Self.IsRecording then
    Exit;

  {$IFNDEF WL_DISABLE_FAKE_INPUT}
  case Client.Typ of
    {$IFDEF WINDOWS}
    EClient.OFFICIAL:
    begin
      window := ToStr(WaspInput.Window);
      plugin := 'wasp-input';
    end;
    {$ENDIF}
    EClient.LEGACY, EClient.RUNELITE:
    begin
      window := ToStr(RemoteInput.Window);
      plugin := 'remote-input';
    end;
  end;
  {$ENDIF}

  process := StartProcess(
    GetProcessPath(GetProcessID()),
    [
      {$IFDEF WL_DEBUG_RECORDER}'--open', {$ENDIF}
      '--run',
      {$MACRO DIR} + 'recorder_subprocess.simba'
    ],
    '',
    [
      {$IFDEF WL_DEBUG_RECORDER}'debugging=true', {$ENDIF}
      'script=' + ToStr(GetProcessID()),
      'target=' + window,
      'time='   + ToStr(Self.BufferSeconds),
      'plugin=' + plugin,
      'path='   + WLEnv.VideosDir
    ]
  );

  Self.IsRecording := True;
  process.Free();
end;

var
  SimbaRecorder: TSimbaRecorder;
