procedure TAntiBan.HoverMSTile(dotType: EDot; rightClick: Boolean = False);
var
  tries: Int32;
  a: Double;
  rDot: TPoint;
  msBox: TBox;
  dots,cTPA: TPointArray;
  cArr: TColorArray;
begin
  dots := Minimap.GetDots(dotType);
  if dots.Length < 1 then Exit;
  a := Minimap.CompassRadians;
  repeat
    Inc(tries);
    rDot := dots[Random(Low(dots),High(dots))];
    msBox := Minimap.Vector2MSQuad([rDot.X, rDot.Y, 0], a).Bounds;
    if MainScreen.Bounds.ContainsBox(msBox) then
    begin
      Writeln('Hovering random ' + toStr(dotType));
      cArr := Target.GetColors(TPointArray.CreateFromBox(msBox,True));
      cTPA := Target.FindColor(cArr.GetRarest(), 15, msBox);
      Mouse.Move(cTPA.Mean());
      if rightClick then
        Mouse.Click(EMouseButton.RIGHT);

      Biometrics.Sleep(1500, 2700);
      if rightClick then
        ChooseOption.Close();
      Exit;
    end;
  until(tries > 10);
end;

procedure TAntiban.HoverRandomNPC();
begin
  Self.HoverMSTile(EDot.NPC);
end;

procedure TAntiban.HoverRandomPlayer();
begin
  Self.HoverMSTile(EDot.PLAYER);
end;

procedure TAntiban.HoverRandomGroundItem();
begin
  Self.HoverMSTile(EDot.ITEM);
end;



//Antiban task "packs"
procedure TAntiban.RandomCameraTask();
begin
  case Random(10) of
    0..4: Self.AdjustZoom();
    5..7: Self.SmallCameraRotation();
    else  Self.LargeCameraRotation();
  end;
end;

procedure TAntiban.RandomMouseTask();
begin
  case Random(10) of
    0..1: Self.RandomRightClick();
    2..4: Self.LargeRandomMouse();
    else  Self.SmallRandomMouse();
  end;
end;

procedure TAntiban.RandomGameTabTask();
begin
  case Random(13) of
    0..3:   Self.RandomTab();
    4..9:   Self.ToggleTab();
    //TODO: 10..11: Self.ToggleAchievementTabs();
    //TODO: 12:     Self.CheckCharges();
  end;
end;

procedure TAntiban.RandomMakeTask();
begin
  case Random(0, 10) of
    0..3:  Self.HoverMakeItem();
    4..6:  Self.HoverMakeQuantity();
    7..8:  Self.ReadMakeItemHint();
    9..10: Self.ToggleMakeQuantity();
  end;
end;

procedure TAntiban.RandomChatTask();
begin
  case Random(30) of
    0..5:   Self.RandomChatTab();
    6..17:  Self.ToggleChatTab();
    18..24: Self.ChatScrolling();
    25..29: Self.RandomChatTabState();
  end;
end;

procedure TAntiban.RandomBankTask();
begin
  case Random(0, 12) of
    0..2: Self.RandomBankTab;
    3..9: Self.ToggleBankTab;
    10..11: Self.BankScrolling;
  end;
end;

procedure TAntiban.RandomDepositTask();
begin
  case Random(0, 10) of
    0..3:  Self.HoverDepositItem();
    4..6:  Self.HoverDepositQuantity();
    7..8:  Self.HoverDepositButton();
    9..10: Self.ToggleDepositQuantity();
  end;
end;

procedure TAntiban.RandomGETask();
begin
  case Random(0, 10) of
    0..2: Self.CheckHistory();
    3..9: Self.RandomOffer();
  end;
end;


procedure TAntiban.LoseFocus();
begin
  DebugLn('Antiban', 'Losing client focus');
  Client.LoseFocus();
end;



type
  TAntibanNamedMethod = record
    Name: String;
    Method: TAntibanMethod;
  end;
  TAntibanNamedMethodArray = array of TAntibanNamedMethod;

function TAntibanNamedMethodArray.IndexOf(value: String): Integer; overload;
begin
  for Result := 0 to High(Self) do
    if Self[Result].Name = value then
      Exit;
  Result := -1;
end;

const
  ANTIBAN_TASKS: TAntibanNamedMethodArray := [
    ['SmallRandomMouse',      @Antiban.SmallRandomMouse],
    ['LargeRandomMouse',      @Antiban.LargeRandomMouse],
    ['SmallCameraRotation',   @Antiban.SmallCameraRotation],
    ['LargeCameraRotation',   @Antiban.LargeCameraRotation],
    ['LoseFocus',             @Antiban.LoseFocus],
    ['HoverSkills',           @Antiban.HoverSkills],
    ['OpenSkills',            @Antiban.OpenSkills],
    ['HoverMakeItem',         @Antiban.HoverMakeItem],
    ['HoverMakeQuantity',     @Antiban.HoverMakeQuantity],
    ['ReadMakeItemHint',      @Antiban.ReadMakeItemHint],
    ['ToggleMakeQuantity',    @Antiban.ToggleMakeQuantity],
    ['RandomMakeTask',        @Antiban.RandomMakeTask],
    ['ChatScrolling',         @Antiban.ChatScrolling],
    ['RandomChatTab',         @Antiban.RandomChatTab],
    ['ToggleChatTab',         @Antiban.ToggleChatTab],
    ['RightClickChatMessage', @Antiban.RightClickChatMessage],
    ['RandomChatTabState',    @Antiban.RandomChatTabState],
