procedure TAntiban.HoverDepositQuantity();
var
  btn: TButton;
begin
  if not DepositBox.IsOpen() then Exit;
  DebugLn('Antiban', 'Hovering a random deposit box quantity button');
  btn := DepositBox.QuantityButtons[EItemQuantity(Random(0, Length(DepositBox.QuantityButtons)-1))];
  Mouse.Move(btn.Bounds);
  Biometrics.Sleep(500, 2000, ERandomDir.LEFT);
