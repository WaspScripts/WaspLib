

{$DEFINE WL_ANTIBAN_TASKS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}




//Mouse antiban
procedure TAntiban.SmallRandomMouse();
var
  pt: TPoint;
begin
  DebugLn('Antiban', 'Random Mouse (Small)');

  repeat
    pt := Mouse.Position.Random(-350, 350);
  until Mouse.Position.DistanceTo(pt) > 50;

  Mouse.Move(pt);
end;

procedure TAntiban.LargeRandomMouse();
var
  speed: Double;
  i: Int32;
  b: TBox;
begin
  DebugLn('Antiban', 'Random Mouse');

  speed := Target.Options.MouseSpeed;
  Target.Options.MouseSpeed := Target.Options.MouseSpeed + Biometrics.RandomModeInteger(2, 1, 5);

  b := Client.Bounds.Expand(150);

  for i := 1 to Trunc(Abs(GaussRand(1, 6))) do
  begin
    if Random() < 0.30 then
      Mouse.Move(b, True, EMouseDistribution.GAUSS)
    else
      Mouse.Move(b, True, EMouseDistribution.RANDOM);

    if Random() < 0.50 then
      Biometrics.Sleep(0, 1000, ERandomDir.LEFT);
  end;

  Target.Options.MouseSpeed := speed;
end;


//Camera antiban
procedure TAntiban.SmallCameraRotation();
begin
  DebugLn('Antiban', 'Small camera rotation');
  Minimap.CompassRadians := Minimap.CompassRadians + GaussRand(PI/12, PI/4) * Random(-1,1);
end;

procedure TAntiban.LargeCameraRotation();
begin
  DebugLn('Antiban', 'Large camera rotation');
  Minimap.CompassRadians := Minimap.CompassRadians + GaussRand(PI/6, TAU) * Random(-1,1);
end;


//Stats antiban
procedure TAntiban.HoverSkill(skill: ESkill; time: UInt32; returnToCurrentTab: Boolean);
var
  tab: EGameTab;
begin
  DebugLn('Antiban', 'Hover skill: ' + ToString(skill));

  if returnToCurrentTab then
    tab := GameTabs.GetCurrent();

  if Stats.Hover(skill) then
  begin
    Sleep(time);
    if returnToCurrentTab then
      GameTabs.Open(tab);
  end;
end;

procedure TAntiban.HoverSkills();
begin
  if Self.Skills = [] then
  begin
    DebugLn('Antiban', 'HoverSkills: No skills declared.', ELogLevel.ERROR);
    Exit;
  end;

  Self.HoverSkill(Self.Skills.Random(), Biometrics.RandomModeInteger(3000, 1000, 8000), RandomBoolean(0.5));
end;

procedure TAntiban.OpenSkill(skill: ESkill; time: Integer; returnToCurrentTab: Boolean);
var
  tab: EGameTab;
begin
  DebugLn('Antiban', 'Opening skill: ' + ToString(skill));

  if returnToCurrentTab then
    tab := GameTabs.GetCurrent();

  if Stats.Hover(skill) then
  begin
    Mouse.Click(EMouseButton.LEFT);
    MSInterface.WaitOpen(EInterfaceType.PAPER);
    Biometrics.Sleep(time);

    MSInterface.Close();

    if returnToCurrentTab then
      GameTabs.Open(tab);
  end;
end;

procedure TAntiban.OpenSkills();
begin
  if Self.Skills = [] then
  begin
    DebugLn('Antiban', 'OpenSkills: No skills declared.', ELogLevel.ERROR);
    Exit;
  end;

  Self.OpenSkill(Self.Skills.Random(), Biometrics.RandomModeInteger(3000, 1000, 8000), RandomBoolean(0.5));
end;



//Make antiban
procedure TAntiban.HoverMakeItem();
var
  boxes: TBoxArray;
begin
  if not Make.IsOpen() then Exit;
  DebugLn('Antiban', 'Hovering a random make item');
  boxes := Make.GetItemBoxes();
  if boxes = [] then Exit;
  Mouse.Move(boxes.Random());
end;

procedure TAntiban.HoverMakeQuantity();
var
  boxes: TBoxArray;
begin
  if not Make.IsOpen() then
    Exit;
  if not Make.CloseHint() then
    Exit;

  DebugLn('Antiban', 'Hovering a random make quantity button');
  boxes := Make.GetQuantityBoxes();
  if boxes = [] then Exit;
  Mouse.Move(boxes.Random());
  Biometrics.Sleep(500, 2000, ERandomDir.LEFT);
end;

procedure TAntiban.ReadMakeItemHint();
var
  boxes: TBoxArray;
begin
  if not Make.IsOpen() then Exit;
  DebugLn('Antiban', 'Reading a random make item hint');
  boxes := Make.GetItemBoxes();
  if boxes = [] then Exit;
  Mouse.Move(boxes.Random());
  if Make.WaitHint(2000) then
  begin
    Biometrics.Sleep(1000, 3000, ERandomDir.LEFT);
    Make.CloseHint();
  end;
end;

procedure TAntiban.ToggleMakeQuantity();
var
  randomBtn: TMakeQuantityButton;
  quantityBtns: array of TMakeQuantityButton;
  currentBtn, customQuantity, i: Integer;
begin
  if not Make.IsOpen() then
    Exit;
  if not Make.CloseHint() then
    Exit;

  DebugLn('Antiban', 'Toggling make quantity buttons');

  quantityBtns := Make.FindQuantityButtons();
  if quantityBtns = [] then Exit;
  currentBtn := Make.GetCurrentQuantity();
  randomBtn := quantityBtns[Random(Length(quantityBtns))];

  if randomBtn.UpText = 'Other' then
  begin
    for i := 0 to High(quantityBtns) do
      if (quantityBtns[i].Quantity = EItemQuantity.CUSTOM)
         and (quantityBtns[i].UpText <> 'Other') then
      begin
        customQuantity := StrToInt(quantityBtns[i].UpText);
      end;

    Make.SetQuantity(Random(1, 27));
    Biometrics.Sleep(1000, 3000, ERandomDir.LEFT);

    if customQuantity > 0 then
    begin
      Make.SetQuantity(customQuantity);
      Biometrics.Sleep(1000, 3000, ERandomDir.LEFT);
    end;
  end
  else
  begin
    // Just click the random button
    randomBtn.Button.Enabled := True;
    Biometrics.Sleep(1000, 3000, ERandomDir.LEFT);
  end;

  // Restore original
  if Make.IsOpen() then
    Make.SetQuantity(currentBtn);
end;

//Chatbox antiban
procedure TAntiban.ChatScrolling();
begin
  DebugLn('Antiban', 'Random scrolling on chat');
  Chat.Scroll.Scroll(Biometrics.RandomModeInteger(5, 3, 8), False);
  Biometrics.Sleep(5000, 8000);
  Chat.Scroll.SetLevel(100);
end;

procedure TAntiban.RandomChatTab();
var
  tab: EChatTab;
begin
  tab := EChatTab(Random(1, Length(EChatTab)-1));
  DebugLn('Antiban', 'Opening ' + ToStr(tab) + ' chat button');
  Chat.Tabs.Open(tab);
end;

procedure TAntiban.ToggleChatTab();
var
  current: EChatTab;
begin
  current := Chat.Tabs.GetActive();
  DebugLn('Antiban', 'Toggling chat buttons');
  Self.RandomChatTab();
  Biometrics.Sleep(3000, 5000);
  Chat.Tabs.Open(current);
end;

procedure TAntiban.RightClickChatMessage();
var
  b: TBox;
  tpa: TPointArray;
begin
  DebugLn('Antiban', 'Toggling chat buttons');
  if Chat.Tabs.Open(EChatTab.PUB) then
  begin
    for b in Chat.MessageLines do
    begin
      tpa := Target.FindColor(TFonts.BLUE, 0, b);
      if tpa <> [] then
      begin
        Mouse.Move(tpa.Bounds());
        if ChooseOption.Open() then
        begin
          Biometrics.Sleep(2*TICK, 4*TICK, ERandomDir.LEFT);
          ChooseOption.Close();
        end;
        Break;
      end;
    end;
  end;
end;

procedure TAntiban.RandomChatTabState();
var
  tab: EChatTab;
  state: EChatTabState;
begin
  tab := EChatTab(Random(1, Length(EChatTab)-1));
  case tab of
    EChatTab.GAME:     state := EChatTabState.FILTERED;
    EChatTab.PUB:      state := EChatTabState(Random(1, Length(EChatTabState)-1));
    EChatTab.PRIV:     state := EChatTabState(Random(1, 3));
    EChatTab.CHANNEL:  state := EChatTabState(Random(1, 3));
    EChatTab.CLAN:     state := EChatTabState(Random(1, 3));
    EChatTab.TRADE:    state := EChatTabState(Random(1, 3));
  end;

  DebugLn('Antiban', 'Changing ' + ToStr(tab) + ' state to ' + ToStr(state));
  Chat.Tabs.ChangeState(tab, state);
end;


//GameTabs antiban
procedure TAntiban.RandomTabBetween(first, last: EGameTab);
begin
  if RandomBoolean(0.5) then
  begin
    GameTabs.Open(EGameTab(Random(Ord(first), Ord(last))));
    Biometrics.Sleep(0, 2500, ERandomDir.LEFT);
  end;

  GameTabs.Open(EGameTab(Random(Ord(first), Ord(last))));
  Biometrics.Sleep(0, 8000, ERandomDir.LEFT);
end;

procedure TAntiban.RandomTab();
begin
  DebugLn('Antiban', 'Random Tab');

  if RandomBoolean(0.8) then
    Self.RandomTabBetween(EGameTab.COMBAT, EGameTab.MAGIC)
  else
    Self.RandomTabBetween(EGameTab.CLAN, EGameTab.MUSIC);
end;

procedure TAntiban.ToggleTab();
var
  current: EGameTab;
begin
  DebugLn('Antiban', 'Toggling GameTabs');
  current := GameTabs.GetCurrent();
  Self.RandomTab();
  Biometrics.Sleep(500, 6000, ERandomDir.LEFT);
  GameTabs.Open(current);
end;


