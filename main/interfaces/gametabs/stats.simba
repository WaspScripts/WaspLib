
{$DEFINE WL_STATS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  ESkill = enum(
    ATTACK,       HITPOINTS, MINING,
    STRENGTH,     AGILITY,   SMITHING,
    DEFENCE,      HERBLORE,  FISHING,
    RANGED,       THIEVING,  COOKING,
    PRAYER,       CRAFTING,  FIREMAKING,
    MAGIC,        FLETCHING, WOODCUTTING,
    RUNECRAFTING, SLAYER,    FARMING,
    CONSTRUCTION, HUNTER,    SAILING,
    TOTAL
  );


  TSkillInfo = record
    Level, XP, Next, Remainder: Integer;
  end;


  TStats = record
    Levels, Goals: array [ESkill] of Integer;
    Skills: TBoxArray;
  end;


procedure TStats.SetupGameTab();
begin
  with GameTab.Bounds do
  begin
    Self.Skills := TBoxArray.Create([X1, Y1+4], 3, 8, 57, 26, [6, 4]);
    Self.Skills += TBox.Create(X1, Y2-18, X2, Y2-2);
  end;
end;




function TStats.IsOpen(): Boolean;
begin
  Result := GameTabs.IsOpen(EGameTab.STATS);
end;


function TStats.Open(): Boolean;
begin
  Result := GameTabs.Open(EGameTab.STATS);
end;


function TStats.Hover(skill: ESkill): Boolean;
begin
  Result := Self.Open();
  if Result then
    Mouse.Move(Self.Skills[skill]);
end;



function TStats.FindSkillInfo(skill: ESkill; out skillInfo: TSkillInfo): Boolean;
var
  tpa: TPointArray;
  lines: TStringArray;
  b: TBox;
  i: Integer;
begin
  tpa := Target.FindColor($A0FFFF, 0, GameTab.Bounds);
  if tpa = [] then Exit;

  b := tpa.Bounds();
  SetLength(lines, b.Height div 12);
  if lines = [] then Exit;

  for i := 0 to High(lines) do
    lines[i] := OCR.Recognize([b.X1, b.Y1 + (i * 12), b.X2, b.Y1 + ((i+1) * 12) + 3], Fonts.PLAIN_12, [0], 0);

  if not (ToStr(skill).After('.').Capitalize() in lines[0]) then Exit;

  skillInfo.XP := lines[0].ExtractInteger(0);
  skillInfo.Level := XP2Level(skillInfo.XP);

  if Length(lines) = 3 then
  begin
    skillInfo.Next := lines[1].ExtractInteger(0);
    skillInfo.Remainder := lines[2].ExtractInteger(0);
  end;

  Result := True;
end;


function TStats.GetSkillInfo(skill: ESkill; time: Integer = 1000): TSkillInfo;
begin
  if not Self.Hover(skill) then Exit;
  SleepUntil(Self.FindSkillInfo(skill, Result), RandomMode(100, 50, 1500) , time);
end;



function TStats.GetLevel(skill: ESkill; useCache: Boolean = True): Integer;
var
  bounds: TBox;
begin
  if useCache then
  begin
    Result := Self.Levels[skill];
    if Result > 0 then
      Exit;
  end;

  if not Self.Open() then
    Exit;

  if skill = ESkill.TOTAL then
    bounds := Self.Skills[skill]
  else
    bounds := [
      Self.Skills[skill].X1, Self.Skills[skill].Y2 - (Self.Skills[skill].Height div 2),
      Self.Skills[skill].X2, Self.Skills[skill].Y2
    ];

  Result := OCR.RecognizeNumber(bounds, Fonts.PLAIN_11, [TFonts.YELLOW], 0);

  if Result > 0 then
    Self.Levels[skill] := Result;
end;


procedure TStats.CacheStats();
var
  i: Integer;
begin
  for i := 0 to Ord(High(ESkill)) do
  begin
    Self.GetLevel(ESkill(i), False);
    if Self.Goals[ESkill(i)] = 0 then
      Self.Goals[ESkill(i)] := $FF;
  end;
end;


procedure TStats.IncrementCachedLevel(skill: ESkill);
begin
  if Self.Levels[skill] > 0 then
    Self.Levels[skill] += 1;
end;




function TStats.GoalCompleted(skill: ESkill): Boolean;
begin
  Result := (Self.Goals[skill] > 0) and
            (Self.GetLevel(skill) >= Self.Goals[skill]);
end;


function TStats.AnyGoalsCompleted(): Boolean;
var
  skill: ESkill;
begin
  for skill := Low(ESkill) to High(ESkill) do
    if Self.GoalCompleted(skill) then
      Exit(True);
end;


function TStats.AllGoalsCompleted(): Boolean;
var
  skill: ESkill;
begin
  for skill := Low(ESkill) to High(ESkill) do
    if (Self.Goals[skill] > 0) and
       (Self.GetLevel(skill) < Self.Goals[skill]) then
      Exit;

  Result := True;
end;

var

  Stats: TStats;
