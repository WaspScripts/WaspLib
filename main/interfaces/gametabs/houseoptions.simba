

{$DEFINE WL_HOUSEOPTIONS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  EHouseOptionsButton = enum(CLOSE, VIEWER, EXPEL, SERVANT, LEAVE);


  THouseOptions = record
    Buttons: TBoxArray;
  end;



procedure THouseOptions.SetupGameTab();
begin
  SetLength(Self.Buttons, 5);

  with Self.Buttons[EHouseOptionsButton.CLOSE] do
  begin
    X1 := GameTab.Bounds.X2 - 22;
    Y1 := GameTab.Bounds.Y1 + 9;
    X2 := X1 + 20;
    Y2 := Y1 + 20;
  end;

  with Self.Buttons[EHouseOptionsButton.VIEWER] do
  begin
    X1 := GameTab.Bounds.X1 + 7;
    Y1 := GameTab.Bounds.Y1 + 26;
    X2 := X1 + 104;
    Y2 := Y1 + 39;
  end;

  with Self.Buttons[EHouseOptionsButton.EXPEL] do
  begin
    X1 := GameTab.Bounds.X1 + 7;
    Y1 := GameTab.Bounds.Y2 - 105;
    X2 := GameTab.Bounds.X2 - 7;
    Y2 := Y1 + 26;
  end;

  with Self.Buttons[EHouseOptionsButton.SERVANT] do
  begin
    X1 := GameTab.Bounds.X1 + 7;
    Y1 := GameTab.Bounds.Y2 - 76;
    X2 := GameTab.Bounds.X2 - 7;
    Y2 := Y1 + 26;
  end;

  with Self.Buttons[EHouseOptionsButton.LEAVE] do
  begin
    X1 := GameTab.Bounds.X1 + 7;
    Y1 := GameTab.Bounds.Y2 - 47;
    X2 := GameTab.Bounds.X2 - 7;
    Y2 := Y1 + 26;
  end;
end;






function THouseOptions.IsOpen(): Boolean;
begin
  Result := Target.HasColor(ColorTolerance($4C9055, 2.496, EColorSpace.HSV, [2.389, 0.261, 0.351]), 148, GameTab.Bounds);
end;


function THouseOptions.WaitOpen(time: Integer = 600; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;


function THouseOptions.Open(): Boolean;
begin
  Result := Self.WaitOpen();
end;


function THouseOptions.Close(): Boolean;
begin
  if not Self.IsOpen() then Exit(True);
  Mouse.Click(Self.Buttons[EHouseOptionsButton.CLOSE], EMouseButton.LEFT);
  Result := SleepUntil(not Self.IsOpen(), RandomMode(100, 50, 1500), 600);
end;



function THouseOptions.ExpelGuests(): Boolean;
begin
  if not Self.Open() then Exit();
  Mouse.Click(Self.Buttons[EHouseOptionsButton.EXPEL], EMouseButton.LEFT);
  Result := True; //TODO: Check if need anything else here.
end;


function THouseOptions.CallServant(): Boolean;
begin
  if not Self.Open() then
    Exit;
  Mouse.Click(Self.Buttons[EHouseOptionsButton.SERVANT], EMouseButton.LEFT);

  Result := SleepUntil(
    Chat.Title.ContainsAny(['utler', 'Repeat']), RandomMode(100, 50, 1500), TICK
  );
end;


function THouseOptions.LeaveHouse(): Boolean;
begin
  if not Self.Open() then
    Exit;
  Mouse.Click(Self.Buttons[EHouseOptionsButton.LEAVE], EMouseButton.LEFT);
  Result := SleepUntil(not Self.IsOpen(), RandomMode(100, 50, 1500), TICK);
end;

var

  HouseOptions: THouseOptions;
