
{$DEFINE WL_ACHIEVEMENTS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  EAchievementTab = enum(SUMMARY, QUESTS, DIARIES, ADVENTURE_PATHS);


  EAchievementDiary = enum(
    ARDOUGNE,
    DESERT,
    FALADOR,
    FREMENNIK,
    KANDARIN,
    KARAMJA,
    KOUREND_AND_KEBOS,
    LUMBRIDGE_AND_DRAYNOR,
    MORYTANIA,
    VARROCK,
    WESTERN_PROVINCES,
    WILDERNESS
  );


  TAchievementsSummary = record
    Username, CombatLevel, TotalLevel, TotalXP, Quests, Diaries, CombatTasks,
    CollectionLog, TimePlayed: TBox;
  end;


procedure TAchievementsSummary.SetupGameTab();
var
  boxes: TBoxArray;
begin
  with GameTab.Bounds do
  begin
    Self.Username := [X1+4, Y1+26, X2-4, Y1+44];
    boxes := TBoxArray.Create([X1, Y1+45], 2, 1, 90, 41, [3,0]);
    Self.CombatLevel := boxes[0];
    Self.TotalLevel := boxes[1];
    Self.TotalXP := [X1, Y1+89, X2, Y1+116];
    boxes := TBoxArray.Create([X1, Y1+119], 2, 2, 90, 53, [3,3]);
    Self.Quests := boxes[0];
    Self.Diaries := boxes[1];
    Self.CombatTasks := boxes[2];
    Self.CollectionLog := boxes[3];
    Self.TimePlayed := [X1, Y2 - 30, X2, Y2-5];
  end;
end;

type

  TQuestList = record
    Scroll: TScrollBar;
  end;


procedure TQuestList.SetupGameTab();
begin
  with GameTab.Bounds do
    Self.Scroll.Area := [X1+6, Y1+51, X2-21, Y2-45];
  Self.Scroll.Setup();
end;

type

  TDiarySlot = record
    Name, Number, Bounds: TBox;
    Levels: TBoxArray;
  end;


  TDiaryList = record
    Names: TStringArray;
    Scroll: TScrollBar;
    Cache: array [EAchievementDiary] of Integer;
  end;


procedure TDiaryList.SetupGameTab();
var
  diary: EAchievementDiary;
begin
  for diary := Low(EAchievementDiary) to High(EAchievementDiary) do
    Self.Names += ToString(diary).After('EAchievementDiary.').Replace('_', ' ').Replace(' AND ', ' & ').CapitalizeWords();

  with GameTab.Bounds do
    Self.Scroll.Area := [X1, Y1+45, X2-16, Y2-4];
  Self.Scroll.Setup();
end;


function TDiaryList.GetSlots(): array of TDiarySlot;
var
  tpa: TPointArray;
  atpa: T2DPointArray;
  slot: TDiarySlot;
begin
  tpa := Target.FindColor($0, 0, Self.Scroll.Area);
  atpa := tpa.Cluster(1.5).ExcludeSize(200, EComparator.__LT__);

  for tpa in atpa do
  begin
    with tpa.Bounds() do
    begin
      slot.Bounds := [X1-4, Y1-17, X2+3, Y2+3];
      if (Self.Scroll.Area.Y1 > slot.Bounds.Y1) or
         (Self.Scroll.Area.Y2 < slot.Bounds.Y2) then
         Continue;
      slot.Name   := [X1-1, Y1 - 15, X1 + 105, Y1 - 1];
      slot.Number := [X2-28, Y1-15, X2+1, Y1-3];
      slot.Levels := TBoxArray.Create(TopLeft, 4, 1, 36, 6, [0,0]);
    end;
    Result += slot;
  end;
end;


function TDiaryList.GetSlot(diary: EAchievementDiary): TDiarySlot;
var
  slot: TDiarySlot;
begin
  for slot in Self.GetSlots() do
    if OCR.Locate(slot.Name, Self.Names[diary], [TFonts.RED, TFonts.YELLOW, TFonts.LIGHT_GREEN, TFonts.WHITE], 0, Fonts.PLAIN_11) > 0.9 then
      Exit(slot);
end;



procedure TDiaryList.ScrollTo(diary : EAchievementDiary);
var
  lo, hi: Integer;
begin
  lo := Max(0, Ord(diary) - 6) * 20;
  hi := Min(100, Ord(diary) * 20);

  if not InRange(Self.Scroll.GetLevel(), lo, hi) then
    Self.Scroll.SetLevel(Random(lo, hi));
end;

type

  TAchievements = record
    TabsArea, TabTitle: TBox;
    Tabs: TBoxArray;
    Summary: TAchievementsSummary;
    Quests: TQuestList;
    Diaries: TDiaryList;
  end;


procedure TAchievements.SetupGameTab();
begin
  with GameTab.Bounds do
  begin
    Self.TabsArea := [X1, Y1 + 5, X2, Y1 + 22];
    Self.TabTitle := [X1, Y1 + 25, X2, Y1 + 48];

    Self.Summary.SetupGameTab();
    Self.Quests.SetupGameTab();
    Self.Diaries.SetupGameTab();
  end;
end;


function TAchievements.IsOpen(): Boolean;
begin
  Result := GameTabs.IsOpen(EGameTab.ACHIEVEMENTS);
end;


function TAchievements.Open(): Boolean;
begin
  Result := GameTabs.Open(EGameTab.ACHIEVEMENTS);
end;




function TAchievements.CountTabs(): Integer;
begin
  Result := Length(Target.FindColor(TInterface.Border, 0, Self.TabsArea).Cluster(1.5));
end;


procedure TAchievements.SetupTabs();
begin
  case Self.CountTabs() of
    3: Self.Tabs := TBoxArray.Create(GameTab.TopLeft.Offset(1,4), 3, 1, 57, 20, [5, 2]);
    4: Self.Tabs := TBoxArray.Create(GameTab.TopLeft.Offset(1,4), 4, 1, 43, 20, [3, 2]);
    else Exit;
  end;
end;


function TAchievements.GetTab(): EAchievementTab;
var
  title: String;
begin
  if Self.Tabs = [] then
  begin
    if not Self.Open() then Exit;
    Self.SetupTabs();
  end;

  title := OCR.Recognize(Self.TabTitle, Fonts.BOLD_SHADOW, [TFonts.ORANGE, $3399FF], 3);

  case title of
    'Quest List': Result := EAchievementTab.QUESTS;
    'Achievement Diaries': Result := EAchievementTab.DIARIES;
    'Click here to see all': Result := EAchievementTab.ADVENTURE_PATHS;
    else Result := EAchievementTab.SUMMARY;
  end;
end;


function TAchievements.OpenTab(tab: EAchievementTab): Boolean;
var
  b: TBox;
begin
  if not Self.Open() then Exit;
  if Self.Tabs = [] then Self.SetupTabs();

  b := Self.Tabs[tab];
  case Self.GetTab() of
    tab: Exit(True);
    EAchievementTab.SUMMARY:
    if (tab <> EAchievementTab.ADVENTURE_PATHS) and Biometrics.RandomBoolean() then
    begin
      if tab = EAchievementTab.QUESTS then b := Self.Summary.Quests
      else b := Self.Summary.Diaries;
    end;
  end;

  Mouse.Click(b, EMouseButton.LEFT);
  Result := SleepUntil(Self.GetTab() = tab, RandomMode(100, 50, 1500), 4*TICK);
end;


var

  Achievements: TAchievements;


function TDiaryList.GetLevel(diary: EAchievementDiary): Integer;
var
  i: Integer;
  slot: TDiarySlot;
begin
  if Self.Cache[diary] > 0 then
    Exit(Self.Cache[diary]-1);

  if not Achievements.OpenTab(EAchievementTab.DIARIES) then Exit(-1);
  Self.ScrollTo(diary);
  slot := Self.GetSlot(diary);

  if slot = Default(TDiarySlot) then
    Exit;

  for i := 0 to 3 do
  begin
    if not Target.HasColor($14B537, 0, 1, slot.Levels[i]) then Break;
    Result += 1;
  end;

  Self.Cache[diary] := Result+1;
end;
