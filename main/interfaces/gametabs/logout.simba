
{$DEFINE WL_LOGOUT_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  ERSRating = (ONE, TWO, THREE, FOUR, FIVE);

  ERSLogoutButton = (WORLD_SWITCHER, CLICK_HERE);


  TLogout = record
    Ratings: array [ERSRating] of TButton;
    Buttons: array [ELoginButton] of TButton;
  end;


procedure TLogout.SetupGameTab();
var
  btns: TBoxArray;
  i: Integer;
begin
  btns := TBoxArray.Create(GameTab.TopLeft.Offset(2,61), 5, 1, 31, 35, [6, 0]);
  for i := 0 to High(btns) do
    Self.Ratings[i] := new TButton(
      btns[i],
      [
        [$0F1043, 0, EColorSpace.RGB, [1,1,1]],
        [$23269F, 0.227, EColorSpace.RGB, [1,1,1]]
      ]
    );

  with GameTab.Bounds do
  begin
    Self.Buttons[ERSLogoutButton.WORLD_SWITCHER] :=
      new TButton(
        [X1+22, Y2-97, X2-22, Y2-66],
        [
          [$0F1043, 0, EColorSpace.RGB, [1,1,1]],
          [$23269F, 0.227, EColorSpace.RGB, [1,1,1]]
        ]
      );
    Self.Buttons[ERSLogoutButton.CLICK_HERE] :=
      new TButton(
        [X1+22, Y2-49, X2-22, Y2-18],
        [
          [$0F1043, 0, EColorSpace.RGB, [1,1,1]],
          [$23269F, 0.227, EColorSpace.RGB, [1,1,1]]
        ]
      );
  end;
end;






function TLogout.IsOpen(): Boolean;
begin
  Result := GameTabs.IsOpen(EGameTab.LOGOUT);
end;


function TLogout.Open(): Boolean;
begin
  Result := GameTabs.Open(EGameTab.LOGOUT);
  if Result and WorldSwitcher._IsOpen() then
    Result := WorldSwitcher.Close();
end;



function TLogout.IsRated(): Boolean;
begin
  Result := Self.Ratings[ERSRating.ONE].Enabled;
end;


function TLogout.Rate(star: ERSRating): Boolean;
begin
   if Self.Ratings[star].Enabled and
      ((star = ERSRating.FIVE) or not Self.Ratings[star+1].Enabled) then
       Exit(True);

   Self.Ratings[star].Click(EMouseButton.LEFT);
   Result := Self.Ratings[star].WaitEnabled();
end;


function TLogout.Logout(attempts: UInt32 = 5; time: UInt32 = 20000): Boolean;
var
  i: Integer;
  interval: UInt32;
  stars: ERSRating;
begin
  if not Self.Open() then Exit;
  if WorldSwitcher.Logout() then Exit(True);

  interval := time div attempts;

  if Biometrics.RandomBoolean(EBiometric.RATING) then
  begin
    if Biometrics.RandomBoolean(EBiometric.LIKES) then
      i := RandomLeft(4, 0)
    else
      i := RandomLeft(0, 4);

    stars := ERSRating(i);
    DebugLn(
      'Logout', 'Rating the game with ' + ToStr(stars) + ' stars before logging out.'
    );
    Self.Rate(stars);
  end;

  if Keyboard.LastKey = EKeyCode.RETURN then
    Keyboard.RandomKey();  //unlock enter if using remote input

  for i := 1 to attempts do
  begin
    Self.Buttons[ERSLogoutButton.CLICK_HERE].Click();
    if SleepUntil(not Client.IsLoggedIn(), 500, interval + Random(-2000, 2000)) then
      Exit(True);
  end;
end;

var

  Logout: TLogout;
