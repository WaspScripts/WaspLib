

{$DEFINE WL_PRAYER_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TPrayerSet = set of EPrayer;


  TPrayer = record
    Slots: TBoxArray;
  end;




procedure TPrayer.SetupGameTab();
begin
  Self.Slots := TBoxArray.Create(GameTab.Bounds.TopLeft.Offset(1,10), 5, 6, 33, 33, [4, 4]);
end;


function TPrayer.IsOpen(): Boolean;
begin
  Result := GameTabs.IsOpen(EGameTab.PRAYER);
end;


function TPrayer.Open(): boolean;
begin
  Result := GameTabs.Open(EGameTab.PRAYER);
end;


function TPrayer.GetInfoBox(): TBox;
const
  INFO_BOX_COLOR: TColor = $A0FFFF;
var
  tpa: TPointArray;
begin
  if not Self.IsOpen() then Exit;

  tpa := Target.FindColor(INFO_BOX_COLOR, 0, GameTab.Bounds);
  if tpa.Length > 1000 then
    Result := tpa.Bounds();
end;


function TPrayer.InfoIsOpen(): Boolean;
begin
  Result := Self.GetInfoBox() <> [];
end;


function TPrayer.CloseInfo(): Boolean;
var
  destination: TPoint;
begin
  if not Self.InfoIsOpen() then
    Exit(True);

  destination := GameTab.Bounds.Expand(10).NearestEdge(Target.MouseXY);

  AsyncMouse.Move(destination);
  Result := SleepUntil(not Self.InfoIsOpen(), 35, 3000);
  AsyncMouse.Stop();
end;


function TPrayer.Find(prayer: EPrayer; out bounds: TBox; attempts: Integer = 2): Boolean;
var
  match: TImageMatch;
begin
  if not Self.IsOpen() then Exit;

  Result := PrayerFinder.Find([prayer], Self.Slots, match);

  if Result then
  begin
    bounds := match.Box.Expand(-1);
    Exit;
  end;

  if attempts = 0 then Exit;

  if Self.InfoIsOpen() then
    Result := Self.CloseInfo() and Self.Find(prayer, bounds, attempts-1);
end;


function TPrayer.Hover(prayer: EPrayer; checkUpText: Boolean = False): Boolean;
var
  b: TBox;
begin
  if not (Self.IsOpen() and Self.Find(prayer, b)) then
    Exit;

  Mouse.Move(b);
  Result := True;

  if checkUpText then
    Result := MainScreen.UpText.After('ctivate').Trim()
      = ToStr(prayer).ToLower().Replace('_', ' ').CapitalizeWords();
end;


function TPrayer.Click(prayer: EPrayer; button: EMouseButton = EMouseButton.LEFT; checkUpText: Boolean = False): Boolean;
begin
  Result := Self.Hover(prayer, checkUpText);
  if Result then
    Target.MouseClick(button);
end;


function TPrayer.CanActivate(prayer: EPrayer): Boolean;
var
  b: TBox;
begin
  Result := Self.Find(prayer, b);
end;


function TPrayer.IsActive(prayers: TPrayerSet): Boolean;
const
  ACTIVE_COLOR: TColorTolerance = [$6CAAC2, 0.777, EColorSpace.HSL, [1.967, 0.232, 0.803]];
var
  prayer: EPrayer;
  b: TBox;
begin
  for prayer in prayers do
    if not (Self.Find(prayer, b) and Target.HasColor(ACTIVE_COLOR, 10, b)) then
      Exit;

  Result := True;
end;


function TPrayer.GetActivePrayers(): TPrayerSet;
var
  prayer: EPrayer;
begin
  for prayer := Low(EPrayer) to High(EPrayer) do
    if Self.IsActive([prayer]) then
      Result += prayer;
end;


function TPrayer.Activate(prayers: TPrayerSet): Boolean;
var
  prayer: EPrayer;
  activatedPrayers: TPrayerSet;
begin
  Result := True;
  if not Self.IsOpen() then
    Exit(False);

  for prayer in prayers do
  begin
    if Self.IsActive([prayer]) then
      Continue;

    if Self.CanActivate(prayer) and Self.Click(prayer) then
      activatedPrayers += prayer
    else
      Result := False;
  end;

  Result := Result and SleepUntil(Self.IsActive(activatedPrayers), 100, 2000);
end;


function TPrayer.Deactivate(prayers: TPrayerSet): Boolean;
var
  prayer: EPrayer;
  emptyPrayerSet: TPrayerSet;
begin
  Result := True;
  if not Self.IsOpen() then
    Exit;

  for prayer in prayers do
  begin
    if not Self.IsActive([prayer]) then
      Continue;
    Result := Result and Self.Click(prayer);
  end;

  Result := Result and SleepUntil(((Self.GetActivePrayers() * prayers) = emptyPrayerSet), 100, 2000);
end;

var

  Prayer: TPrayer;
