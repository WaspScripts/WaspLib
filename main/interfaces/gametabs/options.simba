

{$DEFINE WL_OPTIONS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  EOptionsTab = enum(CONTROLS, AUDIO, DISPLAY);


  EOptionsSlider = enum(BRIGHTNESS, ZOOM);


  EOptionsDropDown = enum(PLAYER_ATTACK, NPC_ATTACK, CLIENT_MODE);


  EOptionsButton = enum(AID, RUN, HOUSE, BOND, ALL_SETTINGS);


  TOptions = record
    Tabs: TBoxArray;
    Sliders: array [EOptionsSlider] of TSlider;
    DropDowns: array [EOptionsDropDown] of TDropDown;
    Buttons: array [EOptionsButton] of TButton;
    ZoomLevel: Integer;
    MaxBrightness, RoofsHidden: Boolean;
  end;

procedure TOptions.Setup();
begin
  case Client.Typ of
    EClient.OFFICIAL:
      Self.Sliders[EOptionsSlider.BRIGHTNESS].Color := $202328;
    EClient.LEGACY, EClient.RUNELITE:
      Self.Sliders[EOptionsSlider.BRIGHTNESS].Color := $1F2227;
  end;

  Self.Sliders[EOptionsSlider.ZOOM].Color := $202328;
  Self.ZoomLevel := -1;
end;


procedure TOptions.SetupGameTab();
var
  boxes: TBoxArray;
  i: Integer;
begin
  Self.Tabs := TBoxArray.Create(GameTab.TopLeft.Offset(0, 5), 3, 1, 55, 24, [9,0]);

  with Self.Sliders[EOptionsSlider.BRIGHTNESS] do
  begin
    Bounds.X1 := GameTab.Bounds.X1 + 57;
    Bounds.Y1 := GameTab.Bounds.Y1 + 72;
    Bounds.X2 := Bounds.X1 + 96;
    Bounds.Y2 := Bounds.Y1 + 9;
    Width := Bounds.Width - 1;
  end;

  with Self.Sliders[EOptionsSlider.ZOOM] do
  begin
    Bounds.X1 := Self.Sliders[EOptionsSlider.BRIGHTNESS].Bounds.X1;
    Bounds.Y1 := GameTab.Bounds.Y1 + 109;
    Bounds.X2 := Self.Sliders[EOptionsSlider.BRIGHTNESS].Bounds.X2;
    Bounds.Y2 := Bounds.Y1 + 9;
    Width := Bounds.Width - 1;
  end;

  boxes := TBoxArray.Create(GameTab.BottomLeft.Offset(9, -85), 4, 1, 39, 39, [3,0]);

  for i := 0 to High(boxes) do
    Self.Buttons[i] := new TButton(boxes[i]);

  with GameTab.Bounds do
  begin
    Self.Buttons[4] := new TButton([X1 + 22, Y2 - 32, X2 - 22, Y2 - 3]);

    Self.DropDowns[0].Bounds := [X1 + 11, Y1 + 111, X2 - 11, Y1 + 130];
    Self.DropDowns[0].Setup(
      [
        'Depends on combat levels', 'Always right-click',
        'Left-click where available', 'Hidden', 'Right-click for clanmates'
      ],
      Fonts.PLAIN_11
    );

    Self.DropDowns[1].Bounds := [X1 + 11, Y1 + 150, X2 - 11, Y1 + 169];
    Self.DropDowns[1].Setup(
      [
        'Depends on combat levels', 'Always right-click', 'Left-click where available',
        'Hidden'
      ],
      Fonts.PLAIN_11
    );

    Self.DropDowns[2].Bounds := [X1 + 11, Y2 - 109, X2 - 11, Y2 - 90];
    Self.DropDowns[2].Setup(
      ['Fixed - Classic layout', 'Resizable - Classic layout', 'Resizable - Modern layout'],
      Fonts.PLAIN_11
    );
  end;
end;




function TOptions.IsOpen(): Boolean;
begin
  Result := GameTabs.IsOpen(EGameTab.OPTIONS);
end;


function TOptions.Open(): Boolean;
begin
  Result := GameTabs.Open(EGameTab.OPTIONS);
end;



function TOptions.GetTab(): EOptionsTab;
var
  tab: EOptionsTab;
begin
  for tab := Low(EOptionsTab) to High(EOptionsTab) do
    if not Target.HasColor($48585D, 0, 50, Self.Tabs[tab]) and
       not Target.HasColor($1E2528, 0, 50, Self.Tabs[tab]) then //transparent bg
      Exit(tab);
end;


function TOptions.OpenTab(tab: EOptionsTab): Boolean;
begin
  if not Self.Open() then Exit;
  if not HouseOptions.Close() then Exit;
  if Self.GetTab() = tab then Exit(True);

  Mouse.Click(Self.Tabs[tab], EMouseButton.LEFT);
  Result := SleepUntil(Self.GetTab() = tab, RandomMode(100, 50, 1500), 2000);
end;



function TOptions._GetZoomLevel(): Integer;
begin
  Result := Self.Sliders[EOptionsSlider.ZOOM].GetLevel();
  if Result = -1 then
  begin
    DebugLn('Options', 'Failed to read zoom!', ELogLevel.ERROR);
    Exit;
  end;

  if Result <> Self.ZoomLevel then
  begin
    Self.ZoomLevel := Result;
    DebugLn('Options', 'Current zoom level: ' + ToStr(Result), ELogLevel.SUCCESS);
  end;
end;


function TOptions.GetZoomLevel(useCache: Boolean = True): Integer;
begin
  if useCache and (Self.ZoomLevel > -1) then
    Exit(Self.ZoomLevel);

  DebugLn('Options', 'Unknown zoom level, reading from the gametab...');

  //Self.Zoom level is checked on TOptions.GetTab() override
  Self.OpenTab(EOptionsTab.DISPLAY);
end;


function TOptions.SetZoomLevel(level: Integer): Boolean;
begin
  if not Self.OpenTab(EOptionsTab.DISPLAY) then Exit;
  Result := Self.Sliders[EOptionsSlider.ZOOM].SetLevel(level);

  if Result then
  begin
    Self.ZoomLevel := level;
    DebugLn('Options', 'Current zoom level set to: ' + ToString(Self.ZoomLevel), ELogLevel.SUCCESS);
  end
  else
  begin
    Self.ZoomLevel := -1;
    DebugLn('Options', 'Failed to set zoom!', ELogLevel.ERROR);
  end;
end;



function TOptions.SetPlayerAttack(index: Integer): Boolean;
begin
  if not Self.OpenTab(EOptionsTab.CONTROLS) then Exit;
  Result := Self.DropDowns[EOptionsDropDown.PLAYER_ATTACK].Select(index);
end;

function TOptions.SetPlayerAttack(option: String): Boolean; overload;
begin
  if not Self.OpenTab(EOptionsTab.CONTROLS) then Exit;
  Result := Self.DropDowns[EOptionsDropDown.PLAYER_ATTACK].Select(option);
end;



function TOptions.SetNPCAttack(index: Integer): Boolean;
begin
  if not Self.OpenTab(EOptionsTab.CONTROLS) then Exit;
  Result := Self.DropDowns[EOptionsDropDown.NPC_ATTACK].Select(index);
end;

function TOptions.SetNPCAttack(option: String): Boolean; overload;
begin
  if not Self.OpenTab(EOptionsTab.CONTROLS) then Exit;
  Result := Self.DropDowns[EOptionsDropDown.NPC_ATTACK].Select(option);
end;



function TOptions.SetClientMode(mode: EMode): Boolean;
begin
  if not Self.OpenTab(EOptionsTab.DISPLAY) then Exit;

  Result := Self.DropDowns[EOptionsDropDown.CLIENT_MODE].Select(Ord(mode)-1);
  if Result and Client.WaitModeChange(4000) then
    Client.IsLoggedIn(); //force trigger SetupInterfaces
end;



procedure TOptions.RenderSelf();
begin
  if Chat.InputHasText() then Keyboard.KeyPress(EKeyCode.RETURN);
  Keyboard.Send('::renderself', EKeyCode.RETURN);
end;



function TOptions.GetRoofsState(): Boolean;
begin
  Result := CacheParser.RoofsHidden();
end;


function TOptions.HideRoofs(): Boolean;
begin
  if CacheParser.Disabled then Exit(True);

  if Self.GetRoofsState() then Exit(True);

  DebugLn('Options', 'TODO: Finish HideRoofs with All Settings menu...', ELogLevel.ERROR);

  Result := SleepUntil(Self.GetRoofsState(), 100, 1200);

  if Result then Self.RoofsHidden := True
  else CacheParser.Disabled := True;
end;


function TOptions.ShowRoofs(): Boolean;
begin
  if CacheParser.Disabled then Exit(True);

  if not Self.GetRoofsState() then Exit(True);

  DebugLn('Options', 'TODO: Finish ShowRoofs with All Settings menu...', ELogLevel.ERROR);

  Result := SleepUntil(not Self.GetRoofsState(), 100, 1200);

  if Result then Self.RoofsHidden := False
  else CacheParser.Disabled := True;
end;



function TOptions.GetBrightness(): Integer;
var
  tmp: Integer;
begin
  if CacheParser.Disabled then
  begin
    Result := Self.Sliders[EOptionsSlider.BRIGHTNESS].GetLevel();
    Self.MaxBrightness := Result = 100;
    Exit;
  end;

  Result := CacheParser.Brightness();

  if Self.IsOpen() and (Self.GetTab() = EOptionsTab.DISPLAY) then
  begin
    tmp := Self.Sliders[EOptionsSlider.BRIGHTNESS].GetLevel();
    if tmp <> Result then //parser is reading wrong file?
    begin
      CacheParser.Disabled := True;
      Result := tmp;
    end;
  end;

  Self.MaxBrightness := Result = 100;
end;


function TOptions.SetMaxBrightness(): Boolean;
begin
  if Self.GetBrightness() = 100 then Exit(True);
  if not Self.OpenTab(EOptionsTab.DISPLAY) then Exit;

  with Self.Sliders[EOptionsSlider.BRIGHTNESS].Bounds do
    Mouse.Click(Point(X2 + Random(3, 5), Random(Y1, Y2)), EMouseButton.LEFT);

  Result := Self.GetBrightness() = 100;
end;

var

  Options: TOptions;
