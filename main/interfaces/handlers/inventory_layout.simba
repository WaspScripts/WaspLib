

{$DEFINE WL_INVENTORY_LAYOUTS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TInventoryLayoutItem = record
    Item: TItem;
    Amount: Integer;
  end;


function TInventoryLayoutItem.ToJSON(): TJSONItem;
begin
  Result := new TJSONObject();
  Result.AddString('Item', Self.Item);
  Result.AddInt('Amount', Self.Amount);
end;

type

  TInventoryLayoutSlots = record
    Name: String;
    Items: array [0..27] of TInventoryLayoutItem;
  end;


function TInventoryLayoutSlots.ToJSON(): TJSONItem;
var
  i: Integer;
begin
  Result := new TJSONArray();
  for i := 0 to 27 do
    Result.AddObject(ToStr(i), Self.Items[i].ToJSON());
end;

type

  TInventoryLayout = record
    Layout: TInventoryLayoutSlots;
    Holding: array [0..27] of TInventoryLayoutItem;
    BankItems: TBankItemArray;
  end;


procedure TInventoryLayout.SetupBankItems();
var
  items: array of TInventoryLayoutItem;
  i, hi, j, count: Integer;
  item: TItem;
begin
  items := Self.Layout.Items.Copy();
  hi := High(items);

  for i := 0 to hi do
  begin
    item := items[i].Item;
    case item of
      'Nothing', 'Anything': Continue;
    end;

    if items[i].Amount > 1 then
    begin
      Self.BankItems += item.ToBankItem(items[i].Amount);
      Continue;
    end;

    count := 1;

    for j := hi downto i+1 do
      if items[j].Item = item then
      begin
        Delete(items, j, 1);
        count += 1;
      end;

    Dec(hi, count-1);
    Self.BankItems += item.ToBankItem(count);
  end;
end;


function TInventoryLayout.IsValid(): Boolean;
var
  i: Integer;
begin
  if Self.BankItems = [] then
    Self.SetupBankItems();

  for i := 0 to High(Self.BankItems) do
    if Inventory.Items.CountEx(Self.BankItems[i].ToItem()) < Self.BankItems[i].Quantity then
      Exit;

  Result := True;
end;


function TInventoryLayout.DepositDiff(): Boolean;
var
  i, j, n, stack: Integer;
  items: TItemArray;
  bitems: TBankItemArray;
begin
  if not Bank.IsOpen() then Exit;

  if Self.BankItems = [] then
    Self.SetupBankItems();

  bitems := Self.BankItems.Copy();

  for i := 0 to 27 do
  begin
    items := Inventory.Items.Recognize(i);
    if items = [] then Continue;

    for j := 0 to High(items) do
      for n := 0 to High(bitems) do
      begin
        if items[j] <> bitems[n].Item then Continue;

        stack := Inventory.Slots.ReadStack(i);

        if stack < 0 then
          bitems[n].Quantity -= 1
        else
        begin
          bitems[n].Quantity -= stack;
          if bitems[n].Quantity < 0 then
          begin
            bitems[n].Quantity := Abs(bitems[n].Quantity);
            if not Bank.Deposit(bitems[n], True) then
              Exit;
            bitems[n].Quantity := 0;
          end;
        end;

        Continue(3);
      end;

    if not Bank.Deposit(items[0].ToBankItem(QUANTITY_ALL), True) then
      Exit;
  end;

  for i := 0 to High(bitems) do
  begin
    if bitems[i].Quantity <= 0 then Continue;
    if not Bank.Deposit(bitems[i], True) then
      Exit;
  end;

  Result := True;
end;



function TInventoryLayout.Withdraw(attempts: Integer = 3): Boolean;
var
  arr: TBankItemArray;
  oldTab, newTab: Integer;
begin
  if attempts = 0 then Exit;
  if not Bank.IsOpen() then Exit;

  if Self.BankItems = [] then
    Self.SetupBankItems();

  if Inventory.Slots.Count() > 0 then
  begin
    if Biometrics.RandomBoolean(0.7) then
      Self.DepositDiff()
    else
      Bank.DepositButtons[EBankDepositButton.INVENTORY].Click();
  end;

  oldTab := Bank.GetCurrentTab();
  arr := Self.BankItems.Copy();

  while Length(arr) > 0 do
  begin
    newTab := Bank.GetCurrentTab();
    if oldTab <> newTab then
      Sort(arr, @Bank.PrioritySort);

    //2 attempts per item
    if not Bank.Withdraw(arr[0], False) and not Bank.Withdraw(arr[0], False) then
      Exit(Self.Withdraw(Dec(attempts)));

    Delete(arr, 0, 1);
  end;

  Result := Self.IsValid() or Self.Withdraw(Dec(attempts));
end;


function TInventoryLayout.Reorder(): Boolean;
var
  i, j: Integer;
  items: array [0..27] of TItemArray;
begin
  for i := 0 to 27 do
  begin
    if items[i] = [] then
      items[i] := Inventory.Items.Recognize(i);

    if items[i].Contains(Self.Layout.Items[i].Item) then
      Continue;

    for j := i+1 to 27 do
    begin
      if items[j] = [] then
        items[j] := Inventory.Items.Recognize(j);

      if items[j].Contains(Self.Layout.Items[i].Item) then
      begin
        if not Inventory.Slots.Move(j, i) then
          Exit;
        Swap(items[i], items[j]);
        Break;
      end;
    end;
  end;

  Result := True;
end;
