
{$DEFINE WL_LOBBY_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TLobbyScreen = record
    Bounds, Button: TBox;
  end;


procedure TLobbyScreen.Setup();
begin
  Self.Bounds.X1 := Target.Width div 2 - 382;
  Self.Bounds.X2 := Target.Width div 2 + 382;
  Self.Bounds.Y1 := Target.Bounds.Y1;
  Self.Bounds.Y2 := Self.Bounds.Y1 + 502;

  with Self.Button do
  begin
    X1 := Self.Bounds.X1 + 268;
    Y1 := Self.Bounds.Y1 + 294;
    X2 := X1 + 228;
    Y2 := Y1 + 89;
  end;
end;



function TLobbyScreen.IsOpen(): Boolean;
begin
  Result := OCR.Locate(Self.Button, 'CLICK HERE TO PLAY', [$FFFFFF], 0, Fonts.BOLD_SHADOW) > 0.999;
end;


function TLobbyScreen.WaitOpen(time: Integer = 600; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;


function TLobbyScreen.EnterGame(): Boolean;
begin
  if Client.IsLoggedIn() then Exit(True);
  WriteLn GetDebugLn('Lobby', 'Entering the game.');
  Mouse.Click(Self.Button, EMouseButton.LEFT);
  Result := Client.WaitLoggedIn(3000);
end;

var

  Lobby: TLobbyScreen;
