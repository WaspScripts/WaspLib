

{$DEFINE WL_LOGIN_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

const

  LOGIN_MESSAGES = [
    'Welcome to ',
    'Connecting to server',
    'Invalid credentials',
    'Incorrect username or password',
    'You need a skill total of',
    'your username/email',
    'Error connecting to server',
    'Your account has not logged out',
    'Login server offline',
    'The game servers are currently being updated',
    ' has been updated!',
    'Error loading your profile',
    'Connection timed out',
    'You were disconnected',
    'Login limit exceeded',
    'This world is full',
    'Your account has been',
    'You need a members'' account',
    'You are standing in a members-only area',
    'move your character to a non-members area',
    'Authenticator'
  ];

type

  ELoginMode    = enum(UNKNOWN, LEGACY, LAUNCHER);
  ELoginButton  = enum(LAUNCHER, EXISTING_USER, LOGIN, RETRY, OKAY, CONTINUE);
  ELoginInput   = enum(USERNAME, PASSWORD);
  ELoginMessage = enum(
    UNKNOWN,
    WELCOME, CONNECTING, INVALID, INCORRECT, SKILL_TOTAL, ENTER_CREDENTIALS,
    ERROR_CONNECTING, ACCOUNT_ONLINE, SERVER_OFFLINE, BEING_UPDATED,
    GAME_UPDATED, ERROR_LOADING, TIMED_OUT, DISCONNECTED,

    LIMIT_EXCEEDED, WORLD_FULL, BANNED, NOT_MEMBER, ON_MEMBER_AREA,
    ON_MEMBER_AREA2,

    AUTHENTICATOR
  );


  TLogin = record
    Bounds: TBox;

    Inputs: array [ELoginInput] of TBox;
    Buttons: array [ELoginButton] of record
      Text: String;
      Bounds: TBox;
      Bold: Boolean;
    end;

    Mode: ELoginMode;
    Attempts: Integer;
    ClearInputs: Boolean;
  end;


procedure TLogin.Setup();
begin
  Self.Bounds.X1 := Target.Width div 2 - 176;
  Self.Bounds.Y1 := Target.Bounds.Y1 + 172;
  Self.Bounds.X2 := Target.Width div 2 + 176;
  Self.Bounds.Y2 := Self.Bounds.Y1 + 194;

  with Self.Inputs[ELoginInput.USERNAME] do
  begin
    X1 := Self.Bounds.X1 + 106;
    Y1 := Self.Bounds.Y1 + 69;
    X2 := X1 + 200;
    Y2 := Y1 + 16;
  end;

  with Self.Inputs[ELoginInput.PASSWORD] do
  begin
    X1 := Self.Bounds.X1 + 138;
    Y1 := Self.Bounds.Y1 + 86;
    X2 := X1 + 204;
    Y2 := Y1 + 13;
  end;

  with Self.Buttons[ELoginButton.LAUNCHER] do
  begin
    Bounds.X1 := Self.Bounds.X1 + 72;
    Bounds.Y1 := Self.Bounds.Y1 + 62;
    Bounds.X2 := Bounds.X1 + 207;
    Bounds.Y2 := Bounds.Y1 + 57;
    Text := '';
  end;

  with Self.Buttons[ELoginButton.EXISTING_USER] do
  begin
    Bold := True;
    Bounds.X1 := Self.Bounds.X1 + 188;
    Bounds.Y1 := Self.Bounds.Y1 + 103;
    Bounds.X2 := Bounds.X1 + 134;
    Bounds.Y2 := Bounds.Y1 + 32;
    Text := 'Existing User';
  end;

  with Self.Buttons[ELoginButton.LOGIN] do
  begin
    Bold := True;
    Bounds.X1 := Self.Bounds.X1 + 28;
    Bounds.Y1 := Self.Bounds.Y1 + 133;
    Bounds.X2 := Bounds.X1 + 134;
    Bounds.Y2 := Bounds.Y1 + 32;
    Text := 'Login';
  end;

  with Self.Buttons[ELoginButton.RETRY] do
  begin
    Bounds.X1 := Self.Bounds.X1 + 108;
    Bounds.Y1 := Self.Bounds.Y1 + 88;
    Bounds.X2 := Self.Bounds.X2 - 110;
    Bounds.Y2 := Bounds.Y1 + 32;
    Text := 'Try again';
  end;

  with Self.Buttons[ELoginButton.OKAY] do
  begin
    Bounds.X1 := Self.Bounds.X1 + 109;
    Bounds.Y1 := Self.Bounds.Y1 + 113;
    Bounds.X2 := Bounds.X1 + 134;
    Bounds.Y2 := Bounds.Y1 + 32;
    Text := 'Ok';
    Bold := True;
  end;
end;



function TLogin.FindButton(button: ELoginButton): Boolean;
begin
  if button = ELoginButton.LAUNCHER then
  begin
    if not InRange(Target.CountColor($FFFFFF, 0, Self.Buttons[ELoginButton.LAUNCHER].Bounds), 500, 550) then
      Exit;

    Exit(True);
  end;

  if Self.Buttons[button].Bold then
    Exit(Self.Buttons[button].Text = OCR.Recognize(Self.Buttons[button].Bounds, Fonts.BOLD_SHADOW, [$FFFFFF], 0));

  Result := Self.Buttons[button].Text = OCR.Recognize(Self.Buttons[button].Bounds, Fonts.PLAIN_12, [$FFFFFF], 0);
end;


function TLogin.ClickButton(button: ELoginButton): Boolean;
begin
  if not Self.FindButton(button) then Exit;
  Result := True;
  Mouse.Click(Self.Buttons[button].Bounds, EMouseButton.LEFT);
end;



function TLogin.SelectInput(field: ELoginInput): Boolean;
begin
  if SleepUntil(Target.HasColor($00FFFF, 0, 8, Self.Inputs[field]), 30, 100) then
    Exit(True);

  if RandomBoolean(0.5) then
    Keyboard.KeyPress(EKeyCode.TAB)
  else
    with Self.Inputs[field] do
      Mouse.Click([X1, Y1, X2, Y2-3], EMouseButton.LEFT);

  Result := SleepUntil(Target.HasColor($00FFFF, 0, 8, Self.Inputs[field]), 30, 600);
end;


function TLogin.InputIsFilled(field: ELoginInput): Boolean;
begin
  Result := Target.HasColor($FFFFFF, 0, 1, Self.Inputs[field]);
end;


function TLogin.ClearInput(field: ELoginInput): Boolean;
var
  timeout: TCountDown;
begin
  if not Self.InputIsFilled(field) then Exit(True);
  if not Self.SelectInput(field) then Exit;

  timeout.Start(6*SECOND);

  repeat
    Keyboard.KeyPress(EKeyCode.BACK);
    if not Self.InputIsFilled(field) then
      Exit(True);
    Sleep(Random(Keyboard.IntervalMin, Keyboard.IntervalMax));
  until timeout.IsFinished;
end;


function TLogin.FillInput(field: ELoginInput; details: String): Boolean;
begin
  if Self.InputIsFilled(field) then Exit(True);
  if not Self.SelectInput(field) then Exit;

  Result := True;
  if details = '' then
    raise GetDebugLn('Login', 'Can''t fill ' + ToStr(field) + ' because the details are empty.');
  Keyboard.Send(details, EKeyCode.RETURN);
end;



function TLogin.GetMessage(): ELoginMessage;
var
  dialog: String;
  msg: ELoginMessage;
begin
  dialog := OCR.RecognizeLines(Self.Bounds, Fonts.BOLD_SHADOW, [$00FFFF], 0).Join(' ');

  if dialog = '' then
    dialog := OCR.RecognizeLines(Self.Bounds, Fonts.PLAIN_12, [$00FFFF], 0).Join(' ');

  if dialog = '' then
    dialog := OCR.RecognizeLines(Self.Bounds, Fonts.BOLD_SHADOW, [$FFFFFF], 0).Join(' ');

  if dialog = '' then
    Exit;

  for msg := ELoginMessage.WELCOME to High(ELoginMessage)-1 do
    if dialog.Contains(LOGIN_MESSAGES[msg-1]) then
      Exit(msg);
end;



function TLogin.GetMode(): ELoginMode;
begin
  if Self.GetMessage() = ELoginMessage.WELCOME then
  begin
    if Self.FindButton(ELoginButton.EXISTING_USER) then
    begin
      DebugLn('Login', 'Legacy client mode detected.');
      Exit(ELoginMode.LEGACY);
    end;

    if Self.FindButton(ELoginButton.LAUNCHER) then
    begin
      DebugLn('Login', 'Launcher client mode detected.');
      Exit(ELoginMode.LAUNCHER);
    end;
  end;

  DebugLn('Login', 'Failed to detect login mode.', ELogLevel.WARN);
end;



function TLogin.HandleWelcome(): Boolean;
begin
  if Self.Mode = ELoginMode.UNKNOWN then
    Self.Mode := Self.GetMode();

  case Self.Mode of
    ELoginMode.LEGACY:   if not Self.ClickButton(ELoginButton.EXISTING_USER) then Exit;
    ELoginMode.LAUNCHER: if not Self.ClickButton(ELoginButton.LAUNCHER) then Exit;
  end;

  Result := SleepUntil(Self.GetMessage() <> ELoginMessage.WELCOME, RandomMode(100, 50, 1500), 600);
end;


function TLogin.Back2Welcome(): Boolean;
begin
  if not Self.ClickButton(ELoginButton.OKAY) then Exit;
  Result := SleepUntil(Self.GetMessage() = ELoginMessage.WELCOME, RandomMode(100, 50, 1500), 600);
end;



function TLogin.EnterCredentials(username, password: String): Boolean;
begin
  if Self.ClearInputs then
  begin
    if not Self.ClearInput(ELoginInput.USERNAME) then Exit;
    if not Self.ClearInput(ELoginInput.PASSWORD) then Exit;
  end;

  if not Self.FillInput(ELoginInput.USERNAME, username) then Exit;
  if not Self.FillInput(ELoginInput.PASSWORD, password) then Exit;
  Result := SleepUntil(Self.GetMessage() <> ELoginMessage.ENTER_CREDENTIALS, RandomMode(100, 50, 1500), 600);
end;



function TLogin.Retry(msg: ELoginMessage): Boolean;
begin
  if not Self.ClickButton(ELoginButton.RETRY) then Exit;
  Self.ClearInputs := True;
  Result := SleepUntil(Self.GetMessage() <> msg, RandomMode(100, 50, 1500), 600);
end;


function TLogin.HandleError(msg: ELoginMessage): Boolean;
var
  time: Integer;
begin
  time := Random(10000, 20000) * Inc(Self.Attempts);

  if (msg = ELoginMessage.WORLD_FULL) or (Self.Attempts < 4) then
  begin
    DebugLn('Login', 'Failed to login ' + ToStr(Self.Attempts) + ' times.', ELogLevel.WARN);
    DebugLn('Login', 'Waiting ' + ToStr(time) + ' seconds before trying again.', ELogLevel.WARN);
    Sleep(time);
    Exit(True);
  end;

  if Self.Attempts = 4 then
  begin
    DebugLn('Login', 'Failed to login ' + ToStr(Self.Attempts) + ' times.', ELogLevel.ERROR);
    DebugLn('Login', 'Script will shutdown if we fail one more time.', ELogLevel.ERROR);
    DebugLn('Login', 'Waiting ' + ToStr(time) + ' seconds before trying again.', ELogLevel.ERROR);
    Sleep(time);
    Exit(True);
  end;

  raise GetDebugLn('Login', 'Failed to login 10 times. Last login state: ' + ToStr(msg));
end;


function TLogin.HandleMessage(msg: ELoginMessage; username, password: String): Boolean;
begin
  case msg of
    ELoginMessage.WELCOME:           Result := Self.HandleWelcome();
    ELoginMessage.CONNECTING:        Result := SleepUntil(msg <> Self.GetMessage(), RandomMode(100, 50, 1500), 50000); //50 secs
    ELoginMessage.DISCONNECTED:      Result := Self.Back2Welcome();
    ELoginMessage.ENTER_CREDENTIALS: Result := Self.EnterCredentials(username, password);

    ELoginMessage.INVALID,
    ELoginMessage.INCORRECT:         Result := Self.Retry(msg);

    ELoginMessage.ERROR_CONNECTING,
    ELoginMessage.LIMIT_EXCEEDED,
    ELoginMessage.ACCOUNT_ONLINE,
    ELoginMessage.WORLD_FULL,
    ELoginMessage.TIMED_OUT:         Result := Self.HandleError(msg);

    ELoginMessage.SKILL_TOTAL:       raise GetDebugLn('Login', 'We are trying to login into a total level world you can''t login to.');
    ELoginMessage.SERVER_OFFLINE:    raise GetDebugLn('Login', 'Login server offline. The game is/was probably updated.');
    ELoginMessage.BEING_UPDATED:     raise GetDebugLn('Login', 'The game is being updated.');
    ELoginMessage.GAME_UPDATED:      raise GetDebugLn('Login', 'The game was updated.');
    ELoginMessage.ERROR_LOADING:     raise GetDebugLn('Login', 'Game loading error. It was probably updated.');
    ELoginMessage.BANNED:            raise GetDebugLn('Login', 'profile seems to be banned or disabled.');
    ELoginMessage.NOT_MEMBER:        raise GetDebugLn('Login', 'profile is not members and we are trying to login into a P2P world.');
    ELoginMessage.ON_MEMBER_AREA,
    ELoginMessage.ON_MEMBER_AREA2:   raise GetDebugLn('Login', 'profile is on a P2P area and we are trying to login into a F2P world.');

    ELoginMessage.AUTHENTICATOR:     raise GetDebugLn('Login', 'profile needs authenticator to login.');

    ELoginMessage.UNKNOWN:           if Client.IsLoggedIn() or Lobby.IsOpen() then Exit(True) else raise GetDebugLn('Login', 'Unknown login state.');
  end;
end;


procedure TLogin.SwitchWorld(worlds: TIntegerArray);
var
  attempt: Integer;
begin
  for attempt := 0 to 4 do
  begin
    if LoginWorldSwitcher.Switch(worlds.Random()) then
      Exit;

    if attempt < 4 then
      Sleep(Random(10000, 20000) * (1 + attempt));
  end;

  raise GetDebugLn('Login', 'Failed to switch to a valid world from the profile list after 5 attempts.');
end;


function TLogin.DoLogin(profile: TProfile = Default(TProfile)): Boolean;
var
  timeout: UInt64;
  switched: Boolean;
begin
  if profile = Default(TProfile) then
    profile := Profiles.Get();

  timeout := Time() + 40000;

  while not Client.IsLoggedIn() and not Lobby.IsOpen() do
  begin
    if Time() > timeout then
    begin
      DebugLn('Login', 'Timed out trying to login.', ELogLevel.ERROR);
      Exit;
    end;

    if not switched and (profile.Worlds <> []) and
       not profile.Worlds.Contains(LoginWorldSwitcher.GetCurrent()) then
    begin
      Self.SwitchWorld(profile.Worlds);
      switched := True;
    end;

    if not Self.HandleMessage(Self.GetMessage(), profile.Username, profile.Password) then
      Exit;
    Sleep(600, 1200);
  end;

  Self.Attempts := 0;

  timeout := Time() + 15000;
  while Lobby.IsOpen() do
  begin
    if Time() > timeout then
    begin
      DebugLn('Login', 'Timed out trying to handle the lobbyscreen.', ELogLevel.ERROR);
      Exit;
    end;

    if Lobby.EnterGame() then Exit(True);
  end;

  Result := Client.IsLoggedIn();
end;

var

  Login: TLogin;
