

{$DEFINE WL_ITEM_INTERFACE_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TItemInterface = record
    Name: String;
    Slots: ^TSlotInterface;
    RecognizeOffset: TPoint;
    PreConditionFunction: TInterfacePreConditionFunction;
  end;


procedure TItemInterface.Setup(
  name: String;
  slots: ^TSlotInterface;
  recognizeOffset: TPoint;
  checkFunc: TInterfacePreConditionFunction = nil
);
begin
  Self.Name := name;
  Self.Slots := slots;
  Self.RecognizeOffset := recognizeOffset;
  Self.PreConditionFunction := @checkFunc;
end;





function TItemInterface.IndexOf(items: TItemArray): Integer;
var
  match: TImageMatch;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit(-1);
  if ItemFinder.Find(items, Self.Slots^.Boxes(), match) then
    Exit(match.Index);
  Result := -1;
end;



function TItemInterface.IndicesOf(items: TItemArray): TIntegerArray;
var
  matches: TImageMatchArray;
  i: Integer;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;

  matches := ItemFinder.FindAll(items, Self.Slots^.Boxes());
  SetLength(Result, Length(matches));
  for i := 0 to High(matches) do
    Result[i] := matches[i].Index;
end;



function TItemInterface.FindAny(items: TItemArray; out slot: TBox): Boolean;
var
  match: TImageMatch;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;

  Result := ItemFinder.Find(items, Self.Slots^.Boxes(), match);
  if Result then
    slot := match.Box;
end;


function TItemInterface.Find(item: TItem; out slot: TBox): Boolean;
begin
  Result := Self.FindAny([item], slot);
end;

function TItemInterface.Find(items: TItemArray; out slot: Integer): Boolean; overload;
var
  match: TImageMatch;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;

  Result := ItemFinder.Find(items, Self.Slots^.Boxes(), match);
  if Result then
    slot := match.Index;
end;

function TItemInterface.Find(item: TItem; out slot: Integer): Boolean; overload;
begin
  Result := Self.Find([item], slot);
end;



function TItemInterface.FindAll(items: TItemArray): TBoxArray;
var
  match: TImageMatch;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;

  for match in ItemFinder.FindAll(items, Self.Slots^.Boxes()) do
    Result += match.Box;
end;

function TItemInterface.FindAll(items: TItemArray; out slots: TIntegerArray): Boolean; overload;
var
  matches: TImageMatchArray;
  i: Integer;
begin
  slots := [];
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;

  Result := ItemFinder.FindAll(items, Self.Slots^.Boxes(), matches);
  if not Result then Exit;
  for i := 0 to High(matches) do
    slots += matches[i].Index;
end;

function TItemInterface.FindAll(items: TItemArray; out boxes: TBoxArray): Boolean; overload;
var
  matches: TImageMatchArray;
  i: Integer;
begin
  boxes := [];
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;

  Result := ItemFinder.FindAll(items, Self.Slots^.Boxes(), matches);
  if not Result then Exit;
  for i := 0 to High(matches) do
    boxes += matches[i].Box;
end;



function TItemInterface.Contains(item: TItem): Boolean;
begin
  Result := Self.IndexOf([Item]) > -1;
end;


function TItemInterface.ContainsAny(items: TItemArray): Boolean;
begin
  Result := Self.IndexOf(items) > -1;
end;


function TItemInterface.ContainsAll(items: TItemArray): Boolean;
var
  matches: TImageMatchArray;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;
  Result := ItemFinder.FindAll(items, Self.Slots^.Boxes(), matches);
end;



function TItemInterface.FindDifferent(items: TItemArray): TIntegerArray;
begin
  Result := Self.Slots^.GetUsed().Difference(Self.IndicesOf(items));
end;


function TItemInterface.ContainsDifferent(items: TItemArray): Boolean;
begin
  Result := Self.FindDifferent(items) <> [];
end;






function TItemInterface._GetShadowHash(slot: Integer): UInt32;
var
  b: TBox;
begin
  with Self.Slots^.Box(slot) do
  begin
    b.X1 := X1 + Self.RecognizeOffset.X;
    b.Y1 := Y1 + Self.RecognizeOffset.Y;
  end;

  b.X2 := b.X1 + 35;
  b.Y2 := b.Y1 + 31;

  Result := TItemSprite.GetBorderCRC(Target.GetImage(b));
end;


function TItemInterface._GetHash(slot: Integer): UInt32;
var
  b: TBox;
begin
  with Self.Slots^.Box(slot) do
  begin
    b.X1 := X1 + Self.RecognizeOffset.X;
    b.Y1 := Y1 + Self.RecognizeOffset.Y;
  end;

  b.X2 := b.X1 + 35;
  b.Y2 := b.Y1 + 31;
  Result := ItemFinder.GetHash(Target.GetImage(b));
end;

function TItemInterface._GetHash(img: TImage): UInt32; overload;
begin
  Result := ItemFinder.GetHash(img);
end;


function TItemInterface._Recognize(slot: Integer): TItemArray;
var
  hash: UInt32;
begin
  hash := Self._GetHash(slot);
  if hash <> 0 then
    Result := ItemFinder.GetHashItems(hash);
end;

function TItemInterface._Recognize(img: TImage): TItemArray; overload;
var
  hash: UInt32;
begin
  hash := Self._GetHash(img);
  if hash <> 0 then
    Result := ItemFinder.GetHashItems(hash);
end;



function TItemInterface.Recognize(slot: Integer): TItemArray;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;
  Result := Self._Recognize(slot);
end;


function TItemInterface.RecognizeAllEx(): array of TItemArray;
var
  img: TImage;
  boxes: TBoxArray;
  b: TBox;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;

  img := Target.GetImage();

  boxes := Self.Slots^.Boxes();

  for b in boxes do
  begin
    b.X1 += Self.RecognizeOffset.X;
    b.Y1 += Self.RecognizeOffset.Y;
    b.X2 := b.X1 + 35;
    b.Y2 := b.Y1 + 31;
    Result += Self._Recognize(img.Copy(b));
  end;
end;


function TItemInterface.RecognizeAll(): TItemArray;
var
  img: TImage;
  items: TItemArray;
  boxes: TBoxArray;
  b: TBox;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;

  img := Target.GetImage();

  boxes := Self.Slots^.Boxes();
  for b in boxes do
  begin
    b.X1 += Self.RecognizeOffset.X;
    b.Y1 += Self.RecognizeOffset.Y;
    b.X2 := b.X1 + 35;
    b.Y2 := b.Y1 + 31;

    items := Self._Recognize(img.Copy(b));
    if items.Length > 0 then
      Result += items[0];
  end;
end;




function TItemInterface.Count(items: TItemArray): Integer;
begin
  Result := Length(Self.IndicesOf(items));
end;

function TItemInterface.Count(item: TItem): Integer; overload;
begin
  Result := Length(Self.IndicesOf([item]));
end;



function TItemInterface.WaitCount(items: TItemArray; count: Integer; time: Integer = 600; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.Count(items) = count, interval, time);
end;

function TItemInterface.WaitCount(item: TItem; count: Integer; time: Integer = 600; interval: Integer = -1): Boolean; overload;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.Count(item) = count, interval, time);
end;



function TItemInterface.ReadStack(item: TItem): Integer;
var
  b: TBox;
begin
  if not Self.FindAny([item], b) then Exit(-1);
  Result := TItem.ReadStack(b);
end;




function TItemInterface.CountEx(item: TItem): Integer;
var
  slots: TIntegerArray;
begin
  if Self.FindAll([item], slots) then
  begin
    Result := Length(slots);
    if (Result = 1) then
      Result := Max(1, Self.Slots^.ReadStack(slots[0]));
  end;
end;




function TItemInterface.Hover(item: TItem): Boolean;
var
  box: TBox;
begin
  Result := Self.FindAny([item], box);
  if Result then Mouse.Move(box);
end;


function TItemInterface.Click(item: TItem; button: EMouseButton = EMouseButton.LEFT): Boolean;
begin
  Result := Self.Hover(item);
  if Result then Target.MouseClick(button);
end;


function TItemInterface.Move(item: TItem; destination: Integer): Boolean; overload;
var
  slots: TBoxArray;
  matches: TImageMatchArray;
  i, n: Integer;
  center: TPoint;
  dist, closest: Double;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;
  slots := Self.Slots^.Boxes();
  if not ItemFinder.FindAll([item], slots, matches) then Exit;

  center := slots[destination].Center;
  closest := $FFFFFF;

  for i := 0 to High(matches) do
  begin
    if matches[i].Index = destination then
      Exit(True);

    dist := matches[i].Box.Center.DistanceTo(center);
    if dist < closest then
    begin
      closest := dist;
      n := matches[i].Index;
    end;
  end;

  Result := Self.Slots^.Move(n, destination);
end;



function TItemInterface.Interact(item: TItem; option: String = ''): Boolean;
begin
  if not Self.Hover(item) then Exit;

  if (option <> '') and not MainScreen.IsUpText(option) then
    Exit(ChooseOption.Select(option));

  Target.MouseClick(EMouseButton.LEFT);
  Result := True;
end;

function TItemInterface.Interact(slot: Integer; option: String = ''): Boolean; overload;
var
  box: TBox;
begin
  if (@Self.PreConditionFunction <> nil) and not Self.PreConditionFunction() then
    Exit;

  if not Self.Slots^.IsUsed(slot) then Exit;

  box := Self.Slots^.Box(slot);
  Mouse.Move(box);

  if (option <> '') and not SleepUntil(MainScreen.IsUpText(option), 20, 200) then
    Exit(ChooseOption.Select(option));

  Target.MouseClick(EMouseButton.LEFT);
  Result := True;
end;
