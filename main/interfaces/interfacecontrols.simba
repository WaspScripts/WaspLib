
{$DEFINE WL_INTERFACE_CONTROLS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TButton = object
    EnabledColors: array of TColorTolerance;
    Bounds: TBox;
  end;

  TButtonArray = array of TButton;

function TButton.Construct(
  bounds: TBox; enabledColors: array of TColorTolerance = []
): TButton; static;
begin
  Result.Bounds := bounds;
  Result.EnabledColors := enabledColors;
end;


procedure TButton.Click(button: EMouseButton = EMouseButton.LEFT);
begin
  Mouse.Click(Self.Bounds, button);
end;

{$R-}

property TButton.Enabled: Boolean;
var
  i: Integer;
begin
  if Self.EnabledColors.IsEmpty then
    raise GetDebugLn(
      'TButton',
      'This button has no state. Use `TButton.Click` instead or add `EnabledColors` to it.'
    );

  for i := 0 to High(Self.EnabledColors) do
    if Target.HasColor(Self.EnabledColors[i], 1, Self.Bounds) then
      Exit(True);
end;

property TButton.Enabled(value: Boolean): Boolean;
begin
  if value = Self.Enabled then
    Exit(True);
  Self.Click();
  Result := SleepUntil(Self.Enabled = value, RandomMode(100, 50, 1500), TICK);
end;


function TButton.WaitEnabled(time: Integer = TICK; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.Enabled, interval, time);
end;


function TButtonArray.Create(
  boxes: TBoxArray; enabledColors: array of TColorTolerance
): TButtonArray; static;
var
  i: Integer;
begin
  SetLength(Result, Length(boxes));
  for i := 0 to High(boxes) do
    Result[i] := new TButton(boxes[i], enabledColors);
end;


type

  TSlider = record
    Color: TColor;
    Width: Integer;
    Bounds: TBox;
  end;


function TSlider.GetLevel(): Integer;
var
  tpa: TPointArray;
begin
  tpa := Target.FindColor(Self.Color, 0, Self.Bounds.Expand(10));
  if tpa.IsEmpty then
    Exit(-1);
  Result := (tpa.Mean().X - Self.Bounds.X1) * 100 div Self.Width;
end;


function TSlider.SetLevel(level: Integer): Boolean;
var
  current: Integer;
  pt: TPoint;
begin
  current := Self.GetLevel();

  case Abs(current - level) of
    0..1:  Exit(True);
    2..20:
      begin
        //Move slider away so we can click the level
        if (current + 40 < 100) then
          Self.SetLevel(current + Random(20, 40))
        else
          Self.SetLevel(current - Random(20, 40));
      end;
  end;

  pt := Self.Bounds.TopLeft.Offset(
    level * Self.Width div 100 + 1, Random(Self.Bounds.Height)
  );
  Mouse.Click(pt, EMouseButton.LEFT);
  Result := SleepUntil(
    Abs(Self.GetLevel()-level) < 2, RandomMode(100, 50, 1500), TICK
  );
end;


type

  TScrollBar = record
    Area, Up, Down, Bounds: TBox;
    Width, Height: Integer;
  end;


procedure TScrollBar.Setup(rightSide: Boolean = True);
begin
  if Self.Area = Default(TBox) then
    raise GetDebugLn(
      'ScrollBar',
      'You need to set a Area to use the TScrollBar.Setup() method.'
    );

  if rightSide then
    Self.Bounds.X1 := Self.Area.X2 + 1
  else
    Self.Bounds.X1 := Self.Area.X1 - 16;

  Self.Bounds.Y1 := Self.Area.Y1 + 16;
  Self.Bounds.X2 := Self.Bounds.X1 + 15;
  Self.Bounds.Y2 := Self.Area.Y2 - 16;

  Self.Width  := Self.Bounds.Width;
  Self.Height := Self.Bounds.Height;

  Self.Up.X1 := Self.Bounds.X1;
  Self.Up.Y1 := Self.Area.Y1;
  Self.Up.X2 := Self.Bounds.X2;
  Self.Up.Y2 := Self.Bounds.Y1 - 1;

  Self.Down.X1 := Self.Bounds.X1;
  Self.Down.Y1 := Self.Bounds.Y2 + 1;
  Self.Down.X2 := Self.Bounds.X2;
  Self.Down.Y2 := Self.Area.Y2;
end;


function TScrollBar.IsVisible(): Boolean;
begin
  Result :=
    Target.HasColor(
      [$16091C, 16.971, EColorSpace.HSV, [0.277, 0.671, 2.054]], 100, Self.Up
    )
    and
    Target.HasColor(
      [$16091C, 16.971, EColorSpace.HSV, [0.277, 0.671, 2.054]], 100, Self.Down
    );
end;


property TScrollBar.Slider: TBox;
var
  pt: TPoint;
  tpa: TPointArray;
begin
  pt.X := Self.Bounds.X1 + Self.Width div 2;
  tpa := Target.FindColor(
    TInterface.BORDER, 0, [pt.X, Self.Bounds.Y1, pt.X + 1, Self.Bounds.Y2]
  );

  if tpa.IsEmpty then
    Exit;
  Result.X1 := Self.Bounds.X1+1;
  Result.Y1 := tpa.First.Y;
  Result.X2 := Self.Bounds.X2-1;
  Result.Y2 := tpa.Last.Y;
end;


function TScrollBar.CanScroll(): Boolean;
begin
  if not Self.IsVisible() then
    Exit;

  Result := (Abs(Self.Slider.Y1 - Self.Bounds.Y1) > 0) or
            (Abs(Self.Slider.Y2 - Self.Bounds.Y2) > 0);
end;



function TScrollBar.GetLevel(): Integer;
begin
  with Self.Slider do
    Result := Round((Y1 - Self.Bounds.Y1) * 100 / (Self.Height - Height));
end;


property TScrollBar.ScrollArea: TBox;
begin
  if Biometrics.RandomBoolean(0.9) then
    Result := Self.Area
  else
    Result := Self.Bounds;
end;


function TScrollBar.SetLevel(value: Integer): Integer;
var
  old, scrolls: Integer;
  direction: Boolean;
  area: TBox;
  timeout: TCountDown;
begin
  if not Self.CanScroll() then
    Exit;
  value := EnsureRange(value, 0, 100);

  old := Self.GetLevel();
  if old = value then
    Exit(value);

  direction := old > value;
  area := Self.ScrollArea;

  timeout.Start(15*SECOND);
  while (old <> value) and (direction = (old > value)) and not timeout.IsFinished do
  begin
    Mouse.Move(area);
    scrolls := Random(1, 3);
    if direction then
      scrolls := -scrolls;
    Target.MouseScroll(scrolls);
    Result := Self.GetLevel();

    //user probably hover them while using RI
    if Result = old then
      Mouse.Move(area, True);
    old := Result;
  end;

  timeout.Start(3*SECOND);
  while not timeout.IsFinished do
    if Target.GetPixelDifference(30, 3, Self.Area).IsEmpty then
      Break;
end;



function TScrollBar.Scroll(amount: Integer; down: Boolean): Boolean;
var
  i: Integer;
  timeout: TCountDown;
begin
  if not Self.CanScroll() then
    Exit;

  Result := True;

  case down of
    True:  if Self.GetLevel() = 100 then Exit;
    False: if Self.GetLevel() = 0   then Exit;
  end;

  Mouse.Move(Self.ScrollArea);

  for i := 1 to amount do
  begin
    case down of
      True:  if Self.GetLevel() = 100 then Exit;
      False: if Self.GetLevel() = 0   then Exit;
    end;

    Mouse.Scroll(Random(1,3), down);
  end;

  timeout.Start(3*SECOND);
  while not timeout.IsFinished do
    if Target.GetPixelDifference(30, 3, Self.Area) = [] then
      Break;
end;


type

  TDropDownOption = record
    Index: Integer;
    Bounds: TBox;
    Text: String;
  end;


  TDropDown = record
    Index: Integer;
    Bounds, Arrow: TBox;
    Center: TPoint;
    Font: TPixelFont;
    Colors: TColorArray;
    Options: array of TDropDownOption;
  end;

  TDropDownArray = array of TDropDown;


procedure TDropDown.Setup(
  options: TStringArray; constref font: TPixelFont;
  colors: TColorArray = [$1F98FF, $3FB8FF]
);
var
  i: Integer;
begin
  if Self.Bounds = Default(TBox) then
    raise GetDebugLn(
      'DropDown',
      'You need to set up `Bounds` to use the TDropDown.Setup() method.'
    );

  Self.Index := -1;

  Self.Arrow.X1 := Self.Bounds.X2 - 17;
  Self.Arrow.Y1 := Self.Bounds.Y1 + 2;
  Self.Arrow.X2 := Self.Bounds.X2 - 2;
  Self.Arrow.Y2 := Self.Bounds.Y2 - 2;

  Self.Center := Self.Bounds.Center;

  Self.Font := font;
  Self.Colors := colors;

  SetLength(Self.Options, Length(options));
  for i := 0 to High(options) do
  begin
    Self.Options[i].Index := i;
    Self.Options[i].Bounds := [
      Self.Bounds.X1+1, Self.Bounds.Y2 + 1 + 15*i,
      Self.Bounds.X2-18, Self.Bounds.Y2 + 1 + 14 + 15*i
    ];
    Self.Options[i].Text := options[i];
  end;
end;



function TDropDown.IsVisible(): Boolean;
begin
  Result := Target.HasColor(
    [$130C18, 15.825, EColorSpace.HSV, [0.271, 0.433, 2.298]], 1, Self.Arrow
  );
end;



function TDropDown.IsOpen(): Boolean;
var
  tpa: TPointArray;
begin
  tpa := Target.FindColor(
    [$130C18, 15.825, EColorSpace.HSV, [0.271, 0.433, 2.298]], Self.Arrow
  );
  Result := Self.Center.Y > tpa.Median().Y;
end;



function TDropDown.WaitOpen(time: Integer = TICK; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;



function TDropDown.Open(): Boolean;
begin
  if not Self.IsVisible() then
    Exit;
  if Self.IsOpen() then
    Exit(True);
  Mouse.Click(Self.Bounds, EMouseButton.LEFT);
  Result := Self.WaitOpen(2000);
end;


function TDropDown.Close(): Boolean;
begin
  if not Self.IsVisible() or not Self.IsOpen() then
    Exit(True);
  Mouse.Click(Self.Bounds, EMouseButton.LEFT);
  Result := SleepUntil(not Self.IsOpen(), RandomMode(100, 50, 1500), TICK);
end;



function TDropDown.GetSelected(): Integer;
var
  match: Single;
begin
  if Self.Index > -1 then
    Exit(Self.Index);

  for Result := 0 to High(Self.Options) do
  begin
    match := OCR.Locate(Self.Bounds, Self.Options[Result].Text, Self.Colors, 0, Self.Font);
    if match >= 0.85 then
    begin
      Self.Index := Result;
      Exit;
    end;
  end;

  Result := -1;
  Self.Index := -1;
end;



function TDropDown.Select(index: Integer): Boolean;
begin
  if (Self.Index < 0) and (Self.GetSelected() < 0) then
    Exit;
  if Self.Index = index then
    Exit(True);
  if not Self.Open() then
    Exit;

  Mouse.Click(Self.Options[index].Bounds, EMouseButton.LEFT);
  Self.Index := -1;
  Result := SleepUntil(Self.GetSelected() = index, RandomMode(100, 50, 1500), 2*TICK);
end;

function TDropDown.Select(option: String): Boolean; overload;
var
  idx: Integer;
begin
  for idx := 0 to High(Self.Options) do
    if Self.Options[idx].Text.Contains(option) then
      Exit(Self.Select(idx));
end;
{$R+}
