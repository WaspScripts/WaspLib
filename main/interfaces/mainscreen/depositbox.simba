(*
## DepositBox.DepositDifferent
```pascal
function TDepositBox.DepositDifferent(
  items: TItemArray; useQuantityButton: Boolean = True
): Boolean;
```
Attempts to deposit all items found that are not the `items` passed as a paremeter.

Example:
```pascal
WriteLn DepositBox.DepositDifferent(['Abyssal whip', 'Bandos chestplate', 'Bandos tassets']);
```
*)
function TDepositBox.DepositDifferent(
  items: TItemArray; useQuantityButton: Boolean = True
): Boolean;
var
  slots, deposited: TIntegerArray;
  slot, hash: Integer;
begin
  slots := Self.Items.FindDifferent(items);
  if slots = [] then Exit(True);

  for slot in slots do
  begin
    hash := Self.Items._GetHash(slot);
    if deposited.Contains(hash) then
      Continue;
    deposited += hash;
    if not Self.DepositHelper(
      Self.Slots.Box(slot), QUANTITY_ALL, useQuantityButton
    ) then
      Exit;
  end;
  Result := True;
end;


procedure TDepositBox._SetupMapObjects();
begin
  Self.DepositBoxes := TObjectArray.Create(
    Map.Walker, MapObjects.GetByAction('Bank Deposit Box')
  );
end;


(*
## DepositBox.Hover
```pascal
function TDepositBox.Hover(constref obj: TObject; walk: Boolean = True): Boolean;
function TDepositBox.Hover(walk: Boolean = True): Boolean; overload;
```
Hovers the closest DepositBox that WaspLib is aware of.

This assumes that {ref}`Map` is being used and setup.
It's possible to use this with other systems but you need to configure it all
manually.

It will always hover the closest DepositBox {ref}`TObject` on your loaded map.

If you are too far, it will attempt to walk closer to it.
*)
function TDepositBox.Hover(constref obj: TObject; walk: Boolean = True): Boolean;
begin
  if walk then
    Exit(obj.WalkHover());
  Result := obj.Hover();
end;

function TDepositBox.Hover(walk: Boolean = True): Boolean; overload;
var
  obj: PRSObject;
  me: TPoint;
begin
  if Self.DepositBoxes = [] then
    Self._SetupMapObjects();

  me := Map.Position();
  obj := @Self.DepositBoxes[Self.DepositBoxes.ClosestIndex(me)];
  Result := Self.Hover(obj^, walk);
end;

(*
## DepositBox.Open
```pascal
function TDepositBox.Open(constref obj: TObject; walk: Boolean = True): Boolean;
function TDepositBox.Open(walk: Boolean = True): Boolean; overload;
```
Opens the DepositBox for you.
This assumes that {ref}`Map` is being used and setup.

It's possible to use this with other systems but you need to configure it all
manually.

It will always use the closest DepositBox {ref}`RSObject` WaspLib is aware of on your
loaded map.

If you are too far, it will attempt to walk closer to it by default unless you
set the `walk` parameter to `False`.

Example:
```pascal
{$I WaspLib/main.simba}
begin
  Map.Setup([EChunk.VARROCK]);
  DepositBox.Open();
end.
```
```{figure} ../../images/DepositBoxopen.gif
```
*)
function TDepositBox.Open(constref obj: TObject; walk: Boolean = True): Boolean;
begin
  if walk then
    Result := obj.WalkInteract(['Deposit Box'])
  else
    Result := obj.Interact(['Deposit Box']);

  if not Result then
    if not MainScreen.IsUpText('Deposit Box') or
       not ChooseOption.Select(['Deposit Deposit']) then
      Exit;

  obj.Walker^.WaitMoving();
  Result := Self.WaitOpen(3000);
end;

function TDepositBox.Open(walk: Boolean = True): Boolean; overload;
var
  obj: PRSObject;
  me: TPoint;
begin
  if MSInterface.IsOpen() then
  begin
    if Self.IsOpen() then
      Exit(True);
    MSInterface.Close(True);
  end;

  if Self.DepositBoxes = [] then
    Self._SetupMapObjects();

  me := Map.Position();
  obj := @Self.DepositBoxes[Self.DepositBoxes.ClosestIndex(me)];
  Result := Self.Open(obj^, walk);
end;

var
(*
## DepositBox variable
Global {ref}`TDepositBox` variable.
*)
  DepositBox: TDepositBox;
