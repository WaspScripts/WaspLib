{$DEFINE WL_SHOP_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type
(*
## EShopQuantity
```pascal
EShopQuantity = enum(ONE, FIVE, TEN, FIFTY);
```
Enum representing the shop quantity buttons.
*)
  EShopQuantity = enum(ONE, FIVE, TEN, FIFTY);
(*
## TShop
Main record to interact with the {ref}`Shop` interface.
*)
  TShop = record
    Title: TInterfaceTitle;
    Slots: TSlotInterface;
    Items: TItemInterface;

    Bounds, SlotsArea, _IsOpenHelper: TBox;
    SlotBoxes: TBoxArray;

    QuantityButtons: array [EShopQuantity] of TButton;
    ValueButton: TButton;

    Shops: TObjectArray;
    Merchants: TEntityArray;
  end;

(*
## Shop.FindItemBoundaries
```pascal
function TShop.FindItemBoundaries(): TBoxArray;
```
Finds item boundaries and returns them as a TBoxArray.

You have 2 ways of getting the shop item slots, a static one:
```pascal
ShowOnTarget(Shop.SlotBoxes);
```
```{figure} ../../images/shop_static_slots.png
The shop static slots.
```

And a dynamic one:
```pascal
ShowOnTarget(Shop.FindItemBoundaries());
```
```{figure} ../../images/shop_item_boundaries.png
The shop "dynamic" slots.
```

There are use cases for both, internally, `Shop.FindItemBoundaries` is usually used.
*)
function TShop.FindItemBoundaries(): TBoxArray;
var
  tpa, final: TPointArray;
  atpa: T2DPointArray;
  b: TBox;
  stack: EStack;
begin
  final := Target.FindColor(ITEM_BORDER, 1, Self.SlotsArea);
  if final = [] then Exit;

  for stack := Low(EStack) to High(EStack) do
  begin
    tpa := Target.FindColor(stack.Color, 0, Self.SlotsArea);
    if tpa <> [] then
      final += tpa;
  end;

  atpa := final.Cluster(200, 3);

  for tpa in atpa do
  begin
    b := tpa.Bounds();
    if b.Height <= 5 then Continue;

    Result += TBoxArray.Create(
      [Self.SlotsArea.X1, b.Y1], 8, 1, 31, Min(Self.SlotsArea.Y2-b.Y1, 31), [16, 1]
    );
  end;
end;

function TShop.IsOpen(): Boolean; forward;

(*
## Shop.SetupInterface
```pascal
procedure TShop.SetupInterface();
```
Internal method used to setup the {ref}`TShop` coordinates.
This is automatically called for you on the {ref}`Shop variable`.
*)
procedure TShop.SetupInterface();
var
  boxes: TBoxArray;
  quantity: EShopQuantity;
begin
  case Client.Mode of
    EMode.FIXED: Self.Bounds := MSInterface.CreateBounds([0, 3, 1, 3], 488, 300);
    EMode.RESIZABLE, EMode.MODERN_COMPACT, EMode.MODERN_WIDE:
      Self.Bounds := MSInterface.CreateBounds([-1, 1, 0, 4], 488, 300);
  end;

  Self.Title.Setup(Self.Bounds);

  with Self.Bounds do
  begin
    Self._IsOpenHelper := TBox.Create(X1 + 30, Y2 - 35, X1 + 100, Y2 - 12);
    Self.ValueButton := new TButton(
      [X1+110, Y2-37, X1+139, Y2-8],
      [
        [$0F1043, 0, EColorSpace.RGB, [1,1,1]],
        [$23269F, 0.227, EColorSpace.RGB, [1,1,1]]
      ]
    );
  end;

  Self.SlotBoxes := TBoxArray.Create(
    Self.Bounds.TopLeft.Offset(61, 40), 8, 5, 35, 32, [12,15]
  );
  Self.SlotsArea := Self.SlotBoxes.Merge();
  Self.Slots.Setup('Shop.Slots', Self.SlotBoxes, @Self.FindItemBoundaries);
  Self.Items.Setup('Shop.Items', @Self.Slots, [0, 1], @Self.IsOpen);


  with Self.Bounds do // This is the whole button
    boxes := TBoxArray.Create([X2-196, Y2-37], 4, 1, 29, 29, [11,0]);

  for quantity := Low(EShopQuantity) to High(EShopQuantity) do
    Self.QuantityButtons[quantity] := new TButton(
      boxes[quantity],
      [
        [$0F1043, 0, EColorSpace.RGB, [1,1,1]],
        [$23269F, 0.227, EColorSpace.RGB, [1,1,1]]
      ]
    );
end;

(*
## Shop.IsOpen
```pascal
function TShop.IsOpen(): Boolean;
```
Returns true if the shop interface is open.

Example:
```pascal
WriteLn Shop.IsOpen();
```
*)
function TShop.IsOpen(): Boolean;
begin
  Result := OCR.Recognize(
      Self._IsOpenHelper, Fonts.PLAIN_12, [TFonts.ORANGE], 0
    ).ContainsAny(['Value','check'], True
  );
end;

(*
## Shop.WaitOpen
```pascal
function TShop.WaitOpen(time: Integer = 600; interval: Integer = -1): Boolean;
```
Returns true if the shop opens within `time` milliseconds.

Example:
```pascal
WriteLn Shop.WaitOpen();
```
*)
function TShop.WaitOpen(time: Integer = 600; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;

(*
## Shop.Close
```pascal
function TShop.Close(escape: Boolean): Boolean;
function TShop.Close(escapeProbability: Double = BioHash): Boolean; overload;
```
Closes the {ref}`Shop` interface, depending on `escape` the function will either
press escape or click the close button.

Example:
```pascal
WriteLn Shop.Close();
```
*)
function TShop.Close(escape: Boolean): Boolean;
begin
  Result := Self.Title.Close(escape);
end;

function TShop.Close(escapeProbability: Single = -1): Boolean; overload;
begin
  Result := Self.Title.Close(escapeProbability);
end;

(*
## Shop.Buy
```pascal
function TShop.Buy(
  item: TItem; quantity: EShopQuantity = EShopQuantity.ONE
): Boolean;
```
Attempts to buy the specified item from the shop.
With the proper quantity button enabled.

Example:
```pascal
WriteLn Shop.Buy('Gold ore', EShopQuantity.FIFTY);
```
*)
function TShop.Buy(
  item: TItem; quantity: EShopQuantity = EShopQuantity.ONE
): Boolean;
begin
  Result := False;
  if not Self.IsOpen() then Exit;
  if not Self.Items.Contains(item) then Exit;


  if not Self.QuantityButtons[quantity].Enabled then
    Self.SetQuantity(quantity);

  case quantity of
    EShopQuantity.ONE: Self.Items.Interact(item, 'Buy 1');
    EShopQuantity.FIVE: Self.Items.Interact(item, 'Buy 5');
    EShopQuantity.TEN: Self.Items.Interact(item, 'Buy 10');
    EShopQuantity.FIFTY: Self.Items.Interact(item, 'Buy 50');
  end;


  // TODO Maybe add Count tracking to see if sale was successful
  Sleep(200, 300);
  Result := True;
end;

(*
## Shop.Sell
```pascal
function TShop.Sell(
  item: TItem; quantity: EShopQuantity = EShopQuantity.ONE
): Boolean;
```
Attempts to sell the specified item to the shop from your inventory.
With the proper quantity button enabled.

Example:
```pascal
WriteLn Shop.Sell('Bones', EShopQuantity.FIVE);
```
*)
function TShop.Sell(
  item: TItem; quantity: EShopQuantity = EShopQuantity.ONE
): Boolean;
begin
  Result := False;
  if not Self.IsOpen() then Exit;
  if not Inventory.Items.Contains(item) then Exit;

  if not Self.QuantityButtons[quantity].Enabled then
    Self.SetQuantity(quantity);

  case quantity of
    EShopQuantity.ONE: Inventory.Items.Interact(item, 'Sell 1');
    EShopQuantity.FIVE: Inventory.Items.Interact(item, 'Sell 5');
    EShopQuantity.TEN: Inventory.Items.Interact(item, 'Sell 10');
    EShopQuantity.FIFTY: Inventory.Items.Interact(item, 'Sell 50');
  end;

  // TODO Maybe add Count tracking to see if sale was successful
  Sleep(200, 300);
  Result := True;
end;

(*
## Shop.GetPrice
```pascal
function TShop.GetPrice(item: TItem): Integer;
```
Returns the price of an item in the shop by examining it.

Example:
```pascal
WriteLn Shop.GetPrice('Gold ore');
```
*)
function TShop.GetPrice(item: TItem): Integer;
begin
  if not Self.IsOpen() then
    Exit;
  if not Self.Items.Contains(item) then
    Exit;
  if not Self.ValueButton.Enabled[True] then
    Exit;

  Sleep(600, 800);

  if Self.Items.Interact(item, 'Value') then
  begin
    Biometrics.Sleep(100, 300);
    // TODO: Implement price reading from chat or interface
    Result := 0;
  end;
end;

(*
## Shop.SetQuantity
```pascal
function TShop.SetQuantity(quantity: EShopQuantity): Boolean;
```
Sets the shop quantity button (1, 5, 10, or 50).

Example:
```pascal
WriteLn Shop.SetQuantity(EShopQuantity.TEN);
```
*)
function TShop.SetQuantity(quantity: EShopQuantity): Boolean;
begin
  if Self.QuantityButtons[quantity].Enabled then Exit(True);
  Result := Self.QuantityButtons[quantity].Enabled[True];
  if Result then Sleep(600, 800);
end;

procedure TShop._SetupMapObjects();
begin
  Self.Shops := TObjectArray.Create(
    Map.Walker, MapObjects.GetByAction('Buy-food')
  );

  Self.Merchants := TEntityArray.Create(
    Map.Walker, NPCsJSON.GetByAction('Trade')
  );
end;

(*
## Shop.Hover
```pascal
function TShop.Hover(obj: TObject; walk: Boolean = True): Boolean;
function TShop.Hover(npc: TEntity; walk: Boolean = True): Boolean; overload;
```
This assumes that {ref}`Map` is being used and setup.
It's possible to use this with other systems but you need to configure it all
manually.

If you are too far, it will attempt to walk closer to it.
*)

function TShop.Hover(obj: TObject; walk: Boolean = True): Boolean;
begin
  if walk then
    Exit(obj.WalkHover());
  Result := obj.Hover();
end;

function TShop.Hover(npc: TEntity; walk: Boolean = True): Boolean; overload;
begin
  if walk then
    Exit(npc.WalkHover());
  Result := npc.Hover();
end;

(*
## Shop.Open
```pascal
function TShop.Open(obj: TObject; walk: Boolean = True): Boolean;
function TShop.Open(npc: TEntity; walk: Boolean = True): Boolean; overload;
```
Opens the shop for you.
This assumes that {ref}`Map` is being used and setup.

Example:
```pascal
{$I WaspLib/main.simba}
begin
  Map.Setup([Map.Setup([EChunk.BLAST_FURNACE]));
  Shop.Open(TEntity.Create(NPCsJSON.GetByName('Ordan', 1).Item[0]));
end.
```
*)
function TShop.Open(obj: TObject; walk: Boolean = True): Boolean;
begin
  if walk then
    Result := obj.WalkInteract(['Trade'])
  else
    Result := obj.Interact(['Trade']);

  if not Result then
    if not MainScreen.IsUpText('Trade') or not ChooseOption.Select(['Trade']) then
      Exit;

  obj.Walker^.WaitMoving();
  Result := Self.WaitOpen(3000);
end;

function TShop.Open(npc: TEntity; walk: Boolean = True): Boolean; overload;
begin
  if walk then
    Result := npc.WalkInteract(['Trade', 'Trade'])
  else
    Result := npc.Interact(['Trade']);

  if not Result and not MainScreen.Interact(['Trade']) then
    Exit;

  npc.Walker^.WaitMoving();
  Result := Self.WaitOpen(3000);
end;

var
(*
## Shop variable
Global {ref}`TShop` variable.
*)
  Shop: TShop;
