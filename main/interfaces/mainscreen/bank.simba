

{$DEFINE WL_BANK_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  EBankButton = enum(SETTINGS, TUTORIAL);


  EBankSideButton = enum(POTION_STORAGE, INCINERATOR);


  EBankModeButton = enum(ARRANGEMENT, NOTES);


  EBankMiscButton = enum(SEARCH, PLACEHOLDERS);


  EBankDepositButton = enum(CONTAINERS, INVENTORY, WORN);


  EBankInteraction = enum(WITHDRAW, DEPOSIT);


  TBankPosition = record
    Tab, Scroll: Integer;
    Slot: TBox;
  end;


  TBank = record
    Bounds: TBox;
    Slots: TSlotInterface;
    Items: TItemInterface;
    Title: TInterfaceTitle;
    Scroll: TScrollBar;

    Incenerator, PotionStorage, SlotsArea: TBox;

    Tabs, SlotBoxes: TBoxArray;

    Worn: TButton;
    Buttons: array [EBankButton] of TButton;
    SidebarButtons: array [EBankSideButton] of TButton;
    ModeButtons: array [EBankModeButton] of TButton;
    QuantityButtons: array [EItemQuantity] of TButton;
    MiscButtons: array [EBankMiscButton] of TButton;
    DepositButtons: array [EBankDepositButton] of TButton;

    JagexAccountAd: record
      NotNow, MoreInfo: TBox;
    end;

    ButtonsOffset, Depleted: Boolean;

    _Cache: record
      Quantity: Integer;
      Items: TStringMap<TBankPosition>;
    end;
    _IsOpenHelperBox: TBox;
    Banks: TObjectArray;
    Bankers: TEntityArray;
  end;

function TBank.FindItemBoundaries(): TBoxArray; forward;

function TBank.IsOpen(): Boolean; forward;


procedure TBank.SetupInterface();
const
  BUTTON_COLORS: array of TColorTolerance = [
    [$0F1043, 0, EColorSpace.RGB, [1,1,1]],
    [$23269F, 0.227, EColorSpace.RGB, [1,1,1]]
  ];
var
  i: Integer;
begin
  Self.Bounds := MSInterface.CreateBounds([0, 2, 0, -1], 488, 800);

  Self.Scroll.Area.X1 := Self.Bounds.X1 + 5;
  Self.Scroll.Area.Y1 := Self.Bounds.Y1 + 77;
  Self.Scroll.Area.X2 := Self.Bounds.X2 - 22;
  Self.Scroll.Area.Y2 := Self.Bounds.Y2 - 44;

  Self.Scroll.Setup();
  Self.Title.Setup(Self.Bounds);

  Self.Tabs := TBoxArray.Create(Self.Bounds.TopLeft.Offset(47, 42), 10, 1, 35, 28, [5, 0]);
  Self.SlotBoxes :=
    TBoxArray.Create(
      Self.Bounds.TopLeft.Offset(57, 77), 8,
      (Self.Bounds.Height - 135) div 35, 31, 31, [17, 5]
    );

  Self.SlotsArea.X1 := Self.Bounds.X1 + 57;
  Self.SlotsArea.Y1 := Self.Bounds.Y1 + 77;
  Self.SlotsArea.X2 := Self.Bounds.X2 - 63;
  Self.SlotsArea.Y2 := Self.Bounds.Y2 - 44;

  with Self.SlotsArea.Center.Offset(0,-1) do
    Self.JagexAccountAd.NotNow := [X-120, Y+43, X-49, Y+66];

  with Self.SlotsArea.Center.Offset(0,-1) do
    Self.JagexAccountAd.MoreInfo := [X+39, Y+43, X+108, Y+66];

  Self.Incenerator.X1 := Self.Bounds.X1 + 5;
  Self.Incenerator.Y1 := Self.Bounds.Y2 - 113;
  Self.Incenerator.X2 := Self.Bounds.X1 + 51;
  Self.Incenerator.Y2 := Self.Bounds.Y2 - 44;

  Self.PotionStorage.X1 := Self.Bounds.X1 + 8;
  Self.PotionStorage.Y1 := Self.Bounds.Y2 - 156;
  Self.PotionStorage.X2 := Self.Bounds.X1 + 51;
  Self.PotionStorage.Y2 := Self.Bounds.Y2 - 118;

  Self.Slots.Setup('Bank.Slots', Self.SlotBoxes, @Self.FindItemBoundaries);
  Self.Items.Setup('Bank.Items', @Self.Slots, [0, 1], @Self.IsOpen);

  Self._IsOpenHelperBox.X1 := Self.Bounds.X1 + 235;
  Self._IsOpenHelperBox.Y1 := Self.Bounds.Y2 - 42;
  Self._IsOpenHelperBox.X2 := Self.Bounds.X2 - 156;
  Self._IsOpenHelperBox.Y2 := Self.Bounds.Y2 - 26;

  with Self.Bounds do
  begin
    Self.Worn := new TButton([X2-40, Y1+38, X2-7, Y1+71], BUTTON_COLORS);

    Self.Buttons[EBankButton.SETTINGS] := new TButton([X1+34, Y1+7, X1+54, Y1+27]);
    Self.Buttons[EBankButton.TUTORIAL] := new TButton([X1+58, Y1+7, X1+78, Y1+27]);

    Self.SidebarButtons[EBankSideButton.POTION_STORAGE] :=
      new TButton([X1+8, Y2-121, X1+41, Y2-88], BUTTON_COLORS);
    Self.SidebarButtons[EBankSideButton.INCINERATOR] :=
      new TButton([X1+8, Y2-85, X1+41, Y2-52]);

    Self.ModeButtons[EBankModeButton.ARRANGEMENT] :=
      new TButton([X1, Y2-41, X1+33, Y2-8]);
    Self.ModeButtons[EBankModeButton.NOTES] :=
      new TButton([X1, Y2-41, X1+33, Y2-8], BUTTON_COLORS);

    for i := 0 to 4 do
      Self.QuantityButtons[i] := new TButton([X1, Y2-41, X1+33, Y2-8], BUTTON_COLORS);
    for i := 0 to 1 do
      Self.MiscButtons[i] := new TButton([X1, Y2-41, X1+33, Y2-8], BUTTON_COLORS);
    for i := 0 to 2 do
      Self.DepositButtons[i] := new TButton([X1, Y2-41, X1+33, Y2-8]);
  end;

  Self.ButtonsOffset := False;
end;

function TBank._GetButtonDividers(): TPointArray;
var
  tpa, dividers: TPointArray;
  atpa: T2DPointArray;

begin
  with Self.Bounds do
    tpa := Target.FindColor($232B2E, 1, [X1+6, Y2-43, X2-6, Y2-6]);
  if tpa.IsEmpty then
    Exit;
  atpa := tpa.Cluster(1.5).ExtractDimensions(0, 0, 4, 30);
  if Length(atpa) <> 3 then
    Exit;

  for tpa in atpa do
    dividers += tpa.First;

  if dividers[0].DistanceTo(dividers[1]) <> 191 then
    Exit;
  if dividers[0].DistanceTo(dividers[2]) <> 284 then
    Exit;
  Result := dividers;
end;


procedure TBank.UpdateButtons(const tpa: TPointArray);
var
  i: Integer;
  boxes: TBoxArray;
begin
  if Self.ButtonsOffset then
    Exit;

  Self.ModeButtons[EBankModeButton.ARRANGEMENT].Bounds.X1 := tpa[0].X - 75;
  Self.ModeButtons[EBankModeButton.ARRANGEMENT].Bounds.X2 := tpa[0].X - 42;
  Self.ModeButtons[EBankModeButton.NOTES].Bounds.X1 := tpa[0].X - 38;
  Self.ModeButtons[EBankModeButton.NOTES].Bounds.X2 := tpa[0].X - 5;

  for i := 0 to 4 do
  begin
    Self.QuantityButtons[i].Bounds.X1 := tpa[0].X + 5 + i*37;
    Self.QuantityButtons[i].Bounds.X2 := tpa[0].X + 38 + i*37;
  end;

  Self.MiscButtons[EBankMiscButton.SEARCH].Bounds.X1 := tpa[1].X + 5;
  Self.MiscButtons[EBankMiscButton.SEARCH].Bounds.X2 := tpa[1].X + 48;
  Self.MiscButtons[EBankMiscButton.PLACEHOLDERS].Bounds.X1 := tpa[1].X + 55;
  Self.MiscButtons[EBankMiscButton.PLACEHOLDERS].Bounds.X2 := tpa[1].X + 88;

  boxes := TBoxArray.Create([tpa[2].X+5, Self.Bounds.Y2-41], 3, 1, 33, 33, [4,0]);
  for i := High(boxes) downto 0 do
    if not Target.HasColor($516472, 0, 1, boxes[i]) then
      Delete(boxes, i, 1);

  case Length(boxes) of
    0: raise GetDebugLn('Bank', 'Something went wrong, couldn''f find any bank deposit button.');
    1:
    begin
      Self.DepositButtons[EBankDepositButton.WORN].Bounds := boxes.Last;
      Self.DepositButtons[EBankDepositButton.INVENTORY] := nil;
      Self.DepositButtons[EBankDepositButton.CONTAINERS] := nil;
    end;
    2:
    begin
      Self.DepositButtons[EBankDepositButton.WORN].Bounds := boxes.Last;
      if Target.HasColor([$0F3669, 2.705, EColorSpace.HSV, [1.943, 0.722, 0.336]], 4, boxes[0]) then
      begin
        Self.DepositButtons[EBankDepositButton.INVENTORY].Bounds := boxes[0];
        Self.DepositButtons[EBankDepositButton.CONTAINERS] := nil;
      end
      else
      begin
        Self.DepositButtons[EBankDepositButton.INVENTORY] := nil;
        Self.DepositButtons[EBankDepositButton.CONTAINERS].Bounds := boxes[0];
      end;
    end;
    3: for i := 0 to High(boxes) do
        Self.DepositButtons[i].Bounds := boxes[i];
  end;

  Self.ButtonsOffset := True;
end;



function TBank.HasJagexAccountAd(): Boolean;
begin
  Result := (Target.CountColor($0000FF, 0, Self.JagexAccountAd.NotNow) = 98) and
            (Target.CountColor($0DC10D, 0, Self.JagexAccountAd.MoreInfo) = 112);
end;


function TBank.CloseJagexAccountAd(): Boolean;
begin
  Mouse.Click(Self.JagexAccountAd.NotNow, EMouseButton.LEFT);
  Result := SleepUntil(not Self.HasJagexAccountAd(), 50, 600);
end;



function TBank.FindItemBoundaries(): TBoxArray;
var
  tpa, final: TPointArray;
  atpa: T2DPointArray;
  b: TBox;
  stack: EStack;
begin
  final := Target.FindColor(ITEM_BORDER, 1, Self.SlotsArea);
  if final.IsEmpty then
    Exit;

  for stack := Low(EStack) to High(EStack) do
  begin
    tpa := Target.FindColor(stack.Color, 0, Self.SlotsArea);
    if tpa <> [] then
      final += tpa;
  end;

  atpa := final.Cluster(200, 3);

  for tpa in atpa do
  begin
    b := tpa.Bounds();
    if b.Height <= 5 then Continue;

    Result += TBoxArray.Create([Self.SlotsArea.X1, b.Y1], 8, 1, 31, Min(Self.SlotsArea.Y2-b.Y1, 31), [17, 1]);
  end;
end;



function TBank.IsOpen(): Boolean;
var
  tpa: TPointArray;
  title: String;
begin
  if BankPin.IsOpen() then
  begin
    if not BankPin.WaitLoading(3000) then
      raise GetDebugLn('BankPin', 'Bank pin buttons don''t seem to have loaded in 3 seconds.');

    if not BankPin.Enter(Profiles.GetPin()) then
      raise GetDebugLn('BankPin', 'Failed to enter bank pin.');
  end;

  tpa := Self._GetButtonDividers();
  Result := (Length(tpa) = 3);

  if not Result then
  begin
    title := Self.Title.GetTitle();
    Result := title in ['Bank', 'Tab ', 'Equip'];
  end;

  if Result then
  begin
    if tpa.IsEmpty then
    begin
      if not Self.HasJagexAccountAd() then Exit;
      if not Self.CloseJagexAccountAd() then Exit;
      Exit(Self.IsOpen()); //ad closed, restart
    end;

    Self.UpdateButtons(tpa);
  end;
end;


function TBank.WaitOpen(time: Integer; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;


function TBank.Close(escape: Boolean): Boolean;
begin
  Result := Self.Title.Close(escape);
end;

function TBank.Close(escapeProbability: Single = -1): Boolean; overload;
begin
  Result := Self.Title.Close(escapeProbability);
end;




function TBank.CountTabs(): Integer;
var
  i: Integer;
begin
  for i := 9 downto 1 do
    if Target.HasColor(ITEM_BORDER, 0, 1, Self.Tabs[i]) then
      Exit(i);
end;


function TBank.GetCurrentTab(): Integer;
var
  i: Integer;
begin
  for i := 0 to 9 do
    with Self.Tabs[i] do
      if not Target.HasColor($516471, 0, 1, [X1+4, Y2+3, X2-4, Y2+5]) then
        Exit(i);
end;


function TBank.OpenTab(tab: Integer): Boolean;
  function _TabChanged(tab: Integer): Boolean;
  begin
    if tab <> 0 then
      Exit(tab = Self.GetCurrentTab());

    //when search is open tab 0 is returned.
    Result := not Chat.FindQuery('Show items');
  end;

begin
  if not Self.IsOpen() then Exit;

  if tab = Self.GetCurrentTab() then
  begin
    if tab <> 0 then Exit(True);
    if not Chat.FindQuery('Show items') then Exit(True);
  end;

  Mouse.Click(Self.Tabs[tab], EMouseButton.LEFT);
  Result := SleepUntil(_TabChanged(tab), RandomMode(100, 50, 1500), 600);
  Sleep(200, 300);
end;



function TBank.SetQuantity(quantity: EItemQuantity; amount: Integer = 0): Boolean;
begin
  if Self.QuantityButtons[quantity].Enabled then
    Exit(True);
  Result := Self.QuantityButtons[quantity].Enabled[True];

  if Result or (quantity <> EItemQuantity.CUSTOM) then
    Exit;

  if Chat.AnswerQuery('Enter amount', ToString(amount), RandomLeft(1400, 2400)) then
  begin
    Self._Cache.Quantity := amount;
    Result := Self.QuantityButtons[quantity].Enabled;
  end;
end;



function TBank.IsSearchOpen(): Boolean;
begin
  Result := Chat.FindQuery('Show items', True);
end;


function TBank.WaitSearchOpen(time: Integer = 600; interval: Integer = -1): Boolean;
begin
  Result := Chat.WaitQuery('Show items', True, time, interval);
end;


function TBank.OpenSearch(waitTime: Integer = 0): Boolean;
begin
  Self.MiscButtons[EBankMiscButton.SEARCH].Click();
  if waitTime <= 0 then
    Exit(Self.IsSearchOpen());
  Result := Self.WaitSearchOpen(waitTime);
  Sleep(200, 300);
end;


function TBank.ClearSearch(): Boolean;
begin
  if not Self.Title.IsTitle('Showing items:') then Exit(True);

  if Biometrics.RandomBoolean() then
    Self.MiscButtons[EBankMiscButton.SEARCH].Click()
  else
    Mouse.Click(Self.Tabs[0], EMouseButton.LEFT);
  Result := SleepUntil(not Self.Title.IsTitle('Showing items:'), RandomMode(100, 50, 1500), 600);
end;


function TBank.Search(item: TItem): Boolean;
var
  txt: String;
  i, j: Integer;
begin
  txt := item.SimplifyName();

  if Self.Title.IsTitle('Showing items: ' + txt) then Exit(True);
  if not Self.ClearSearch() then Exit;
  if not Self.OpenSearch(Random(2000, 2500)) then Exit;

  for i := 1 to Length(txt) do
  begin
    Keyboard.KeyPress(Target.KeyCodeFromChar(txt[i]));
    Sleep(100, 200);

    if i = j then Break;

    if (j = 0) and Self.Items.Contains(item) then
      j := i + Random(2, 4);
  end;

  Result := SleepUntil(Self.Items.Contains(item), 300, 2000);
end;


function TBank.CloseSearch(): Boolean;
begin
  Result := Self.ClearSearch() and
            Chat.AnswerQuery('Show items', '', Random(2000, 2500));
end;


function TBank.HasIncinerator(): Boolean;
begin
  with Self.Incenerator do
    Result := Target.HasColor(ColorTolerance($517F9E, 2.132, EColorSpace.HSV, [2.437, 0.309, 0.256]), 1, [X1, Y1+55, X2, Y2]);
end;


function TBank.InceneratorTooltipVisible(): Boolean;
begin
  with Self.Incenerator do
    Result := Target.HasColor($A0FFFF, 0, 1, [X1+6, Y1+76, X2, Y2+35]);
end;


function TBank.CloseInceneratorTooltip(): Boolean;
var
  boxes: TBoxArray;
begin
  if not Self.Incenerator.Contains(Target.MouseXY) then
    Exit(True);

  boxes := Self.Incenerator.Invert(Self.Bounds).SortFrom(Target.MouseXY);

  ASyncMouse.Move(boxes[RandomLeft(0, High(boxes))].RandomPoint());
  Result := SleepUntil(not Self.InceneratorTooltipVisible(), 100, 1000);
  ASyncMouse.Stop();
end;



function TBank.HasPotionStorage(): Boolean;
begin
  Result := Target.HasColor(ColorTolerance($517F9E, 2.132, EColorSpace.HSV, [2.437, 0.309, 0.256]), 1, Self.PotionStorage);
end;


function TBank.PotionStorageIsOpen(): Boolean;
begin
  Result := Target.HasColor($1F98FF, 0,  3000, Self.SlotsArea);
end;



function TBank._FindTabText(tpa: TPointArray; out bounds: TBox): Boolean;
var
  atpa: T2DPointArray;
begin
  if tpa.IsEmpty then
    Exit;
  atpa := tpa.Cluster(6).ExcludeDimensions(24, 8, 26, 8);
  if atpa.IsEmpty then
    Exit;

  atpa := atpa.SortByY(False)[0].Cluster(1.5);
  bounds := atpa.SortByX(False)[0].Bounds();

  bounds.X1 -= 1;
  bounds.Y1 -= 1;
  bounds.X2 += 1;
  bounds.Y2 += 3;
  Result := True;
end;


function TBank.FindTab(item: TItem): Integer;
var
  bounds: TBox;
begin
  if not Self.Search(item) then Exit(-1);
  if not Self.Items.Find(item, bounds)  then Exit(-1);

  bounds := [Self.Bounds.X1 + 56, Self.Bounds.Y1 + 77, Self.Bounds.X1 + 84, bounds.Y1];
  if bounds.Height < 8 then Exit(0);

  if Self._FindTabText(Target.FindColor(TFonts.LIGHT_YELLOW, 0, bounds), bounds) then
    Result := OCR.RecognizeNumber(bounds, Fonts.PLAIN_11, [TFonts.LIGHT_YELLOW], 0);
  if Self._FindTabText(Target.FindColor(TFonts.WHITE, 0, bounds), bounds) then
    Result := OCR.RecognizeNumber(bounds, Fonts.PLAIN_11, [TFonts.WHITE], 0);
end;


function TBank.FindScroll(item: TItem): Integer;
var
  next: Integer;
  down: Boolean;
begin
  if not Self.Scroll.CanScroll() then Exit(-1);

  Result := Self.Scroll.GetLevel();
  down := (Result > 0) or RandomBoolean(0.5);

  if Self.Items.Contains(item) then Exit;

  repeat
    if down then next := Result - 5
    else next := Result + 5;

    Result := Self.Scroll.SetLevel(next);
    if Self.Items.Contains(item) then Exit;

    if not Self.IsOpen() then Exit(-1); //failsafe
  until not InRange(Result, 1, 99);

  down := not down;
  repeat
    if down then next := Result - 5
    else next := Result + 5;

    Result := Self.Scroll.SetLevel(next);
    if Self.Items.Contains(item) then Exit;

    if not Self.IsOpen() then Exit(-1);
  until not InRange(Result, 1, 99);

  Result := -1;
end;


function TBank._InteractionHelper(mode: EBankInteraction; slot: TBox; amount: Integer; useQuantityButton: Boolean): Boolean;
var
  quantity: EItemQuantity;
  amountStr, modeStr, upText: String;
  timeout: TCountDown;
begin
  amountStr := ToString(amount);
  quantity := EItemQuantity.Integer2Quantity(amount);

  if mode = EBankInteraction.DEPOSIT then
    modeStr := 'Deposit-'
  else
    modeStr := 'Withdraw-';

  if useQuantityButton then
  begin
    if not Self.SetQuantity(quantity, amount) then
      Exit;

    Mouse.Move(slot);
    if quantity <> EItemQuantity.CUSTOM then
    begin
      Mouse.Click(EMouseButton.LEFT);
      Exit(True);
    end;

    if Self._Cache.Quantity = amount then
    begin
      Mouse.Click(EMouseButton.LEFT);
      Exit(True);
    end;

    timeout.Start(Round(RandomMode(100, 85, 250)));

    repeat
      if MainScreen._IsUpText(upText, [modeStr], True, 0.85) then
      begin
        Sleep(50);
        if MainScreen._IsUpText(upText, [modeStr], True, 0.85) then
          Break;
      end;

      if timeout.IsFinished then
        Exit;
      Sleep(25);
    until False;


    upText := upText.Between(modeStr, ' ');

    if upText = amountStr then
    begin
      Self._Cache.Quantity := amount;
      Mouse.Click(EMouseButton.LEFT);
      Exit(True);
    end;

    if not ChooseOption.Select(modeStr + 'X') then
      Exit;
    if Chat.AnswerQuery('Enter amount', amountStr, RandomLeft(1400, 2400)) then
    begin
      Self._Cache.Quantity := amount;
      Exit(True);
    end
    else
      Exit;
  end;

  Mouse.Move(slot);

  if (quantity <> EItemQuantity.CUSTOM) then
  begin
    if Self.QuantityButtons[quantity].Enabled then
    begin
      Mouse.Click(EMouseButton.LEFT);
      Exit(True);
    end;
  end
  else
  if MainScreen.IsUpText(modeStr + amountStr) then
  begin
    Mouse.Click(EMouseButton.LEFT);
    Exit(True);
  end;

  if (quantity = EItemQuantity.ALL) then
    Exit(ChooseOption.Select(modeStr + 'All'));

  Result := ChooseOption.Select(modeStr + amountStr + ' ', True, False) or
            (ChooseOption.Select(modeStr + 'X') and Chat.AnswerQuery('Enter amount', amountStr, RandomLeft(1400, 2400)));
end;


function TBank.Find(item: TItem; out data: TBankPosition; attempts: Int32 = 3): Boolean;
begin
  if attempts = 0 then Exit(False);

  if Self.Items.Find(item, data.Slot) then
  begin
    if not Self.MiscButtons[EBankMiscButton.SEARCH].Enabled then
    begin
      data.Tab := Self.GetCurrentTab();
      data.Scroll := Self.Scroll.GetLevel();
      Self._Cache.Items.Value[item] := data;
      Exit(True);
    end;

    if Self.WaitSearchOpen(600) then
      if not Self.CloseSearch() then Exit(Self.Find(item, data, Dec(attempts))); //unknown state, reset search
  end;

  data.Tab := Self.FindTab(item);
  if data.Tab = -1 then
    Exit(Self.Find(item, data, Dec(attempts)));
  Self.OpenTab(data.Tab);

  if Self.Items.Find(item, data.Slot) then
  begin
    data.Scroll := Self.Scroll.GetLevel();
    Self._Cache.Items.Value[item] := data;
    Exit(True);
  end;

  data.Scroll := Self.FindScroll(item);
  if data.Scroll = -1 then
    Exit(Self.Find(item, data, Dec(attempts)));

  if not Self.Items.Find(item, data.Slot) then
    Exit(Self.Find(item, data, Dec(attempts)));

  Result := True;
  Self._Cache.Items.Value[item] := data;
end;



function TBank.Withdraw(item: TBankItem; useQuantityButton, useCache: Boolean = True; waitConfirmation: Boolean = False): Boolean;
var
  data: TBankPosition;
  tmp: TItem;
  count: Integer;
  attempt: Integer;
begin
  if useCache and Self._Cache.Items.Exists(item.Item) then
    data := Self._Cache.Items.Value[item.Item]
  else if not Self.Find(item.Item, data) then
    Exit;

  if not Self.OpenTab(data.Tab) then Exit;
  if not InRange(Self.Scroll.GetLevel() - data.Scroll, -5, 5) then
    Self.Scroll.SetLevel(data.Scroll);

  tmp := item.ToItem();

  for attempt := 0 to 2 do
  begin
    count := Self.Slots.ReadStack(data.Slot);
    if not Self.ModeButtons[EBankModeButton.NOTES].Enabled[item.Noted] then
      Continue;
    if Self._InteractionHelper(EBankInteraction.WITHDRAW, data.Slot, item.Quantity, useQuantityButton) then
    begin
      if not waitConfirmation then
        Exit(True);

      Self.Slots.WaitFade(data.Slot);
      Sleep(200);

      if SleepUntil(Self.Slots.ReadStack(data.Slot) < count, 200, 4200) then
        Exit(True);
    end;
  end;
end;

function TBank.Withdraw(item: TItem; useQuantityButton: Boolean = True; useCache: Boolean = True): Boolean; overload;
begin
  Result := Self.Withdraw(item.ToBankItem(), useQuantityButton, useCache);
end;


function TBank.Deposit(item: TBankItem; useQuantityButton: Boolean = True): Boolean;
var
  slot: TBox;
begin
  if Inventory.Items.Find(item.ToItem(), slot) then
    Result := Self._InteractionHelper(EBankInteraction.DEPOSIT, slot, item.Quantity, useQuantityButton);
end;

function TBank.Deposit(item: TItem; useQuantityButton: Boolean = True): Boolean; overload;
var
  slot: TBox;
begin
  if Inventory.Items.Find(item, slot) then
    Result := Self._InteractionHelper(EBankInteraction.DEPOSIT, slot, 1, useQuantityButton);
end;


function TBank.DepositContainers(): Boolean;
begin
  if not Self.IsOpen() then
    Exit;
  Self.DepositButtons[EBankDepositButton.CONTAINERS].Click(EMouseButton.LEFT);
  Result := True;
end;


function TBank.DepositInventory(): Boolean;
var
  count: Integer;
begin
  if not Self.IsOpen() then
    Exit;
  count := Inventory.Slots.Count();
  Self.DepositButtons[EBankDepositButton.INVENTORY].Click(EMouseButton.LEFT);
  Result := SleepUntil(Inventory.Slots.Count() < count, 200, 4*TICK);
end;


function TBank.DepositWorn(): Boolean;
begin
  if not Self.IsOpen() then
    Exit;
  Self.DepositButtons[EBankDepositButton.WORN].Click(EMouseButton.LEFT);
  Result := True;
end;



function TBank.DepositDifferent(items: TItemArray; useQuantityButton: Boolean = True): Boolean;
var
  slots, deposited: TIntegerArray;
  slot, hash: Integer;
begin
  slots := Inventory.Items.FindDifferent(items);
  if slots.IsEmpty then
    Exit(True);

  for slot in slots do
  begin
    hash := Inventory.Items._GetHash(slot);
    if deposited.Contains(hash) then
      Continue;
    deposited += hash;
    if not Self._InteractionHelper(EBankInteraction.DEPOSIT, Inventory.Slots.Box(slot), QUANTITY_ALL, useQuantityButton) then
      Exit;
  end;
  Result := True;
end;



function TBank.IsDepleted(item: TBankItem; attempts: Integer = 3): Boolean;
var
  data: TBankPosition;
begin
  if attempts = 0 then Exit;

  if Self.Find(item.Item, data) then
  begin
    if Max(1, TItem.ReadStack(data.Slot)) < Min(item.Quantity, 28) then
    begin
      Self.Depleted := Self.IsOpen();
      Exit(True);
    end;

    Exit(False);
  end;

  Result := Self.IsDepleted(item, attempts-1);

  Self.Depleted := Result and Self.IsOpen();
end;



function TBank.PrioritySort(constref l, r: TBankItem): Int32;
var
  a, b: Boolean;
begin
  a := Self.Items.Contains(l.Item);
  b := Self.Items.Contains(r.Item);
  if a = b then Exit(0);
  if a then Exit(-1);
  Result := 1;
end;


procedure TBank._SetupMapObjects();
begin
  Self.Banks := TObjectArray.Create(
                  Map.Walker, MapObjects.GetByAction('Bank')
                ) +
                TObjectArray.Create(
                  Map.Walker, MapObjects.GetByAllActions(['Use', 'Collect'])
                );
  Self.Bankers := TEntityArray.Create(Map.Walker, NPCsJSON.GetByAction('Bank'));
end;


function TBank.Hover(const obj: TObject; walk: Boolean = True): Boolean;
begin
  if walk then
    Exit(obj.WalkHover());
  Result := obj.Hover();
end;

function TBank.Hover(const npc: TEntity; walk: Boolean = True): Boolean; overload;
begin
  if walk then
    Exit(npc.WalkHover());
  Result := npc.Hover();
end;

function TBank.Hover(walk: Boolean = True): Boolean; overload;
var
  obj: PRSObject;
  npc: PRSEntity;
  me: TPoint;
begin
  if Self.Banks.IsEmpty or Self.Bankers.IsEmpty then
    Self._SetupMapObjects();

  me := Map.Position();
  obj := @Self.Banks[Self.Banks.ClosestIndex(me)];
  npc := @Self.Bankers[Self.Bankers.ClosestIndex(me)];

  if obj^.DistanceTo(me) < npc^.DistanceTo(me) then
    Exit(Self.Hover(obj^, walk));
  Result := Self.Hover(npc^, walk);
end;


function TBank.Open(const obj: TObject; walk: Boolean = True): Boolean;
begin
  if walk then
    Result := obj.WalkInteract(['Bank B', 'Bank E', 'Bank G', 'Use B'])
  else
    Result := obj.Interact(['Bank B', 'Bank E', 'Bank G', 'Use B']);

  if not Result then
    if not MainScreen.IsUpText('Bank') or not ChooseOption.Select(['Bank B', 'Bank E']) then
      Exit;

  obj.Walker^.WaitMoving();
  Result := Self.WaitOpen(3000);
end;

function TBank.Open(const npc: TEntity; walk: Boolean = True): Boolean; overload;
begin
  if walk then
    Result := npc.WalkInteract(['Bank B', 'Bank E'])
  else
    Result := npc.Interact(['Bank B', 'Bank E']);

  if not Result and not MainScreen.Interact(['Bank B', 'Bank E']) then
    Exit;

  npc.Walker^.WaitMoving();
  Result := Self.WaitOpen(3000);
end;

function TBank.Open(walk: Boolean = True): Boolean; overload;
var
  obj: PRSObject;
  npc: PRSEntity;
  me: TPoint;
begin
  if MSInterface.IsOpen() then
  begin
    if Self.IsOpen() then
      Exit(True);
    MSInterface.Close(True);
  end;

  if Self.Banks.IsEmpty or Self.Bankers.IsEmpty then
    Self._SetupMapObjects();

  me := Map.Position();
  obj := @Self.Banks[Self.Banks.ClosestIndex(me)];
  npc := @Self.Bankers[Self.Bankers.ClosestIndex(me)];

  if obj^.DistanceTo(me) < npc^.DistanceTo(me) then
    Exit(Self.Open(obj^, walk));
  Result := Self.Open(npc^, walk);
end;


function TBank.IsSlotLocked(slot: Integer): Boolean;
var
  bounds: TBox;
  tpa: TPointArray;
begin
  bounds := Inventory.Slots.Box(slot);
  tpa := Target.FindColor($0000FF, 4, bounds.Expand(2, 1));
  tpa := tpa.ExcludeBox(bounds);
  Result := Length(tpa) >= 100;
end;


function TBank.GetLockedSlots(): TIntegerArray;
var
  slot: Integer;
begin
  for slot := Inventory.Slots.Boxes().Low to Inventory.Slots.Boxes().High do
    if Self.IsSlotLocked(slot) then
      Result += slot;
end;


function TBank.LockSlot(slot: Integer): Boolean;
begin
  if Self.IsSlotLocked(slot) then Exit(True);
  Result := Inventory.Slots.Interact(slot, 'Lock-slot') and SleepUntil(Self.IsSlotLocked(slot), Random(100, 300), 2*TICK);
end;


function TBank.UnlockSlot(slot: Integer): Boolean;
begin
  if not Self.IsSlotLocked(slot) then Exit(True);
  Result := Inventory.Slots.Interact(slot, 'Unlock-slot') and SleepUntil(not Self.IsSlotLocked(slot), Random(100, 300), 2*TICK);
end;

var

  Bank: TBank;
