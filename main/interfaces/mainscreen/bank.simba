(*
# Bank
Methods to interact with the bank interface:
```{figure} ../../images/bank_interface.png
```
*)

{$DEFINE WL_BANK_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type
(*
(EBankButton)=
## EBankButton enum
```pascal
EBankButton = enum(SETTINGS, TUTORIAL);
```
Enum representing the 2 top buttons of the {ref}`Bank` interface.
The tutorial button can be hidden.
*)
  EBankButton = enum(SETTINGS, TUTORIAL);

(*
(EBankSideButton)=
## EBankSideButton enum
```pascal
EBankSideButton = enum(SETTINGS, TUTORIAL);
```
Enum representing the side buttons of the {ref}`Bank` interface.
The incinerator button can be hidden and the potion storage might not be
unlocked.
*)
  EBankSideButton = enum(POTION_STORAGE, INCINERATOR);

(*
(EBankModeButton)=
## EBankModeButton enum
```pascal
EBankModeButton = enum(ARRANGEMENT, NOTES);
```
Enum representing the arrangement and notes buttons of the {ref}`Bank` interface.
*)
  EBankModeButton = enum(ARRANGEMENT, NOTES);

(*
(EBankMiscButton)=
## EBankMiscButton enum
```pascal
EBankMiscButton = enum(SEARCH, PLACEHOLDERS);
```
Enum representing the 2 misc buttons on the bottom of the {ref}`Bank` interface.
These buttons can shift places because you can enable/disable {ref}`EBankDepositButton` buttons.
*)
  EBankMiscButton = enum(SEARCH, PLACEHOLDERS);

(*
(EBankDepositButton)=
## EBankDepositButton enum
```pascal
EBankDepositButton = enum(CONTAINERS, INVENTORY, WORN);
```
Enum representing the 3 deposit buttons on the right bottom corner of the {ref}`Bank` interface.
These buttons are dynamic because they can be enabled/disabled and shift places.
*)
  EBankDepositButton = enum(CONTAINERS, INVENTORY, WORN);

(*
(EBankInteraction)=
## EBankInteraction enum
```pascal
EBankInteraction = enum(WITHDRAW, DEPOSIT);
```
Enum representing 2 core actions you can perform on the {ref}`Bank` interface.
*)
  EBankInteraction = enum(WITHDRAW, DEPOSIT);

(*
## TBankPosition type
Helper record to cache items positions on the {ref}`Bank` interface.
*)
  TBankPosition = record
    Tab, Scroll: Integer;
    Slot: TBox;
  end;

(*
(TBank)=
## TBank type
Record responsible to handle the {ref}`Bank` interface.
*)
  TBank = record
    Bounds: TBox;
    Slots: TSlotInterface;
    Items: TItemInterface;
    Title: TInterfaceTitle;
    Scroll: TScrollBar;

    Incenerator, PotionStorage, SlotsArea: TBox;

    Tabs, SlotBoxes: TBoxArray;

    Worn: TButton;
    Buttons: array [EBankButton] of TButton;
    SidebarButtons: array [EBankSideButton] of TButton;
    ModeButtons: array [EBankModeButton] of TButton;
    QuantityButtons: array [EItemQuantity] of TButton;
    MiscButtons: array [EBankMiscButton] of TButton;
    DepositButtons: array [EBankDepositButton] of TButton;

    JagexAccountAd: record
      NotNow, MoreInfo: TBox;
    end;

    ButtonsOffset, Depleted: Boolean;

    _Cache: record
      Quantity: Integer;
      Items: TStringMap<TBankPosition>;
    end;
    _IsOpenHelperBox: TBox;
    Banks: TObjectArray;
    Bankers: TEntityArray;
  end;

function TBank.FindItemBoundaries(): TBoxArray; forward;

function TBank.IsOpen(): Boolean; forward;

(*
## Bank.SetupInterface
```pascal
procedure TBank.SetupInterface();
```
Internal method used to setup the {ref}`TBank` coordinates.
This is automatically called for you on the {ref}`Bank variable`.
*)
procedure TBank.SetupInterface();
const
  BUTTON_COLORS: array of TColorTolerance = [
    [$0F1043, 0, EColorSpace.RGB, [1,1,1]],
    [$23269F, 0.227, EColorSpace.RGB, [1,1,1]]
  ];
var
  i: Integer;
begin
  Self.Bounds := MSInterface.CreateBounds([0, 2, 0, -1], 488, 800);

  Self.Scroll.Area.X1 := Self.Bounds.X1 + 5;
  Self.Scroll.Area.Y1 := Self.Bounds.Y1 + 77;
  Self.Scroll.Area.X2 := Self.Bounds.X2 - 22;
  Self.Scroll.Area.Y2 := Self.Bounds.Y2 - 44;

  Self.Scroll.Setup();
  Self.Title.Setup(Self.Bounds);

  Self.Tabs := TBoxArray.Create(Self.Bounds.TopLeft.Offset(47, 42), 10, 1, 35, 28, [5, 0]);
  Self.SlotBoxes :=
    TBoxArray.Create(
      Self.Bounds.TopLeft.Offset(57, 77), 8,
      (Self.Bounds.Height - 135) div 35, 31, 31, [17, 5]
    );

  Self.SlotsArea.X1 := Self.Bounds.X1 + 57;
  Self.SlotsArea.Y1 := Self.Bounds.Y1 + 77;
  Self.SlotsArea.X2 := Self.Bounds.X2 - 63;
  Self.SlotsArea.Y2 := Self.Bounds.Y2 - 44;

  with Self.SlotsArea.Center.Offset(0,-1) do
    Self.JagexAccountAd.NotNow := [X-120, Y+43, X-49, Y+66];

  with Self.SlotsArea.Center.Offset(0,-1) do
    Self.JagexAccountAd.MoreInfo := [X+39, Y+43, X+108, Y+66];

  Self.Incenerator.X1 := Self.Bounds.X1 + 5;
  Self.Incenerator.Y1 := Self.Bounds.Y2 - 113;
  Self.Incenerator.X2 := Self.Bounds.X1 + 51;
  Self.Incenerator.Y2 := Self.Bounds.Y2 - 44;

  Self.PotionStorage.X1 := Self.Bounds.X1 + 8;
  Self.PotionStorage.Y1 := Self.Bounds.Y2 - 156;
  Self.PotionStorage.X2 := Self.Bounds.X1 + 51;
  Self.PotionStorage.Y2 := Self.Bounds.Y2 - 118;

  Self.Slots.Setup('Bank.Slots', Self.SlotBoxes, @Self.FindItemBoundaries);
  Self.Items.Setup('Bank.Items', @Self.Slots, [0, 1], @Self.IsOpen);

  Self._IsOpenHelperBox.X1 := Self.Bounds.X1 + 235;
  Self._IsOpenHelperBox.Y1 := Self.Bounds.Y2 - 42;
  Self._IsOpenHelperBox.X2 := Self.Bounds.X2 - 156;
  Self._IsOpenHelperBox.Y2 := Self.Bounds.Y2 - 26;

  with Self.Bounds do
  begin
    Self.Worn := new TButton([X2-40, Y1+38, X2-7, Y1+71], BUTTON_COLORS);

    Self.Buttons[EBankButton.SETTINGS] := new TButton([X1+34, Y1+7, X1+54, Y1+27]);
    Self.Buttons[EBankButton.TUTORIAL] := new TButton([X1+58, Y1+7, X1+78, Y1+27]);

    Self.SidebarButtons[EBankSideButton.POTION_STORAGE] :=
      new TButton([X1+8, Y2-121, X1+41, Y2-88], BUTTON_COLORS);
    Self.SidebarButtons[EBankSideButton.INCINERATOR] :=
      new TButton([X1+8, Y2-85, X1+41, Y2-52]);

    Self.ModeButtons[EBankModeButton.ARRANGEMENT] :=
      new TButton([X1, Y2-41, X1+33, Y2-8]);
    Self.ModeButtons[EBankModeButton.NOTES] :=
      new TButton([X1, Y2-41, X1+33, Y2-8], BUTTON_COLORS);

    for i := 0 to 4 do
      Self.QuantityButtons[i] := new TButton([X1, Y2-41, X1+33, Y2-8], BUTTON_COLORS);
    for i := 0 to 1 do
      Self.MiscButtons[i] := new TButton([X1, Y2-41, X1+33, Y2-8], BUTTON_COLORS);
    for i := 0 to 2 do
      Self.DepositButtons[i] := new TButton([X1, Y2-41, X1+33, Y2-8]);
  end;

  Self.ButtonsOffset := False;
end;

function TBank._GetButtonDividers(): TPointArray;
var
  tpa, dividers: TPointArray;
  atpa: T2DPointArray;

begin
  with Self.Bounds do
    tpa := Target.FindColor($232B2E, 1, [X1+6, Y2-43, X2-6, Y2-6]);
  if tpa.IsEmpty then
    Exit;
  atpa := tpa.Cluster(1.5).ExtractDimensions(0, 0, 4, 30);
  if Length(atpa) <> 3 then
    Exit;

  for tpa in atpa do
    dividers += tpa.First;

  if dividers[0].DistanceTo(dividers[1]) <> 191 then
    Exit;
  if dividers[0].DistanceTo(dividers[2]) <> 284 then
    Exit;
  Result := dividers;
end;

(*
## Bank.UpdateButtons
```pascal
procedure TBank.UpdateButtons(const tpa: TPointArray);
```
Internal helper method used to update the buttons coordinates.

All the bank's bottom buttons shift slightly on the X axis depending on how many dynamic buttons are visible.

```{note}
This is automatically called for you with {ref}`Bank.IsOpen`.
```
*)
procedure TBank.UpdateButtons(const tpa: TPointArray);
var
  i: Integer;
  boxes: TBoxArray;
begin
  if Self.ButtonsOffset then
    Exit;

  Self.ModeButtons[EBankModeButton.ARRANGEMENT].Bounds.X1 := tpa[0].X - 75;
  Self.ModeButtons[EBankModeButton.ARRANGEMENT].Bounds.X2 := tpa[0].X - 42;
  Self.ModeButtons[EBankModeButton.NOTES].Bounds.X1 := tpa[0].X - 38;
  Self.ModeButtons[EBankModeButton.NOTES].Bounds.X2 := tpa[0].X - 5;

  for i := 0 to 4 do
  begin
    Self.QuantityButtons[i].Bounds.X1 := tpa[0].X + 5 + i*37;
    Self.QuantityButtons[i].Bounds.X2 := tpa[0].X + 38 + i*37;
  end;

  Self.MiscButtons[EBankMiscButton.SEARCH].Bounds.X1 := tpa[1].X + 5;
  Self.MiscButtons[EBankMiscButton.SEARCH].Bounds.X2 := tpa[1].X + 48;
  Self.MiscButtons[EBankMiscButton.PLACEHOLDERS].Bounds.X1 := tpa[1].X + 55;
  Self.MiscButtons[EBankMiscButton.PLACEHOLDERS].Bounds.X2 := tpa[1].X + 88;

  boxes := TBoxArray.Create([tpa[2].X+5, Self.Bounds.Y2-41], 3, 1, 33, 33, [4,0]);
  for i := High(boxes) downto 0 do
    if not Target.HasColor($516472, 0, 1, boxes[i]) then
      Delete(boxes, i, 1);

  case Length(boxes) of
    0: raise GetDebugLn('Bank', 'Something went wrong, couldn''f find any bank deposit button.');
    1:
    begin
      Self.DepositButtons[EBankDepositButton.WORN].Bounds := boxes.Last;
      Self.DepositButtons[EBankDepositButton.INVENTORY] := nil;
      Self.DepositButtons[EBankDepositButton.CONTAINERS] := nil;
    end;
    2:
    begin
      Self.DepositButtons[EBankDepositButton.WORN].Bounds := boxes.Last;
      if Target.HasColor([$0F3669, 2.705, EColorSpace.HSV, [1.943, 0.722, 0.336]], 4, boxes[0]) then
      begin
        Self.DepositButtons[EBankDepositButton.INVENTORY].Bounds := boxes[0];
        Self.DepositButtons[EBankDepositButton.CONTAINERS] := nil;
      end
      else
      begin
        Self.DepositButtons[EBankDepositButton.INVENTORY] := nil;
        Self.DepositButtons[EBankDepositButton.CONTAINERS].Bounds := boxes[0];
      end;
    end;
    3: for i := 0 to High(boxes) do
        Self.DepositButtons[i].Bounds := boxes[i];
  end;

  Self.ButtonsOffset := True;
end;


(*
## Bank.HasJagexAccountAd
```pascal
function TBank.HasJagexAccountAd(): Boolean;
```
Returns true if the bank has the jagex account ad pop-up.
This only ever shows up on non jagex accounts and tries to buy you in with bank space.

Example:
```pascal
WriteLn Bank.HasJagexAccountAd();
```
*)
function TBank.HasJagexAccountAd(): Boolean;
begin
  Result := (Target.CountColor($0000FF, 0, Self.JagexAccountAd.NotNow) = 98) and
            (Target.CountColor($0DC10D, 0, Self.JagexAccountAd.MoreInfo) = 112);
end;

(*
## Bank.CloseJagexAccountAd
```pascal
function TBank.CloseJagexAccountAd(): Boolean;
```
Attempts to close the jagex account advert. Returns true on success.

Example:
```pascal
WriteLn Bank.CloseJagexAccountAd();
```
*)
function TBank.CloseJagexAccountAd(): Boolean;
begin
  Mouse.Click(Self.JagexAccountAd.NotNow, EMouseButton.LEFT);
  Result := SleepUntil(not Self.HasJagexAccountAd(), 50, 600);
end;


(*
## Bank.FindItemBoundaries
```pascal
function TBank.FindItemBoundaries(): TBoxArray;
```
Finds item boundaries and returns them as a TBoxArray.

You have 2 ways of getting the bank slots, a static one:
```pascal
ShowOnTarget(Bank.SlotBoxes);
```
```{figure} ../../images/bank_static_slots.png
The bank static slots.
```

And a dynamic one:
```pascal
ShowOnTarget(Self.FindItemBoundaries());
```
```{figure} ../../images/bank_item_boundaries.png
The bank "dynamic" slots.
```

There are use cases for both, internally, `Bank.FindItemBoundaries` is usually used.
*)
function TBank.FindItemBoundaries(): TBoxArray;
var
  tpa, final: TPointArray;
  atpa: T2DPointArray;
  b: TBox;
  stack: EStack;
begin
  final := Target.FindColor(ITEM_BORDER, 1, Self.SlotsArea);
  if final.IsEmpty then
    Exit;

  for stack := Low(EStack) to High(EStack) do
  begin
    tpa := Target.FindColor(stack.Color, 0, Self.SlotsArea);
    if tpa <> [] then
      final += tpa;
  end;

  atpa := final.Cluster(200, 3);

  for tpa in atpa do
  begin
    b := tpa.Bounds();
    if b.Height <= 5 then Continue;

    Result += TBoxArray.Create([Self.SlotsArea.X1, b.Y1], 8, 1, 31, Min(Self.SlotsArea.Y2-b.Y1, 31), [17, 1]);
  end;
end;


(*
## Bank.IsOpen
```pascal
function TBank.IsOpen(): Boolean;
```
Returns true if the bank is open.

Example:
```pascal
WriteLn Bank.IsOpen();
```
*)
function TBank.IsOpen(): Boolean;
var
  tpa: TPointArray;
  title: String;
begin
  if BankPin.IsOpen() then
  begin
    if not BankPin.WaitLoading(3000) then
      raise GetDebugLn('BankPin', 'Bank pin buttons don''t seem to have loaded in 3 seconds.');

    if not BankPin.Enter(Profiles.GetPin()) then
      raise GetDebugLn('BankPin', 'Failed to enter bank pin.');
  end;

  tpa := Self._GetButtonDividers();
  Result := (Length(tpa) = 3);

  if not Result then
  begin
    title := Self.Title.GetTitle();
    Result := title in ['Bank', 'Tab ', 'Equip'];
  end;

  if Result then
  begin
    if tpa.IsEmpty then
    begin
      if not Self.HasJagexAccountAd() then Exit;
      if not Self.CloseJagexAccountAd() then Exit;
      Exit(Self.IsOpen()); //ad closed, restart
    end;

    Self.UpdateButtons(tpa);
  end;
end;

(*
## Bank.WaitOpen
```pascal
function TBank.WaitOpen(time: Integer; interval: Integer = -1): Boolean;
```
Returns true if the bank is open within `time` milliseconds.

## Example:
```pascal
WriteLn Bank.WaitOpen();
```
*)
function TBank.WaitOpen(time: Integer; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;

(*
## Bank.Close
```pascal
function TBank.Close(escape: Boolean): Boolean;
function TBank.Close(escapeProbability: Single = 0): Boolean; overload;
```
Closes the bank, depending on `escape` or `escapeProbability the function will
either click the button or press escape key.

Example:
```pascal
WriteLn Bank.Close();
```
*)
function TBank.Close(escape: Boolean): Boolean;
begin
  Result := Self.Title.Close(escape);
end;

function TBank.Close(escapeProbability: Single = -1): Boolean; overload;
begin
  Result := Self.Title.Close(escapeProbability);
end;

(*
## Bank.Tabs
You can access the bank tabs coordinates via the `TBank.Tabs` variable.

Example:
```pascal
ShowOnTarget(Bank.Tabs);
```
```{figure} ../../images/bank_tabs.png
The bank interface.
```
*)

(*
### Bank.CountTabs
```pascal
function TBank.CountTabs: Integer;
```
Counts the existing bank tabs.

Example:
```pascal
WriteLn Bank.CountTabs();
```
*)
function TBank.CountTabs(): Integer;
var
  i: Integer;
begin
  for i := 9 downto 1 do
    if Target.HasColor(ITEM_BORDER, 0, 1, Self.Tabs[i]) then
      Exit(i);
end;

(*
### Bank.GetCurrentTab
```pascal
function TBank.GetCurrentTab(): Integer;
```
Get the current active bank tab.

Example:
```pascal
tab := Bank.GetCurrentTab();
WritLn tab;
ShowOnTarget(Bank.Tabs[tab]);
```
*)
function TBank.GetCurrentTab(): Integer;
var
  i: Integer;
begin
  for i := 0 to 9 do
    with Self.Tabs[i] do
      if not Target.HasColor($516471, 0, 1, [X1+4, Y2+3, X2-4, Y2+5]) then
        Exit(i);
end;

(*
### Bank.OpenTab
```pascal
function TBank.OpenTab(tab: Integer): Boolean;
```
Opens the specified bank tab.

Example:
```pascal
WriteLn Bank.OpenTab(0);
```
*)
function TBank.OpenTab(tab: Integer): Boolean;
  function _TabChanged(tab: Integer): Boolean;
  begin
    if tab <> 0 then
      Exit(tab = Self.GetCurrentTab());

    //when search is open tab 0 is returned.
    Result := not Chat.FindQuery('Show items');
  end;

begin
  if not Self.IsOpen() then Exit;

  if tab = Self.GetCurrentTab() then
  begin
    if tab <> 0 then Exit(True);
    if not Chat.FindQuery('Show items') then Exit(True);
  end;

  Mouse.Click(Self.Tabs[tab], EMouseButton.LEFT);
  Result := SleepUntil(_TabChanged(tab), RandomMode(100, 50, 1500), 600);
  Sleep(200, 300);
end;


(*
## Bank.SetQuantity
```pascal
function TBank.SetQuantity(quantity: EItemQuantity; amount: Integer = 0): Boolean;
```
Attempts to set the bank quantity to `quantity`, returns true if we succeed.

Example:
```pascal
WriteLn Bank.SetQuantity(EItemQuantity.FIVE);
```
*)
function TBank.SetQuantity(quantity: EItemQuantity; amount: Integer = 0): Boolean;
begin
  if Self.QuantityButtons[quantity].Enabled then
    Exit(True);
  Result := Self.QuantityButtons[quantity].Enabled[True];

  if Result or (quantity <> EItemQuantity.CUSTOM) then
    Exit;

  if Chat.AnswerQuery('Enter amount', ToString(amount), RandomLeft(1400, 2400)) then
  begin
    Self._Cache.Quantity := amount;
    Result := Self.QuantityButtons[quantity].Enabled;
  end;
end;


(*
