(*
## Bank.DepositDifferent
```pascal
function TBank.DepositDifferent(items: TItemArray; useQuantityButton: Boolean = True): Boolean;
```
Attempts to deposit all items found that are not the `items` passed as a paremeter.

Example:
```pascal
WriteLn Bank.DepositDifferent(['Abyssal whip', 'Bandos chestplate', 'Bandos tassets']);
```
*)
function TBank.DepositDifferent(items: TItemArray; useQuantityButton: Boolean = True): Boolean;
var
  slots, deposited: TIntegerArray;
  slot, hash: Integer;
begin
  slots := Inventory.Items.FindDifferent(items);
  if slots.IsEmpty then
    Exit(True);

  for slot in slots do
  begin
    hash := Inventory.Items._GetHash(slot);
    if deposited.Contains(hash) then
      Continue;
    deposited += hash;
    if not Self._InteractionHelper(EBankInteraction.DEPOSIT, Inventory.Slots.Box(slot), QUANTITY_ALL, useQuantityButton) then
      Exit;
  end;
  Result := True;
end;


(*
## Bank.IsDepleted
```pascal
function TBank.IsDepleted(item: TBankItem; attempts: Integer = 3): Boolean;
```
Checks if a item is depleted in the bank.
This returns true if the `item.Item` quantity in the bank is less than `item.Quantity`.

It also sets the `Bank.Depleted` variable to true which you can use in your script for whatever you see fit.

Example:
```pascal
WriteLn Bank.IsDepleted(item);
```
*)
function TBank.IsDepleted(item: TBankItem; attempts: Integer = 3): Boolean;
var
  data: TBankPosition;
begin
  if attempts = 0 then Exit;

  if Self.Find(item.Item, data) then
  begin
    if Max(1, TItem.ReadStack(data.Slot)) < Min(item.Quantity, 28) then
    begin
      Self.Depleted := Self.IsOpen();
      Exit(True);
    end;

    Exit(False);
  end;

  Result := Self.IsDepleted(item, attempts-1);

  Self.Depleted := Result and Self.IsOpen();
end;


(*
## Bank.PrioritySort
```pascal
function TBank.PrioritySort(constref l, r: TBankItem): Int32;
```
Sorting function for {ref}`TBankItemArray`.

In a nutshell, this can be used to sort a `TBankitemArray` by prioritizing
what's currently visitble.

Do keep in mind that this uses {ref}`ItemFinder` to work and may be a bad idea
to use in huge arrays.

Example:
```pascal
bankItems := Sorted(bankItems, @Bank.PrioritySort);
```
*)
function TBank.PrioritySort(constref l, r: TBankItem): Int32;
var
  a, b: Boolean;
begin
  a := Self.Items.Contains(l.Item);
  b := Self.Items.Contains(r.Item);
  if a = b then Exit(0);
  if a then Exit(-1);
  Result := 1;
end;


procedure TBank._SetupMapObjects();
begin
  Self.Banks := TObjectArray.Create(
                  Map.Walker, MapObjects.GetByAction('Bank')
                ) +
                TObjectArray.Create(
                  Map.Walker, MapObjects.GetByAllActions(['Use', 'Collect'])
                );
  Self.Bankers := TEntityArray.Create(Map.Walker, NPCsJSON.GetByAction('Bank'));
end;

(*
## Bank.Hover
```pascal
function TBank.Hover(const obj: TObject; walk: Boolean = True): Boolean;
function TBank.Hover(const npc: TEntity; walk: Boolean = True): Boolean; overload;
function TBank.Hover(walk: Boolean = True): Boolean; overload;
```
Hovers the closest bank that WaspLib is aware of.

This assumes that {ref}`Map` is being used and setup.
It's possible to use this with other systems but you need to configure it all
manually.

It will always hover the closest bank {ref}`TObject` or {ref}`TEntity` on your
loaded map.

If you are too far, it will attempt to walk closer to it.
*)
function TBank.Hover(const obj: TObject; walk: Boolean = True): Boolean;
begin
  if walk then
    Exit(obj.WalkHover());
  Result := obj.Hover();
end;

function TBank.Hover(const npc: TEntity; walk: Boolean = True): Boolean; overload;
begin
  if walk then
    Exit(npc.WalkHover());
  Result := npc.Hover();
end;

function TBank.Hover(walk: Boolean = True): Boolean; overload;
var
  obj: PRSObject;
  npc: PRSEntity;
  me: TPoint;
begin
  if Self.Banks.IsEmpty or Self.Bankers.IsEmpty then
    Self._SetupMapObjects();

  me := Map.Position();
  obj := @Self.Banks[Self.Banks.ClosestIndex(me)];
  npc := @Self.Bankers[Self.Bankers.ClosestIndex(me)];

  if obj^.DistanceTo(me) < npc^.DistanceTo(me) then
    Exit(Self.Hover(obj^, walk));
  Result := Self.Hover(npc^, walk);
end;

(*
## Bank.Open
```pascal
function TBank.Open(const obj: TObject; walk: Boolean = True): Boolean;
function TBank.Open(const npc: TEntity; walk: Boolean = True): Boolean; overload;
function TBank.Open(walk: Boolean = True): Boolean; overload;
```
Opens the bank for you.
This assumes that {ref}`Map` is being used and setup.

It's possible to use this with other systems but you need to configure it all
manually.

It will always use the closest bank {ref}`RSObject` or {ref}`RSNPC` WaspLib is
aware of on your loaded map.

If you are too far, it will attempt to walk closer to it by default unless you
set the `walk` parameter to `False`.

Example:
```pascal
{$I WaspLib/main.simba}
begin
  Map.Setup([EChunk.VARROCK]);
  Bank.Open();
end.
```
```{figure} ../../images/bankopen.gif
```
*)
function TBank.Open(const obj: TObject; walk: Boolean = True): Boolean;
begin
  if walk then
    Result := obj.WalkInteract(['Bank B', 'Bank E', 'Bank G', 'Use B'])
  else
    Result := obj.Interact(['Bank B', 'Bank E', 'Bank G', 'Use B']);

  if not Result then
    if not MainScreen.IsUpText('Bank') or not ChooseOption.Select(['Bank B', 'Bank E']) then
      Exit;

  obj.Walker^.WaitMoving();
  Result := Self.WaitOpen(3000);
end;

function TBank.Open(const npc: TEntity; walk: Boolean = True): Boolean; overload;
begin
  if walk then
    Result := npc.WalkInteract(['Bank B', 'Bank E'])
  else
    Result := npc.Interact(['Bank B', 'Bank E']);

  if not Result and not MainScreen.Interact(['Bank B', 'Bank E']) then
    Exit;

  npc.Walker^.WaitMoving();
  Result := Self.WaitOpen(3000);
end;

function TBank.Open(walk: Boolean = True): Boolean; overload;
var
  obj: PRSObject;
  npc: PRSEntity;
  me: TPoint;
begin
  if MSInterface.IsOpen() then
  begin
    if Self.IsOpen() then
      Exit(True);
    MSInterface.Close(True);
  end;

  if Self.Banks.IsEmpty or Self.Bankers.IsEmpty then
    Self._SetupMapObjects();

  me := Map.Position();
  obj := @Self.Banks[Self.Banks.ClosestIndex(me)];
  npc := @Self.Bankers[Self.Bankers.ClosestIndex(me)];

  if obj^.DistanceTo(me) < npc^.DistanceTo(me) then
    Exit(Self.Open(obj^, walk));
  Result := Self.Open(npc^, walk);
end;

(*
## Bank.IsSlotLocked
```pascal
function TBank.IsSlotLocked(slot: Integer): Boolean;
```
Checks if an inventory slot is locked.
This assumes that the bank interface is open as locked slots are only visible with the bank open.

Example:
```pascal
{$I WaspLib/main.simba}
begin
  if Bank.IsSlotLocked(0) then
    WriteLn('Slot 0 is locked');
end.
```
*)
function TBank.IsSlotLocked(slot: Integer): Boolean;
var
  bounds: TBox;
  tpa: TPointArray;
begin
  bounds := Inventory.Slots.Box(slot);
  tpa := Target.FindColor($0000FF, 4, bounds.Expand(2, 1));
  tpa := tpa.ExcludeBox(bounds);
  Result := Length(tpa) >= 100;
end;

(*
## Bank.GetLockedSlots
```pascal
function TBank.GetLockedSlots(): TIntegerArray;
```
Returns all inventory slots that are locked.

Example:
```pascal
{$I WaspLib/main.simba}
begin
  WriteLn(Bank.GetLockedSlots());
end.
```
*)
function TBank.GetLockedSlots(): TIntegerArray;
var
  slot: Integer;
begin
  for slot := Inventory.Slots.Boxes().Low to Inventory.Slots.Boxes().High do
    if Self.IsSlotLocked(slot) then
      Result += slot;
end;

(*
## Bank.LockSlot
```pascal
function TBank.LockSlot(slot: Integer): Boolean;
```
Locks an inventory slot and returns confirmation the slot was locked.

Example:
```pascal
{$I WaspLib/main.simba}
begin
  if Bank.LockSlot(0) then
    WriteLn('Slot 0 has been locked');
end.
```
*)
function TBank.LockSlot(slot: Integer): Boolean;
begin
  if Self.IsSlotLocked(slot) then Exit(True);
  Result := Inventory.Slots.Interact(slot, 'Lock-slot') and SleepUntil(Self.IsSlotLocked(slot), Random(100, 300), 2*TICK);
end;

(*
## Bank.UnlockSlot
```pascal
function TBank.UnlockSlot(slot: Integer): Boolean;
```
Unlocks an inventory slot and returns confirmation the slot was unlocked.

Example:
```pascal
{$I WaspLib/main.simba}
begin
  if Bank.UnlockSlot(0) then
    WriteLn('Slot 0 has been unlocked');
end.
```
*)
function TBank.UnlockSlot(slot: Integer): Boolean;
begin
  if not Self.IsSlotLocked(slot) then Exit(True);
  Result := Inventory.Slots.Interact(slot, 'Unlock-slot') and SleepUntil(not Self.IsSlotLocked(slot), Random(100, 300), 2*TICK);
end;

var
(*
## Bank variable
Global {ref}`TBank` variable.
*)
  Bank: TBank;
