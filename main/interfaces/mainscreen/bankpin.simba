

{$DEFINE WL_BANKPIN_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TBankPin = record
    Bounds: TBox;
    Buttons: TBoxArray;
  end;


procedure TBankPin.SetupInterface();
begin
  case Client.Mode of
    EMode.FIXED:
      Self.Bounds := MSInterface.CreateBounds([0, 11, 0, 0], 488, 305);
    EMode.RESIZABLE, EMode.MODERN_COMPACT, EMode.MODERN_WIDE:
      Self.Bounds := MSInterface.CreateBounds([0, 10, 0, 0], 488, 305);
  end;

  Self.Buttons := TBoxArray.Create(Self.Bounds.TopLeft.Offset(21,83), 3, 3, 63, 63, [31, 9]);
  Self.Buttons.Insert(Self.Buttons[2].Offset([84, 0]), 3);
end;


function TBankPin.IsOpen(): Boolean;
begin
  Result := Target.HasColor($060D56, 10, 3400, Self.Buttons[0]);
end;


function TBankPin.WaitOpen(time: Integer = 600; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;



function TBankPin.IsLoading(): Boolean;
begin
  Result := not Target.HasColor($007FFF, 0, 1, Self.Buttons[0]);
end;


function TBankPin.WaitLoading(time: Integer = 600; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(not Self.IsLoading(), interval, time);
end;



function TBankPin.FindDigit(digit: Char): Integer;
var
  i: Integer;
  hovering: Integer = -1;
begin
  for i := 0 to High(Self.Buttons) do
  begin
    if Self.Buttons[i].Contains(Mouse.Position) then
    begin
      hovering := i;
      Continue;
    end;

    if OCR.Locate(Self.Buttons[i], digit, [$007FFF], 0, Fonts.BOLD) > 0.95 then
      Exit(i);
  end;

  if hovering > -1 then Exit(hovering);
  Result := -1;
end;


function TBankPin.ClickDigit(digit: Char): Boolean;
var
  i: Integer;
begin
  i := Self.FindDigit(digit);
  if i < 0 then Exit;
  Mouse.Click(Self.Buttons[i], EMouseButton.LEFT);
  Result := True;
end;



function TBankPin.GetDigitIndex(): Integer;
const
  DIGITS: TStringArray = ['FIRST', 'SECOND', 'THIRD', 'FOURTH'];
var
  i: Integer;
begin
  for i := 0 to High(DIGITS) do
    if OCR.Locate(Self.Bounds, DIGITS[i], [$FFFFFF], 0, Fonts.BOLD) > 0.95 then
      Exit(i+1);
end;


function TBankPin.Enter(pin: String; attempts: Integer = 3): Boolean;

  function _IsUnlocked(): Boolean;
  begin
    if Self.IsOpen() then
      Exit;
    Result := not Chat.Options.ToString().ContainsAny(['try again', 'forgotten your PIN', 'PIN incorrectly several']);
  end;

var
  i, idx: Integer;
  digit: Char;
  chatCache: String;
begin
  if attempts <= 0 then Exit;

  for i := 0 to 3 do
  begin
    idx := Self.GetDigitIndex();
    if idx = 0 then Break;

    digit := pin[idx];
    if not Self.ClickDigit(digit) then Break;
    Biometrics.Sleep(200, 1500, ERandomDir.LEFT);
    SleepUntil((idx <> Self.GetDigitIndex()) and not Self.IsLoading(), 100, 5000);
  end;

  chatCache := Chat.Options.ToString();
  if 'try again' in chatCache then
  begin
    Chat.Continue();
    Exit(Self.Enter(pin, Dec(attempts)));
  end;

  if 'forgotten your PIN' in chatCache then
  begin
    SleepUntil(not ('forgotten your PIN' in Chat.Options.ToString()), 300, 20000);
    Exit(Self.Enter(pin, Dec(attempts)));
  end;

  if 'PIN incorrectly several' in chatCache then
    raise GetDebugLn('BankPin', 'Failed to enter the bank pin several times. Check that the pin is correct.');

  Result := SleepUntil(_IsUnlocked(), 300, 3000) or Self.Enter(pin, Dec(attempts));
end;

var

  BankPin: TBankPin;
