

{$DEFINE WL_LAMP_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TLamp = record
    Title: TInterfaceTitle;
    Bounds, ConfirmBounds: TBox;
    Slots: TButtonArray;
  end;

function TLamp.IsOpen(): Boolean; forward;


procedure TLamp.SetupInterface();
const
  SKILL_ORDER: array [0..23] of ESkill = [
    ESkill.ATTACK,ESkill.STRENGTH,ESkill.RANGED,ESkill.MAGIC,ESkill.DEFENCE, ESkill.SAILING,
    ESkill.HITPOINTS,ESkill.PRAYER,ESkill.AGILITY,ESkill.HERBLORE,ESkill.THIEVING,
    ESkill.CRAFTING,ESkill.RUNECRAFTING,ESkill.SLAYER,ESkill.FARMING,ESkill.MINING,
    ESkill.SMITHING,ESkill.FISHING,ESkill.COOKING,ESkill.FIREMAKING,ESkill.WOODCUTTING,
    ESkill.FLETCHING,ESkill.CONSTRUCTION,ESkill.HUNTER
  ];
var
  i: Integer;
  tba: TBoxArray;
begin
  Self.Bounds := MSInterface.CreateBounds([0,0,0,0], 300, 260);

  Self.Title.Bounds.X1 := Self.Bounds.X1+8;
  Self.Title.Bounds.Y1 := Self.Bounds.Y1+38;
  Self.Title.Bounds.X2 := Self.Bounds.X2-8;
  Self.Title.Bounds.Y2 := Self.Title.Bounds.Y1 + 22;

  Self.Title.CloseButton.X1 := Self.Bounds.X2+69;
  Self.Title.CloseButton.Y1 := Self.Bounds.Y1-20;
  Self.Title.CloseButton.X2 := Self.Bounds.X2+92;
  Self.Title.CloseButton.Y2 := Self.Bounds.Y1+2;

  Self.Title.TitleColor := $999999;
  Self.Title.IsOpen := @Self.IsOpen;

  with Self.Bounds.TopLeft do
    tba := TBoxArray.Create([X+41,Y+71], 6, 1, 30, 30, [8,7]) +
           TBoxArray.Create([X+42,Y+108], 6, 3, 30, 30, [7,7]);

  for i := 3 to 5 do
    tba[i] := tba[i].Offset([-2-(i-3),0]);

  SetLength(Self.Slots, Length(tba));

  for i := 0 to High(tba) do
    Self.Slots[SKILL_ORDER[i]] := new TButton(
      tba[i], [[$0F1043, 0, EColorSpace.RGB, [1,1,1]],[$23269F, 0.227, EColorSpace.RGB, [1,1,1]]]
    );

  Self.ConfirmBounds.X1 := Self.Bounds.X1 + 81;
  Self.ConfirmBounds.Y1 := Self.Bounds.Y2 - 35;
  Self.ConfirmBounds.X2 := Self.Bounds.X2 - 81;
  Self.ConfirmBounds.Y2 := Self.Bounds.Y2 - 13;
end;


function TLamp.IsOpen(): Boolean;
begin
  Result := Self.Title._IsOpen() and
            Target.HasColor($999999, 0, 819, Self.Title.Bounds);
end;


function TLamp.WaitOpen(time: Integer; interval: Integer = -1): Boolean;
begin
  Result := Self.Title.WaitOpen(time, interval);
end;



function TLamp.Open(item: TItem = 'Lamp'): Boolean;
begin
  if Self.IsOpen() then
    Exit(True);

  if Inventory.Items.Interact(item, 'Rub') then
    Result := Self.WaitOpen(1200);
end;



function TLamp.Close(escape: Boolean): Boolean;
begin
  Result := Self.Title.Close(escape);
end;

function TLamp.Close(escapeProbability: Single = -1): Boolean; overload;
begin
  Result := Self.Title.Close(escapeProbability);
end;



function TLamp.GetSelected(): ESkill;
begin
  for Result := Low(ESkill) to High(ESkill)-1 do
    if Self.Slots[Result].Enabled then
      Exit;
  Result := ESkill.TOTAL;
end;


function TLamp.Enable(skill: ESkill): Boolean;
begin
  Result := Self.Slots[skill].Enabled[True];
end;


function TLamp.Confirm(): Boolean;
begin
  if not Self.IsOpen() then
    Exit;
  Mouse.Click(Self.ConfirmBounds, EMouseButton.LEFT);
  Result := SleepUntil(not Self.IsOpen(), 50, 600);
end;


function TLamp.Select(skill: ESkill): Boolean;
begin
  if not Self.Open() then
    Exit;
  Result := Self.Slots[skill].Enabled[True] and Self.Confirm();
end;

var

  Lamp: TLamp;
