

{$DEFINE WL_GRANDEXCHANGE_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  EGEOfferStatus = enum(NONE, PROGRESSING, COMPLETED, ABORTED);


  EGESlotType = enum(EMPTY, SELL, BUY, UNAVAILABLE);


  TGrandExchangeSlot = record
    Typ: EGESlotType;
    Bounds, Header, BuyButton, SellButton: TBox;
    ItemBox, ItemNameBox, ValueBox, StatusBox: TBox;
  end;

  TGrandExchangeSlotArray = array of TGrandExchangeSlot;

procedure TGrandExchangeSlot._Setup(bounds: TBox);
begin
  Self.Bounds := bounds;
  with bounds do
  begin
    Self.Header.X1 := X1+3;
    Self.Header.Y1 := Y1+4;
    Self.Header.X2 := X2-3;
    Self.Header.Y2 := Y1+22;

    Self.BuyButton.X1 := X1+6;
    Self.BuyButton.Y1 := Y1+43;
    Self.BuyButton.X2 := Self.BuyButton.X1+46;
    Self.BuyButton.Y2 := Self.BuyButton.Y1+45;

    Self.SellButton := Self.BuyButton.Offset([56,0]);

    Self.ItemBox.X1 := X1+6;
    Self.ItemBox.Y1 := Y1+34;
    Self.ItemBox.X2 := Self.ItemBox.X1+35;
    Self.ItemBox.Y2 := Self.ItemBox.Y1+31;

    Self.ItemNameBox.X1 := X1+44;
    Self.ItemNameBox.Y1 := Y1+33;
    Self.ItemNameBox.X2 := X2-3;
    Self.ItemNameBox.Y2 := Self.ItemNameBox.Y1+36;

    Self.StatusBox.X1 := X1+4;
    Self.StatusBox.Y1 := Y2-35;
    Self.StatusBox.X2 := X2-4;
    Self.StatusBox.Y2 := Y2-21;

    Self.ValueBox.X1 := X1+4;
    Self.ValueBox.Y1 := Y2-20;
    Self.ValueBox.X2 := X2-4;
    Self.ValueBox.Y2 := Y2-4;
  end;
end;


function TGrandExchangeSlot.GetType(): EGESlotType;
var
  count: Integer;
begin
  //no need for ocr, color count is lighter and should work fine.
  count := Target.CountColor(TFonts.ORANGE, 0, Self.Header);
  case count of
    154:
        if Target.HasColor($6082AB, 0, 1, Self.BuyButton) then
          Result := EGESlotType.UNAVAILABLE
        else
          Result := EGESlotType.EMPTY;
    90:  Result := EGESlotType.SELL;
    101: Result := EGESlotType.BUY;
  end;

  Self.Typ := Result;
end;



function TGrandExchangeSlot.Contains(item: TItem): Boolean;
var
  match: TImageMatch;
begin
  Result := ItemFinder.Find([item], [Self.ItemBox], match);
end;


function TGrandExchangeSlot.Discover(): TItemArray;
var
  hash: UInt32;
begin
  hash := ItemFinder.GetHash(Target.GetImage(Self.ItemBox));
  if hash <> 0 then
    Result := ItemFinder.GetHashItems(hash);
end;


property TGrandExchangeSlot.Item: TItem;
begin
  Result := OCR.RecognizeLines(Self.ItemNameBox, Fonts.PLAIN_11, [TFonts.LIGHT_ORANGE], 0).Join(' ');
end;


property TGrandExchangeSlot.Value: Integer;
var
  str: String;
begin
  str := OCR.Recognize(Self.ValueBox, Fonts.PLAIN_11, [TFonts.ORANGE], 0);
  Result := str.ExtractInteger(-1);
end;


property TGrandExchangeSlot.Quantity: Integer;
var
  str: String;
begin
  if (Self.GetType() = EGESlotType.EMPTY) or (Self.GetType() = EGESlotType.UNAVAILABLE) then Exit(-1);
  str := OCR.Recognize(Self.ItemBox, Fonts.PLAIN_11, [TFonts.YELLOW], 0);
  Result := str.ExtractInteger(1);
end;


property TGrandExchangeSlot.TotalValue: Integer;
var
  postTaxValue, tax: Integer;
begin
  Result := Self.Value * Self.Quantity;

  if Self.GetType() = EGESlotType.BUY then Exit;

  case ItemData.GetTradeableID(Self.Item) of
      '8011', '365', '2309', '882', '806', '1891', '8010', '1755', '28824',
      '2140', '2142', '8009', '5325', '1785', '2347', '347', '884', '807',
      '28790', '379', '8008', '355', '2327', '558', '1733', '13190', '233',
      '351', '5341', '2552', '329', '8794', '5329', '5343', '1735', '315',
      '952', '886', '808', '8013', '361', '8007', '5331': Exit;
  end;

  if Self.Value >= 250000000 then
    postTaxValue := Self.Value - 5000000
  else
  begin
    tax := Floor(Self.Value * 0.02);
    postTaxValue := Self.Value - tax;
  end;

  Result := postTaxValue * Self.Quantity;
end;


property TGrandExchangeSlot.Status: EGEOfferStatus;
begin
  if Target.HasColor($005F00, 0, 1, Self.StatusBox) then
    Exit(EGEOfferStatus.COMPLETED);
  if Target.HasColor($2080D8, 0, 1, Self.StatusBox) then
    Exit(EGEOfferStatus.PROGRESSING);
  if Target.HasColor($00008F, 0, 1, Self.StatusBox) then
    Exit(EGEOfferStatus.ABORTED);

  Result := EGEOfferStatus.NONE;
end;


property TGrandExchangeSlot.Progress: Integer;
var
  tpa: TPointArray;
begin
  tpa := Target.FindColor($1964A8, 0, Self.StatusBox);
  if not (tpa = []) then
    Result := Round(tpa.Bounds().Width / 105 * 100)
  else if Target.HasColor($004A00, 0, 1, Self.StatusBox) then
    Result := 100
  else
    Result := -1;
end;


function TGrandExchangeSlot.Open(): Boolean; forward;


function TGrandExchangeSlot.Buy(): Boolean; forward;


function TGrandExchangeSlot.Sell(): Boolean; forward;


function TGrandExchangeSlot.Abort(): Boolean;
begin
  if Self.Status = EGEOfferStatus.ABORTED then Exit(True);

  Mouse.Move(Self.Bounds);
  if ChooseOption.Select('Abort offer') then
    Result := SleepUntil(Self.Status = EGEOfferStatus.ABORTED, 250, 2000);
end;

type

  TGrandExchange = record
    Title: TInterfaceTitle;
    Bounds: TBox;
    Slots: array [0..7] of TGrandExchangeSlot;
    HistoryButton, CollectButton: TBox;
  end;

function TGrandExchange.IsOpen(): Boolean; forward;


procedure TGrandExchange.SetupInterface();
var
  i: Integer;
  tba: TBoxArray;
begin
  case Client.Mode of
    EMode.FIXED: Self.Bounds := MSInterface.CreateBounds([0, 2, 0, -1], 484, 304);
    EMode.RESIZABLE, EMode.MODERN_COMPACT, EMode.MODERN_WIDE:
      Self.Bounds := MSInterface.CreateBounds([0, 1, 0, -2], 484, 304);
  end;

  Self.Title.Setup(Self.Bounds);
  Self.Title.IsOpen := @Self.IsOpen;

  tba := TBoxArray.Create(Self.Bounds.TopLeft + [9,65], 4, 2, 114, 110, [3, 8]);
  for i := 0 to High(tba) do
    Self.Slots[i]._Setup(tba[i]);

  with Self.Bounds do
  begin
    Self.HistoryButton := [X1+7, Y1+7, X1+53, Y1+26];
    Self.CollectButton := [X1+391, Y1+40, X1+473, Y1+59];
  end;
end;


function TGrandExchange.IsOpen(): Boolean;
begin
  if BankPin.IsOpen() then
  begin
    if not BankPin.WaitLoading(3000) then
      raise GetDebugLn('BankPin', 'GrandExchange pin buttons don''t seem to have loaded in 3 seconds.');

    if not BankPin.Enter(Profiles.GetPin()) then
      raise GetDebugLn('BankPin', 'Failed to enter GrandExchange pin.');
  end;

  Result := Self.Title.GetTitle() = 'Grand Exchange';
end;


function TGrandExchange.WaitOpen(time: Integer; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;


function TGrandExchange.Close(escape: Boolean): Boolean;
begin
  Result := Self.Title.Close(escape);
end;

function TGrandExchange.Close(escapeProbability: Single = -1): Boolean; overload;
begin
  Result := Self.Title.Close(escapeProbability);
end;



function TGrandExchange.GetEmptySlots(): TGrandExchangeSlotArray;
var
  i: Integer;
begin
  for i := 0 to 7 do
    if Self.Slots[i].GetType() = EGESlotType.EMPTY then
      Result += Self.Slots[i];
end;


function TGrandExchange.IndexOfEmptySlot(): Integer;
begin
  for Result := 0 to 7 do
    if Self.Slots[Result].GetType() = EGESlotType.EMPTY then
      Exit;
  Result := -1;
end;


function TGrandExchange.GetEmptySlot(): TGrandExchangeSlot;
var
  slot: Integer;
begin
  slot := Self.IndexOfEmptySlot();
  if slot > -1 then
    Result := Self.Slots[slot];
end;


function TGrandExchange.Collect(): Boolean;
begin
  if not Target.HasColor(TFonts.WHITE, 0, 1, Self.CollectButton) then Exit(False);
  Mouse.Click(Self.CollectButton, EMouseButton.LEFT);
  Result := SleepUntil(not Target.HasColor(TFonts.WHITE, 0, 1, Self.CollectButton),200, 2000);
end;

var

  GrandExchange: TGrandExchange;

function TGrandExchangeSlot.Open(): Boolean;
begin
  if Self.GetType() = EGESlotType.EMPTY then Exit;
  Mouse.Click(Self.Bounds, EMouseButton.LEFT);
  Result := SleepUntil(not GrandExchange.IsOpen(), 200, 2000);
end;

function TGrandExchangeSlot.Buy(): Boolean;
begin
  if Self.GetType() <> EGESlotType.EMPTY then
    Exit;
  Mouse.Click(Self.BuyButton, EMouseButton.LEFT);
  Result := SleepUntil(not GrandExchange.IsOpen(), 200, 2000);
end;

function TGrandExchangeSlot.Sell(): Boolean;
begin
  if Self.GetType() <> EGESlotType.EMPTY then
    Exit;
  Mouse.Click(Self.SellButton, EMouseButton.LEFT);
  Result := SleepUntil(not GrandExchange.IsOpen(), 200, 2000);
end;
