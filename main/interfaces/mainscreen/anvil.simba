

{$DEFINE WL_ANVIL_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TAnvil = record
    Title: TInterfaceTitle;
    Slots: TSlotInterface;
    Items: TItemInterface;
    Bounds, SlotsArea: TBox;
    SlotBoxes: TBoxArray;
    QuantityButtons: TButtonArray;

    Anvils: TObjectArray;
  end;

function TAnvil.GetSlotBoxes(): TBoxArray; forward;


procedure TAnvil.SetupInterface();
var
  i: Integer;
  boxes: TBoxArray;
begin
  case Client.Mode of
    EMode.FIXED: Self.Bounds := MSInterface.CreateBounds([0, 2, 0, -1], 500, 320);
    EMode.RESIZABLE, EMode.MODERN_COMPACT, EMode.MODERN_WIDE:
      Self.Bounds := MSInterface.CreateBounds([0, -1, 0, 1], 500, 320);
  end;

  Self.Title.Setup(Self.Bounds);

  Self.SlotsArea.X1 := Self.Bounds.X1 + 4;
  Self.SlotsArea.Y1 := Self.Bounds.Y1 + 30;
  Self.SlotsArea.X2 := Self.Bounds.X2 - 50;
  Self.SlotsArea.Y2 := Self.Bounds.Y2 - 4;

  Self.SlotBoxes := TBoxArray.Create(Self.Bounds.TopLeft + [6, 36], 6, 5, 75, 54, [1, 1]);
  for i in [5, 11, 17, 23, 29] do
    Self.SlotBoxes[i].X2 := Self.SlotBoxes[i].X1 + 67;

  Self.Slots.Setup('Anvil.Slots', Self.SlotBoxes, @Self.GetSlotBoxes);
  Self.Items.Setup('Anvil.Items', @Self.Slots, [0, 0]);

  with Self.Bounds do
    boxes := TBoxArray.Create([X2-43, Y1+36], 1, 6, 36, 36, [0,9]);
  Self.QuantityButtons := TButtonArray.Create(
    boxes, [[$FFFFFF, 0.000, EColorSpace.RGB, [1.000, 1.000, 1.000]]]
  );
end;


function TAnvil.GetSlotBoxes(): TBoxArray;
var
  i: Integer;
begin
  for i := 0 to High(Self.SlotBoxes) do
    if Target.HasColor(TFonts.GREEN, 0, 1, Self.SlotBoxes[i]) or Target.HasColor(TFonts.ORANGE, 0, 1, Self.SlotBoxes[i]) then
      Result += Self.SlotBoxes[i];
end;


function TAnvil.IsOpen(): Boolean;
begin
  Result := MSInterface.IsOpen(EInterfaceType.CLASSIC) and
            Target.HasColor($00FF00, 0, 300, Self.SlotsArea);
end;


function TAnvil.WaitOpen(time: Integer; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;


function TAnvil.SetQuantity(value: Integer): Boolean;
var
  i: Integer;
  btns: TButtonArray;
  str, recognized: String;
begin
  if value = 1 then
    Exit(Self.QuantityButtons[0].Enabled[True]);

  for i := 1 to High(Self.QuantityButtons) do
    if Target.HasColor(TFonts.BLACK, 0,  1, Self.QuantityButtons[i].Bounds) then
      btns += Self.QuantityButtons[i];

  if btns = [] then
    Exit;

  if value <= 0 then
    str := 'All'
  else
    case value of
      5, 10: str := ToStr(value);
      else
      begin
        if Length(btns) < 2 then
          Exit;

        str := ToStr(value);
        i := High(btns);
        if OCR.RecognizeShadow(btns[i].Bounds, Fonts.PLAIN_11, 0) = str then
          Exit(btns[i].Enabled);

        case OCR.RecognizeShadow(btns[Dec(i)].Bounds, Fonts.PLAIN_11, 0) of
          'X': Mouse.Click(btns[i].Bounds, EMouseButton.LEFT);
          '?': ;
          else Exit;
        end;

        Exit(Chat.AnswerQuery('Enter amount:', str, 1200));
      end;
    end;

  for i := 0 to High(btns) do
  begin
    recognized := OCR.RecognizeShadow(btns[i].Bounds.Expand(-2), Fonts.PLAIN_11, 0);
    if recognized = str then
      Exit(btns[i].Enabled[True]);
  end;
end;



function TAnvil.CanSmith(item: TItem): Boolean;
var
  slot: Integer;
begin
  slot := Self.Items.IndexOf([item]);
  if slot = -1 then Exit;

  Result := Target.HasColor($00FF00, 0, 1, Self.Slots.Box(slot));
end;



function TAnvil.Smith(item: TItem; quantity: Integer = QUANTITY_ALL; keyboardProbability: Single = -1): Boolean;
var
  slot, count: Integer;
begin
  slot := Self.Items.IndexOf([item]);
  if slot = -1 then Exit;

  if not Target.HasColor(TFonts.GREEN, 0, 1, Self.Slots.Box(slot)) then
    Exit;

  if not Self.SetQuantity(quantity) then
    Exit;

  if keyboardProbability < 0 then
    keyboardProbability := Biometrics.RandomDouble(0.5);

  count := Inventory.Items.CountEx(item);
  if RandomBoolean(keyboardProbability) and Target.HasColor($485969, 0.5, 300, Self.Slots.Box(slot)) then
    Keyboard.KeyPress(EKeyCode.SPACE)
  else
    Mouse.Click(Self.Slots.Box(slot), EMouseButton.LEFT);

  if SleepUntil(not Self.IsOpen(), 200, 4 * TICK) then
    Result := SleepUntil(Inventory.Items.CountEx(item) > count, 200, 6 * TICK);
end;



function TAnvil.Hover(walk: Boolean = True): Boolean;
var
  obj: TObject;
begin
  if Self.Anvils = [] then
    Self.Anvils := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Smith'));

  obj := Self.Anvils[Self.Anvils.ClosestIndex(Map.Position())];
  if walk then
    Exit(obj.WalkHover());
  Result := obj.Hover();
end;


function TAnvil.Open(constref obj: TObject; walk: Boolean = True): Boolean;
begin
  if walk then
    Result := obj.WalkInteract(['Smith', 'nvil'])
  else
    Result := obj.Interact(['Smith', 'nvil']);

  if not Result and not MainScreen.Interact(['Smith']) then
    Exit;

  obj.Walker^.WaitMoving();
  Result := Self.WaitOpen(6*TICK);
end;

function TAnvil.Open(walk: Boolean = True): Boolean; overload;
var
  obj: TObject;
begin
  if MSInterface.IsOpen() then
  begin
    if Self.IsOpen() then
      Exit(True);
    MSInterface.Close(True);
  end;

  if Self.Anvils = [] then
    Self.Anvils := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Smith'));

  obj := Self.Anvils[Self.Anvils.ClosestIndex(Map.Position())];
  Result := Self.Open(obj, walk);
end;

var

  Anvil: TAnvil;
