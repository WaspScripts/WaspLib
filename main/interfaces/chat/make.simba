

{$DEFINE WL_MAKE_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TMakeQuantityButton = record
    Quantity: EItemQuantity;
    Button: TButton;
    UpText: String;
  end;


  TMakeItem = record
    Item: String;
    Index, Quantity: Integer;
  end;


  TMake = record
    Items: array of TMakeItem;
    QuantityButtonBoxes: TBoxArray;
    SelectedQuantity: Integer;
    QuantityArea: TBox;
    _IsOpenHelper, _ItemsHelper: TBox;

    const TEXT_COLOR: TColor = $203040;
    const BORDER_COLOR: TColorTolerance = [$080707, 5, EColorSpace.RGB, [1.000, 1.000, 1.000]];
  end;


procedure TMake.SetupInterface();
begin
  with Chat.Bounds do
  begin
    Self._IsOpenHelper.X1 := X1 + 10;
    Self._IsOpenHelper.Y1 := Y1 + 12;
    Self._IsOpenHelper.X2 := X2 - 10;
    Self._IsOpenHelper.Y2 := Y1 + 34;

    Self.QuantityButtonBoxes := TBoxArray.Create([X2-228, Y1+15], 6, 1, 29, 29, [6,0]).Reversed();
    Self.QuantityButtonBoxes[0].X2 += 5;
    Self.QuantityArea := Self.QuantityButtonBoxes.Merge();

    Self._ItemsHelper.X1 := X1 + 8;
    Self._ItemsHelper.Y1 := Y1 + 51;
    Self._ItemsHelper.X2 := X2 - 8;
    Self._ItemsHelper.Y2 := Y2 - 14;
  end;
end;


function TMake.IsOpen(): Boolean;
begin
  Result := Target.HasColor(Self.TEXT_COLOR, 0, 500, Self._IsOpenHelper);
end;


function TMake.WaitOpen(time: Integer = TICK; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.IsOpen(), interval, time);
end;


function TMake.GetItemBoxes(): TBoxArray;
var
  tpa: TPointArray;
  b: TBox;
begin
  tpa := Target.FindColor(Self.BORDER_COLOR, Self._ItemsHelper);
  for tpa in tpa.Cluster(1.5) do
  begin
    b := tpa.Bounds();
    if InRange(b.Height, 60, 85) and InRange(b.Width, 20, 120) then
      Result += b;
  end;
end;


function TMake.GetQuantityBoxes(): TBoxArray;
var
  tpa: TPointArray;
  b: TBox;
begin
  tpa := Target.FindColor(Self.BORDER_COLOR, Self.QuantityArea);
  for tpa in tpa.Cluster(1.5) do
  begin
    b := tpa.Bounds();
    if InRange(b.Height, 20, 40) and InRange(b.Width, 20, 40) then
      Result += b;
  end;
  Result := Result.SortByX(True);
end;


function TMake.GetQuantityButtons(): array of TMakeQuantityButton;
var
  boxes: TBoxArray;
  i: Integer;
  str: String;
begin
  boxes := Self.GetQuantityBoxes();
  SetLength(Result, Length(boxes));

  for i := 0 to High(boxes) do
  begin
    str := OCR.Recognize(boxes[i], Fonts.PLAIN_11, [Self.TEXT_COLOR, TFonts.WHITE], 0);

    Result[i].Quantity := EItemQuantity.String2Quantity(str);
    Result[i].Button := new TButton(boxes[i], [[TFonts.WHITE, 0, EColorSpace.RGB, [1,1,1]]]);

    if str.Equals('X', True) then
    begin
      Result[i].UpText := 'Other';
      Continue;
    end;

    str := Fonts.PLAIN_11.NormalizeGlyphs(str, '0123456789');
    Result[i].UpText := str;
  end;
end;



function TMake.FindQuantityButtons(): array of TMakeQuantityButton;
begin
  if not Self.IsOpen() then
    Exit;
  Result := Self.GetQuantityButtons();
end;


function TMake.GetCurrentQuantityButton(): TMakeQuantityButton;
var
  btns: array of TMakeQuantityButton;
  i: Integer;
begin
  btns := Self.FindQuantityButtons();
  if Length(btns) = 0 then
    Exit;

  for i := 0 to High(btns) do
    if btns[i].Button.Enabled then
      Exit(btns[i]);
end;


function TMake.GetCurrentQuantity(): Integer;
var
  current: TMakeQuantityButton;
begin
  current := Self.GetCurrentQuantityButton();
  if current = [] then
    Exit;

  if current.Button.Bounds.Area = 0 then
    raise GetDebugLn('Make', 'Failed to get current quantity button');

  if current.UpText.Equals('All', True) then
    Exit(-1);

  Result := StrToInt(current.UpText);
end;



function TMake.HasHint(): Boolean;
begin
  Result := Target.HasColor($A0FFFF, 0, 1, Chat.Bounds);
end;


function TMake.WaitHint(time: Integer = TICK; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.HasHint(), interval, time);
end;


function TMake.GetHintBox(): TBox;
var
  tpa: TPointArray;
begin
  tpa := Target.FindColor($A0FFFF, 0, Chat.Bounds);
  if tpa <> [] then
    Result := tpa.Bounds();
end;


function TMake.ReadHint(): String;
begin
  Result := OCR.Recognize(Self.GetHintBox(), Fonts.PLAIN_12, [$0], 0);
end;


function TMake.CloseHint(): Boolean;
var
  tpa: TPointArray;
  b: TBox;
begin
  if not Self.HasHint() then
    Exit(True);

  tpa := TPointArray.CreateFromBox(Chat.Bounds, True);
  for b in Self.GetItemBoxes() do
    tpa := tpa.ExcludeBox(b.Expand(1));

  tpa := tpa.SortFrom(Mouse.Position);
  Mouse.Move(tpa[RandomLeft(0, High(tpa))]);
  Result := SleepUntil(not Self.HasHint(), RandomMode(100, 50, 1500), 600);
end;




function TMake.FindQuantityButton(amount: Integer): TMakeQuantityButton;
var
  idx: Integer;
  quantity: EItemQuantity;
  quantitybtns: array of TMakeQuantityButton;
begin
  if not Self.CloseHint() then
    raise GetDebugLn('Make', 'Failed to close the tooltip which could be covering the quantity buttons');

  quantitybtns := Self.FindQuantityButtons();
  quantity := EItemQuantity.Integer2Quantity(amount);

  for idx := 0 to High(quantitybtns) do
  begin
    if quantitybtns[idx].Quantity = quantity then
    begin
      if quantity = EItemQuantity.CUSTOM then
      begin
        if quantitybtns[idx].UpText = IntToStr(amount) then
        Exit(quantitybtns[idx]);
        if quantitybtns[idx].UpText = 'Other' then
          Exit(quantitybtns[idx]);
      end
      else
        Exit(quantitybtns[idx]);
    end;
  end;
 Result := [];
end;


function TMake.IsQuantitySelected(idx: Integer): Boolean;
begin
  Result := Target.HasColor(TFonts.WHITE, 0, 1, Self.QuantityButtonBoxes[idx]);
end;


function TMake.SetQuantity(amount: Integer): Boolean;
var
  quantityButton: TMakeQuantityButton;
  done: Boolean;
begin
  quantityButton := Self.FindQuantityButton(amount);
  if quantityButton = [] then
    raise GetDebugLn('Make', 'Quantity button for "' + ToStr(amount) + '" is not available.');

  if quantityButton.Button.Enabled then
    Exit(True);

  quantityButton.Button.Click(EMouseButton.LEFT);

  Result := SleepUntil(
              (done := quantityButton.Button.Enabled) or
              Chat.FindQuery('Enter amount', True), RandomMode(100, 50, 1500), 600
            );
  if done then Exit;

  Result := Chat.AnswerQuery('Enter amount', ToStr(amount), 600);
end;



function TMake._SelectHelper(index: Integer; boxes: TBoxArray; keyboardProbability: Single): Boolean;
begin
  if High(boxes) < index then Exit;

  if keyboardProbability = -1 then
    keyboardProbability := Biometrics.RandomDouble(0.5);

  if not RandomBoolean(keyboardProbability) then
  begin
    Mouse.Click(boxes[index], EMouseButton.LEFT);
    Exit(SleepUntil(not Self.IsOpen(), RandomMode(100, 50, 1500), 2000));
  end;

  boxes[index].Y1 := boxes[index].Y2 + 1;
  boxes[index].Y2 += 15;

  if OCR.Locate(boxes[index], 'Space', [Self.TEXT_COLOR], 0, Fonts.PLAIN_11) >= 0.95 then
    Keyboard.KeyPress(EKeyCode.SPACE)
  else
    Keyboard.KeyPress(EKeyCode(Ord(EKeyCode.NUM_1) + index));

  Result := SleepUntil(not Self.IsOpen(), RandomMode(100, 50, 1500), 2000);
end;


function TMake.Select(index, quantity: Integer; keyboardProbability: Single = -1): Boolean;
var
  boxes: TBoxArray;
begin
  if not Self.IsOpen() then Exit;
  if not Self.SetQuantity(quantity) then Exit;
  boxes := Self.GetItemBoxes();
  if index <= High(boxes) then
    Result := Self._SelectHelper(index, boxes, keyboardProbability);
end;

function TMake.Select(item: String; quantity: Integer; keyboardProbability: Single = -1): Boolean; overload;
var
  boxes: TBoxArray;
  i: Integer;
begin
  if not Self.IsOpen() then Exit;
  boxes := Self.GetItemBoxes();

  for i := 0 to High(Self.Items) do
  begin
    if Self.Items[i].Item <> item then Continue;

    if Self.Items[i].Quantity <> quantity then
    begin
      if not Self.SetQuantity(quantity) then Exit;
      Self.Items[i].Quantity := quantity;
    end;

    Exit(Self._SelectHelper(Self.Items[i].Index, boxes, keyboardProbability));
  end;

  if not Self.SetQuantity(quantity) then Exit;

  for i := 0 to High(boxes) do
  begin
    Mouse.Move(boxes[i]);
    if not Self.WaitHint(4000) then Continue;

    if SameText(Self.ReadHint(), item) then
    begin
      Self.Items += [item, i, quantity];
      Exit(Self._SelectHelper(i, boxes, keyboardProbability));
    end;
  end;
end;

var

  Make: TMake;
