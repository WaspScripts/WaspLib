
{$DEFINE WL_CHAT_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  EChatColor = enum(
    BLACK, MAROON, BLUE, PURPLE, RED, LIGHT_RED, WHITE, LIGHT_PURPLE, NAVY, GREEN
  );

  EChatColorArray = array of EChatColor;


  EIron = enum(
    NONE, IRONMAN, HARDCORE, ULTIMATE, GROUP, HARCORE_GROUP, UNRANKED_GROUP
  );


  TChat = record
    Bounds: TBox;
    Scroll: TScrollBar;
    Tabs: TChatTabs;
    MessageLines: TBoxArray;
    InputLine: TBox;
    ReportButton: TButton;
    Colors: TColorArray;
  end;


procedure TChat.SetupInterface();
begin
  Self.Tabs.SetupInterface();

  with Self.Tabs.Bounds do
  begin
    Self.ReportButton := new TButton(
      [X1 + 436, Y1,  X1 + 515, Y2 - 1],
      [
        [$000613, 6, EColorSpace.RGB, [1,1,1]],
        [$526572, 0, EColorSpace.RGB, [1,1,1]],
        [$0C233C, 0, EColorSpace.RGB, [1,1,1]]
      ]
    );
    Self.Bounds.X1 := X1;
    Self.Bounds.X2 := X2;
    Self.Bounds.Y1 := Y1 - 142;
    Self.Bounds.Y2 := Y1 - 1;
  end;

  Self.MessageLines := TBoxArray.Create(
    Self.Bounds.TopLeft + [10, 8], 1, 9, Self.Bounds.Width - 34, 13, [0, 1]
  );

  Self.InputLine := Self.MessageLines.Pop;
  Self.InputLine.X2 += 17;
  Self.InputLine.Y2 += 2;

  Self.Scroll.Area.X1 := Self.Bounds.X1 + 6;
  Self.Scroll.Area.Y1 := Self.Bounds.Y1 + 6;
  Self.Scroll.Area.X2 := Self.Bounds.X2 - 23;
  Self.Scroll.Area.Y2 := Self.InputLine.Y1 - 1;

  Self.Scroll.Setup();

  Self.Colors := [
    TFonts.BLACK, $7F0000, TFonts.BLUE, $7F007F, $2010EF, TFonts.RED,
    TFonts.WHITE, $FF9090, TFonts.DARK_BLUE, $005F00
  ];
  MainScreen.Mask.DrawColor := $0000FF;
  MainScreen.Mask.DrawBoxFilled(Self.Bounds);
end;




function TChat.GetColors(colors: EChatColorArray): TColorArray;
var
  c: EChatColor;
begin
  {$R-}
  for c in colors do Result += Self.Colors[c];
  {$R+}
end;



function TChat.GetDisplayNameBox(out color: Integer): TBox;
var
  b: TBox;
  tpa: TPointArray;
begin
  b.X1 := Self.InputLine.X1;
  b.Y1 := Self.InputLine.Y1;
  b.X2 := b.X1 + Self.InputLine.Width div 4;
  b.Y2 := Self.InputLine.Y2;

  for color in [TFonts.WHITE, TFonts.BLACK] do
  begin
    tpa := Target.FindColor(color, 0, b);
    if tpa <> [] then Exit(tpa.Bounds());
  end;
end;

function TChat.GetDisplayNameBox(): TBox; overload;
var
  color: Integer;
begin
  Result := Self.GetDisplayNameBox(color);
end;


function TChat.GetDisplayName(): String;
var
  b: TBox;
begin
  b.X1 := Self.InputLine.X1;
  b.Y1 := Self.InputLine.Y1;
  b.X2 := b.X1 + Self.InputLine.Width div 4;
  b.Y2 := Self.InputLine.Y2;

  Result := OCR.RecognizeStatic(b, Fonts.PLAIN_12, [$FFFFFF, $000000], 0);

  if ':' in Result then
    Result := Result.Before(':');
end;



function TChat.GetIronManType(): EIron;
var
  b: TBox;
begin
  b.X1 := Self.InputLine.X1;
  b.Y1 := Self.InputLine.Y1;
  b.X2 := Self.InputLine.X1 + 10;
  b.Y2 := Self.InputLine.Y2;

  if Target.HasColor(
    [$484949, 1.216, EColorSpace.HSL, [0.018, 2.599, 0.385]], 1, b
  ) then
  begin
    if Target.HasColor(
      [$7E3C1A, 0.761, EColorSpace.HSL, [1.396, 1.396, 0.210]], 1, b
    ) then
      Exit(EIron.GROUP);
    if Target.HasColor(
      [$1A1A83, 0.817, EColorSpace.HSL, [1.977, 0.683, 0.342]], 1, b
    ) then
      Exit(EIron.HARCORE_GROUP);
    if Target.HasColor(
      [$5D801A, 1.2, EColorSpace.HSL, [1.345, 1.345, 0.312]], 1, b
    ) then
      Exit(EIron.UNRANKED_GROUP);

    Exit(EIron.IRONMAN);
  end;

  if Target.HasColor(
    [$1B1B57, 0.787, EColorSpace.HSL, [2.371, 0.206, 0.425]], 1, b
  ) then
    Exit(EIron.HARDCORE);

  if Target.HasColor(
    [$BFC1C1, 2.268, EColorSpace.HSL, [0.034, 2.779, 0.189]], 1, b
  ) then
    Exit(EIron.ULTIMATE);
end;



function TChat.IsTransparent(): Boolean;
var
  b: TBox;
begin
  b.X1 := Self.InputLine.X1;
  b.Y1 := Self.InputLine.Y1;
  b.X2 := b.X1 + Self.InputLine.Width div 4;
  b.Y2 := Self.InputLine.Y2;

  Result := Target.HasColor($FFFFFF, 0, 1, b);
end;



function TChat.IsOpen(): Boolean;
begin
  if Client.Mode = EMode.FIXED then Exit(True);
  Result := Self.Tabs.GetActive() <> EChatTab.NONE;
end;


function TChat.Close(): Boolean;
begin
  if Client.Mode = EMode.FIXED then Exit(False);
  if Self.Tabs.GetActive() = EChatTab.NONE then Exit(True);

  Self.Tabs.Tabs[Self.Tabs.GetActive()].Click();
  Result := Self.Tabs.GetActive() = EChatTab.NONE;
end;





function TChat.GetQuery(): String;
begin
  Result := OCR.Recognize(Self.Bounds, Fonts.BOLD, [$0], 0);
end;


function TChat.GetQueryAnswer(): String;
begin
  Result := OCR.Recognize(Self.Bounds, Fonts.BOLD, [TFonts.DARK_BLUE], 0);
end;


function TChat.FindQuery(const query: String; matchCase: Boolean = False): Boolean;
begin
  Result := Self.GetQuery().Contains(query, matchCase);
end;


function TChat.WaitQuery(
  const query: String;
  matchCase: Boolean = False;
  time: Integer = TICK;
  interval: Integer = -1
): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.FindQuery(query, matchCase), interval, time);
end;


function TChat.AnswerQuery(
  query, answer: String; waitTime: Integer = TICK; interval: Integer = -1
): Boolean;
begin
  Result := Self.WaitQuery(query, False, waitTime, interval);
  if not Result then Exit;

  if Self.GetQueryAnswer() <> Answer then
    while Self.GetQueryAnswer() <> '*' do
      Target.KeyPress(EKeyCode.BACK);

  Keyboard.Send(answer, EKeyCode.RETURN);
end;


{$R-}
function TChat._GetMessage(line: Integer): String;
const
  STATIC_OFFSET: Integer = 2;
  CHAT_BACKGROUND: TColorTolerance = [$6593AC, 3.329, EColorSpace.HSL, [2.063, 0.536, 0.402]];
var
  bounds: TBox;
  tpa: TPointArray;
  colors: TColorArray;
begin
  with Self.MessageLines[line] do
    bounds := [X1, Y1-STATIC_OFFSET, X2, Y2];

  //Find chatbox_bg_colors.txt has the colors used
  tpa := Target.FindColor(CHAT_BACKGROUND, bounds).Invert();
  colors := Target.GetColors(tpa).Unique();
  Result := OCR.Recognize(bounds, Fonts.PLAIN_12, colors, 0);
end;

function TChat._GetTransparentMessage(line: Integer): String;
const
  STATIC_OFFSET: Integer = 2;
var
  b: TBox;
  img: TImage;
  tpa: TPointArray;
begin
  with Self.MessageLines[line] do
    b := [X1, Y1-STATIC_OFFSET, X2, Y2];

  img := Target.GetImage(b);
  // First shadow from above line draws over our line.
  // Mark the shadow as a match since OCR requires 100% character match.
  tpa := img.FindColor($000000, 0, [0, STATIC_OFFSET, img.Width, STATIC_OFFSET]);
  img.DrawColor := $FFFFFF;
  img.DrawTPA(tpa);

  // Now find shadows, offset by -1,-1 to find colors of text
  tpa := img.FindColor(0, 0, [1, 1, img.Width, img.Height]);
  tpa := tpa.Offset([-1,-1]).ExcludePoints(tpa);
  img.ReplaceColorBinary(False, img.GetColors(tpa).Unique(), 0);

  Result := OCR.Engine.Recognize(img, Fonts.PLAIN_12, [0,0]);
end;



function TChat.GetMessage(line: Integer): String;
begin
  if not Self.IsTransparent() then
    Exit(Self._GetMessage(line).ExtractText());
  Result := Self._GetTransparentMessage(line).ExtractText();
end;


function TChat.IndexOfMessage(const msg: String; matchCase: Boolean = False): Integer;
begin
  if Self.IsTransparent() then
  begin
    for Result := 0 to High(Self.MessageLines) do
      if Self._GetTransparentMessage(Result).Contains(msg, matchCase) then
        Exit;
    Exit(-1);
  end;

  for Result := 0 to High(Self.MessageLines) do
    if Self._GetMessage(Result).Contains(msg, matchCase) then
      Exit;
  Result := -1;
end;


function TChat.ContainsMessage(const msg: String; matchCase: Boolean = False): Boolean;
begin
  Result := Self.IndexOfMessage(msg, matchCase) > -1;
end;


function TChat.CountNewMessage(const msg: String; matchCase: Boolean = False): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := High(Self.MessageLines) downto 0 do
  begin
    if not Self.GetMessage(i).Equals(msg, matchCase) then
      Exit;
    Inc(Result);
  end;
end;


function TChat.GetMessagesString(): String;
var
  i: Integer;
  msg: String;
begin
  if Self.IsTransparent() then
  begin
    for i := 0 to High(Self.MessageLines) do
    begin
      msg := Self._GetTransparentMessage(i);
      if msg <> '' then
      begin
        if Result <> '' then
          Result += LINE_SEP;
        Result += msg;
      end;
    end;

    Exit;
  end;

  for i := 0 to High(Self.MessageLines) do
  begin
    msg := Self._GetMessage(i);
    if msg <> '' then
    begin
      if Result <> '' then
        Result += LINE_SEP;
      Result += msg;
    end;
  end;
end;
{$R+}


function TChat.InputHasText(): Boolean;
begin
  Result := Target.HasColor(Self.Colors[EChatColor.BLUE], 0, 15, Self.InputLine);
end;

var

  Chat: TChat;
