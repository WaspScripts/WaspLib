
{$DEFINE WL_CHAT_TABS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  EChatTab = enum(NONE, ALL, GAME, PUB, PRIV, CHANNEL, CLAN, TRADE);


  EChatTabState = enum(NONE, ENABLED, FILTERED, DISABLED, HIDE, AUTOCHAT);


  TChatTabs = record
    Bounds: TBox;
    Tabs: array [0..7] of TButton;
  end;


procedure TChatTabs.SetupInterface();
var
  i: Int32;
begin
  with Client.Bounds do
  begin
    Self.Bounds.X1 := X1;
    Self.Bounds.X2 := X1 + 518;
    Self.Bounds.Y1 := Y2 - 22;
    Self.Bounds.Y2 := Y2;
  end;

  with Self.Bounds do
    for i := 0 to 6 do
      Self.Tabs[i+1] := new TButton(
        [X1+3+(i*62), Y1, X1+58+(i*62), Y2-1],
        [[$112244, 7.768, EColorSpace.HSV, [0.623, 1.217, 1.161]]]
      );

  MainScreen.Mask.DrawColor := $FFFFFF;
  MainScreen.Mask.DrawBoxFilled(Self.Bounds);
end;


function TChatTabs.GetActive(): EChatTab;
var
  tab: EChatTab;
begin
  for tab := EChatTab.ALL to High(EChatTab) do
    if Self.Tabs[tab].Enabled then
      Exit(tab);
end;


function TChatTabs.IsActive(tab: EChatTab): Boolean;
begin
  Result := Self.Tabs[tab].Enabled;
end;



function TChatTabs.Open(tab: EChatTab): Boolean;
begin
  Result := Self.Tabs[tab].Enabled[True];
end;


function TChatTabs._GetState(tab: EChatTab): EChatTabState;
const
  COLORS: array [1..5] of Integer = [65280, 65535, 255, 16776960, 16756480];
var
  state: EChatTabState;
begin
  Result := EChatTabState.NONE;
  if tab = EChatTab.ALL then Exit;

  for state := EChatTabState.ENABLED to High(EChatTabState) do
    if Target.CountColor(COLORS[state], 0, Self.Tabs[tab].Bounds) > 0 then
      Exit(state);
end;


function TChatTabs.GetState(tab: EChatTab): EChatTabState;
begin
  Result := Self._GetState(tab);
end;


function TChatTabs.ChangeState(tab: EChatTab; state: EChatTabState): Boolean;
begin
  if Self._GetState(tab) = state then
    Exit(True);

  Self.Tabs[tab].Click(EMouseButton.RIGHT);

  if not ChooseOption.WaitOpen(200) then
    Exit;

  case state of
    EChatTabState.ENABLED:  ChooseOption.Select(['Filter', 'standard', 'all']);
    EChatTabState.FILTERED: ChooseOption.Select(['Filter', 'friends']);
    EChatTabState.DISABLED: ChooseOption.Select(['none']);
    EChatTabState.HIDE:     ChooseOption.Select(['Hide']);
    EChatTabState.AUTOCHAT: ChooseOption.Select(['autochat']);
  end;

  Result := Self._GetState(tab) = state;
end;
