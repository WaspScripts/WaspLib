(*
# ChatTabs
Chat tabs refer to the tabs/buttons that are below the {ref}`Chat` box.

You can use these to change the current chat being viewed.
```{figure} ../../images/chattabs.png
```
*)
{$DEFINE WL_CHAT_TABS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type
(*
(EChatTab)=
## EChatTab enum
```pascal
EChatTab = enum(NONE, ALL, GAME, PUB, PRIV, CHANNEL, CLAN, TRADE);
```
Enum representing each of the chat tabs available.
*)
  EChatTab = enum(NONE, ALL, GAME, PUB, PRIV, CHANNEL, CLAN, TRADE);

(*
(EChatTabState)=
## EChatTabState enum
```pascal
EChatTabState = enum(NONE, ENABLED, FILTERED, DISABLED, HIDE, AUTOCHAT);
```
Enum representing each of the filters a chat tab can have.

You can see the filters when you right click the tab:
```{figure} ../../images/chattab_filter.png
```
*)
  EChatTabState = enum(NONE, ENABLED, FILTERED, DISABLED, HIDE, AUTOCHAT);

(*
## TChatTabs
Record responsible with interacting with the {ref}`ChatTabs`.

In {ref}`TChat` you have a `Tabs` variable of this type.
*)
  TChatTabs = record
    Bounds: TBox;
    Tabs: array [0..7] of TButton;
  end;

(*
## Chat.Tabs.SetupInterface
```pascal
procedure TChatTabs.SetupInterface();
```
Internal method used to setup the {ref}`TChatTabs` coordinates.

This is automatically called for you on the {ref}`Chat.Tabs variable`.
*)
procedure TChatTabs.SetupInterface();
var
  i: Int32;
begin
  with Client.Bounds do
  begin
    Self.Bounds.X1 := X1;
    Self.Bounds.X2 := X1 + 518;
    Self.Bounds.Y1 := Y2 - 22;
    Self.Bounds.Y2 := Y2;
  end;

  with Self.Bounds do
    for i := 0 to 6 do
      Self.Tabs[i+1] := new TButton(
        [X1+3+(i*62), Y1, X1+58+(i*62), Y2-1],
        [[$112244, 7.768, EColorSpace.HSV, [0.623, 1.217, 1.161]]]
      );

  MainScreen.Mask.DrawColor := $FFFFFF;
  MainScreen.Mask.DrawBoxFilled(Self.Bounds);
end;

(*
## Chat.Tabs.GetActive
```pascal
function TChatTabs.GetActive(): EChatTab;
```
Returns the {ref}`TChatTab` that is active right now.

Example:
```pascal
WriteLn Chat.Tabs.GetActive();
```
*)
function TChatTabs.GetActive(): EChatTab;
var
  tab: EChatTab;
begin
  for tab := EChatTab.ALL to High(EChatTab) do
    if Self.Tabs[tab].Enabled then
      Exit(tab);
end;

(*
## Chat.Tabs.IsActive
```pascal
function TChatTabs.IsActive(tab: EChatTab): Boolean;
```
Returns True/False if the specified {ref}`EChatTab` is active right now.

Example:
```pascal
WriteLn Chat.Tabs.IsActive(EChatTab.ALL);
```
*)
function TChatTabs.IsActive(tab: EChatTab): Boolean;
begin
  Result := Self.Tabs[tab].Enabled;
end;


(*
## Chat.Tabs.Open
```pascal
function TChatTabs.Open(tab: EChatTab): Boolean;
```
Attempts to open the specified {ref}`EChatTab`.

Example:
```pascal
WriteLn Chat.Tabs.Open(EChatTab.ALL);
```
*)
function TChatTabs.Open(tab: EChatTab): Boolean;
begin
  Result := Self.Tabs[tab].Enabled[True];
end;


(*
## Chat.Tabs.GetState
```pascal
function TChatTabs.GetState(tab: EChatTab): EChatTabState;
```
Returns the {ref}`EChatTabState` of the specified {ref}`EChatTab`.

Example:
```pascal
WriteLn Chat.Tabs.GetState(EChatTab.PUBLIC_);
```
*)
function TChatTabs.GetState(tab: EChatTab): EChatTabState;
const
  COLORS: array [1..5] of Integer = [65280, 65535, 255, 16776960, 16756480];
var
  state: EChatTabState;
  img: TImage;
  trgt: TTarget;
begin
  Result := EChatTabState.NONE;
  if tab = EChatTab.ALL then
    Exit;

  //we create a new trgt this doesn't hold `Target` in async scripts
  img := Target.GetImage();
  trgt := new TTarget();
  trgt.SetImage(img);

  for state := EChatTabState.ENABLED to High(EChatTabState) do
    if trgt.CountColor(COLORS[state], 0, Self.Tabs[tab].Bounds) > 0 then
      Exit(state);
end;

(*
## Chat.Tabs.ChangeState
```pascal
function TChatTabs.ChangeState(tab: EChatTab; state: EChatTabState): Boolean;
```
Attempts to change the state of the specified {ref}`EChatTab` to the
specified {ref}`EChatTabState`.

Example:
```pascal
WriteLn Chat.Tabs.GetState(EChatTab.PUBLIC_, EChatTabState.ENABLED);
```
*)
function TChatTabs.ChangeState(tab: EChatTab; state: EChatTabState): Boolean;
begin
  if Self.GetState(tab) = state then
    Exit(True);

  Self.Tabs[tab].Click(EMouseButton.RIGHT);

  if not ChooseOption.WaitOpen(200) then
    Exit;

  case state of
    EChatTabState.ENABLED:  ChooseOption.Select(['Filter', 'standard', 'all']);
    EChatTabState.FILTERED: ChooseOption.Select(['Filter', 'friends']);
    EChatTabState.DISABLED: ChooseOption.Select(['none']);
    EChatTabState.HIDE:     ChooseOption.Select(['Hide']);
    EChatTabState.AUTOCHAT: ChooseOption.Select(['autochat']);
  end;

  Result := Self.GetState(tab) = state;
end;
