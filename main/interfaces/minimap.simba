(*
## Minimap.FindFlag
```pascal
function TMinimap.FindFlag(out pt: TPoint): Boolean;
```
Returns True/False if the minimap walking flag is visible on the minimap.
`pt` will return the coordinate where the flag was found.

Example:
```pascal
if Minimap.FindFlag(flagPt) then
  ShowOnTarget(TCircle.Create(flagPt.X, flagPt.Y, 6));
```
*)
function TMinimap.FindFlag(out pt: TPoint): Boolean;
begin
  pt := Target.FindImage(Self.FLAG, 0, Self.Bounds);
  Result := Self.Polygon.Contains(pt);
end;

(*
## Minimap.HasFlag
```pascal
function TMinimap.HasFlag(): Boolean;
```
Returns True/False if the minimap walking flag is visible on the minimap.
Same as `Minimap.FindFlag()` but without the need for parameters.

Example:
```pascal
WriteLn Minimap.HasFlag();
```
*)
function TMinimap.HasFlag(): Boolean;
var
  p: TPoint;
begin
  Result := Self.FindFlag(p);
end;

(*
## Minimap.WaitFlag
```pascal
function TMinimap.WaitFlag(time: Integer = 600; interval: Integer = -1): Boolean;
```
Returns True/False if the minimap walking flag becomes (or already is) visible
within `time` milliseconds.

Example:
```pascal
pt := Minimap.RandomPoint(Minimap.Center, 30);
Mouse.Click(pt, EMouseButton.LEFT);
WriteLn Minimap.WaitFlag(2000);
```
*)
function TMinimap.WaitFlag(time: Integer = 600; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.HasFlag(), interval, time);
end;


(*
## Minimap.CountColor
```pascal
function TMinimap.CountColor(color: TColor; tolerance: Single = 0): Integer;
function TMinimap.CountColor(color: TColorTolerance): Integer; overload;
```
Counts the specified `color` on the {ref}`Minimap`.

Example:
```pascal
WriteLn Minimap.CountColor($FFFFFF);
```
*)
function TMinimap.CountColor(color: TColor; tolerance: Single = 0): Integer;
var
  tpa: TPointArray;
begin
  tpa := Target.FindColor(color, tolerance, Self.Bounds);
  Result := tpa.ExtractPolygon(Self.Polygon).Length;
end;

function TMinimap.CountColor(color: TColorTolerance): Integer; overload;
var
  tpa: TPointArray;
begin
  tpa := Target.FindColor(color, Self.Bounds);
  Result := tpa.ExtractPolygon(Self.Polygon).Length;
end;


(*
## Minimap.ColorPercent
```pascal
function TMinimap.ColorPercent(color: TColor; tolerance: Single = 0): Single;
function TMinimap.ColorPercent(color: TColorTolerance): Single; overload;
```
Counts the percentage of the specified `color` on the {ref}`Minimap`.

Example:
```pascal
WriteLn Minimap.ColorPercent($FFFFFF);
```
*)
function TMinimap.ColorPercent(color: TColor; tolerance: Single = 0): Single;
var
  count: Integer;
begin
  count := Self.CountColor(color, tolerance);
  Result := count / Self.Polygon.Area();
end;

function TMinimap.ColorPercent(color: TColorTolerance): Single; overload;
var
  count: Integer;
begin
  count := Self.CountColor(color);
  Result := count / Self.Polygon.Area();
end;


(*
## Minimap.Normalize
```pascal
function TMinimap.Normalize(pt: TPoint; angle: Single): TPoint;
function TMinimap.NormalizeEx(vector: Vector2; angle: Single): Vector2;
```
Normalizes minimap coordinates to 0º.
Basically, whatever `pt` or `vector` you pass into this, will be rotated to it's
position on the minimap at 0º.
`angle` should be in radians.

Example:
```pascal
pt := Minimap.RandomPoint(Minimap.Center, 30);
angle := Minimap.CompassRadians;
pt := Minimap.Normalize(pt, angle);
ShowOnTarget(TCircle.Create(pt.X, pt.Y, 6));
```
*)
function TMinimap.Normalize(pt: TPoint; angle: Single): TPoint;
begin
  with pt.Rotate(-angle, Self.Center) do
  begin
    Result.X := Round((X - Self.Center.X) / 4) * 4 + Self.Center.X;
    Result.Y := Round((Y - Self.Center.Y) / 4) * 4 + Self.Center.Y;
  end;
end;

function TMinimap.NormalizeEx(vector: TVector2; angle: Single): TVector2;
begin
  with vector.Rotate(-angle, Self.Center.X, Self.Center.Y) do
  begin
    Result.X := Round((X - Self.Center.X) / 4) * 4 + Self.Center.X;
    Result.Y := Round((Y - Self.Center.Y) / 4) * 4 + Self.Center.Y;
  end;
end;


(*
## Minimap.GetDots
```pascal
function TMinimap._GetDots(dot: EDot; img: TImage; offset: TPoint): TPointArray;
function TMinimap.GetDots(dot: EDot; bounds: TBox): TPointArray;
function TMinimap.GetDots(dot: EDot): TPointArray; overload;
function TMinimap.GetDots(dots: EDots; bounds: TBox): TDotArray; overload;
function TMinimap.GetDots(dots: EDots = [EDot.PLAYER, EDot.NPC, EDot.ITEM]): TDotArray; overload;
```
Returns minimap dots found.
You can specify which dots you want to look for in `dot` or `dots`.
You can also optionalyl specify `bounds` to returns minimap dots from just a region of the minimap.

For example, this is how you can find NPC dots and debug them:
```pascal
{$I WaspLib/main.simba}

var
  pt: TPoint;
  boxes: TBoxArray;
begin
  for pt in Minimap.GetDots(EDot.NPC) do
    boxes += TBox.Create(pt, 3, 3);
  ShowOnTarget(boxes);
end.
```

Your result should look something like this on the minimap:
```{figure} ../../images/npcdots.png
```

Finding minimap dots accurately is quite complex as they can overlap each other
and the way WaspLib does it is not perfect.

It basically comes down to whether you want a simple solution that people can
reason with or something complex that does it accurately.
WaspLib goes with the first option.

This means that depending on the type of {ref}`EDot` you are trying to
find and the {ref}`EClient` you are using, you might get 2 `TPoints` per dot.

This is because the way it works is as follows:
- We try to find the 2 bottom center pixels (blue square on the image below)
- These 2 pixels are always guaranteed to be visible and any other combination of pixels can be covered by other dots overlapping when there's too many
- When we find those 2 pixels, we return the top left center pixel of the dot (green cross below)
```{figure} ../../images/minimap_getdots_java.png
```

However, with `EDot.PLAYER` and every dot on `EClient.OFFICIAL` you
have the following issue:
```{figure} ../../images/minimap_getdots_cpp.png
```
The 2 bottom center pixels are not unique anymore which makes it so you get 2 points returned per dot
(the 2 green crosses)

So do have that in mind when writing your scripts.
*)
function TMinimap._GetDots(dot: EDot; img: TImage; offset: TPoint): TPointArray; static;
const
  COLORS: array [EClient] of array [EDot] of array [0..1] of TColor = [
    //PLAYER              NPC                 ITEM
    [[$FEFEFE, $ECECEC], [$02FCFC, $00EDED], [$0606FC, $0000F1]], //UNKNOWN
    [[$FEFEFE, $ECECEC], [$02FCFC, $00EDED], [$0606FC, $0000F1]], //LEGACY
    [[$FEFEFE, $ECECEC], [$02FCFC, $00EDED], [$0606FC, $0000F1]], //RUNELITE
    [[$FEFEFE, $ECECEC], [$00F1FE, $00DFEC], [$0000FE, $0000EC]]  //OFFICIAL
  ];
var
  y,x: Integer;
  color0, color1: TColor;
begin
  color0 := COLORS[Client.Typ][dot][0];
  color1 := COLORS[Client.Typ][dot][1];

  for y := 0 to img.Height-2 do
    for x := 0 to img.Width-2 do
    begin
      if img.Pixel[x,y] <> color0 then
        Continue;
      if img.Pixel[x+1,y] <> color1 then
        Continue;
      //TODO: maybe confirm dot shadow or confirm other dots in range.
      //Some dots are detected twice, especially players.
      Result += [x + offset.X, y + offset.Y-1];
    end;
end;

function TMinimap.GetDots(dot: EDot; bounds: TBox): TPointArray;
var
  img: TImage;
begin
  bounds := bounds.Clip(Self._PolyBounds);
  img := Target.GetImage(bounds);
  Result := Self._GetDots(dot, img, bounds.TopLeft);
end;

function TMinimap.GetDots(dot: EDot): TPointArray; overload;
begin
  Result := Self.GetDots(dot, Self._PolyBounds);
end;

function TMinimap.GetDots(dots: EDots; bounds: TBox): TDotArray; overload;
var
  dot: EDot;
  img: TImage;
begin
  bounds := bounds.Clip(Self._PolyBounds);
  img := Target.GetImage(bounds);

  for dot in dots do
    Result[dot] := Self._GetDots(dot, img, bounds.TopLeft);
end;

function TMinimap.GetDots(dots: EDots = ALL_DOTS): TDotArray; overload;
begin
  Result := Self.GetDots(dots, Self._PolyBounds);
end;


(*
## Minimap.GetCleanMask
```pascal
function TMinimap.GetCleanMask(img: TImage): TPointArray;
```
Returns a TPA of a mask to clean the minimap.
*)
function TMinimap.GetCleanMask(img: TImage): TPointArray;

  function _DotTPA(pt: TPoint; bounds: TBox): TPointArray;
  var
    q: TPoint;
  begin
    if bounds.Contains(pt) then
      Exit([
        pt.Offset(0,-1), pt.Offset(1,-1),
        pt.Offset(-1,0), pt, pt.Offset(1,0), pt.Offset(2,0),
        pt.Offset(-1,1), pt.Offset(0,1), pt.Offset(1,1), pt.Offset(2,1),
        pt.Offset(0,2), pt.Offset(1,2),
        pt.Offset(-1,2), pt.Offset(2,2), pt.Offset(0,3), pt.Offset(1,3)
      ]);

    q := pt.Offset(0,-1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(1,-1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(-1,0);
    if bounds.Contains(q) then Result += q;

    Result += pt;

    q := pt.Offset(1,0);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(2,0);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(-1,1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(0,1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(1,1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(2,1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(0,2);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(1,2);
    if bounds.Contains(q) then Result += q;

    q := pt.Offset(-1,2);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(2,2);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(0,3);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(1,3);
    if bounds.Contains(q) then Result += q;
  end;

var
  pt: TPoint;
  bounds: TBox;
  dot: EDot;
begin
  bounds := [1,1,img.Width-2, img.Height-2];

  for dot := EDot.PLAYER to EDot.ITEM do
    for pt in Self._GetDots(dot, img, [0,0]) do
      Result += _DotTPA(pt, bounds);

  with img.Center do
  begin
    Result += [X,Y];
    Result += [X-1,Y];
    Result += [X+1,Y];
    Result += [X,Y+1];
    Result += [X+1,Y+1];
    Result += [X-1,Y+1];
    Result += [X,Y-1];
    Result += [X-1,Y-1];
    Result += [X+1,Y-1];
  end;

  Result += img.FindColor($0000FF, 0); //flag
  Result += img.FindColor($1C4BC4, 0); //flag on gpu
  Result += img.FindColor($152F5C, 0); //flag on gpu
  Result += img.FindColor($0456C6, 0); //idk ask slacky/olly
  Result += img.FindColor($11335D, 0); //idk ask slacky/olly
  Result += img.FindColor($010000, 0); //replaced black
end;


(*
## Minimap.CleanImage
```pascal
function TMinimap.CleanImage(img: TImage; radius: Integer): TImage;
```
Cleans a TImage of the {ref}`Minimap` you pass into it.
"Clean" means that minimap dots, the running flag and a few other things are
removed and the colors around it will be blended in.

The image i

Example:
```pascal
{$I WaspLib/main.simba}

var
  before, after, combined: TImage;
begin
  before := Target.GetImage(Minimap.Bounds);
  after := Minimap.CleanImage(before.Copy(), 65);

  combined := new TImage(before.Width*2, before.Height);

  combined.DrawImage(before, [0,0]);
  combined.DrawImage(after, [before.Width+1, 0]);
  combined.Show();
end.
```

```{figure} ../../images/mmclean.png
```
*)
function TMinimap.CleanImage(img: TImage): TImage;
begin
  Result := img.Blend(Self.GetCleanMask(img).SortFrom(img.Center), 6);
end;

(*
## Minimap.GetCleanImage
```pascal
function TMinimap.GetCleanImage(angle: Single = $FFFF; radius: Integer = -1): TImage;
```
Returns a clean `TImage` of the {ref}`Minimap`.

Read {ref}`Minimap.CleanImage` for more information.

Unlike {ref}`Minimap.CleanImage`, the `TImage` returned is rotated to 0º as you
can see in the following example:
```pascal
{$I WaspLib/main.simba}

var
  img: TImage;
begin
  while True do
  begin
    img := Minimap.GetCleanImage();
    img.Show();
  end;
end.
```

```{figure} ../../images/mmcleaned.gif
```
*)
function TMinimap.GetCleanImage(angle: Single = $FFFF; radius: Integer = -1): TImage;
var
  img, clean: TImage;
  center: TPoint;
begin
  if angle = $FFFF then angle := Self.CompassRadians;

  img := Target.GetImage(Self.Bounds);
  img.ReplaceColor($0, $1, 0.23);

  clean := Self.CleanImage(img);

  center := clean.Center;
  if Client.Mode = EMode.FIXED then
    center := center.Offset(0, -8)
  else
    center := center.Offset(-2, -1);

  if radius = -1 then
    clean.Crop(TBox.Create(center, Self.Radius, Self.Radius))
  else
    clean.Crop(TBox.Create(center, radius, radius));

  Result := clean.Rotate(EImageRotateAlgo.BILINEAR, angle, False);
end;


(*
## Minimap.ScaleMinimap
```pascal
function TMinimap.ScaleMinimap(img: TImage; scaling: Integer; radius: Integer = -1): TImage;
```
Scales down a minimap TImage passed in the `img` parameter.

Example:
```pascal
{$I WaspLib/main.simba}

var
  img, downscaled: TImage;
begin
  img := Minimap.GetCleanImage();
  downscaled := Minimap.ScaleMinimap(img, 4);
  downscaled.Show();
end.
```

And this should be the result you see:
```{figure} ../../images/mmdownscale.png
```

As you can see, it's pretty small, if we zoom it in 800% it should look
something like this:
```{figure} ../../images/mmdownscale2.png
```
*)
function TMinimap.ScaleMinimap(img: TImage; scaling: Integer; radius: Integer = -1): TImage;
var
  tpa: TPointArray;
begin
  Result := img.Copy();

  if radius = -1 then
    radius := Self.Radius;

  Result.Crop(TBox.Create(Result.Center, radius, radius));
  tpa := Result.FindColor($0, 0).SortFrom(Result.Center);

  Result := Result.Blend(tpa, 8);
  if scaling > 1 then
    Result := Result.Resize(EImageResizeAlgo.BOX, 1/scaling);

  Result.DrawColor := $0;
  Result.DrawCircleInverted(Result.Center, radius div scaling);
end;


(*
## Minimap.IsPlayerMoving
```pascal
function TMinimap.IsPlayerMoving(minShift: Integer = 500): Boolean;
```
Returns whether the player is moving or not according to the specified minimum
pixel shift.

Example:
```pascal
WriteLn Minimap.IsPlayerMoving();
```
*)
function TMinimap.IsPlayerMoving(minShift: Integer = 500): Boolean;
begin
  Result := Target.GetPixelDifference(300, TBox.Create(Self.Center, 40, 40)).Length >= minShift;
end;

(*
## Minimap.WaitMoving
```pascal
procedure TMinimap.WaitMoving(time: Integer = 20000; minShift: Integer = 500);
```
To put it simply, waits `time` milliseconds for {ref}`Minimap.IsPlayerMoving` to
return false with the specified `minShift`.

Example:
```pascal
WriteLn Minimap.WaitMoving();
```
*)
procedure TMinimap.WaitMoving(time: Integer = 20000; minShift: Integer = 500);
var
  timeout, countdown: TCountDown;
  moving: Boolean;
begin
  timeout.Start(time);
  countdown.Start(500);

  repeat
    moving := Self.IsPlayerMoving(minShift);
    if moving then countdown.Restart(0, 1000);
  until timeout.IsFinished or (not moving and countdown.IsFinished) or not Self.HasFlag();
end;

var
(*
## Minimap variable
Global {ref}`TMinimap` variable.
*)
  Minimap: TMinimap;
