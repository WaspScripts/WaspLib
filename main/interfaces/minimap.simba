(*
## Minimap Orbs Statuses and States
The following are methods to interact and read information from the
{ref}`Minimap` {ref}`EMinimapOrb` orbs.
*)

(*
### Minimap Status
Methods to retrieve {ref}`Minimap` {ref}`EMinimapOrb` orbs statuses.
*)

(*
#### Minimap.HasPoison
```pascal
function TMinimap.HasPoison(): Boolean;
```
Returns whether the `EMinimapOrb.HITPOINTS` has the poison status.

Example:
```pascal
WriteLn Minimap.HasPoison();
```
*)
function TMinimap.HasPoison(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.HITPOINTS].Circle.Bounds do
    b := [X1+3, Y2-4, X2-3, Y2+1];

  Result := Target.HasColor($004007, 8, 1, b);
end;

(*
#### Minimap.HasVenom
```pascal
function TMinimap.HasVenom(): Boolean;
```
Returns whether the `EMinimapOrb.HITPOINTS` has the venom status.

Example:
```pascal
WriteLn Minimap.HasVenom();
```
*)
function TMinimap.HasVenom(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.HITPOINTS].Circle.Bounds do
    b := [X1+3, Y2-4, X2-3, Y2+1];
  Result := Target.HasColor([$2D351B, 8.330, EColorSpace.HSV, [0.882, 1.148, 0.971]], 1, b);
end;

(*
#### Minimap.HasStamina
```pascal
function TMinimap.HasStamina(): Boolean;
```
Returns whether the `EMinimapOrb.ENERGY` has the stamina status.

Example:
```pascal
WriteLn Minimap.HasStamina();
```
*)
function TMinimap.HasStamina(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.ENERGY].Circle.Center do
    b := TBox.Create([X,Y], 4, 4);
  Result := Target.HasColor([$2D61C1, 1.475, EColorSpace.HSV, [2.455, 0.300, 0.247]], 1, b);
end;

(*
#### Minimap.HasSpecial
```pascal
function TMinimap.HasSpecial(): Boolean;
```
Returns whether the `EMinimapOrb.SPECIAL` has the special status, in other
words, whether the current weapon is a special attack weapon or not.

Example:
```pascal
WriteLn Minimap.HasSpecial();
```
*)
function TMinimap.HasSpecial(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.SPECIAL].Circle.Bounds do
    b := [X1+3, Y2-4, X2-3, Y2];
  Result := Target.HasColor([$6A6330, 12.309, EColorSpace.HSV, [1.620, 0.532, 0.850]], 1, b);
end;


(*
### Minimap States
Methods to retrieve {ref}`Minimap` {ref}`EMinimapOrb` orbs states.
*)

(*
#### Minimap.PrayerEnabled
```pascal
function TMinimap.PrayerEnabled(): Boolean;
```
Returns whether the `EMinimapOrb.PRAYER` is enabled or not.

Example:
```pascal
WriteLn Minimap.PrayerEnabled();
```
*)
function TMinimap.PrayerEnabled(): Boolean;
begin
  Result := Target.HasColor(ColorTolerance($2188AB, 10.980, EColorSpace.HSV, [1.317, 1.076, 0.609]), 8, Self.Orbs[EMinimapOrb.PRAYER].Circle.Bounds);
end;

(*
#### Minimap.EnergyEnabled
```pascal
function TMinimap.EnergyEnabled(): Boolean;
```
Returns whether the `EMinimapOrb.ENERGY` is enabled or not.

Example:
```pascal
WriteLn Minimap.EnergyEnabled();
```
*)
function TMinimap.EnergyEnabled(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.ENERGY].Circle.Bounds do
    b := [X1+3, Y2-3, X2-3, Y2];

  Result := Target.HasColor([$2A6C8E, 9.954, EColorSpace.HSV, [1.771, 0.726, 0.505]], 8, b);
end;

(*
#### Minimap.SpecialEnabled
```pascal
function TMinimap.SpecialEnabled(): Boolean;
```
Returns whether the `EMinimapOrb.SPECIAL` is enabled or not.

Example:
```pascal
WriteLn Minimap.SpecialEnabled();
```
*)
function TMinimap.SpecialEnabled(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.SPECIAL].Circle.Bounds do
    b := [X1+3, Y2-4, X2-3, Y2];
  Result := Target.HasColor([$718B63, 8.414, EColorSpace.HSV, [0.258, 0.495, 2.249]], 8, b);
end;


(*
## Minimap.GetPercent
```pascal
function TMinimap.GetPercent(orb: EMinimapOrb): Integer;
```
Returns the percent remaining of the specified `orb`.

Example:
```pascal
WriteLn Minimap.GetPercent(EMinimapOrb.HITPOINTS);
```
*)
function TMinimap.GetPercent(orb: EMinimapOrb): Integer;
var
  tpa: TPointArray;
  col: TColorTolerance;
begin
  case orb of
    EMinimapOrb.HITPOINTS:
    begin
      col := ColorTolerance($030575, 1.242, EColorSpace.RGB, [0.064, 1.068, 1.869]);
      if Self.HasPoison  then col := ColorTolerance($02851C, 1.688, EColorSpace.LCH, [0.201, 0.166, 2.635]);
      if Self.HasVenom then col := ColorTolerance($27361A, 0.983, EColorSpace.LCH, [0.227, 0.346, 2.428]);
    end;
    EMinimapOrb.PRAYER:
    begin
      col := ColorTolerance($42232D, 2.354, EColorSpace.HSL, [1.309, 1.314, 0.378]);
      if Self.PrayerEnabled then col := ColorTolerance($643940, 6.384, EColorSpace.HSV, [1.045, 1.532, 0.424]);
    end;
    EMinimapOrb.ENERGY:  Exit(Self.GetLevel(orb));
    EMinimapOrb.SPECIAL: Exit(Self.GetLevel(orb));
  end;

  tpa := Target.FindColor(col, Self.Orbs[orb].Circle.Bounds.Expand(1));
  if Length(tpa) < 1 then Exit;
  tpa := tpa.SortByY(True);
  Result := Round(((tpa[High(TPA)].Y-tpa[0].Y)/25)*100);
end;

