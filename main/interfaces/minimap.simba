

{$DEFINE WL_MINIMAP_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  EDot  = enum(PLAYER, NPC, ITEM);
  EDots = set of EDot;
  TDotArray = array [EDot] of TPointArray;

const
  ALL_DOTS: EDots = [EDot.PLAYER, EDot.NPC, EDot.ITEM];

type

  EMinimapOrb = enum(HITPOINTS, PRAYER, ENERGY, SPECIAL);

  TMinimapOrb = record
    Bounds : TBox;
    Circle : TCircle;
  end;


  TMinimap = record
    Orbs: array of TMinimapOrb;
    Bounds, _PolyBounds: TBox;
    Center: TPoint;
    Radius: Integer;
    Polygon: TPolygon;

    Compass: record
      Circle: TCircle;
      Accuracy: Single;
    end;

    Mask: TPointArray;

    const FLAG: TImage = ImageFromString('IMG:AQAAAAIAAAACAAAAAAAAAIDjPwEAAAAA7joBAAEAAACQ4z8BAAAAALEMAQABAAAAgH8GCQAAAAAAiAYJAAAAAAgAAAAIAAAAgH8GCQAAAAABAAAAAgAAAAIAAAAYAAAAAAAAAAAAAAAAAAAAAwAAABgIEAgICAAAAAEAAAIAAAAAAAAAAAAAAAAAAAAAiVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAFUlEQVR4nGP4z8AQayzIcCyMBUgBABrmA2K2r4OdAAAAAElFTkSuQmCC');
  end;


procedure TMinimap.SetupInterface();
var
  img: TImage;
  tpa: TPointArray;
  i: Integer;
begin
  MainScreen.Mask.DrawColor := $FFFFFF;

  case Client.Mode of
    EMode.RESIZABLE, EMode.MODERN_COMPACT, EMode.MODERN_WIDE:
    begin
      img := new TImage(WLEnv.AssetsDir + 'images' + PATH_SEP + 'mm_resizable_mask.png');
      Self.Mask := img.FindColor($0, 0).Invert().Grow(3).ExtractBox([0, 0, img.Width-1, img.Height-1]);

      with Client.Bounds do
      begin
        Self.Bounds.X1 := X2 - 157;
        Self.Bounds.X2 := X2 - 6;
        Self.Bounds.Y1 := Y1 + 8;
        Self.Bounds.Y2 := Y1 + 159;
      end;

      Self.Radius := 71;
    end;

    EMode.FIXED:
    begin
      img := new TImage(WLEnv.AssetsDir + 'images' + PATH_SEP + 'mm_fixed_mask.png');
      Self.Mask := img.FindColor($0, 0).Invert().Grow(3).ExtractBox([0, 0, img.Width-1, img.Height-1]);

      with Client.Bounds do
      begin
        Self.Bounds.X1 := X2 - 194;
        Self.Bounds.X2 := X2 - 50;
        Self.Bounds.Y1 := Y1 + 9;
        Self.Bounds.Y2 := Y1 + 159;
      end;

      Self.Radius := 65;
    end;
  end;

  with Self.Bounds do
    case Client.Mode of
      EMode.RESIZABLE, EMode.MODERN_COMPACT, EMode.MODERN_WIDE:
      begin
        Self.Compass.Circle := [X1 - 2,  Y1 + 14,  17];
        Self.Orbs[EMinimapOrb.HITPOINTS].Circle := [X1 - 13, Y1 + 56,  12];
        Self.Orbs[EMinimapOrb.PRAYER].Circle    := [X1 - 14, Y1 + 89,  12];
        Self.Orbs[EMinimapOrb.ENERGY].Circle    := [X1 - 3,  Y1 + 122, 12];
        Self.Orbs[EMinimapOrb.SPECIAL].Circle   := [X1 + 18, Y1 + 147, 12];
        tpa := [[0, -76], [21, -73], [40, -64], [56, -51], [68, -33], [75, -1], [67, 34], [52, 43], [40, 62], [21, 72], [0, 75], [-21, 72], [-40, 62], [-56, 49], [-68, 31], [-75, -1], [-68, -33], [-56, -51], [-40, -64], [-21, -73]];
      end;

      EMode.FIXED:
      begin
        Self.Compass.Circle := [X1 - 9,  Y1 + 11,  16];
        Self.Orbs[EMinimapOrb.HITPOINTS].Circle := [X1 - 15, Y1 + 48,  12];
        Self.Orbs[EMinimapOrb.PRAYER].Circle    := [X1 - 15, Y1 + 82,  12];
        Self.Orbs[EMinimapOrb.ENERGY].Circle    := [X1 - 4,  Y1 + 115, 12];
        Self.Orbs[EMinimapOrb.SPECIAL].Circle   := [X1 + 17, Y1 + 140, 12];
        tpa := [[21, -71], [39, -62], [55, -49], [67, -32], [70, 0], [66, 19], [57, 32], [41, 43], [20, 58], [12, 71], [0, 74], [-11, 72], [-24, 55], [-47, 39], [-60, 31], [-66, 22], [-71, 0], [-72, -14], [-67, -32], [-55, -49], [-39, -62], [-21, -71], [0, -74]];
      end;
    end;

  MainScreen.Mask.DrawCircleFilled(Self.Compass.Circle.Expand(4));

  for i := 0 to High(Self.Orbs) do
  begin
    with Self.Orbs[i].Circle do
      Self.Orbs[i].Bounds := TBox.Create(X-35, Y-1, X-15, Y+9);
    MainScreen.Mask.DrawCircleFilled(Self.Orbs[i].Circle.Expand(6));
  end;

  with Self.Orbs[EMinimapOrb.HITPOINTS].Bounds do
    MainScreen.Mask.DrawBoxFilled([X1 - 5, Y1 - 6, X2 + 7, Y2 + 5]);
  with Self.Orbs[EMinimapOrb.PRAYER].Bounds do
    MainScreen.Mask.DrawBoxFilled([X1 - 4, Y1 - 5, X2 + 7, Y2 + 6]);
  with Self.Orbs[EMinimapOrb.ENERGY].Bounds do
    MainScreen.Mask.DrawBoxFilled([X1 - 5, Y1 - 6, X2 + 7, Y2 + 5]);
  with Self.Orbs[EMinimapOrb.SPECIAL].Bounds do
    MainScreen.Mask.DrawBoxFilled([X1 - 4, Y1 - 6, X2 + 7, Y2 + 5]);

  Self.Center := Self.Bounds.Center;
  Self.Polygon := tpa.Offset(Self.Center);
  Self._PolyBounds := Self.Polygon.Bounds();
  MainScreen.Mask.DrawPolygonFilled(Self.Polygon.Expand(9));
  MainScreen.Mask.DrawCircleFilled(Self.Center.Offset(63,56), 14);
end;


function TMinimap.Contains(pt: TPoint): Boolean;
begin
  Result := Self.Polygon.Contains(pt);
end;


function TMinimap.Filter(tpa: TPointArray): TPointArray;
begin
  Result := tpa.ExtractPolygon(Self.Polygon);
end;



function TMinimap.RandomPoint(pt: TPoint; randomness: Integer): TPoint;
begin
  if not Self.Polygon.Contains(pt) then
    raise GetDebugLn('Minimap', ToStr(pt) + ' is not a valid point to generate a random point.');

  repeat
    Result := pt.Random(-randomness, randomness);
  until Self.Polygon.Contains(Result);
end;





property TMinimap.CompassRadians: Single;
var
  center: TPoint;
  bounds: TBox;
  north,south,west,east: TPoint;
  Nclr, dials, southArr, westArr, eastArr: TPointArray;
  n,w,e,s,x,y: Single;
begin
  center := Self.Compass.Circle.Center;
  bounds := Self.Compass.Circle.Bounds;

  dials := Target.FindColor($26259C,  12, bounds); //red
  Nclr  := Target.FindColor($1D2931, 0.6, bounds); //N

  dials := dials.ExtractDist(center, 10, 20);
  north := Nclr.ExtractDist(center, 0,20).Mean();

  southArr := dials.ExtractDist(north, 21, 50);
  south    := southArr.FurthestPoint(center);

  dials  := dials.Difference(southArr);

  for dials in dials.Cluster(3) do
  begin
    if CrossProduct(dials.Mean(), north, south) > 0 then
      westArr := dials
    else
      eastArr := dials;
  end;

  west := westArr.FurthestPoint(eastArr.Mean());
  east := eastArr.FurthestPoint(westArr.Mean());

  n := ArcTan2(north.Y-center.Y, north.X-center.X) + HALF_PI;
  s := ArcTan2(south.Y-center.Y, south.X-center.X) - HALF_PI;
  w := ArcTan2(west.Y-center.Y, west.X-center.X) + PI;
  e := ArcTan2(east.Y-center.Y, east.X-center.X);

  x := Cos(s) + Cos(e) + Cos(w) + Cos(n);
  y := Sin(s) + Sin(e) + Sin(w) + Sin(n);

  Result := ArcTan2(y/4, x/4);
  if Result < 0 then
    Result := Result + TAU;
end;

property TMinimap.CompassRadians(radians: Single): Boolean;
const
  RAD_PER_PIXEL: Single = 162.2004206;
var
  available: TBox;
  remain, oneDeg: Single;
  clockwise: Boolean;
  destination: TPoint;
  pixels: Integer;
  timeout: UInt64;
begin
  available := Client.Bounds.Expand(-10);
  radians := RadNormalize(radians);
  timeout := Time() + RandomMean(6000, 8000);
  oneDeg := DegToRad(1);

  repeat
    remain := DeltaAngle(Self.CompassRadians, radians, TAU);
    if Abs(remain) <= Self.Compass.Accuracy then
      Exit(True);

    pixels := Round(Abs(remain) * RAD_PER_PIXEL);
    clockwise := InRange(remain, oneDeg, PI) or (remain < -PI);

    if clockwise then
    begin
      if (not available.Contains(Target.MouseXY)) or ((Target.MouseY + 200 > available.Y2) or (Target.MouseX + pixels > available.X2)) then
        Mouse.Move([available.X1, available.Y1, available.X1 + 200, available.Y1 + 200]);

      destination.X := Target.MouseX + pixels;
    end
    else
    begin
      if (not available.Contains(Target.MouseXY)) or ((Target.MouseY + 200 > available.Y2) or (Target.MouseX - pixels < available.X1)) then
        Mouse.Move([available.X2 - 200, available.Y1, available.X2, available.Y1 + 200]);

      destination.X := Target.MouseX - pixels;
    end;

    destination.Y := Random(Target.MouseY + 100, available.Y2);

    Mouse.Drag(destination, EMouseButton.MIDDLE);
    Biometrics.Sleep(100, 1000, ERandomDir.LEFT);
  until Time() > timeout;

  DebugLn('Minimap', 'Setting `CompassRadians` timed out.', ELogLevel.WARN);

  if not Client.IsLoggedIn() then
    Login.DoLogin()
  else
    DebugLn('Minimap', 'Make sure the setting "Middle mouse button controls the camera" is enabled in the game settings.', ELogLevel.WARN);
end;

property TMinimap.CompassRadians(minRadians, maxRadians: Single): Boolean;
var
  radians: Single;
begin
  radians := RandomMean(RadNormalize(minRadians), RadNormalize(maxRadians));
  Result := Self.CompassRadians := radians;
end;



property TMinimap.CompassDegrees: Single;
begin
  Result := RadToDeg(Self.CompassRadians);
end;

property TMinimap.CompassDegrees(degrees: Single): Boolean;
begin
  Result := Self.CompassRadians := DegToRad(degrees);
end;

property TMinimap.CompassDegrees(minDegrees, maxDegrees: Single): Boolean;
begin
  Result := Self.CompassRadians[DegToRad(minDegrees), DegToRad(maxDegrees)];
end;



function TMinimap.GetLevel(orb: EMinimapOrb): Integer;
begin
  Result := OCR.RecognizeShadow(Self.Orbs[orb].Bounds, Fonts.PLAIN_11, 0).ExtractInteger();
end;


function TMinimap.UnderLevel(orb: EMinimapOrb; level: Integer): Boolean;
begin
  Result := Self.GetLevel(orb) < level;
end;


function TMinimap.OverLevel(orb: EMinimapOrb; level: Integer): Boolean;
begin
  Result := Self.GetLevel(orb) > level;
end;


function TMinimap.GetRunEnergy(): Integer;
begin
  Result := Self.GetLevel(EMinimapOrb.ENERGY);
end;


function TMinimap.GetHPLevel(): Integer;
begin
  Result := Self.GetLevel(EMinimapOrb.HITPOINTS);
end;


function TMinimap.GetPrayerLevel(): Integer;
begin
  Result := Self.GetLevel(EMinimapOrb.PRAYER);
end;


function TMinimap.GetSpecLevel(): Integer;
begin
  Result := Self.GetLevel(EMinimapOrb.SPECIAL);
end;






function TMinimap.HasPoison(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.HITPOINTS].Circle.Bounds do
    b := [X1+3, Y2-4, X2-3, Y2+1];

  Result := Target.HasColor($004007, 8, 1, b);
end;


function TMinimap.HasVenom(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.HITPOINTS].Circle.Bounds do
    b := [X1+3, Y2-4, X2-3, Y2+1];
  Result := Target.HasColor([$2D351B, 8.330, EColorSpace.HSV, [0.882, 1.148, 0.971]], 1, b);
end;


function TMinimap.HasStamina(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.ENERGY].Circle.Center do
    b := TBox.Create([X,Y], 4, 4);
  Result := Target.HasColor([$2D61C1, 1.475, EColorSpace.HSV, [2.455, 0.300, 0.247]], 1, b);
end;


function TMinimap.HasSpecial(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.SPECIAL].Circle.Bounds do
    b := [X1+3, Y2-4, X2-3, Y2];
  Result := Target.HasColor([$6A6330, 12.309, EColorSpace.HSV, [1.620, 0.532, 0.850]], 1, b);
end;





function TMinimap.PrayerEnabled(): Boolean;
begin
  Result := Target.HasColor(ColorTolerance($2188AB, 10.980, EColorSpace.HSV, [1.317, 1.076, 0.609]), 8, Self.Orbs[EMinimapOrb.PRAYER].Circle.Bounds);
end;


function TMinimap.EnergyEnabled(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.ENERGY].Circle.Bounds do
    b := [X1+3, Y2-3, X2-3, Y2];

  Result := Target.HasColor([$2A6C8E, 9.954, EColorSpace.HSV, [1.771, 0.726, 0.505]], 8, b);
end;


function TMinimap.SpecialEnabled(): Boolean;
var
  b: TBox;
begin
  with Self.Orbs[EMinimapOrb.SPECIAL].Circle.Bounds do
    b := [X1+3, Y2-4, X2-3, Y2];
  Result := Target.HasColor([$718B63, 8.414, EColorSpace.HSV, [0.258, 0.495, 2.249]], 8, b);
end;



function TMinimap.GetPercent(orb: EMinimapOrb): Integer;
var
  tpa: TPointArray;
  col: TColorTolerance;
begin
  case orb of
    EMinimapOrb.HITPOINTS:
    begin
      col := ColorTolerance($030575, 1.242, EColorSpace.RGB, [0.064, 1.068, 1.869]);
      if Self.HasPoison  then col := ColorTolerance($02851C, 1.688, EColorSpace.LCH, [0.201, 0.166, 2.635]);
      if Self.HasVenom then col := ColorTolerance($27361A, 0.983, EColorSpace.LCH, [0.227, 0.346, 2.428]);
    end;
    EMinimapOrb.PRAYER:
    begin
      col := ColorTolerance($42232D, 2.354, EColorSpace.HSL, [1.309, 1.314, 0.378]);
      if Self.PrayerEnabled then col := ColorTolerance($643940, 6.384, EColorSpace.HSV, [1.045, 1.532, 0.424]);
    end;
    EMinimapOrb.ENERGY:  Exit(Self.GetLevel(orb));
    EMinimapOrb.SPECIAL: Exit(Self.GetLevel(orb));
  end;

  tpa := Target.FindColor(col, Self.Orbs[orb].Circle.Bounds.Expand(1));
  if Length(tpa) < 1 then Exit;
  tpa := tpa.SortByY(True);
  Result := Round(((tpa[High(TPA)].Y-tpa[0].Y)/25)*100);
end;


function TMinimap.GetHPPercent(): Integer;
begin
  Result := Self.GetPercent(EMinimapOrb.HITPOINTS);
end;


function TMinimap.GetPrayerPercent(): Integer;
begin
  Result := Self.GetPercent(EMinimapOrb.PRAYER);
end;


function TMinimap.Toggle(orb: EMinimapOrb): Boolean;
var
  state: Boolean;
begin
  case orb of
    EMinimapOrb.HITPOINTS: Exit;
    EMinimapOrb.PRAYER:  state := Self.PrayerEnabled();
    EMinimapOrb.ENERGY:  state := Self.EnergyEnabled();
    EMinimapOrb.SPECIAL:
      if not Self.HasSpecial() then
        Exit
      else
        state := Self.SpecialEnabled();
  end;

  Mouse.Click(Self.Orbs[orb].Circle, EMouseButton.LEFT);

  case orb of
    EMinimapOrb.HITPOINTS: Exit;
    EMinimapOrb.PRAYER:  Result := Self.PrayerEnabled() <> state;
    EMinimapOrb.ENERGY:  Result := Self.EnergyEnabled() <> state;
    EMinimapOrb.SPECIAL: Result := Self.SpecialEnabled() <> state;
  end;
end;



function TMinimap.EnablePrayer(): Boolean;
begin
  if Self.PrayerEnabled() then
    Exit(True);

  if Self.GetLevel(EMinimapOrb.PRAYER) <= 1 then
    Exit;

  Mouse.Click(Self.Orbs[EMinimapOrb.PRAYER].Circle, EMouseButton.LEFT, True);
  Result := SleepUntil(Self.PrayerEnabled(), 200, 2*TICK);
end;


function TMinimap.DisablePrayer(): Boolean;
begin
  if not Self.PrayerEnabled() then
    Exit(True);

  if Self.GetLevel(EMinimapOrb.PRAYER) <= 1 then
    Exit(True);

  Mouse.Click(Self.Orbs[EMinimapOrb.PRAYER].Circle, EMouseButton.LEFT, True);
  Result := SleepUntil(not Self.PrayerEnabled(), 200, 2*TICK);
end;



function TMinimap.CurePoison(): Boolean;
begin
  if not Self.HasPoison() then
    Exit(True);

  Mouse.Click(Self.Orbs[EMinimapOrb.HITPOINTS].Circle, EMouseButton.LEFT, True);
  Result := SleepUntil(not Self.HasPoison(), 200, 2*TICK);
end;


function TMinimap.CureVenom(): Boolean;
begin
  if not Self.HasVenom() then
    Exit(True);

  Mouse.Click(Self.Orbs[EMinimapOrb.HITPOINTS].Circle, EMouseButton.LEFT, True);
  Result := SleepUntil(not Self.HasVenom(), 200, 2*TICK);
end;



function TMinimap.EnableEnergy(): Boolean;
begin
  if Self.EnergyEnabled() then
    Exit(True);

  if Self.GetLevel(EMinimapOrb.ENERGY) <= 1 then
    Exit;

  Mouse.Click(Self.Orbs[EMinimapOrb.ENERGY].Circle, EMouseButton.LEFT, True);
  Result := SleepUntil(Self.EnergyEnabled(), 200, 2*TICK);
end;


function TMinimap.DisableEnergy(): Boolean;
begin
  if not Self.EnergyEnabled() then
    Exit(True);

  if Self.GetLevel(EMinimapOrb.ENERGY) <= 1 then
    Exit(True);

  Mouse.Click(Self.Orbs[EMinimapOrb.ENERGY].Circle, EMouseButton.LEFT, True);
  Result := SleepUntil(not Self.EnergyEnabled(), 200, 2*TICK);
end;




function TMinimap.EnableSpecial(level: Integer): Boolean;
begin
  if Self.SpecialEnabled() then
    Exit(True);

  if Self.HasSpecial() and (Self.GetLevel(EMinimapOrb.SPECIAL) >= level) then
  begin
    Mouse.Click(Self.Orbs[EMinimapOrb.SPECIAL].Circle, EMouseButton.LEFT, True);
    Result := SleepUntil(Self.SpecialEnabled(), 200, 2*TICK);
  end;
end;


function TMinimap.DisableSpecial(): Boolean;
begin
  if not Self.SpecialEnabled() or Self.HasSpecial() then
    Exit(True);

  Mouse.Click(Self.Orbs[EMinimapOrb.SPECIAL].Circle, EMouseButton.LEFT, True);
  Result := SleepUntil(not Self.SpecialEnabled(), 200, 2*TICK);
end;




function TMinimap.FindFlag(out pt: TPoint): Boolean;
begin
  pt := Target.FindImage(Self.FLAG, 0, Self.Bounds);
  Result := Self.Polygon.Contains(pt);
end;


function TMinimap.HasFlag(): Boolean;
var
  p: TPoint;
begin
  Result := Self.FindFlag(p);
end;


function TMinimap.WaitFlag(time: Integer = 600; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(Self.HasFlag(), interval, time);
end;



function TMinimap.CountColor(color: TColor; tolerance: Single = 0): Integer;
var
  tpa: TPointArray;
begin
  tpa := Target.FindColor(color, tolerance, Self.Bounds);
  Result := tpa.ExtractPolygon(Self.Polygon).Length;
end;

function TMinimap.CountColor(color: TColorTolerance): Integer; overload;
var
  tpa: TPointArray;
begin
  tpa := Target.FindColor(color, Self.Bounds);
  Result := tpa.ExtractPolygon(Self.Polygon).Length;
end;



function TMinimap.ColorPercent(color: TColor; tolerance: Single = 0): Single;
var
  count: Integer;
begin
  count := Self.CountColor(color, tolerance);
  Result := count / Self.Polygon.Area();
end;

function TMinimap.ColorPercent(color: TColorTolerance): Single; overload;
var
  count: Integer;
begin
  count := Self.CountColor(color);
  Result := count / Self.Polygon.Area();
end;



function TMinimap.Normalize(pt: TPoint; angle: Single): TPoint;
begin
  with pt.Rotate(-angle, Self.Center) do
  begin
    Result.X := Round((X - Self.Center.X) / 4) * 4 + Self.Center.X;
    Result.Y := Round((Y - Self.Center.Y) / 4) * 4 + Self.Center.Y;
  end;
end;

function TMinimap.NormalizeEx(vector: TVector2; angle: Single): TVector2;
begin
  with vector.Rotate(-angle, Self.Center.X, Self.Center.Y) do
  begin
    Result.X := Round((X - Self.Center.X) / 4) * 4 + Self.Center.X;
    Result.Y := Round((Y - Self.Center.Y) / 4) * 4 + Self.Center.Y;
  end;
end;



function TMinimap._GetDots(dot: EDot; img: TImage; offset: TPoint): TPointArray; static;
const
  COLORS: array [EClient] of array [EDot] of array [0..1] of TColor = [
    //PLAYER              NPC                 ITEM
    [[$FEFEFE, $ECECEC], [$02FCFC, $00EDED], [$0606FC, $0000F1]], //UNKNOWN
    [[$FEFEFE, $ECECEC], [$02FCFC, $00EDED], [$0606FC, $0000F1]], //LEGACY
    [[$FEFEFE, $ECECEC], [$02FCFC, $00EDED], [$0606FC, $0000F1]], //RUNELITE
    [[$FEFEFE, $ECECEC], [$00F1FE, $00DFEC], [$0000FE, $0000EC]]  //OFFICIAL
  ];
var
  y,x: Integer;
  color0, color1: TColor;
begin
  color0 := COLORS[Client.Typ][dot][0];
  color1 := COLORS[Client.Typ][dot][1];

  for y := 0 to img.Height-2 do
    for x := 0 to img.Width-2 do
    begin
      if img.Pixel[x,y] <> color0 then
        Continue;
      if img.Pixel[x+1,y] <> color1 then
        Continue;
      //TODO: maybe confirm dot shadow or confirm other dots in range.
      //Some dots are detected twice, especially players.
      Result += [x + offset.X, y + offset.Y-1];
    end;
end;

function TMinimap.GetDots(dot: EDot; bounds: TBox): TPointArray;
var
  img: TImage;
begin
  bounds := bounds.Clip(Self._PolyBounds);
  img := Target.GetImage(bounds);
  Result := Self._GetDots(dot, img, bounds.TopLeft);
end;

function TMinimap.GetDots(dot: EDot): TPointArray; overload;
begin
  Result := Self.GetDots(dot, Self._PolyBounds);
end;

function TMinimap.GetDots(dots: EDots; bounds: TBox): TDotArray; overload;
var
  dot: EDot;
  img: TImage;
begin
  bounds := bounds.Clip(Self._PolyBounds);
  img := Target.GetImage(bounds);

  for dot in dots do
    Result[dot] := Self._GetDots(dot, img, bounds.TopLeft);
end;

function TMinimap.GetDots(dots: EDots = ALL_DOTS): TDotArray; overload;
begin
  Result := Self.GetDots(dots, Self._PolyBounds);
end;



function TMinimap.GetCleanMask(img: TImage): TPointArray;

  function _DotTPA(pt: TPoint; bounds: TBox): TPointArray;
  var
    q: TPoint;
  begin
    if bounds.Contains(pt) then
      Exit([
        pt.Offset(0,-1), pt.Offset(1,-1),
        pt.Offset(-1,0), pt, pt.Offset(1,0), pt.Offset(2,0),
        pt.Offset(-1,1), pt.Offset(0,1), pt.Offset(1,1), pt.Offset(2,1),
        pt.Offset(0,2), pt.Offset(1,2),
        pt.Offset(-1,2), pt.Offset(2,2), pt.Offset(0,3), pt.Offset(1,3)
      ]);

    q := pt.Offset(0,-1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(1,-1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(-1,0);
    if bounds.Contains(q) then Result += q;

    Result += pt;

    q := pt.Offset(1,0);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(2,0);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(-1,1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(0,1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(1,1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(2,1);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(0,2);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(1,2);
    if bounds.Contains(q) then Result += q;

    q := pt.Offset(-1,2);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(2,2);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(0,3);
    if bounds.Contains(q) then Result += q;
    q := pt.Offset(1,3);
    if bounds.Contains(q) then Result += q;
  end;

var
  pt: TPoint;
  bounds: TBox;
  dot: EDot;
begin
  bounds := [1,1,img.Width-2, img.Height-2];

  for dot := EDot.PLAYER to EDot.ITEM do
    for pt in Self._GetDots(dot, img, [0,0]) do
      Result += _DotTPA(pt, bounds);

  with img.Center do
  begin
    Result += [X,Y];
    Result += [X-1,Y];
    Result += [X+1,Y];
    Result += [X,Y+1];
    Result += [X+1,Y+1];
    Result += [X-1,Y+1];
    Result += [X,Y-1];
    Result += [X-1,Y-1];
    Result += [X+1,Y-1];
  end;

  Result += img.FindColor($0000FF, 0); //flag
  Result += img.FindColor($1C4BC4, 0); //flag on gpu
  Result += img.FindColor($152F5C, 0); //flag on gpu
  Result += img.FindColor($0456C6, 0); //idk ask slacky/olly
  Result += img.FindColor($11335D, 0); //idk ask slacky/olly
  Result += img.FindColor($010000, 0); //replaced black
end;



function TMinimap.CleanImage(img: TImage): TImage;
begin
  Result := img.Blend(Self.GetCleanMask(img).SortFrom(img.Center), 6);
end;


function TMinimap.GetCleanImage(angle: Single = $FFFF; radius: Integer = -1): TImage;
var
  img, clean: TImage;
  center: TPoint;
begin
  if angle = $FFFF then angle := Self.CompassRadians;

  img := Target.GetImage(Self.Bounds);
  img.ReplaceColor($0, $1, 0.23);

  clean := Self.CleanImage(img);

  center := clean.Center;
  if Client.Mode = EMode.FIXED then
    center := center.Offset(0, -8)
  else
    center := center.Offset(-2, -1);

  if radius = -1 then
    clean.Crop(TBox.Create(center, Self.Radius, Self.Radius))
  else
    clean.Crop(TBox.Create(center, radius, radius));

  Result := clean.Rotate(EImageRotateAlgo.BILINEAR, angle, False);
end;



function TMinimap.ScaleMinimap(img: TImage; scaling: Integer; radius: Integer = -1): TImage;
var
  tpa: TPointArray;
begin
  Result := img.Copy();

  if radius = -1 then
    radius := Self.Radius;

  Result.Crop(TBox.Create(Result.Center, radius, radius));
  tpa := Result.FindColor($0, 0).SortFrom(Result.Center);

  Result := Result.Blend(tpa, 8);
  if scaling > 1 then
    Result := Result.Resize(EImageResizeAlgo.BOX, 1/scaling);

  Result.DrawColor := $0;
  Result.DrawCircleInverted(Result.Center, radius div scaling);
end;



function TMinimap.IsPlayerMoving(minShift: Integer = 500): Boolean;
begin
  Result := Target.GetPixelDifference(300, TBox.Create(Self.Center, 40, 40)).Length >= minShift;
end;


procedure TMinimap.WaitMoving(time: Integer = 20000; minShift: Integer = 500);
var
  timeout, countdown: TCountDown;
  moving: Boolean;
begin
  timeout.Start(time);
  countdown.Start(500);

  repeat
    moving := Self.IsPlayerMoving(minShift);
    if moving then countdown.Restart(0, 1000);
  until timeout.IsFinished or (not moving and countdown.IsFinished) or not Self.HasFlag();
end;

var

  Minimap: TMinimap;
