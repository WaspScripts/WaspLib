
{$DEFINE WL_LISTENERS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type

  TListener = record
    Name: String;
    Setup: procedure (trgt: TTarget) of object;
    Check: function (): Boolean of object;
  end;


  TListeners = record
    Interval: Integer;
    Thread: TThread;
    Running: Boolean;
    Listeners: array of TListener;
    Target: TTarget;
  end;


procedure TListeners.Add(
  name: String; setup: procedure (trgt: TTarget) of object;
  check: function (): Boolean of object
);
var
  i: Integer;
  tmp: String;
begin
  if Self.Running then
    raise GetDebugLn('Listeners', 'You can''t add listeners after `Listeners` is already running.');
  if name = '' then
    raise GetDebugLn('Listeners', 'When you add a listener it should have a name.');

  tmp := LowerCase(name);
  for i := 0 to High(Self.Listeners) do
    if LowerCase(Self.Listeners[i].Name) = tmp then
      Exit;

  if @check = nil then
    raise GetDebugLn('Listeners', 'When you add a listener it must have a `check` function.');

  Self.Listeners += [name, @setup, @check];
end;


procedure TListeners.Remove(name: String);
var
  i: Integer;
  tmp: String;
begin
  tmp := LowerCase(name);
  for i := 0 to High(Self.Listeners) do
    if LowerCase(Self.Listeners[i].Name) = tmp then
    begin
      Delete(Self.Listeners, i, 1);
      Break;
    end;
end;



procedure TListeners.Free();
begin
  Self.Running := False;
  if Self.Thread <> nil then
  begin
    Self.Thread.WaitForTerminate(5000);
    Self.Thread.Free();
  end;
  Self.Listeners := [];
end;


procedure TListeners.Setup();
var
  i: Integer;
begin
  if Self.Interval = 0 then
  begin
    WriteLn(#0#0'000004', GetTimeStamp(), ':[Listeners]: Interval cannot be 0.');
    RaiseException(#0#0'000004' + GetTimeStamp() + ':[Listeners]: Interval cannot be 0.');
  end;

  for i := 0 to High(Self.Listeners) do
    if @Self.Listeners[i].Setup <> nil then
      try
        Self.Listeners[i].Setup(Self.Target);
      except
        WriteLn(#0#0'000004', GetTimeStamp(), ':[Listeners]: ', Self.Listeners[i].Name, ' crashed:');
        WriteLn(#0#0'000004', GetExceptionMessage());
        RaiseException(GetExceptionMessage());
      end;

  if Self.Thread = nil then
    AddOnTerminate(@Self.Free);

  Self.Running := True;
end;


procedure TListeners.Start(params: TPointerArray);
var
  i, hi: Integer;
  t, total, avg: Int64;
begin
  if Self.Running then
    Exit;
  if Self.Target = nil then
    Self.Target := TTarget(params[0]^);
  Self.Setup();

  hi := High(Self.Listeners);
  avg := Self.Interval div (hi+1);

  repeat
    total := Time();
    for i := 0 to hi do
    begin
      t := Time();

      try
        Self.Listeners[i].Check();
      except
        WriteLn(#0#0'000004', GetTimeStamp(), ':[Listeners]: ', Self.Listeners[i].Name, ' crashed:');
        WriteLn(#0#0'000004', GetExceptionMessage());
        RaiseException(GetExceptionMessage());
      end;

      t := Time()-t;
      if t > avg then
      begin
        WriteLn(
          #0#0'000002', GetTimeStamp(), ':[Listeners]: ',
          Self.Listeners[i].Name, ' took ', t, 'ms to run.', LINE_SEP,
          #0#0'000002', 'This is slower than expected for your interval.'
        );
      end;
    end;

    t := Time()-total;
    if t <= Self.Interval then
    begin
      Sleep(Self.Interval-t);
      Continue;
    end;

    WriteLn(
      #0#0'000002', GetTimeStamp(), ':[Listeners]: Your listeners took ', t,
      'ms to run. This is slower than your interval.'
    );
  until not Self.Running;
end;


procedure TListeners.StartInThread(interval: Integer = 200);
begin
  Self.Target := new TTarget();

  {$IFNDEF WL_DISABLE_FAKE_INPUT}
  case Client.Typ of
    {$IFDEF WINDOWS}
    EClient.OFFICIAL:
      Self.Target.SetPlugin(
        {$MACRO LOADEDLIB(waspinput)}, ToStr(WaspInput.Window.GetPID())
      );
    {$ENDIF}
    EClient.LEGACY, EClient.RUNELITE:
      Self.Target.SetPlugin(
        {$MACRO LOADEDLIB(libremoteinput)}, ToStr(RemoteInput.Window.GetPID())
      );
    else
      Self.Target.SetWindow(GetSimbaTargetWindow());
  end;
  {$ELSE}
  Self.Target.SetWindow(GetSimbaTargetWindow());
  {$ENDIF}

  if Self.Running then
    raise GetDebugLn('Listeners', 'Already running.');
  Self.Interval := interval;
  Self.Thread := TThread.CreateEx(@Self.Start, []);
  AddOnTerminate(Self.Free);
end;

var

  Listeners: TListeners;

{%anchor WL_SYNC_LISTENERS}
{.$DEFINE WL_SYNC_LISTENERS}

procedure StartListeners(interval: Integer = 200);
begin

  LevelUpListener.OnLevelUp += @LevelUpListener.SaveScreenshot;
  LevelUpListener.OnLevelUp += @LevelUpListener.UpdateStats;
  Listeners.Add('LevelUpListener', @LevelUpListener.Setup, @LevelUpListener.Check);

  {$IFDEF WL_SYNC_LISTENERS}
  Listeners.Interval := interval;
  Listeners.Start([@Target]);
  {$ELSE}
  Listeners.StartInThread(interval);
  {$ENDIF}
end;
