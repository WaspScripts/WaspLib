

{$DEFINE WL_MAPLOADER_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

{%anchor WL_GENERATE_GRAPH_ALWAYS}
{.$DEFINE WL_GENERATE_GRAPH_ALWAYS}

{%anchor WL_DEBUG_MAPLOADER}
{.$DEFINE WL_DEBUG_MAPLOADER}

{$R-}

{$IFDEF RANGECHECKS}
begin
  DebugLn('MapLoader', 'Range checks are enabled for MapLoader, these should be disabled in production!', ELogLevel.WARN);
end;
{$ENDIF}

type

  TMapRegion = record
    Chunks: TPointArray;
    Original, Region: TBox;
    Plane: Integer;
    Offset: TPoint;
    Graph: TWebGraph;
    Heights: THeightMap;
  end;


property TMapRegion.Name: String;
begin
  with Self.Chunks.Bounds() do
    Result := ToStr(X1) + '-' + ToStr(Y1) + '_' + ToStr(X2) + '-' + ToStr(Y2) + '_p' + ToStr(Self.Plane);
end;

type

  EMap = enum(NORMAL, COLLISION);


  TMapLoader = record
    GraphsDir: String;
    Map, Collision, HalfMap: TImage;
    DownscaledMatrix: TIntegerMatrix;
    MapBox: TBox;
    Graph: TWebGraph;
    Regions: array of TMapRegion;
    Padding, Downscale: Integer;

    ChunkLoader: TMapChunkLoader;
    ChunkLoaderReady: Boolean;

    //one tile is this many map pixels
    const TILE_SIZE: Integer = 4;
  end;




function TMapLoader.LocalIndex(pt: TPoint): Integer;
begin
  for Result := 0 to High(Self.Regions) do
    if pt in Self.Regions[Result].Region then
      Exit;
  Result := -1;
end;


function TMapLoader.GlobalIndex(pt: TPoint): Integer;
begin
  for Result := 0 to High(Self.Regions) do
    if pt in Self.Regions[Result].Original then
      Exit;
  Result := -1;
end;



function TMapLoader.GetGlobal(regionIdx: Integer; pt: TPoint; offset: TPoint = [0,0]): TPoint;
begin
  Result := pt + Self.Regions[regionIdx].Offset - Self.Regions[regionIdx].Region.TopLeft + offset;
end;

function TMapLoader.GetGlobal(pt: TPoint; offset: TPoint = [0,0]): TPoint; overload;
var
  regionIdx: Integer;
begin
  regionIdx := Self.LocalIndex(pt);
  if regionIdx = -1 then Exit(pt);
  Result := Self.GetGlobal(regionIdx, pt, offset);
end;

function TMapLoader.GetGlobal(tpa: TPointArray; offset: TPoint = [0,0]): TPointArray; overload;
var
  i: Integer;
  delta: TPoint;
begin
  if tpa.IsEmpty then
    Exit;
  i := Self.LocalIndex(tpa[0]);
  if i = -1 then
    Exit(tpa);

  delta := Self.Regions[i].Offset - Self.Regions[i].Region.TopLeft + offset;
  SetLength(Result, Length(tpa));
  for i := 0 to High(tpa) do
    Result[i] := tpa[i] + delta;
end;



function TMapLoader.GetLocal(regionIdx: Integer; pt: TPoint; offset: TPoint = [0,0]): TPoint;
begin
  Result := pt - Self.Regions[regionIdx].Offset + Self.Regions[regionIdx].Region.TopLeft + offset;
end;

function TMapLoader.GetLocal(regionIdx: Integer; b: TBox; offset: TPoint = [0,0]): TBox; overload;
var
  topLeft, btmRight: TPoint;
begin
  topLeft  := Self.GetLocal(regionIdx, b.TopLeft, offset);
  btmRight := Self.GetLocal(regionIdx, b.BottomRight, offset);
  Result := [topLeft.X, topLeft.Y, btmRight.X, btmRight.Y];
end;

function TMapLoader.GetLocal(pt: TPoint; offset: TPoint = [0,0]): TPoint; overload;
var
  regionIdx: Integer;
begin
  regionIdx := Self.GlobalIndex(pt);
  if regionIdx = -1 then Exit(pt);
  Result := Self.GetLocal(regionIdx, pt, offset);
end;

function TMapLoader.GetLocal(tpa: TPointArray; offset: TPoint = [0,0]): TPointArray; overload;
var
  i: Integer;
begin
  SetLength(Result, Length(tpa));
  for i := 0 to High(tpa) do
    Result[i] := Self.GetLocal(tpa[i], offset);
end;



procedure TMapLoader.Free();
begin
  Self.Map := nil;
  Self.Collision := nil;
  Self.HalfMap := nil;
  Self.ChunkLoader := Default(TMapChunkLoader);
  Self.ChunkLoaderReady := False;
  Self.DownscaledMatrix := [];
  Self.MapBox := [];
  Self.Graph := [];
  Self.Regions := [];
  Self.Padding := 0;
  Self.Downscale := 0;
end;

procedure TMapLoader.Setup(downscale: UInt32);
begin
  Self.Downscale := downscale;
  AddOnTerminate(@Self.Free);

  if Self.GraphsDir = '' then
    Self.GraphsDir := WLEnv.CacheDir + 'map' + PATH_SEP + 'graphs' + PATH_SEP;
end;



procedure TMapLoader.SetupChunkLoader();
begin
  if Self.ChunkLoaderReady then
    Exit;

  CacheReader.Indices[ECacheIndex.MAPS].Cache();
  Self.ChunkLoader.MapData.Load();
  Self.ChunkLoaderReady := True;
end;


function TMapLoader.GetFile(chunk: T3DPoint; map: EMap): TImage;
begin
  if (map = EMap.COLLISION) and WebGraphGenerator.BlockedChunks.Contains(chunk) then
    Exit(new TImage(RSTranslator.MAP_CHUNK_SIZE, RSTranslator.MAP_CHUNK_SIZE));

  Self.SetupChunkLoader();

  if map = EMap.COLLISION then
    Exit(Self.ChunkLoader.GetChunkCollisionImage(chunk.X, chunk.Y, chunk.Z));

  Result := Self.ChunkLoader.GetChunkImage(chunk.X, chunk.Y, chunk.Z);
end;


function TMapLoader.GetMap(chunks: TPointArray; plane: Integer; map: EMap): TImage;
var
  i, x, y, n: Integer;
  lo, hi: TPoint;
  img: TImage;
  pt3D: T3DPoint;
begin
  lo := [$FFFFFF, $FFFFFF];
  hi := [-$FFFFFF, -$FFFFFF];

  for i := 0 to High(chunks) do
  begin
    x := chunks[i].X;
    y := 199 - chunks[i].Y;

    lo := [Min(x, lo.X), Min(y, lo.Y)];
    hi := [Max(x, hi.X), Max(y, hi.Y)];
  end;

  n := RSTranslator.MAP_CHUNK_SIZE;
  Result := new TImage((hi.X-lo.X) * n + 1 + n, (hi.Y-lo.Y) * n + 1 + n);

  for i := 0 to High(chunks) do
  begin
    x := (chunks[i].X - lo.X) * n;
    y := ((199 - chunks[i].Y) - lo.Y) * n;

    pt3D.X := chunks[i].X;
    pt3d.Y := chunks[i].Y;
    pt3D.Z := plane;

    img := Self.GetFile(pt3D, map);
    Result.DrawImage(img, [x, y]);
  end;
end;


function TMapLoader.GetHeights(chunks: TPointArray; plane: Integer): THeightMap;
begin
  Self.SetupChunkLoader();
  Result := Self.ChunkLoader.GetChunksHeightMap(chunks.Bounds(), plane);
end;


function TMapLoader.GetHeight(regionIdx: Integer; local: TPoint): Single;
var
  region: TMapRegion;
  x, y, tx, ty, w, h, west, east, north, south: Integer;
  top, bottom: Integer;
begin
  region := Self.Regions[regionIdx];
  if region.Heights = [] then
    Exit;

  //into the region's own pixels, past the padding
  x := local.X - region.Region.X1 - Self.Padding;
  y := local.Y - region.Region.Y1 - Self.Padding;

  w := Length(region.Heights);
  h := Length(region.Heights[0]);

  //a point in the padding is off the map, and div would round it up into tile 0
  if (x < 0) or (y < 0) or (x > w * TMapLoader.TILE_SIZE) or (y > h * TMapLoader.TILE_SIZE) then
    Exit;

  //how far the point is past the tile's north west corner
  tx := x mod TMapLoader.TILE_SIZE;
  ty := y mod TMapLoader.TILE_SIZE;
  x := x div TMapLoader.TILE_SIZE;
  y := y div TMapLoader.TILE_SIZE;

  //a tile's height is its south west corner, so its north corners belong to the tile above it
  west  := Min(x, w - 1);
  east  := Min(x + 1, w - 1);
  north := EnsureRange(y - 1, 0, h - 1);
  south := Min(y, h - 1);

  top    := region.Heights[west, north] * (TMapLoader.TILE_SIZE - tx) + region.Heights[east, north] * tx;
  bottom := region.Heights[west, south] * (TMapLoader.TILE_SIZE - tx) + region.Heights[east, south] * tx;

  Result := -(top * (TMapLoader.TILE_SIZE - ty) + bottom * ty) / (Sqr(TMapLoader.TILE_SIZE) * 32);
end;

function TMapLoader.GetHeight(local: TPoint): Single; overload;
var
  regionIdx: Integer;
begin
  regionIdx := Self.LocalIndex(local);
  if regionIdx = -1 then
    Exit;
  Result := Self.GetHeight(regionIdx, local);
end;


property TMapLoader.Heightmap: TImage;
var
  i: Integer;
  region: TMapRegion;
  tiles, scaled: TImage;
begin
  Result := new TImage(Self.MapBox.Width, Self.MapBox.Height);

  for i := 0 to High(Self.Regions) do
  begin
    region := Self.Regions[i];
    if region.Heights = [] then
      Continue;

    //one pixel per tile, blown up to the map's 4 pixels per tile
    tiles := region.Heights.ToImage();
    scaled := tiles.Resize(
      EImageResizeAlgo.NEAREST_NEIGHBOUR,
      tiles.Width * TMapLoader.TILE_SIZE, tiles.Height * TMapLoader.TILE_SIZE
    );

    Result.DrawImage(scaled, region.Region.TopLeft + [Self.Padding, Self.Padding]);
  end;
end;



procedure TMapLoader.CacheGraph(constref graph: TWebGraph; path: String);
begin
  if graph.Nodes.IsEmpty then
    raise GetDebugLn('MapLoader', 'Graph has no nodes for some reason.');
  if graph.Paths.IsEmpty then
    raise GetDebugLn('MapLoader', 'Graph has no paths for some reason.');

  if not FileWriteBytes(path + 'nodes.txt', CompressBytes(ECompressAlgo.ZLIB, graph.Nodes.ToBytes())) then
    raise GetDebugLn('MapLoader', 'Failed to create cache for graph nodes: ' + path);

  if not FileWriteBytes(path + 'paths.txt', CompressBytes(ECompressAlgo.ZLIB, graph.Paths.ToBytes())) then
    raise GetDebugLn('MapLoader', 'Failed to create cache for graph paths: ' + path);

  if not graph.WalkableSpace.IsEmpty then
    if not FileWriteBytes(path + 'walkablespace.txt', CompressBytes(ECompressAlgo.ZLIB, graph.WalkableSpace.ToBytes())) then
      raise GetDebugLn('MapLoader', 'Failed to create cache for graph WalkableSpace: ' + path);

  if not graph.WalkableClusters.IsEmpty then
    if not FileWriteBytes(path + 'walkableclusters.txt', CompressBytes(ECompressAlgo.ZLIB, graph.WalkableClusters.ToBytes())) then
      raise GetDebugLn('MapLoader', 'Failed to create cache for graph WalkableClusters: ' + path);

  if not graph.ObjectClusters.IsEmpty then
    if not FileWriteBytes(path + 'objectclusters.txt', CompressBytes(ECompressAlgo.ZLIB, graph.ObjectClusters.ToBytes())) then
      raise GetDebugLn('MapLoader', 'Failed to create cache for graph ObjectClusters: ' + path);
end;


function TMapLoader.GraphFromCache(path: String): TWebGraph;
begin
  if FileExists(path + 'nodes.txt') then
    Result.Nodes := TPointArray.CreateFromBytes(DecompressBytes(ECompressAlgo.ZLIB, FileReadBytes(path + 'nodes.txt')));
  if FileExists(path + 'paths.txt') then
    Result.Paths := T2DIntegerArray.CreateFromBytes(DecompressBytes(ECompressAlgo.ZLIB, FileReadBytes(path + 'paths.txt')));

  if FileExists(path + 'walkablespace.txt') then
    Result.WalkableSpace := TPointArray.CreateFromBytes(DecompressBytes(ECompressAlgo.ZLIB, FileReadBytes(path + 'walkablespace.txt')));
  if FileExists(path + 'walkableclusters.txt') then
    Result.WalkableClusters := T2DPointArray.CreateFromBytes(DecompressBytes(ECompressAlgo.ZLIB, FileReadBytes(path + 'walkableclusters.txt')));
  if FileExists(path + 'objectclusters.txt') then
    Result.ObjectClusters := T2DPointArray.CreateFromBytes(DecompressBytes(ECompressAlgo.ZLIB, FileReadBytes(path + 'objectclusters.txt')));

  SetLength(Result.Paths, Length(Result.Nodes));
end;


function TMapLoader.GetGraph(const region: TMapRegion; map: TImage): TWebGraph;
var
  name, path, plane: String;
begin
  name := region.Name;
  {$IFDEF WL_GENERATE_GRAPH_ALWAYS}
  Exit(WebGraphGenerator.BuildGraph(name, map));
  {$ENDIF}
  plane := ToStr(region.Plane);
  path := Self.GraphsDir + plane + PATH_SEP + name + '-' +
          ToStr(WebGraphGenerator.CRC) + PATH_SEP;

  if
    not FileExists(path + 'nodes.txt') or
    not FileExists(path + 'paths.txt') or
    not FileExists(path + 'walkablespace.txt') or
    not FileExists(path + 'walkableclusters.txt') or
    not FileExists(path + 'objectclusters.txt') then
  begin
    if not DirCreate(path) then
      raise GetDebugLn('MapLoader', 'Failed to create cache directory: ' + path);

    Result := WebGraphGenerator.BuildGraph(name, map);
    if Result = Default(TWebGraph) then
      Exit;

    Self.CacheGraph(Result, path);
    Exit;
  end;

  Result := Self.GraphFromCache(path);
end;



procedure TMapLoader.Add(chunks: array of TMapChunk; downscale: UInt32 = 8; padding: UInt32 = 40);
var
  chunk: TMapChunk;
  region: TMapRegion;
  i, idx, plane, regionCount: Integer;
  maps, collisionmaps: TImageArray;
  topLeft, btmRight: TPoint;
  boxes, oldRegions: TBoxArray;
  newMap, newCollision: TImage;
  oldMapBox: TBox;
  graphPath: String;
  kdItems: TKDItems;
  graph: TWebGraph;
  {$IFDEF WL_DEBUG_MAPLOADER}
  t: Double;
  {$ENDIF}
begin
  if Self.Downscale <> downscale then
    raise GetDebugLn('MapLoader', 'Cannot add chunks with different downscale value');
  if Self.Padding <> padding then
    raise GetDebugLn('MapLoader', 'Cannot add chunks with different padding value');

  regionCount := Length(Self.Regions);

  for i := 0 to High(Self.Regions) do
    boxes += RSTranslator.Global2Chunk(Self.Regions[i].Original);

  for chunk in chunks do
  begin
    for plane in chunk.Planes do
    begin
      for i := 0 to High(boxes) do
        if (Self.Regions[i].Plane = plane) and (boxes[i] = chunk.Box) then
            Continue(2);

      topLeft  := Point(Min(chunk.Box.X1, chunk.Box.X2), Max(chunk.Box.Y1, chunk.Box.Y2));
      btmRight := Point(Max(chunk.Box.X1, chunk.Box.X2), Min(chunk.Box.Y1, chunk.Box.Y2));
      chunk.Box := Box(topLeft.X, topLeft.Y, btmRight.X, btmRight.Y);

      region.Chunks := RSTranslator.GetChunks(topLeft, btmRight);
      region.Plane := plane;

      region.Original := RSTranslator.Chunk2Coordinate(chunk.Box, plane);

      with RSTranslator.Chunk2Coordinate(topLeft) do
        region.Offset := [X + RSTranslator.MapWidth * plane - padding, Y - padding];

      Self.Regions += region;
    end;
  end;

  if Length(Self.Regions) = regionCount then
    Exit;

  SetLength(maps, Length(Self.Regions)-regionCount);
  SetLength(collisionmaps, Length(maps));
  SetLength(boxes, Length(maps));

  for i := regionCount to High(Self.Regions) do
  begin
    idx := i-regionCount;
    region := Self.Regions[i];

    maps[idx] := Self.GetMap(region.Chunks, region.Plane, EMap.NORMAL);
    collisionmaps[idx] := Self.GetMap(region.Chunks, region.Plane, EMap.COLLISION);
    Self.Regions[i].Heights := Self.GetHeights(region.Chunks, region.Plane);

    if not WebGraphGenerator.Disabled then
      Self.Regions[i].Graph := Self.GetGraph(region, collisionmaps[idx]);

    maps[idx].Pad(padding);
    collisionmaps[idx].Pad(padding);
    boxes[idx] := Box(0, 0, maps[idx].Width, maps[idx].Height);
  end;

  SetLength(oldRegions, regionCount);
  for i := 0 to regionCount - 1 do
  begin
    oldRegions[i] := Self.Regions[i].Region;
    boxes.Insert(Self.Regions[i].Region, i);
  end;

  boxes := boxes.Pack();
  oldMapBox := Self.MapBox;
  Self.MapBox := [];

  for i := 0 to High(boxes) do
  begin
    Self.Regions[i].Region := boxes[i];
    Self.MapBox := Self.MapBox.Combine(boxes[i]);
  end;

  newMap := new TImage(Self.MapBox.Width, Self.MapBox.Height);
  newCollision := new TImage(Self.MapBox.Width, Self.MapBox.Height);
  Self.Graph := Default(TWebGraph);

  {$IFDEF WL_DEBUG_MAPLOADER}
  t := PerformanceTime();
  {$ENDIF}

  for i := 0 to regionCount - 1 do
  begin
    topLeft := Self.Regions[i].Region.TopLeft;
    newMap.DrawImage(Self.Map.Copy(oldRegions[i]), topLeft);
    newCollision.DrawImage(Self.Collision.Copy(oldRegions[i]), topLeft);
    graph := Self.Regions[i].Graph.Offset(topLeft+[padding,padding]);
    kdItems += graph.GetKDItems(Length(Self.Graph.WalkableClusters));
    Self.Graph.Merge(graph);
  end;

  for i := regionCount to High(Self.Regions) do
  begin
    idx := i - regionCount;
    topLeft := Self.Regions[i].Region.TopLeft;
    newMap.DrawImage(maps[idx], topLeft);
    newCollision.DrawImage(collisionmaps[idx], topLeft);
    graph := Self.Regions[i].Graph.Offset(topLeft+[padding,padding]);
    kdItems += graph.GetKDItems(Length(Self.Graph.WalkableClusters));
    Self.Graph.Merge(graph);
  end;

  Self.Map := newMap;
  Self.Collision := newCollision;

  Self.HalfMap := Self.Map.Resize(EImageResizeAlgo.BOX, 0.5);
  Self.DownscaledMatrix := Self.Map.Resize(EImageResizeAlgo.BOX, 1/Self.Downscale).ToMatrix();

  if WebGraphGenerator.Disabled then
    Exit;

  graphPath := Self.GraphsDir + 'trees' + PATH_SEP;
  if not DirCreate(graphPath) then
    raise GetDebugLn('MapLoader', 'Failed to create path: ' + graphPath);

  graphPath += ToStr(Self.Graph.CRC);

  {$IFNDEF WL_DEBUG_MAPLOADER}
  if FileExists(graphPath) then
    Self.Graph.KDTree := TKDTree.Create(graphPath)
  else
  {$ENDIF}
  begin
    Self.Graph.Setup(kdItems);
    {$IFDEF WL_DEBUG_MAPLOADER}
    WriteLn('MapLoader took ', PerformanceTime()-t, 'ms to setup graph.');
    {$ENDIF}
    Self.Graph.KDTree.SaveToFile(graphPath);
  end;
end;


procedure TMapLoader.Load(chunks: TMapChunkArray; downscale: UInt32 = 8; padding: UInt32 = 40);
begin
  Self.Setup(downscale);
  if Self.Padding = 0 then
    Self.Padding := padding;
  Self.Add(chunks, downscale, Self.Padding);
end;
{$R+}
