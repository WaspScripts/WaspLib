(*
# Objects
This page is about {ref}`Objects` which are an interface for interacting with
game objects.
*)

{$DEFINE WL_OBJECTS_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

{$R-}

{$IFDEF RANGECHECKS}
begin
  WriteLn GetDebugLn('TObject', 'Range checks are enabled for TObject, these should be disabled in production!', ELogLevel.WARN);
end;
{$ENDIF}

type
(*
## TObject
Main type to handle {ref}`Objects`.
*)
  TObject = record
    UpText: TStringArray;
    Size, Offset: TVector3;
    Model: TModel;
    Coordinates: TPointArray;
    LastCoordinate: TPoint;
    Rotations: TIntegerArray;
    Finder: TColorFinder;
    Walker: PRSWalker;
    MinDistance: Integer;
  end;

  PRSObject = ^TObject;

(*
## TObjectArray
Array of {ref}`TObject`.
*)
  TObjectArray = array of TObject;

(*
## TObject.Create
```pascal
function TObject.Create(var walker: TWalker; size: TVector3; coordinates: TPointArray; uptext: TStringArray = []): TObject; static;
function TObject.Create(var walker: TWalker; data: TMapObjectData): TObject; static; overload;
```
Create function to create your {ref}`TObject`.

Assuming you create the `RSObject` manually, the create function will provide
you with a fully built `TObject` without a finder.

You may optionally assign one later if you want:
```pascal
{$I WaspLib/main.simba}
var
  obj: TObject;
begin
  Map.Setup([EChunk.VARROCK]);
  obj := TObject.Create(Map.Walker, [1,1,7], [[8648,36686]], ['Bank booth']);
  //obj.Finder.Colors += $FFFFFF;
end;
```

The `data` version builds the object from one of the {ref}`Map Objects`, finder included:
```pascal
{$I WaspLib/main.simba}
var
  obj: TObject;
begin
  Map.Setup([EChunk.VARROCK]);
  obj := TObject.Create(Map.Walker, MapObjects.GetByName('Bank booth', 1)[0]);
end;
```
*)
function TObject.Create(var walker: TWalker; size: TVector3; coordinates: TPointArray; uptext: TStringArray = []): TObject; static;
begin
  Result.Coordinates := coordinates;
  SetLength(Result.Rotations, Length(coordinates));
  Result.Size := size;
  if uptext <> [] then
    Result.UpText := uptext;
  Result.Walker := @walker;
  Result.MinDistance := 32;
end;

function TObject.Create(var walker: TWalker; data: TMapObjectData): TObject; static; overload;
var
  i, j, l: Integer;
  unique: array of TColorArray;
  color: TColor;
  best: TBestColor;
begin
  Result.UpText := [data.Name];
  Result.Coordinates := data.Coordinates;
  Result.Rotations := data.Rotations;
  SetLength(Result.Rotations, Length(Result.Coordinates));

  Result.Size.X := data.Size.X * 0.8;
  Result.Size.Y := data.Size.Y * 0.8;
  Result.Size.Z := data.Height / 128;

  if Abs(Result.Size.Z) < 0.05 then
    Result.Size.Z := 3.0;

  for i := 0 to High(data.Colors) do
  begin
    color := data.Colors[i];

    for j := 0 to High(unique) do
    begin
      for l := 0 to High(unique[j]) do
        if ColorDistance(color, unique[j, l], EColorSpace.HSL, [1.5, 1.5, 1.5]) < 15 then
        begin
          unique[j] += color;
          Continue(3);
        end;
    end;

    unique += [color];
  end;

  for i := 0 to High(unique) do
  begin
    best := GetBestColor(EColorSpace.HSL, unique[i]);
    Result.Finder.Colors += [best.Color, best.Tolerance*1.5, EColorSpace.HSL, [best.Mods[0]*1.5, best.Mods[1]*1.5, best.Mods[2]*1.5]];
  end;

  Result.Walker := @walker;
  Result.MinDistance := 32;
end;

(*
## TObjectArray.Create
```pascal
function TObjectArray.Create(var walker: TWalker; data: TMapObjectDataArray): TObjectArray; static;
```
Create function to build your {ref}`TObjectArray`.

Builds one {ref}`TObject` for each of the {ref}`Map Objects` in `data`.

Example:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByName('Bank booth'));
end;
```
*)
function TObjectArray.Create(var walker: TWalker; data: TMapObjectDataArray): TObjectArray; static;
var
  i: Integer;
begin
  SetLength(Result, Length(data));
  for i := 0 to High(Result) do
    Result[i] := TObject.Create(walker, data[i]);
end;

(*
## RSObject.Rotation
```pascal
TObject.Rotations: TIntegerArray;
```
`Rotations` allows you to customize the rotation of a `TObject`.
By default unless you used {ref}`MapObjects` to create your object they will
no rotation set, AKA `0`.

It's very important that `Rotations` is the same length as `Coordinates` as they
complement each other, each coordinate needs to have a rotation value.

The rotation you want o set should be the respective angle of the object rotated
on it's center:
```pascal
{$I WaspLib/main.simba}
var
  furnace: TObject;
begin
  Map.Setup([EChunk.FALADOR]);
  furnace := TObject.Create(@Map.Walker, [2, 3, 6], [[7810, 36954]], ['Furnace']);
  while True do
  begin
    furnace.Rotations[0] += 1;
    ShowOnTarget(furnace);
  end;
end.
```
```{figure} ../../images/obj_rotation.gif
```
*)


(*
## RSObject._GetBounds
```pascal
function TObject._GetBounds(me: TPoint; vector: TVector2; size: TVector3; height, radians: Single): TCuboid;
```
Internal helper function for {ref}`TObject.GetBoundsArray`.
*)
function TObject._GetBounds(me: TPoint; vector: TVector2; size: TVector3; height, radians, rotation: Single): TPolygon;
var
  corners: TVector3Array;
  pt: TPoint;
  c0, c1, c2, c3: TPoint;
  h0, h1, h2, h3: Single;
begin
  pt := me + vector.ToPoint() - Minimap.Center;
  if Self.Model <> nil then
    Exit(Self.Model.GetArea(Projection.ProjectModel(Self.Model, vector.ToVec3(Self.Walker^.Height(pt, False) - height), rotation, radians)));

  if Abs(size.X - 0) < 0.005 then
    raise GetDebugLn('TObject', 'Your object has a size.X of 0 or is simply too small! An object can''t be ' + ToStr(size.X) + ' tiles wide.');
  if Abs(size.Y - 0) < 0.005 then
    raise GetDebugLn('TObject', 'Your object has a size.Y of 0 or is simply too small! An object can''t be ' + ToStr(size.Y) + ' tiles wide.');

  size.X := size.X*2;
  size.Y := size.Y*2;

  c0 := [Round(pt.X-size.X), Round(pt.Y-size.Y)];
  c1 := [Round(pt.X+size.X), Round(pt.Y-size.Y)];
  c2 := [Round(pt.X+size.X), Round(pt.Y+size.Y)];
  c3 := [Round(pt.X-size.X), Round(pt.Y+size.Y)];

  h0 := Self.Walker^.Height(c0, False) - height + Self.Offset.Z;
  h1 := Self.Walker^.Height(c1, False) - height + Self.Offset.Z;
  h2 := Self.Walker^.Height(c2, False) - height + Self.Offset.Z;
  h3 := Self.Walker^.Height(c3, False) - height + Self.Offset.Z;

  corners := [
    [vector.X-size.X+Self.Offset.X, vector.Y-size.Y+Self.Offset.Y, h0],
    [vector.X+size.X+Self.Offset.X, vector.Y-size.Y+Self.Offset.Y, h1],
    [vector.X+size.X+Self.Offset.X, vector.Y+size.Y+Self.Offset.Y, h2],
    [vector.X-size.X+Self.Offset.X, vector.Y+size.Y+Self.Offset.Y, h3],
    [vector.X-size.X+Self.Offset.X, vector.Y-size.Y+Self.Offset.Y, h0+size.Z],
    [vector.X+size.X+Self.Offset.X, vector.Y-size.Y+Self.Offset.Y, h1+size.Z],
    [vector.X+size.X+Self.Offset.X, vector.Y+size.Y+Self.Offset.Y, h2+size.Z],
    [vector.X-size.X+Self.Offset.X, vector.Y+size.Y+Self.Offset.Y, h3+size.Z]
  ];

  Result := Projection.Run(corners, radians).ConvexHull();
end;

(*
## RSObject.GetBoundsArray
```pascal
function TObject.GetBoundsArray(me: TPoint; angle: Single = $FFFF): TCuboidArray;
```
Internal function that returns an array of cuboids of the object if it's
coordinates are visible on the {ref}`MainScreen`.

Example:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
  cuboids: TCuboidArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  cuboids := objs[1].GetBoundsArray(Map.Position());
  ShowOnTarget(cuboids);
end.
```

```{figure} ../../images/objs_cuboids.png
```
*)
function TObject.GetBoundsArray(me: TPoint; out coordinates: TPointArray; radians: Single): TPolygonArray;
var
  weights: TDoubleArray;
  meLocal, pt: TPoint;
  i: Integer;
  h, dist: Double;
  vector: TVector2;
begin
  coordinates := [];
  meLocal := Self.Walker^.GetLocal(me);

  h := Self.Walker^.Height(meLocal, False);

  for i := 0 to High(Self.Coordinates) do
  begin
    pt := Self.Coordinates[i];
    dist := me.DistanceTo(pt);
    if dist > 85 then
      Continue;

    weights += dist;
    coordinates += pt;

    vector := Self.Walker^.Point2MMVec(me, pt, radians);
    vector := vector.Rotate(-radians, Minimap.Center);

    Result += Self._GetBounds(meLocal, vector, Self.Size, h, radians, DegToRad(Self.Rotations[i]));
  end;

  if Result <> [] then
  begin
    Sort(Result, weights, True);
    coordinates.Sort(weights, True);
  end;
end;


(*
## RSObject.FindOnMainScreen
```pascal
function TObject.FindOnMainScreen(cuboidArray: TCuboidArray): T2DPointArray;
```
Internal TObject method responsible for filtering a TCuboidArray by what's
visible in the mainscren.

This is meant to filter {ref}`TObject.GetBoundsArray` so targets that are
outside of the mainscreen are filtered out.

You will probably never need to use this directly.
*)
function TObject.FindOnMainScreen(out coordinates: TPointArray; boundsArray: TPolygonArray): T2DPointArray;
var
  i: Integer;
  found: TBooleanArray;
begin
  if Self.Finder <> Default(TColorFinder) then
  begin
    Self.Finder.FindEx(Result, found, boundsArray, Self.Model = nil);

    for i := High(found) downto 0 do
      if not found[i] then
        Delete(coordinates, i, 1);

    Exit;
  end;

  if Self.Model <> nil then
    Exit(boundsArray);

  for i := 0 to High(boundsArray) do
    Result += TPointArray(boundsArray[i]).Connect().ShapeFill();
end;
{$R+}

(*
## RSObject.FindEx
```pascal
function TObject.FindEx(me: TPoint; out boundsArray: TPolygonArray; out coordinates: TPointArray; out atpa: T2DPointArray): Boolean;
```
Internal {ref}`TObject` method used to find a {ref}`RSObject`.
If found returns true, if not returns false.

You also have {ref}`RSObject.Find` to find objects, this version of the method
is internal because it returns extra information about the found objects for
internal use, like it's `cuboids` for example.

This also returns an `atpa` containing the colors of the object that were found
assuming the object has a {ref}`TColorFinder` setup.
If not, the cuboids area are returned as the match.

This extra information is easy to see when you debug your object with
`ShowOnTarget(TObject)`:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  ShowOnTarget(objs[1]);
end.
```

```{figure} ../../images/objs_showontarget.png
```

As you can see, this image is very similar to the one in
{ref}`RSObject.GetBoundsArray`, they differ however in the fact that this one,
aside from the cuboids also shows the object colors that were found within
the cuboids.

This object colors is what's returned through the `atpa` and is what would be
clicked if you use {ref}`RSObject.Click` for example.

Assuming your `RSObject`does not have a {ref}`TColorFinder` setup, this is what
it would look like:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  objs[1].Finder := []; //removing the finder for this example.
  ShowOnTarget(objs[1]);
end.
```

```{figure} ../../images/objs_nofinder.png
```
*)
function TObject.FindEx(me: TPoint; out boundsArray: TPolygonArray; out coordinates: TPointArray; out atpa: T2DPointArray): Boolean;
begin
  boundsArray := Self.GetBoundsArray(me, coordinates, Minimap.CompassRadians);
  if boundsArray = [] then Exit;
  atpa := Self.FindOnMainScreen(coordinates, boundsArray);
  Result := atpa <> [];
end;


(*
## RSObject.Find
```pascal
function TObject.Find(out coordinates: TPointArray; out atpa: T2DPointArray): Boolean;
function TObject.Find(out atpa: T2DPointArray): Boolean; overload;
```
{ref}`TObject` method used to find a {ref}`RSObject`.
This returns True/False if the object was found and it's `atpa` which cointains
the colors of it that were found.

For more information on this refer to {ref}`RSObject.FindEx`, it's an internal
function but is used within this one and will go into more detail.
*)
function TObject.Find(out coordinates: TPointArray; out atpa: T2DPointArray): Boolean;
var
  boundsArray: TPolygonArray;
begin
  Result := Self.FindEx(Self.Walker^.Position(), boundsArray, coordinates, atpa);
end;

function TObject.Find(out atpa: T2DPointArray): Boolean; overload;
var
  coordinates: TPointArray;
  boundsArray: TPolygonArray;
begin
  Result := Self.FindEx(Self.Walker^.Position(), boundsArray, coordinates, atpa);
end;


(*
## RSObject.IsVisible
```pascal
function TObject.IsVisible(): Boolean;
```
Returns a boolean whether the object is currently visible or not.
*)
function TObject.IsVisible(): Boolean;
var
  coordinates: TPointArray;
  boundsArray: TPolygonArray;
  atpa: T2DPointArray;
begin
  Result := Self.FindEx(Self.Walker^.Position(), boundsArray, coordinates, atpa);
end;


(*
## RSObject.FindFrom
```pascal
function TObject.FindFrom(position: TPoint; out atpa: T2DPointArray): Boolean;
```
This is similar to {ref}`RSObject.Find` but differs from it in that you can set
your `position`.

This is only useful when you want to predict an object position as if you were
somewhere else you are not.

What you use this for is up to you but an example use case is to pre-hover
objects before you reach a `position` you know you will be at in the future.

For example, imagine a slow agility obstacle on an agility course. Imagine you
want to click the obstacle and hover the next. You know where you will be after
you get through the current obstacle so you can use this to set your `position`
to where you will be after the current obstacle and hover the next one:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
  atpa: T2DPointArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  objs[1].Finder := [];

  while True do
  begin
    ShowOnTarget(atpa);
    objs[1].FindFrom([8912,36742], atpa);
  end;
end.
```

```{figure} ../../images/obj_findfrom.gif
```
As you can see on the gif above, the objects debug match the object exactly when
you are at the right coordinate.

For this I also recommend to not have a `TColorFinder` setup because it will
only match when you are at the right position.
*)
function TObject.FindFrom(position: TPoint; out atpa: T2DPointArray): Boolean;
var
  boundsArray: TPolygonArray;
  coordinates: TPointArray;
begin
  Result := Self.FindEx(position, boundsArray, coordinates, atpa);
end;

(*
## RSObject._UpTextCheck
```pascal
function TObject._UpTextCheck(out shouldExit: Boolean; action: TStringArray): Boolean;
```
Internal `TObject` helper method that is used by all hovering methods.

You probably don't need to use this directly.
*)
function TObject._UpTextCheck(out shouldExit: Boolean; action: TStringArray): Boolean;
var
  text: String;
begin
  shouldExit := True;

  if (Client.Mode = EMode.FIXED) and MSInterface.IsOpen() then
    Exit;

  if Self.UpText <> [] then
    Self.Walker^.TargetUpText := Copy(Self.UpText);

  text := MainScreen.UpText;

  if text.Contains('>') and not action.Contains(['>']) then
  begin
    ChooseOption.Close();
    Exit;
  end;

  if not Self.UpText.IsEmpty and text.ContainsAny(Self.UpText) then
    Exit(True);

  shouldExit := False;
end;


(*
## RSObject.PreHover
```pascal
function TObject.PreHover(me: TPoint; attempts: Integer = 2): Boolean;
```
To understand what this does it's recommended to read {ref}`RSObject.FindFrom`.

This method basically uses {ref}`RSObject.FindFrom` and moves the
mouse to one of the matches.
*)
function TObject.PreHover(me: TPoint; attempts: Integer = 2): Boolean;
var
  attempt: Integer;
  atpa: T2DPointArray;
begin
  for attempt := 0 to attempts do
  begin
    if not Self.FindFrom(me, atpa) then Continue;
    Mouse.Move(atpa.Random().Random());
    Exit(True);
  end;
end;


(*
## RSObject._HoverHelper
```pascal
function TObject._HoverHelper(strings: TStringArray; attempt, attempts: Integer): Boolean; static;
```
Internal `TObject` helper method that is used by both {ref}`TObject.Hover`
and {ref}`TEntity.Hover`.
You probably don't need to use this directly.
*)
function TObject._HoverHelper(strings: TStringArray; attempt, attempts: Integer): Boolean; static;
begin
  if MainScreen.Bounds.Contains(Mouse.Position) and MainScreen.IsUpText(strings) then
    Exit(True);

  if attempt < (attempts - 1) then
    Minimap.CompassRadians := Minimap.CompassRadians + PI/3.6 * Random(-1,1);
end;

(*
## RSObject._WalkHoverHelper
```pascal
function TObject._WalkHoverHelper(strings: TStringArray; walker: PRSWalker; dist, attempt, attempts: Integer; coordinates: TPointArray): Boolean; static;
```
Internal `TObject` helper method that is used by both {ref}`TObject.WalkHover`
and {ref}`TEntity.WalkHover`.
You probably don't need to use this directly.
*)
function TObject._WalkHoverHelper(strings: TStringArray; walker: PRSWalker; dist, attempt, attempts: Integer; coordinates: TPointArray): Boolean; static;
var
  me, closest: TPoint;
begin
  if MainScreen.Bounds.Contains(Mouse.Position) and MainScreen.IsUpText(strings) then
    Exit(True);

  me := walker^.Position();
  closest := walker^.Graph^.NearestPathable(me, coordinates);

  if me.DistanceTo(closest) > dist then
  begin
    walker^.WebWalkEx(me, closest, dist, 0.33);
    Exit;
  end;

  if attempt < (attempts - 1) then
  begin
    dist := dist div 2;
    if me.DistanceTo(closest) > dist then
      walker^.WebWalkEx(me, closest, dist, 0.15)
    else
      Minimap.CompassRadians := Minimap.CompassRadians + PI/3.6 * Random(-1,1);
  end;
end;


(*
## RSObject._ClickHelper
```pascal
function TObject._ClickHelper(leftClick: Boolean): Boolean;
```
Internal `TObject` helper method that is used by other clicking methods.
You probably don't need to use this directly.

This is what's responsible for deciding if we click a target we are hovering or
not.
*)
function TObject._ClickHelper(leftClick: Boolean): Boolean;
begin
  if Self.Walker^.RedClicked then
  begin
    Self.Walker^.RedClicked := False;
    Exit(True);
  end;

  if ChooseOption.IsOpen() then
  begin
    if (Self.UpText <> []) and ChooseOption.Select(Self.UpText) then
      Exit(True);
    ChooseOption.Close();
    Exit;
  end;

  if leftClick and Biometrics.RedClick(EMouseButton.LEFT, 2) then
    Exit(True);

  Result := not leftClick and (Self.UpText <> []) and ChooseOption.Select(Self.UpText);
end;

(*
## RSObject._SelectHelper
```pascal
function TObject._SelectHelper(action: TStringArray): Boolean;
```
Internal TObject helper method that is used by other select methods.

You probably don't need to use this directly.

This is what is responsible for deciding if we just left click a target we are
hovering or right click it and choose an option.
*)
function TObject._SelectHelper(action: TStringArray): Boolean;
begin
  if Self.Walker^.RedClicked then
  begin
    Self.Walker^.RedClicked := False;
    Exit(True);
  end;

  if ChooseOption.IsOpen() and ChooseOption.Select(action) then
    Exit(True);

  if MainScreen.IsUpText(action) then
    Exit(Biometrics.RedClick(EMouseButton.LEFT, 2));

  Result := ChooseOption.Select(action);
end;


(*
## RSObject.Hover
```pascal
function TObject.Hover(action: TStringArray = []; attempts: Integer = 2): Boolean;
```
Method used to hover a TObject target if it's found on the mainscreen.

Example:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
  atpa: T2DPointArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  objs[1].Hover();
end.
```

```{figure} ../../images/obj_hover.gif
```
*)
function TObject.Hover(action: TStringArray = []; attempts: Integer = 2): Boolean;
var
  me: TPoint;
  shouldExit: Boolean;
  attempt, i: Integer;
  atpa: T2DPointArray;
  tpa, coordinates: TPointArray;
begin
  if ChooseOption.IsOpen() then
  begin
    if MainScreen.Bounds.Contains(Mouse.Position) then
      if ((Self.UpText <> []) or (action <> [])) then
        if ChooseOption.ContainsAny(Self.UpText + action) then
          Exit(True);
    ChooseOption.Close();
  end;

  if Self.Walker = nil then
    raise GetDebugLn('TObject', 'Walker pointer missing.');
  if Self.Coordinates = [] then
    raise GetDebugLn('TObject', 'Coordinates missing.');
  if Length(Self.Coordinates) <> Length(Self.Rotations) then
    raise GetDebugLn('TObject', 'Coordinates and Rotations don''t match.');

  me := Self.Walker^.Position();
  if not TWalker.MakePointVisibleEx(me, Self.Coordinates.NearestPoint(me)) then
    Exit;

  Result := Self._UpTextCheck(shouldExit, action);
  if shouldExit then
    Exit;

  for attempt := 0 to attempts do
  begin
    if Self.Find(coordinates, atpa) then
    begin
      if attempt < 2 then i := 0
      else if Length(atpa) > (attempt - 2) then i := attempt - 2
      else i := Random(Low(atpa), High(atpa));

      tpa := atpa[i].ExtractBox(MainScreen.Bounds);
      if tpa = [] then
        Continue;

      Self.LastCoordinate := coordinates[i];

      Mouse.Move(tpa.RandomMean());

      if Self.UpText = [] then Exit(True);
    end;

    if TObject._HoverHelper(Self.UpText + action, attempt, attempts) then
      Exit(True);
  end;
end;

(*
## RSObject.WalkHover
```pascal
function TObject.WalkHover(action: TStringArray = []; attempts: Integer = 2): Boolean;
```
Method used to walk towards and hover a `TObject` target if it's found on the
mainscreen.

Example:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
  atpa: T2DPointArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  objs[1].WalkHover();
end.
```

```{figure} ../../images/obj_walkhover.gif
```

In the gif above the function exited true before we finished walking
which is why it's not hovering the bank after we finished walking.

The way this works is that if we successfully hover the bank while walking
it returns true.
*)
function TObject.WalkHover(action: TStringArray = []; attempts: Integer = 2): Boolean;
var
  me, closest: TPoint;
  coordinates, tpa: TPointArray;
  shouldExit: Boolean;
  attempt, i: Integer;
  atpa: T2DPointArray;
begin
  if ChooseOption.IsOpen() then
  begin
    if MainScreen.Bounds.Contains(Mouse.Position) then
      if ((Self.UpText <> []) or (action <> [])) then
        if ChooseOption.ContainsAny(Self.UpText + action) then
          Exit(True);
    ChooseOption.Close();
  end;

  me :=  Self.Walker^.Position();
  closest := Self.Walker^.Graph^.NearestPathable(me, Self.Coordinates);

  Self.Walker^.TargetUpText := Copy(Self.UpText);
  Self.Walker^.ActionUpText := action;

  try
    if not TWalker.MakePointVisibleEx(me, closest) then
    begin
      if not Self.Walker^.WebWalkEx(me, closest, Self.MinDistance, 0.33) then
        Exit;

      me := Self.Walker^.Position();
      if not TWalker.MakePointVisibleEx(me, Self.Coordinates.NearestPoint(me)) then
        Exit;
    end;

    Result := Self._UpTextCheck(shouldExit, action) or Self.Walker^.RedClicked;
    if shouldExit then Exit;

    for attempt := 0 to attempts do
    begin
      if Self.Find(coordinates, atpa) then
      begin
        if attempt < 2 then i := 0
        else if Length(atpa) > (attempt - 2) then i := attempt - 2
        else i := Random(Low(atpa), High(atpa));

        tpa := atpa[i].ExtractBox(MainScreen.Bounds);
        if tpa = [] then
          Continue;

        Self.LastCoordinate := coordinates[i];

        Mouse.Move(tpa.RandomMean());

        if Self.UpText = [] then
          Exit(True);
        Sleep(50); //give uptext 1~ frame time to update
      end;

      if TObject._WalkHoverHelper(Self.UpText + action, Self.Walker, Self.MinDistance, attempt, attempts, Self.Coordinates) then
        Exit(True);
    end;
  finally
    Self.Walker^.TargetUpText := [];
    Self.Walker^.ActionUpText := [];
  end;
end;


(*
## RSObject.Click
```pascal
function TObject.Click(leftClick: Boolean = True; attempts: Integer = 2): Boolean;
```
Method used to click a `TObject` target if it's found on the mainscreen.

Example:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
  atpa: T2DPointArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  objs[1].Click();
end.
```

```{figure} ../../images/obj_click.gif
```
*)
function TObject.Click(leftClick: Boolean = True; attempts: Integer = 2): Boolean;
begin
  Result := Self.Hover([], attempts) and Self._ClickHelper(leftClick);
end;

(*
## RSObject.Interact
```pascal
function TObject.Interact(action: TStringArray; attempts: Integer = 2): Boolean;
```
Method used to select an option on a `TObject` target if it's found on the
mainscreen.

Through `action` you can specify the interaction you are looking for.
If this interaction is the uptext when you hover the object WaspLib will simply
left click it.

Example:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
  atpa: T2DPointArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  objs[1].Interact(['Collect']);
end.
```

```{figure} ../../images/obj_select.gif
```
*)
function TObject.Interact(action: TStringArray; attempts: Integer = 2): Boolean;
begin
  Result := Self.Hover(action, attempts) and Self._SelectHelper(action);
end;


(*
## RSObject.WalkClick
```pascal
function TObject.WalkClick(leftClick: Boolean = True; attempts: Integer = 2): Boolean;
```
Method used to walk towards and click a `TObject` target if it's found on the
mainscreen.

Example:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
  atpa: T2DPointArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  objs[1].WalkClick();
end.
```

```{figure} ../../images/obj_walkclick.gif
```
*)
function TObject.WalkClick(leftClick: Boolean = True; attempts: Integer = 2): Boolean;
begin
  if Self.Walker = nil then
    raise GetDebugLn('TObject', 'Walker pointer missing.');
  if Self.Coordinates = [] then
    raise GetDebugLn('TObject', 'Coordinates missing.');
  if Length(Self.Coordinates) <> Length(Self.Rotations) then
    raise GetDebugLn('TObject', 'Coordinates and Rotations don''t match.');

  Result := Self.WalkHover([], attempts) and Self._ClickHelper(leftClick);
end;

(*
## RSObject.WalkInteract
```pascal
function TObject.WalkInteract(action: TStringArray; attempts: Integer = 2): Boolean;
```
Method used to walk towards and select an option on a `TObject` target if it's
found on the mainscreen.

Through `action` you can specify the interaction you are looking for.
If this interaction is the uptext when you hover the object WaspLib will simply
left click it.

Example:
```pascal
{$I WaspLib/main.simba}

var
  objs: TObjectArray;
  atpa: T2DPointArray;
begin
  Map.Setup([EChunk.VARROCK]);
  objs := TObjectArray.Create(Map.Walker, MapObjects.GetByAction('Bank'));
  objs[1].WalkInteract(['Collect']);
end.
```

```{figure} ../../images/obj_walkselect.gif
```
*)
function TObject.WalkInteract(action: TStringArray; attempts: Integer = 2): Boolean;
begin
  if Self.Walker = nil then
    raise GetDebugLn('TObject', 'Walker pointer missing.');
  if Self.Coordinates = [] then
    raise GetDebugLn('TObject', 'Coordinates missing.');
  if Length(Self.Coordinates) <> Length(Self.Rotations) then
    raise GetDebugLn('TObject', 'Coordinates and Rotations don''t match.');

  Result := Self.WalkHover(action, attempts);
  Result := Result and Self._SelectHelper(action);
end;


(*
## RSObject.DistanceTo
```pascal
function TObject.DistanceTo(pt: TPoint): Double;
```
Returns the distance of an object to you. Because {ref}`Objects` can have
multiple coordinates, only the closest one is considered for the calculation.

This is useful to for example, compared which of 2 objects are closest to you.

Example:
```pascal
me := Map.Position();

if bankBooth.DistanceTo(me) < bankChest.DistanceTo(me) then
  bankBooth.WalkClick()
else
  bankChest.WalkClick();
```
*)
function TObject.DistanceTo(pt: TPoint): Double;
var
  dist: Double;
  i: Integer;
begin
  Result := $FFFFFF;
  for i := 0 to High(Self.Coordinates) do
  begin
    dist := Self.Coordinates[i].DistanceTo(pt);
    if dist < Result then
      Result := dist;
  end;
end;

(*
## RSObjectArray.ClosestIndex
```pascal
function TObjectArray.ClosestIndex(pt: TPoint): Integer;
```
Returns the index of the `TObjectArray` which is closest to you.

Uses {ref}`RSObject.DistanceTo` on each of the indices of the current
`TObjectArray` and returns the closest index.
*)
function TObjectArray.ClosestIndex(pt: TPoint): Integer;
var
  closest, dist: Double;
  i, j: Integer;
begin
  closest := $FFFFFF;
  for i := 0 to High(Self) do
    for j := 0 to High(Self[i].Coordinates) do
    begin
      dist := Self[i].Coordinates[j].DistanceTo(pt);
      if dist >= closest then Continue;

      closest := dist;
      Result := i;
    end;
end;

(*
## DrawObject
```pascal
procedure TImage.DrawObject(const obj: TObject; alpha: Byte = $C8);
procedure TExternalCanvas.DrawObject(const obj: TObject; alpha: Byte = $C8);
```
Helper methods to debug TObjects.
*)
procedure TImage.DrawObject(const obj: TObject; alpha: Byte = $C8);
var
  atpa: T2DPointArray;
  boundsArray: TPolygonArray;
  i: Integer;
  coordinates: TPointArray;
begin
  if obj.FindEx(obj.Walker^.Position(), boundsArray, coordinates, atpa) then
  begin
    Self.DrawColor := TColor.Random();
    Self.DrawAlpha := alpha;
    Self.DrawATPA(atpa);
  end;

  Self.DrawAlpha := $FF;
  Self.DrawColor := $FFFFFF;
  if obj.Model = nil then
  begin
    for i := 0 to High(boundsArray) do
      Self.DrawTPA(boundsArray[i].Connect());
    Exit;
  end;

  for i := 0 to High(boundsArray) do
    Self.DrawTPA(TPointArray(boundsArray[i]).Edges());
end;

procedure TExternalCanvas.DrawObject(const obj: TObject; alpha: Byte = $C8);
var
  atpa: T2DPointArray;
  boundsArray: TPolygonArray;
  i: Integer;
  coordinates: TPointArray;
begin
  if obj.FindEx(obj.Walker^.Position(), boundsArray, coordinates, atpa) then
  begin
    Self.DrawColor := TColor.Random();
    Self.DrawAlpha := alpha;
    Self.DrawATPA(atpa);
  end;

  Self.DrawAlpha := $FF;
  Self.DrawColor := $FFFFFF;
  if obj.Model = nil then
  begin
    for i := 0 to High(boundsArray) do
      Self.DrawTPA(boundsArray[i].Connect());
    Exit;
  end;

  for i := 0 to High(boundsArray) do
    Self.DrawTPA(TPointArray(boundsArray[i]).Edges());
end;


(*
## ShowOnTarget TObject
```pascal
procedure ShowOnTarget(obj: TObject); overload;
```
Shows an image of the target with the `TObject` drawn on it.
*)
procedure ShowOnTarget(obj: TObject); overload;
var
  img: TImage;
begin
  img := Target.GetImage();
  img.DrawObject(obj);
  img.Show();
end;

(*
## ShowOnTarget TObjectArray
```pascal
procedure ShowOnTarget(objs: TObjectArray); overload;
```
Shows an image of the target with the `TObjectArray` drawn on it.
*)
procedure ShowOnTarget(objs: TObjectArray); overload;
var
  img: TImage;
  i: Integer;
begin
  img := Target.GetImage();
  for i := 0 to High(objs) do
    img.DrawObject(objs[i]);
  img.Show();
end;

function ToString(constref obj: TObject): String; override;
begin
  Result := '[' + ToString(obj.UpText) + ', ' +
                  ToString(obj.Size) + ', ' +
                  ToString(obj.Coordinates) + ', ' +
                  ToString(obj.Rotations) + ', ' +
                  ToString(obj.Finder) + ']';
end;
