
{$DEFINE WL_HOUSELOADER_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

{$R-}

{$IFDEF RANGECHECKS}
begin
  WriteLn GetDebugLn('HouseLoader', 'Range checks are enabled for HouseLoader, these should be disabled in production!', ELogLevel.WARN);
end;
{$ENDIF}

type
  EHouseWall = enum(OPEN, SOLID, TWIN_DOORS, WIDE_DOOR, CENTER_DOOR, ALL_DOORS, OPEN_CENTER_DOOR);

function EHouseWall.WallSegments(): TIntegerArray;
begin
  case Self of
    EHouseWall.SOLID:       Result := [0, 1, 2, 3, 4, 5, 6, 7];
    EHouseWall.TWIN_DOORS:  Result := [0, 1, 3, 4, 6, 7];
    EHouseWall.WIDE_DOOR:   Result := [0, 1, 6, 7];
    EHouseWall.CENTER_DOOR: Result := [0, 1, 2, 5, 6, 7];
  end;
end;

function EHouseWall.DoorSegments(): TIntegerArray;
begin
  case Self of
    EHouseWall.TWIN_DOORS:       Result := [2, 5];
    EHouseWall.WIDE_DOOR:        Result := [2, 3, 4, 5];
    EHouseWall.CENTER_DOOR:      Result := [3, 4];
    EHouseWall.ALL_DOORS:        Result := [0, 1, 2, 3, 4, 5, 6, 7];
    EHouseWall.OPEN_CENTER_DOOR: Result := [3, 4];
  end;
end;

type

  THouseLoader = record
    Downscale, LayoutIndex: Integer;
    Map, Collision, HalfMap: TImage;
    DownscaleMatrix: TIntegerMatrix;

    Rooms: THouseRoomMatrix;

    //helpers:
    TeleportRooms: TTeleportRoomMatrix;

    RoomImages, IconImages: array [EHouseRoom] of TImage;
    HouseBounds: TBox;

    Location: EHouseLocation;
    Decoration: EHouseDecoration;
    Colors: THouseColor;
    Config: TConfigJSON;

    const SIZE: Integer = 32;
    const AMOUNT: Integer = 13;
  end;

procedure THouseLoader.DrawMap(room: THouseRoom; p: TPoint); forward;

procedure THouseLoader.SetColors(decoration: EHouseDecoration);
begin
  Self.Decoration := decoration;
  Self.Colors := decoration.GetColors();
end;

procedure THouseLoader.SetupConfig();
var
  str: String;
begin
  if (Self.Config.Data <> nil) and (Self.LayoutIndex = ProfileIndex) then
    Exit;
  Self.LayoutIndex := ProfileIndex;
  Self.Config.Setup('house' + PATH_SEP + ToStr(ProfileIndex));

  if Self.Config.Data.Count = 0 then
  begin
    Self.Location := EHouseLocation.RIMMINGTON;
    Self.SetColors(EHouseDecoration.WOOD);
    SetLength(Self.Rooms, Self.AMOUNT, Self.AMOUNT);
    SetLength(Self.TeleportRooms, Self.AMOUNT, Self.AMOUNT);


    Self.Config.Data.AddString('Rooms', '');
    Self.Config.Data.AddString('TeleportRooms', '');

    Self.DrawMap([EHouseRoom.GARDEN, 0, [EHouseObject.EXIT]], [Self.AMOUNT div 2, Self.AMOUNT div 2]);

    Self.Config.Data.AddInt('EHouseObject', Ord(High(EHouseObject)));
    Self.Config.Data.AddInt('EHouseTeleport', Ord(High(EHouseTeleport)));
    Self.Config.Data.AddInt('Location', Ord(Self.Location));
    Self.Config.Data.AddInt('Decoration', Ord(Self.Decoration));
    Self.Config.Data.AddInt('TeleportMode', 0);
    Self.Config.Save();
    Exit;
  end;

  Self.Location := EHouseLocation(Self.Config.Data.Item['Location'].AsInt);
  Self.SetColors(EHouseDecoration(Self.Config.Data.Item['Decoration'].AsInt));

  str := DecompressString(ECompressAlgo.ZLIB, EBaseEncoding.b64, Self.Config.Data.Item['Rooms'].AsString);
  Self.Rooms := THouseRoomMatrix.CreateFromBytes(str.ToBytes());

  str := DecompressString(ECompressAlgo.ZLIB, EBaseEncoding.b64, Self.Config.Data.Item['TeleportRooms'].AsString);
  Self.TeleportRooms := TTeleportRoomMatrix.CreateFromBytes(str.ToBytes());

  Self.Redraw();
end;


procedure THouseLoader.Init();
begin
  Self.Map := new TImage(Self.SIZE * Self.AMOUNT, Self.SIZE * Self.AMOUNT);
  Self.SetupConfig();
  Self.DownscaleMatrix := [];
  Self.HalfMap := new TImage();
end;

procedure THouseLoader.Setup(downscale: Integer);
var
  empty, walls, windows: TPointArray;
  tmp: T2DPointArray;
begin
  Self.Downscale := downscale;
  Self.DownscaleMatrix := Self.Map.Resize(EImageResizeAlgo.BOX, 1/Self.Downscale).ToMatrix();
  Self.HalfMap := Self.Map.Resize(EImageResizeAlgo.BOX, 0.5);

  walls := Self.Map.FindColor($EEEEEE, 0);
  windows := Self.Map.FindColor($0000EE, 0);
  empty := Self.Map.FindColor($0, 0);

  tmp := windows.Cluster(1);
  tmp.ExcludeSize(5, EComparator.__LT__);
  windows := tmp.Merge();

  Self.Collision := new TImage(Self.Map.Width, Self.Map.Height);
  Self.Collision.ReplaceColor($0, $FFFFFF);
  Self.Collision.DrawColor := $0;
  Self.Collision.DrawTPA(walls + empty + windows);
end;


function THouseLoader.GetColor(room: EHouseRoom): Integer;
begin
  if room.IsOutdoors() then Exit(Self.Colors.Outdoors);
  Result := Self.Colors.Indoors;
end;


function THouseLoader._GetRoomImage(room: EHouseRoom): TImage;
const
  SIDES: array of array of EHouseWall = [
    [EHouseWall.OPEN, EHouseWall.OPEN, EHouseWall.OPEN, EHouseWall.OPEN],
    [EHouseWall.TWIN_DOORS, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR],
    [EHouseWall.OPEN_CENTER_DOOR, EHouseWall.OPEN_CENTER_DOOR, EHouseWall.OPEN_CENTER_DOOR, EHouseWall.OPEN_CENTER_DOOR],
    [EHouseWall.TWIN_DOORS, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.TWIN_DOORS],
    [EHouseWall.TWIN_DOORS, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR],
    [EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.TWIN_DOORS, EHouseWall.TWIN_DOORS],
    [EHouseWall.TWIN_DOORS, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.TWIN_DOORS],
    [EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR],
    [EHouseWall.SOLID, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR],
    [EHouseWall.TWIN_DOORS, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR],
    [EHouseWall.SOLID, EHouseWall.CENTER_DOOR, EHouseWall.CENTER_DOOR, EHouseWall.CENTER_DOOR],
    [EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR],
    [EHouseWall.OPEN_CENTER_DOOR, EHouseWall.OPEN_CENTER_DOOR, EHouseWall.OPEN_CENTER_DOOR, EHouseWall.OPEN_CENTER_DOOR],
    [EHouseWall.CENTER_DOOR, EHouseWall.CENTER_DOOR, EHouseWall.CENTER_DOOR, EHouseWall.CENTER_DOOR],
    [EHouseWall.TWIN_DOORS, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR],
    [EHouseWall.SOLID, EHouseWall.WIDE_DOOR, EHouseWall.TWIN_DOORS, EHouseWall.TWIN_DOORS],
    [EHouseWall.TWIN_DOORS, EHouseWall.CENTER_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.TWIN_DOORS],
    [EHouseWall.TWIN_DOORS, EHouseWall.CENTER_DOOR, EHouseWall.TWIN_DOORS, EHouseWall.TWIN_DOORS],
    [EHouseWall.ALL_DOORS, EHouseWall.ALL_DOORS, EHouseWall.ALL_DOORS, EHouseWall.ALL_DOORS],
    [EHouseWall.TWIN_DOORS, EHouseWall.CENTER_DOOR, EHouseWall.TWIN_DOORS, EHouseWall.TWIN_DOORS],
    [EHouseWall.ALL_DOORS, EHouseWall.ALL_DOORS, EHouseWall.ALL_DOORS, EHouseWall.ALL_DOORS],
    [EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR, EHouseWall.WIDE_DOOR],
    [EHouseWall.CENTER_DOOR, EHouseWall.CENTER_DOOR, EHouseWall.SOLID, EHouseWall.SOLID]
  ];
var
  wallSegs, doorSegs: TIntegerArray;
  wallTPA, doorTPA: TPointArray;
  side, seg, hi: Integer;
  b: TBox;
begin
  hi := Self.SIZE - 1;

  for side := 0 to 3 do
  begin
    wallSegs := SIDES[room][side].WallSegments();
    doorSegs := SIDES[room][side].DoorSegments();

    for seg := 0 to 7 do
    begin
      case side of
        0: b := [seg*4, 0, seg*4 + 3, 0];
        1: b := [seg*4, hi, seg*4 + 3, hi];
        2: b := [0, seg*4, 0, seg*4 + 3];
        3: b := [hi, seg*4, hi, seg*4 + 3];
      end;

      if wallSegs.Contains(seg) then
        wallTPA += TPointArray.CreateFromBox(b, True)
      else if doorSegs.Contains(seg) then
        doorTPA += TPointArray.CreateFromBox(b, True);
    end;
  end;

  case room of
    EHouseRoom.COMBAT:
    begin
      doorTPA += TPointArray.CreateFromBox([7, 7, 24, 24], False);
      doorTPA += TPointArray.CreateFromBox([7, 12, 24, 12], True);
      doorTPA += TPointArray.CreateFromBox([12, 8, 12, 11], True);
      doorTPA += TPointArray.CreateFromBox([20, 19, 24, 19], True);
      doorTPA += TPointArray.CreateFromBox([19, 20, 19, 23], True);
    end;

    EHouseRoom.MENAGERIE_OUTDOORS, EHouseRoom.MENAGERIE_INDOORS:
      doorTPA += TPointArray.CreateFromBox([7, 15, 12, 24], False);
  end;

  Result := new TImage(Self.SIZE, Self.SIZE);
  Result.DrawColor := $EEEEEE;
  Result.DrawTPA(wallTPA);

  Result.DrawColor := $0000EE;
  Result.DrawTPA(doorTPA);
end;

function THouseLoader.GetRoomImage(room: EHouseRoom): TImage;
begin
  if Self.RoomImages[room] = nil then
    Self.RoomImages[room] := Self._GetRoomImage(room);

  Result := Self.RoomImages[room].Copy();
  Result.ReplaceColor($0, Self.GetColor(room));
end;


function THouseLoader._GetIconImage(room: EHouseRoom): TImage;
const
  ICONS: array of TIntegerArray = [
  //Room, ID,  W, H
    [1, 8077, 11, 0],
    [1, 8124, 0, 23],
    [1, 8124, 23, 23],
    [1, 8315, 11, 12],
    [2, 8168, 11, 12],
    [3, 8222, 11, 1],
    [3, 8232, 23, 13],
    [3, 8233, 21, 22],
    [3, 8248, 11, 12],
    [4, 8077, 11, 0],
    [4, 8101, 0, 23],
    [4, 8121, 11, 12],
    [5, 8394, 22, 0],
    [5, 9831, 0, 12],
    [5, 9831, 22, 12],
    [5, 30666, 11, 12],
    [6, 8037, 11, 1],
    [6, 8044, 23, 1],
    [6, 8051, 1, 1],
    [6, 8076, 23, 22],
    [6, 8077, 23, 12],
    [7, 8085, 18, 12],
    [7, 8095, 0, 1],
    [7, 8266, 23, 1],
    [7, 8275, 5, 12],
    [8, 8077, 21, 23],
    [8, 25352, 3, 1],
    [8, 25352, 11, 1],
    [8, 25352, 19, 1],
    [8, 25360, 0, 22],
    [9, 8160, 21, 22],
    [9, 8164, 0, 22],
    [9, 8167, 11, 0],
    [10, 20629, 12, 0],
    [10, 25154, 0, 22],
    [11, 8124, 22, 23],
    [11, 8281, 0, 0],
    [11, 8284, 0, 23],
    [12, 9831, 13, 6],
    [12, 12717, 23, 1],
    [12, 12724, 1, 1],
    [13, 9831, 13, 6],
    [13, 12717, 23, 1],
    [13, 12724, 1, 1],
    [14, 8124, 11, 0],
    [14, 9831, 4, 4],
    [14, 24132, 3, 20],
    [15, 8319, 11, 12],
    [15, 9828, 0, 12],
    [15, 9828, 3, 0],
    [15, 9831, 11, 0],
    [16, 8068, 11, 12],
    [16, 8084, 0, 23],
    [16, 8384, 23, 23],
    [16, 9831, 22, 12],
    [17, 8330, 0, 12],
    [17, 8330, 12, 0],
    [17, 8330, 23, 12],
    [17, 8332, 12, 12],
    [18, 8168, 11, 12],
    [19, 8103, 4, 1],
    [19, 8363, 12, 1],
    [19, 8374, 11, 12],
    [20, 20637, 11, 12],
    [20, 20643, 21, 2],
    [21, 22706, 12, 12],
    [21, 22708, 3, 22],
    [21, 22708, 19, 22],
    [22, 8077, 21, 11],
    [22, 8124, 0, 2],
    [22, 8384, 0, 22],
    [22, 9831, 21, 22],
    [22, 20624, 21, 0]
  ];
var
  i: Integer;
  sprite: TItemSprite;
  img: TImage;
  color: TColor;
begin
  Result := Self.GetRoomImage(room);
  color := Self.GetColor(room);

  for i := 0 to High(ICONS) do
  begin
    if ICONS[i][0] <> Ord(room) then
      Continue;

    sprite := TItemSprite.Create(ICONS[i][1]);
    img := sprite.ToImage();

    img.ReplaceColor($0, color);
    img := img.Resize(EImageResizeAlgo.BILINEAR, 0.33);

    Result.DrawImage(img, [ICONS[i][2], ICONS[i][3]]);
  end;
end;

function THouseLoader.GetIconImage(room: EHouseRoom): TImage;
begin
  if Self.IconImages[room] = nil then
    Self.IconImages[room] := Self._GetIconImage(room);

  Result := Self.IconImages[room].Copy();
end;



procedure THouseLoader.WriteRoom(room: THouseRoom; index: TPoint);
begin
  Self.Rooms[index.Y,index.X] := room;

  case room.Room of
    EHouseRoom.PORTAL_CHAMBER, EHouseRoom.SUPERIOR_GARDEN, EHouseRoom.PORTAL_NEXUS:;
    else Self.TeleportRooms[index.Y,index.X] := [];
  end;

  Self.Config.Data.Item['Rooms'].AsString         := CompressString(ECompressAlgo.ZLIB, EBaseEncoding.b64, String.CreateFromBytes(Self.Rooms.ToBytes()));
  Self.Config.Data.Item['TeleportRooms'].AsString := CompressString(ECompressAlgo.ZLIB, EBaseEncoding.b64, String.CreateFromBytes(Self.TeleportRooms.ToBytes()));
  Self.Config.Save();
end;


function THouseLoader.ReadRoom(index: TPoint): THouseRoom;
begin
  Result := Self.Rooms[index.Y,index.X];
end;


procedure THouseLoader.PrintRooms();
var
  str: String;
  i, j: Integer;
begin
  str := '[' + LINE_SEP;
  for i := 0 to High(Self.Rooms) do
  begin
    for j := 0 to High(Self.Rooms[i]) do
    begin
      if j = 0 then
      begin
        str += '  [';
      end;
        str += ToStr(Self.Rooms[i][j]);
      if j < High(Self.Rooms[i]) then
        str += ', ';
    end;
      str += ', ' + LINE_SEP;
  end;
  str += ']';
  WriteLn str;
end;



procedure THouseLoader.DrawMap(img: TImage; room: THouseRoom; index: TPoint); overload;
begin
  Self.WriteRoom(room, index);

  img := img.RotateClockWise(room.Rotation);
  Self.Map.DrawImage(img, [Self.SIZE * index.X, Self.SIZE * index.Y]);

  if (index.X > Self.HouseBounds.X1) and (index.X < Self.HouseBounds.X2) and
     (index.Y > Self.HouseBounds.Y1) and (index.Y < Self.HouseBounds.Y2) then
    Exit;

  if room.Room <> EHouseRoom.UNKNOWN then
  begin
    if index.X < Self.HouseBounds.X1 then Self.HouseBounds.X1 := index.X;
    if index.X > Self.HouseBounds.X2 then Self.HouseBounds.X2 := index.X;
    if index.Y < Self.HouseBounds.Y1 then Self.HouseBounds.Y1 := index.Y;
    if index.Y > Self.HouseBounds.Y2 then Self.HouseBounds.Y2 := index.Y;
  end;

  img := Self.GetRoomImage(EHouseRoom.UNKNOWN);
  for index.Y := 0 to Self.AMOUNT-1 do
    for index.X := 0 to Self.AMOUNT-1 do
    begin
      if Self.ReadRoom(index).Room <> EHouseRoom.UNKNOWN then Continue;
      Self.Map.DrawImage(img, [Self.SIZE * index.X, Self.SIZE * index.Y]);
    end;
end;

procedure THouseLoader.DrawMap(room: THouseRoom; p: TPoint);
begin
  Self.DrawMap(Self.GetRoomImage(room.Room), room, p);
end;



procedure THouseLoader.Redraw();
var
  img: TImage;
  index: TPoint;
  room: THouseRoom;
begin
  Self.HouseBounds := [$FFFFFF, $FFFFFF, 0, 0];

  for index.Y := 0 to Self.AMOUNT-1 do
    for index.X := 0 to Self.AMOUNT-1 do
    begin
      room := Self.ReadRoom(index);
      img := Self.GetRoomImage(room.Room).RotateClockWise(room.Rotation);
      Self.Map.DrawImage(img, [Self.SIZE * index.X, Self.SIZE * index.Y]);

      if room.Room <> EHouseRoom.UNKNOWN then
      begin
        if index.X < Self.HouseBounds.X1 then Self.HouseBounds.X1 := index.X;
        if index.X > Self.HouseBounds.X2 then Self.HouseBounds.X2 := index.X;
        if index.Y < Self.HouseBounds.Y1 then Self.HouseBounds.Y1 := index.Y;
        if index.Y > Self.HouseBounds.Y2 then Self.HouseBounds.Y2 := index.Y;
      end;
    end;
end;
{$R+}
