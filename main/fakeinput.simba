
{$DEFINE WL_FAKE_INPUT_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

{%anchor WL_DISABLE_FAKE_INPUT}
{.$DEFINE WL_DISABLE_FAKE_INPUT}

{$IFDEF WL_TEST}{$DEFINE WL_DISABLE_FAKE_INPUT}{$ENDIF}

{$IFNDEF WL_DISABLE_FAKE_INPUT}

{$loadlib Plugins/wasp-plugins/libremoteinput/libremoteinput}

type

  TRemoteInput = record
    Target: Pointer;
    Window: TWindowHandle;
  end;


procedure TRemoteInput.Setup();
var
  timer: TCountDown;
  pid: TProcessID;
begin
  if Target.Info.Kind <> ETargetKind.WINDOW then
    raise GetDebugLn('RemoteInput', 'Can''t get target window.');

  Self.Window := Target.Info.Window;

  case Self.Window.GetClassName() of
    'SunAwtCanvas', 'net-runelite-client-RuneLite': ;
    else Exit;
  end;

  pid := Self.Window.GetPID();

  try
    RIInject(pid);
  except
    if GetExceptionMessage() = 'Access violation' then
      ErrorDialog(
        'RemoteInput',
        'A different RemoteInput has already been paired with this client.' +
        LINE_SEP + LINE_SEP + 'Please open a new one.'
      );
    raise GetExceptionMessage();
  end;

  timer.Start(2000);
  repeat
    try
      Self.Target := EIOS_PairClient(pid);
    except
      if GetExceptionMessage() = 'Access violation' then
        ErrorDialog(
          'RemoteInput',
          'A different RemoteInput has already been paired with this client.' +
          LINE_SEP + LINE_SEP + 'Please open a new one.'
        );
      raise GetExceptionMessage();
    end;

    if Self.Target <> nil then
      Break;
    Sleep(100);
  until timer.IsFinished;

  if Self.Target = nil then
  begin
    DebugLn('RemoteInput', 'Invalid target for RemoteInput, RemoteInput will not be used.', ELogLevel.WARN);
    Exit;
  end;

  try
    Target.SetPlugin({$MACRO LOADEDLIB(libremoteinput)}, ToStr(pid), Client.Canvas);
  except
    if GetExceptionMessage() = 'Access violation' then
      ErrorDialog(
        'RemoteInput',
        'A different RemoteInput has already been paired with this client.' +
        LINE_SEP + LINE_SEP + 'Please open a new one.'
      );

    raise GetExceptionMessage();
  end;
end;

var

  RemoteInput: TRemoteInput;

{$IFDEF WINDOWS}
{$loadlib Plugins/wasp-plugins/waspinput/waspinput}

type

  TWaspInput = record
    Target: Pointer;
    Window: TWindowHandle;
  end;


procedure TWaspInput.Setup();
var
  pid: TProcessID;
begin
  if Target.Info.Kind <> ETargetKind.WINDOW then
    raise GetDebugLn('WaspInput', 'Can''t get target window.');

  Self.Window := Target.Info.Window;
  if Self.Window.GetClassName() <> 'JagRenderView' then
    Exit;

  pid := Self.Window.GetPID();
  Inject({$MACRO LOADEDLIB(waspinput)}, pid);
  Target.SetPlugin({$MACRO LOADEDLIB(waspinput)}, ToStr(pid), Client.Canvas);
  Self.Target := @pid;
end;

var
  WaspInput: TWaspInput;
{$ENDIF}
{$ENDIF}



procedure TClient.Clear();
begin
  if Self.Canvas <> nil then
    Self.Canvas.Clear();
end;



procedure TClient.LoseFocus();
{$IFNDEF WL_DISABLE_FAKE_INPUT}
var
  space: TBoxArray;
{$ENDIF}
begin
  {$IFNDEF WL_DISABLE_FAKE_INPUT}
  case Client.Typ of
    {$IFDEF WINDOWS}
    EClient.OFFICIAL:
      if WaspInput.Target <> nil then
      begin
        space := Target.Bounds.Expand(50).Invert(Target.Bounds.Expand(500));
        if Length(space) = 0 then Exit;

        DebugLn('Client', 'LoseFocus method is not implemented for WaspInput yet.', ELogLevel.WARN);
        Exit;
      end;
    {$ENDIF}
    EClient.LEGACY, EClient.RUNELITE:
      if RemoteInput.Target <> nil then
      begin
        space := Target.Bounds.Expand(50).Invert(Target.Bounds.Expand(500));
        if Length(space) = 0 then Exit;

        Target.MouseMove(Space.Random());
        Target.MouseClick(EMouseButton.LEFT);
        Exit;
      end;
  end;
  {$ENDIF}
  DebugLn('Client', 'LoseFocus method is not implemented without a fake input tool.', ELogLevel.WARN);
end;

procedure TClient.LoseFocus(delay: UInt32); overload;
begin
  Sleep(delay);
  Self.LoseFocus();
end;



function TClient.IsInputEnabled(): Boolean;
begin
  {$IFNDEF WL_DISABLE_FAKE_INPUT}
  case Client.Typ of
    {$IFDEF WINDOWS}
    EClient.OFFICIAL: if WaspInput.Target <> nil then Exit(GetInputState());
    {$ENDIF}
    EClient.LEGACY, EClient.RUNELITE:
      if RemoteInput.Target <> nil then
        Exit(EIOS_IsMouseInputEnabled(RemoteInput.Target) and EIOS_IsKeyboardInputEnabled(RemoteInput.Target));
  end;
  {$ENDIF}
  DebugLn('Client', 'IsInputEnabled method is not implemented without a fake input tool.', ELogLevel.WARN);
  Result := False;
end;



procedure TClient.DisableRealInput();
begin
  {$IFNDEF WL_DISABLE_FAKE_INPUT}
  case Client.Typ of
    {$IFDEF WINDOWS}
    EClient.OFFICIAL: if WaspInput.Target <> nil then SetInputState(False);
    {$ENDIF}
    EClient.LEGACY, EClient.RUNELITE:
      if RemoteInput.Target <> nil then
      begin
        EIOS_SetMouseInputEnabled(RemoteInput.Target, False);
        EIOS_SetKeyboardInputEnabled(RemoteInput.Target, False);
      end;
  end;
  {$ELSE}
  DebugLn('Client', 'DisableRealInput method is not implemented without a fake input tool.', ELogLevel.WARN);
  {$ENDIF}
end;


procedure TClient.EnableRealInput();
begin
  {$IFNDEF WL_DISABLE_FAKE_INPUT}
  case Client.Typ of
    {$IFDEF WINDOWS}
    EClient.OFFICIAL: if WaspInput.Target <> nil then SetInputState(True);
    {$ENDIF}
    EClient.LEGACY, EClient.RUNELITE:
      if RemoteInput.Target <> nil then
      begin
        EIOS_SetMouseInputEnabled(RemoteInput.Target, True);
        EIOS_SetKeyboardInputEnabled(RemoteInput.Target, True);
      end;
  end;
  {$ELSE}
  DebugLn('Client', 'EnableRealInput method is not implemented without a fake input tool.', ELogLevel.WARN);
  {$ENDIF}
end;


procedure TClient.InjectInput();
begin
  {$IFNDEF WL_DISABLE_FAKE_INPUT}
  case Self.Typ of
    {$IFDEF WINDOWS}
    EClient.OFFICIAL: WaspInput.Setup();
    {$ENDIF}
    EClient.LEGACY, EClient.RUNELITE: RemoteInput.Setup();
  end;

  AddOnTerminate(@Self.Clear);
  AddOnTerminate(@Self.EnableRealInput);
  {$ELSE}
  DebugLn('Client', 'InjectInput method is not implemented without a fake input tool.', ELogLevel.WARN);
  {$ENDIF}
end;
